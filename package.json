{
  "name": "suhendar-aryadi-blog",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build && node -e \"const fs=require('fs');const p='.vercel/output/functions/_render.func/.vc-config.json';if(fs.existsSync(p)){let c=fs.readFileSync(p,'utf8').replace('nodejs18.x','nodejs20.x');fs.writeFileSync(p,c);}\" && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/mdx": "^3.0.0",
    "@astrojs/vercel": "^7.8.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.7",
    "@vercel/postgres": "^0.10.0",
    "astro": "^4.10.0",
    "bcryptjs": "^3.0.3",
    "sql.js": "^1.14.1",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/sql.js": "^1.4.11",
    "pagefind": "^1.1.0"
  }
}
