---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect(`/auth/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const KKM = 75;

const caseStudies = [
  {
    id: 'tugas-flowchart',
    caseNumber: 1,
    title: 'Studi Kasus 1: Pengumpulan Revisi Tugas LKPD Flowchart',
    shortTitle: 'Revisi Tugas Flowchart',
    category: 'Akademik / Sekolah',
    badgeClass: 'badge-purple',
    icon: '📚',
    scenario: 'Anda baru saja menyelesaikan perbaikan (revisi) tugas LKPD 2 Flowchart & Pseudocode. Anda diminta mengirimkan berkas diagram alir (format PDF) dan ringkasan perbaikan langsung kepada Guru Pengampu (Pak Suhendar Aryadi, S.Pd.,Gr.). Tembusan (Cc) dikirimkan kepada Guru Pendamping (Pak Sopiyudin Latif).',
    defaultTo: 'suhendararyadi@guru.smk.belajar.id',
    defaultCc: 'sopiyudinlatif05@guru.smk.belajar.id',
    suggestedSubject: `[${user.class_name || '10 RPL 3'}] Pengumpulan Revisi Tugas LKPD 2 Flowchart - ${user.name}`,
    bodyPlaceholder: `Yth. Bapak Suhendar Aryadi, S.Pd.,Gr.\nGuru Mata Pelajaran Informatika SMK\n\nSelamat pagi Bapak,\n\nPerkenalkan saya ${user.name} dari kelas ${user.class_name || '10 RPL 3'}. Bersama email ini, saya bermaksud mengumpulkan revisi tugas LKPD 2 Perancangan Flowchart & Pseudocode yang telah saya perbaiki sesuai arahan Bapak pada pertemuan sebelumnya.\n\nAdapun perbaikan yang saya lakukan mencakup koreksi simbol decision (percabangan) dan penulisan algoritma looping. Berkas diagram alir lengkap telah saya lampirkan pada email ini dalam format PDF.\n\nDemikian pesan ini saya sampaikan. Terima kasih banyak atas bimbingan dan waktu yang Bapak berikan.\n\nHormat saya,\n\n${user.name}\nSiswa Kelas ${user.class_name || '10 RPL 3'}\nSMK Negeri 1 Talaga`,
    attachmentPlaceholder: `LKPD2_Flowchart_${user.name.replace(/\s+/g, '')}_${(user.class_name || '10RPL3').replace(/\s+/g, '')}.pdf`
  },
  {
    id: 'izin-kendala',
    caseNumber: 2,
    title: 'Studi Kasus 2: Permohonan Dispensasi & Laporan Kendala Teknis Lab',
    shortTitle: 'Kendala Teknis & Izin Lab',
    category: 'Etika Komunikasi Izin',
    badgeClass: 'badge-cyan',
    icon: '🛠️',
    scenario: 'Saat praktikum berlangsung, komputer lab Anda mengalami kegagalan sistem (OS crash) sehingga berkas proyek belum sempat diunggah tepat waktu sebelum bel pulang. Anda diminta menyusun email permohonan dispensasi perpanjangan waktu pengumpulan (1x24 jam) kepada Guru Pengampu dengan bahasa yang santun, menjelaskan kronologi secara jujur, dan melampirkan foto kendala layar eror.',
    defaultTo: 'suhendararyadi@guru.smk.belajar.id',
    defaultCc: '',
    suggestedSubject: `[${user.class_name || '10 RPL 3'}] Permohonan Dispensasi & Laporan Kendala Lab - ${user.name}`,
    bodyPlaceholder: `Yth. Bapak Suhendar Aryadi, S.Pd.,Gr.\nGuru Pengampu Lab Informatika\n\nSelamat siang Bapak,\n\nSaya ${user.name} dari kelas ${user.class_name || '10 RPL 3'}. Mohon izin mengabarkan bahwa pada sesi praktikum hari ini, komputer PC-08 yang saya gunakan mengalami kendala sistem (bluescreen/crash) sebelum proses submit selesai.\n\nMelalui email ini, saya bermaksud memohon izin dispensasi perpanjangan waktu pengumpulan hingga esok pagi pukul 08.00 WIB agar saya dapat mengekspor ulang berkas praktikum di perpustakaan sekolah. Foto bukti kendala layar telah saya lampirkan sebagai bahan pertimbangan Bapak.\n\nMohon maaf atas ketidaknyamanan ini dan terima kasih banyak atas kebijaksanaan Bapak.\n\nHormat saya,\n\n${user.name}\nSiswa Kelas ${user.class_name || '10 RPL 3'}\nSMK Negeri 1 Talaga`,
    attachmentPlaceholder: `Bukti_Kendala_PC08_LabRPL_${user.name.replace(/\s+/g, '')}.jpg`
  },
  {
    id: 'lamaran-magang',
    caseNumber: 3,
    title: 'Studi Kasus 3: Surat Pengantar Permohonan Magang PKL Industri',
    shortTitle: 'Permohonan Magang PKL',
    category: 'Dunia Kerja & PKL',
    badgeClass: 'badge-amber',
    icon: '💼',
    scenario: 'Anda mewakili diri sendiri untuk mengajukan permohonan tempat Praktik Kerja Lapangan (PKL) / Magang di PT Solusi Inovasi Digital (Software House). Anda diminta mengirimkan surat pengantar formal kepada HRD (Ibu Maya Lestari), memperkenalkan keahlian dasar Anda di bidang RPL (HTML, CSS, JS, Python, SQL), dan melampirkan berkas CV Portofolio dalam format PDF.',
    defaultTo: 'hrd@solusidigital.id',
    defaultCc: 'hubin.smk@sekolah.sch.id',
    suggestedSubject: `[Lamaran PKL RPL] Permohonan Magang Siswa SMK - ${user.name}`,
    bodyPlaceholder: `Yth. Ibu Maya Lestari\nHRD PT Solusi Inovasi Digital\n\nDengan hormat,\n\nPerkenalkan saya ${user.name}, siswa kelas ${user.class_name || '10 RPL 3'} Program Keahlian Rekayasa Perangkat Lunak di SMK Negeri 1 Talaga. Melalui surel ini, saya bermaksud mengajukan permohonan untuk melaksanakan Praktik Kerja Lapangan (PKL) / Magang di PT Solusi Inovasi Digital pada posisi Junior Web Developer.\n\nSelama pembelajaran di sekolah, saya telah memiliki pemahaman dasar dalam pengembangan web modern (HTML, CSS, JavaScript, SQL, dan Python) serta aktif menyelesaikan berbagai proyek praktikum algoritma. Bersama email ini, saya lampirkan berkas Curriculum Vitae (CV) dan tautan portofolio proyek untuk bahan pertimbangan Ibu.\n\nBesar harapan saya untuk memperoleh kesempatan wawancara dan berkontribusi di perusahaan yang Ibu pimpin. Terima kasih atas perhatian dan waktu Ibu.\n\nHormat saya,\n\n${user.name}\nSiswa RPL SMK Negeri 1 Talaga\nNo. HP: 0812-3456-7890 | Email: ${user.email}`,
    attachmentPlaceholder: `CV_Portofolio_${user.name.replace(/\s+/g, '')}_RPL.pdf`
  }
];

// Fetch all submissions for active user
let userSubmissions: any[] = [];
const submissionsMap: Record<string, any> = {};

try {
  const subRes = await query(
    `SELECT * FROM lkpd_email_submissions WHERE user_id = $1 ORDER BY updated_at ASC`,
    [user.id]
  );
  if (subRes.rows) {
    userSubmissions = subRes.rows;
    userSubmissions.forEach(r => {
      submissionsMap[r.case_study_id] = r;
    });
  }
} catch (e) {
  console.warn('Error fetching email submissions:', e);
}

const submittedCount = Object.keys(submissionsMap).length;
const isAllCasesSubmitted = submittedCount >= caseStudies.length;

// Preload initial active case
const initialActiveCaseId = caseStudies[0].id;
---

<MainLayout
  title="LKPD Praktik: Simulator 3 Studi Kasus Email Profesional | SMK RPL"
  description="Lembar Kerja Peserta Didik (LKPD) Interaktif: Praktik Menulis Surat Elektronik Formal Berstandar Industri untuk 3 Skenario Wajib."
>
  <div class="lkpd-page-container">
    <!-- Top Navigation -->
    <div class="page-top-nav">
      <a href="/belajar/etika-email" class="btn btn-outline btn-sm">
        &larr; Kembali ke Materi Etika Email
      </a>
      <div class="top-nav-right">
        <span class="badge badge-purple">LKPD SOFTSKILL</span>
        <span class="badge badge-cyan">3 SKENARIO WAJIB</span>
      </div>
    </div>

    <!-- Student Header & Summary Progress Banner -->
    <div class="student-header glass-card">
      <div class="header-content">
        <div class="user-meta">
          <div class="avatar-box">{user.name.charAt(0).toUpperCase()}</div>
          <div>
            <h1 class="student-title">{user.name}</h1>
            <p class="student-sub">
              Kelas / Rombel: <strong>{user.class_name || '10 RPL'}</strong> | Email Resmi: <code>{user.email}</code>
            </p>
          </div>
        </div>

        <div class="progress-summary-box">
          <div class="progress-info">
            <span class="progress-label">Progres LKPD Etika Email:</span>
            <span class="progress-val"><strong>{submittedCount}</strong> dari <strong>{caseStudies.length}</strong> Kasus Selesai</span>
          </div>
          <div class="progress-bar-bg">
            <div class="progress-bar-fill" style={`width: ${(submittedCount / caseStudies.length) * 100}%`}></div>
          </div>
        </div>
      </div>

      {isAllCasesSubmitted ? (
        <div class="all-done-banner">
          🎉 <strong>Seluruh 3 Studi Kasus Telah Dikirim!</strong> Anda telah menyelesaikan simulasi korespondensi untuk ranah Akademik, Komunikasi Izin/Kendala, dan Dunia Industri (PKL). Guru akan memeriksa dan memberikan penilaian per skenario.
        </div>
      ) : (
        <div class="instruction-banner">
          📌 <strong>Petunjuk Pengerjaan:</strong> Anda diwajibkan menyelesaikan <strong>seluruh 3 studi kasus</strong> di bawah secara berurutan. Klik tab tiap kasus, lengkapi pesan surel pada komposer, dan tekan tombol <strong>"Kirim Jawaban Kasus"</strong>.
        </div>
      )}
    </div>

    <!-- 3 Case Studies Stepper Nav -->
    <div class="case-stepper-card glass-card">
      <div class="stepper-title-row">
        <h2>Pilih Studi Kasus untuk Dikerjakan:</h2>
        <span class="text-sm text-muted">Pastikan ketiga kasus tercentang hijau</span>
      </div>

      <div class="stepper-grid">
        {caseStudies.map((cs) => {
          const sub = submissionsMap[cs.id];
          const isGraded = sub?.score !== null && sub?.score !== undefined;
          const score = isGraded ? parseInt(sub.score, 10) : null;
          const isPass = score !== null && score >= KKM;

          return (
            <button
              type="button"
              class={`step-card ${cs.id === initialActiveCaseId ? 'step-active' : ''} ${sub ? 'step-completed' : ''}`}
              data-case-id={cs.id}
              id={`btn-step-${cs.id}`}
            >
              <div class="step-card-header">
                <span class="step-icon">{cs.icon}</span>
                <span class={`badge ${cs.badgeClass}`}>KASUS {cs.caseNumber}</span>
              </div>
              <h3 class="step-title">{cs.shortTitle}</h3>
              <p class="step-desc">{cs.category}</p>
              
              <div class="step-status">
                {sub ? (
                  isGraded ? (
                    <span class={`status-pill ${isPass ? 'pill-pass' : 'pill-remedial'}`}>
                      {isPass ? `✅ Tuntas (${score}/100)` : `⚠️ Remedial (${score}/100)`}
                    </span>
                  ) : (
                    <span class="status-pill pill-waiting">
                      ⏳ Terkirim (Menunggu Guru)
                    </span>
                  )
                ) : (
                  <span class="status-pill pill-empty">
                    📝 Belum Dikerjakan
                  </span>
                )}
              </div>
            </button>
          );
        })}
      </div>
    </div>

    <!-- Active Scenario Brief Box -->
    <div class="scenario-brief glass-card" id="scenario-brief-card">
      <div class="scenario-header">
        <div class="scenario-title-wrap">
          <span class="badge badge-purple" id="brief-badge">STUDI KASUS 1</span>
          <h2 id="brief-title">{caseStudies[0].title}</h2>
        </div>
      </div>
      <p class="scenario-desc" id="brief-desc">{caseStudies[0].scenario}</p>
      <div class="scenario-targets">
        <div class="target-item">
          <strong>Penerima Utama (To):</strong>
          <code id="brief-to">{caseStudies[0].defaultTo}</code>
        </div>
        <div class="target-item" id="brief-cc-wrap">
          <strong>Tembusan (Cc):</strong>
          <code id="brief-cc">{caseStudies[0].defaultCc || '(Tidak ada)'}</code>
        </div>
      </div>
    </div>

    <!-- Workspace Layout: Email Window + Etiquette Inspector -->
    <div class="workspace-layout">
      <!-- Main Email Window Frame -->
      <div class="email-window glass-card">
        <div class="window-topbar">
          <div class="window-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <div class="window-title" id="window-header-title">Pesan Baru — Studi Kasus 1</div>
          <div class="window-actions-dummy">
            <span>🗕</span>
            <span>🗖</span>
            <span>✕</span>
          </div>
        </div>

        <form id="email-simulator-form" class="email-form">
          <!-- Hidden Case Study Input -->
          <input type="hidden" id="input-case-id" name="caseStudyId" value={initialActiveCaseId} />

          <!-- From (Readonly) -->
          <div class="field-row">
            <label class="field-label" for="input-from">Dari (From):</label>
            <div class="field-input-wrap">
              <input type="text" id="input-from" class="field-input readonly-input" value={`${user.name} <${user.email}>`} readonly />
            </div>
          </div>

          <!-- To -->
          <div class="field-row">
            <label class="field-label" for="input-to">Kepada (To):</label>
            <div class="field-input-wrap">
              <input 
                type="email" 
                id="input-to" 
                name="recipientTo"
                class="field-input" 
                placeholder="nama.guru@sekolah.sch.id" 
                value={submissionsMap[initialActiveCaseId]?.recipient_to || caseStudies[0].defaultTo} 
                onpaste="return false;"
                ondrop="return false;"
                autocomplete="off"
                required 
              />
            </div>
          </div>

          <!-- Cc -->
          <div class="field-row">
            <label class="field-label" for="input-cc">Tembusan (Cc):</label>
            <div class="field-input-wrap">
              <input 
                type="text" 
                id="input-cc" 
                name="recipientCc"
                class="field-input" 
                placeholder="rekan.tim@sekolah.sch.id / guru.pendamping@sekolah.sch.id (Opsional)" 
                value={submissionsMap[initialActiveCaseId]?.recipient_cc || caseStudies[0].defaultCc} 
                onpaste="return false;"
                ondrop="return false;"
                autocomplete="off"
              />
            </div>
          </div>

          <!-- Subject -->
          <div class="field-row">
            <label class="field-label" for="input-subject">Subjek (Subject):</label>
            <div class="field-input-wrap">
              <input 
                type="text" 
                id="input-subject" 
                name="subjectText"
                class="field-input font-medium" 
                placeholder="[KELAS] - [PERIHAL TUGAS] - [NAMA LENGKAP]" 
                value={submissionsMap[initialActiveCaseId]?.subject_text || ''} 
                onpaste="return false;"
                ondrop="return false;"
                autocomplete="off"
                required 
              />
            </div>
          </div>

          <!-- Body Textarea -->
          <div class="body-field-wrap">
            <div class="toolbar-hint">
              <span>✍️ Struktur: (1) Salam Formal &rarr; (2) Identitas &rarr; (3) Inti &rarr; (4) Penutup &amp; Signature</span>
              <span class="anti-paste-badge">🔒 Anti-Paste Aktif (Wajib Ketik Langsung)</span>
              <span id="char-count" class="font-mono text-muted">0 karakter</span>
            </div>
            <textarea 
              id="input-body" 
              name="bodyText"
              class="body-textarea" 
              placeholder={caseStudies[0].bodyPlaceholder} 
              rows="14" 
              onpaste="return false;"
              ondrop="return false;"
              autocomplete="off"
              required
            >{submissionsMap[initialActiveCaseId]?.body_text || ''}</textarea>
          </div>

          <!-- Attachment Section -->
          <div class="attachment-box">
            <div class="att-header">
              <span>📎 Berkas Lampiran &amp; Tautan Dokumen</span>
            </div>
            <div class="att-grid">
              <div>
                <label for="input-attachment-name" class="att-label">Nama Berkas Lampiran:</label>
                <input 
                  type="text" 
                  id="input-attachment-name" 
                  name="attachmentName"
                  class="field-input font-mono text-sm" 
                  placeholder={caseStudies[0].attachmentPlaceholder} 
                  value={submissionsMap[initialActiveCaseId]?.attachment_name || ''} 
                  onpaste="return false;"
                  ondrop="return false;"
                  autocomplete="off"
                />
              </div>
              <div>
                <label for="input-attachment-link" class="att-label">Tautan Google Drive / GitHub (Opsional):</label>
                <input 
                  type="url" 
                  id="input-attachment-link" 
                  name="attachmentLink"
                  class="field-input font-mono text-sm" 
                  placeholder="https://drive.google.com/... (Izin Viewer dibuka)" 
                  value={submissionsMap[initialActiveCaseId]?.attachment_link || ''} 
                  onpaste="return false;"
                  ondrop="return false;"
                  autocomplete="off"
                />
              </div>
            </div>
          </div>

          <!-- Active Case Teacher Feedback if exists -->
          <div id="case-feedback-box" class="teacher-feedback-alert" style="display: none;">
            <div class="tf-title">Catatan &amp; Umpan Balik Guru untuk Kasus Ini:</div>
            <p class="tf-text" id="case-feedback-text"></p>
          </div>

          <!-- Action Footer -->
          <div class="form-footer">
            <div id="submit-status-msg" class="status-msg"></div>
            <button id="submit-email-btn" type="submit" class="btn btn-primary btn-md">
              <span id="submit-btn-text">🚀 Simpan &amp; Kirim Jawaban Kasus 1</span>
            </button>
          </div>
        </form>
      </div>

      <!-- Live Etiquette Inspector / Linter Widget -->
      <div class="inspector-pane glass-card">
        <div class="inspector-header">
          <span class="badge badge-purple">REAL-TIME EVALUATOR</span>
          <h3>Etiquette Inspector</h3>
          <p>Pemeriksaan otomatis kesesuaian surel Anda dengan standar etika formal industri sebelum dikirim:</p>
        </div>

        <div class="checklist-items">
          <div id="check-subject" class="check-item check-warn">
            <div class="check-icon">⏳</div>
            <div class="check-text">
              <strong>Format Subjek Standar</strong>
              <span>Memuat kelas dalam kurung siku <code>[10 RPL ...]</code> dan perihal yang jelas.</span>
            </div>
          </div>

          <div id="check-salutation" class="check-item check-warn">
            <div class="check-icon">⏳</div>
            <div class="check-text">
              <strong>Salam Pembuka Formal</strong>
              <span>Terdapat sapaan santun (seperti <em>"Yth."</em>, <em>"Selamat pagi/siang"</em>, atau <em>"Dengan hormat"</em>).</span>
            </div>
          </div>

          <div id="check-identity" class="check-item check-warn">
            <div class="check-icon">⏳</div>
            <div class="check-text">
              <strong>Perkenalan Identitas Diri</strong>
              <span>Menyebutkan nama dan kelas/sekolah pada paragraf pembuka.</span>
            </div>
          </div>

          <div id="check-signature" class="check-item check-warn">
            <div class="check-icon">⏳</div>
            <div class="check-text">
              <strong>Salam Penutup &amp; Signature</strong>
              <span>Terdapat salam resmi (<em>"Hormat saya"</em>) dan identitas pengirim di akhir.</span>
            </div>
          </div>

          <div id="check-slang" class="check-item check-pass">
            <div class="check-icon">✅</div>
            <div class="check-text">
              <strong>Bebas Singkatan &amp; Slang Chat</strong>
              <span>Pilihan kata menggunakan bahasa Indonesia baku yang baik.</span>
            </div>
          </div>

          <div id="check-attachment" class="check-item check-warn">
            <div class="check-icon">⏳</div>
            <div class="check-text">
              <strong>Nama Berkas Terstruktur</strong>
              <span>Nama file lampiran jelas dan tidak acak (misal: memuat nama &amp; kelas).</span>
            </div>
          </div>
        </div>

        <div class="tips-box">
          <div class="tips-title">💡 Panduan Guru:</div>
          <p>Pastikan sebelum menekan tombol kirim, Anda telah membaca ulang (*proofreading*) seluruh kalimat dan memastikan tidak ada kata chat kasual.</p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ caseStudiesData: caseStudies, initialSubmissions: submissionsMap, userClass: user.class_name || '10 RPL 3', userName: user.name }}>
  document.addEventListener('DOMContentLoaded', () => {
    let activeCaseId = caseStudiesData[0].id;
    const clientSubmissions = { ...initialSubmissions };

    // DOM Elements
    const stepButtons = document.querySelectorAll('.step-card');
    const briefBadge = document.getElementById('brief-badge');
    const briefTitle = document.getElementById('brief-title');
    const briefDesc = document.getElementById('brief-desc');
    const briefTo = document.getElementById('brief-to');
    const briefCc = document.getElementById('brief-cc');
    const windowHeaderTitle = document.getElementById('window-header-title');

    const form = document.getElementById('email-simulator-form');
    const caseInput = document.getElementById('input-case-id');
    const toInput = document.getElementById('input-to');
    const ccInput = document.getElementById('input-cc');
    const subjectInput = document.getElementById('input-subject');
    const bodyInput = document.getElementById('input-body');
    const attNameInput = document.getElementById('input-attachment-name');
    const attLinkInput = document.getElementById('input-attachment-link');
    const charCount = document.getElementById('char-count');
    const submitBtn = document.getElementById('submit-email-btn');
    const submitBtnText = document.getElementById('submit-btn-text');
    const statusMsg = document.getElementById('submit-status-msg');
    const caseFeedbackBox = document.getElementById('case-feedback-box');
    const caseFeedbackText = document.getElementById('case-feedback-text');

    // Inspector Elements
    const checkSubject = document.getElementById('check-subject');
    const checkSalutation = document.getElementById('check-salutation');
    const checkIdentity = document.getElementById('check-identity');
    const checkSignature = document.getElementById('check-signature');
    const checkSlang = document.getElementById('check-slang');
    const checkAttachment = document.getElementById('check-attachment');

    const bannedSlangs = ['gw', 'gue', 'lu', 'lo', 'klo', 'kalo', 'bgt', 'banget', 'gmn', 'gimana', 'tks', 'thx', 'thanks', 'makasih', 'mksih', 'oy', 'oi', 'gan', 'bro', 'sis', 'dgn', 'dg', 'yg', 'utk', 'pls', 'please', '^p$'];

    function saveCurrentFormStateToMemory() {
      if (!clientSubmissions[activeCaseId]) {
        clientSubmissions[activeCaseId] = {};
      }
      clientSubmissions[activeCaseId].recipient_to = toInput?.value || '';
      clientSubmissions[activeCaseId].recipient_cc = ccInput?.value || '';
      clientSubmissions[activeCaseId].subject_text = subjectInput?.value || '';
      clientSubmissions[activeCaseId].body_text = bodyInput?.value || '';
      clientSubmissions[activeCaseId].attachment_name = attNameInput?.value || '';
      clientSubmissions[activeCaseId].attachment_link = attLinkInput?.value || '';
    }

    function switchActiveCase(targetCaseId) {
      saveCurrentFormStateToMemory();
      activeCaseId = targetCaseId;

      const currentCase = caseStudiesData.find(c => c.id === targetCaseId) || caseStudiesData[0];
      const savedData = clientSubmissions[targetCaseId];

      // Update Step Card UI
      stepButtons.forEach(btn => {
        if (btn.getAttribute('data-case-id') === targetCaseId) {
          btn.classList.add('step-active');
        } else {
          btn.classList.remove('step-active');
        }
      });

      // Update Scenario Brief
      if (briefBadge) briefBadge.textContent = `STUDI KASUS ${currentCase.caseNumber}`;
      if (briefTitle) briefTitle.textContent = currentCase.title;
      if (briefDesc) briefDesc.textContent = currentCase.scenario;
      if (briefTo) briefTo.textContent = currentCase.defaultTo;
      if (briefCc) briefCc.textContent = currentCase.defaultCc || '(Tidak ada)';
      if (windowHeaderTitle) windowHeaderTitle.textContent = `Pesan Baru — Studi Kasus ${currentCase.caseNumber}`;

      // Populate Form Fields
      if (caseInput) caseInput.value = targetCaseId;
      if (toInput) toInput.value = savedData?.recipient_to || currentCase.defaultTo;
      if (ccInput) ccInput.value = savedData?.recipient_cc !== undefined ? savedData.recipient_cc : currentCase.defaultCc;
      if (subjectInput) {
        subjectInput.value = savedData?.subject_text || '';
        subjectInput.placeholder = currentCase.suggestedSubject;
      }
      if (bodyInput) {
        bodyInput.value = savedData?.body_text || '';
        bodyInput.placeholder = currentCase.bodyPlaceholder;
      }
      if (attNameInput) {
        attNameInput.value = savedData?.attachment_name || '';
        attNameInput.placeholder = currentCase.attachmentPlaceholder;
      }
      if (attLinkInput) {
        attLinkInput.value = savedData?.attachment_link || '';
      }

      // Check grading & lock status
      const isGraded = savedData?.score !== null && savedData?.score !== undefined;
      const score = isGraded ? parseInt(savedData.score, 10) : null;
      const isPass = score !== null && score >= 75;

      if (isPass) {
        toInput.disabled = true;
        ccInput.disabled = true;
        subjectInput.disabled = true;
        bodyInput.disabled = true;
        attNameInput.disabled = true;
        attLinkInput.disabled = true;
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.className = 'btn btn-secondary btn-md';
        }
        if (submitBtnText) submitBtnText.textContent = `🔒 Kasus ${currentCase.caseNumber} Terkunci (Tuntas KKM: ${score}/100)`;
      } else {
        toInput.disabled = false;
        ccInput.disabled = false;
        subjectInput.disabled = false;
        bodyInput.disabled = false;
        attNameInput.disabled = false;
        attLinkInput.disabled = false;
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.className = 'btn btn-primary btn-md';
        }
        if (submitBtnText) {
          submitBtnText.textContent = savedData?.id 
            ? `🔄 Simpan Ulang Jawaban Kasus ${currentCase.caseNumber}` 
            : `🚀 Simpan & Kirim Jawaban Kasus ${currentCase.caseNumber}`;
        }
      }

      // Feedback display
      if (caseFeedbackBox && caseFeedbackText) {
        if (savedData?.teacher_feedback) {
          caseFeedbackText.textContent = savedData.teacher_feedback;
          caseFeedbackBox.style.display = 'block';
        } else {
          caseFeedbackBox.style.display = 'none';
        }
      }

      if (statusMsg) statusMsg.textContent = '';
      runInspector();
    }

    // Step button click listeners
    stepButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetCaseId = btn.getAttribute('data-case-id');
        if (targetCaseId) switchActiveCase(targetCaseId);
      });
    });

    function runInspector() {
      const sub = (subjectInput?.value || '').trim();
      const body = (bodyInput?.value || '').trim();
      const att = (attNameInput?.value || '').trim();

      if (charCount) {
        charCount.textContent = `${body.length} karakter`;
      }

      // 1. Check Subject Formula [KELAS] ...
      const subRegex = /\[.*?(rpl|x|xi|xii|tkj|dkv|\d).*?\]\s*.+/i;
      if (sub.length > 5 && subRegex.test(sub)) {
        setCheck(checkSubject, true, 'Format Subjek Sesuai Formula Baku', 'Memuat label kelas dalam kurung siku dan perihal yang jelas.');
      } else {
        setCheck(checkSubject, false, 'Format Subjek Belum Tepat', 'Gunakan format: [KELAS] - [PERIHAL TUGAS/SURAT] - [NAMA LENGKAP].');
      }

      // 2. Check Salutation
      const bodyLower = body.toLowerCase();
      const salutationRegex = /(yth\.|selamat\s+(pagi|siang|sore|malam)|assalamu|kepada\s+yth|dengan\s+hormat|dear)/i;
      if (salutationRegex.test(bodyLower)) {
        setCheck(checkSalutation, true, 'Salam Pembuka Santun', 'Terdeteksi sapaan pembuka formal yang sopan.');
      } else {
        setCheck(checkSalutation, false, 'Salam Pembuka Belum Ada', 'Awali dengan "Yth. Bapak/Ibu..." atau "Dengan hormat,".');
      }

      // 3. Check Identity Introduction
      const identityRegex = /(saya|nama\s+saya|perkenalkan|dari\s+kelas|siswa\s+kelas|siswa\s+rpl)/i;
      if (identityRegex.test(bodyLower) && body.length > 30) {
        setCheck(checkIdentity, true, 'Perkenalan Identitas Lengkap', 'Menyebutkan identitas diri dan kelas/sekolah secara jelas.');
      } else {
        setCheck(checkIdentity, false, 'Perkenalan Identitas Belum Jelas', 'Tuliskan perkenalan nama dan kelas di paragraf pembuka.');
      }

      // 4. Check Signature
      const signRegex = /(hormat\s+saya|salam\s+takzim|wassalamu|terima\s+kasih)/i;
      const hasSign = signRegex.test(bodyLower) && body.split('\n').length >= 3;
      if (hasSign) {
        setCheck(checkSignature, true, 'Salam Penutup & Signature Terisi', 'Terdapat salam penutup resmi dan blok tanda tangan pengirim.');
      } else {
        setCheck(checkSignature, false, 'Signature Penutup Belum Lengkap', 'Tutup dengan "Hormat saya," diikuti nama lengkap & kelas.');
      }

      // 5. Check Slang words
      const words = bodyLower.replace(/[^a-z0-9\s]/g, ' ').split(/\s+/);
      const foundSlangs = [];
      words.forEach((w) => {
        if (bannedSlangs.includes(w) && !foundSlangs.includes(w)) {
          foundSlangs.push(w);
        }
      });

      if (foundSlangs.length === 0) {
        setCheck(checkSlang, true, 'Bebas Singkatan & Slang Chat', 'Pilihan kata menggunakan bahasa Indonesia baku yang baik.');
      } else {
        setCheck(checkSlang, false, `Terdeteksi ${foundSlangs.length} Kata Slang Chat`, `Hindari kata kasual: "${foundSlangs.slice(0, 3).join('", "')}".`);
      }

      // 6. Check Attachment Naming
      const badAttRegex = /(screenshot|fix_bgt|final_2|untitled|image|foto)/i;
      if (att.length > 4 && !badAttRegex.test(att) && att.includes('.')) {
        setCheck(checkAttachment, true, 'Nama Lampiran Profesional', `Berkas "${att}" terstruktur rapi.`);
      } else if (att.length > 0) {
        setCheck(checkAttachment, false, 'Nama Lampiran Kurang Rapi', 'Gunakan format: NamaBerkas_NamaSiswa_Kelas.pdf');
      } else {
        setCheck(checkAttachment, false, 'Lampiran Belum Diberi Nama', 'Tuliskan nama berkas lampiran yang akan dikirim.');
      }
    }

    function setCheck(el, isPass, title, desc) {
      if (!el) return;
      el.className = isPass ? 'check-item check-pass' : 'check-item check-warn';
      const icon = el.querySelector('.check-icon');
      const titleEl = el.querySelector('.check-text strong');
      const descEl = el.querySelector('.check-text span');
      if (icon) icon.textContent = isPass ? '✅' : '⏳';
      if (titleEl) titleEl.textContent = title;
      if (descEl) descEl.textContent = desc;
    }

    subjectInput?.addEventListener('input', runInspector);
    bodyInput?.addEventListener('input', runInspector);
    attNameInput?.addEventListener('input', runInspector);

    // Anti-Paste & Anti-Drop Protection: Siswa wajib mengetik langsung
    const formFields = document.querySelectorAll('#email-simulator-form input:not([readonly]), #email-simulator-form textarea');
    formFields.forEach((field) => {
      field.addEventListener('paste', (e) => {
        e.preventDefault();
        alert('⚠️ Fitur Tempel (Paste) Dinonaktifkan!\n\nUntuk melatih kebiasaan menyusun email profesional secara mandiri dan cermat, Anda diwajibkan mengetik langsung seluruh bagian surel.');
        return false;
      });
      field.addEventListener('drop', (e) => {
        e.preventDefault();
        return false;
      });
      field.addEventListener('keydown', (e) => {
        // Intercept Ctrl+V or Cmd+V
        if ((e.ctrlKey || e.metaKey) && (e.key === 'v' || e.key === 'V')) {
          e.preventDefault();
          alert('⚠️ Shortcut Tempel (Paste) Dinonaktifkan!\n\nSilakan ketik langsung pesan surel Anda untuk melatih keterampilan menulis profesional.');
          return false;
        }
      });
    });

    // Initial switch to case 1
    switchActiveCase(caseStudiesData[0].id);

    // Handle Form Submit
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      const currentCase = caseStudiesData.find(c => c.id === activeCaseId) || caseStudiesData[0];

      if (!confirm(`Kirim jawaban surel untuk ${currentCase.title} sekarang?`)) {
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        if (submitBtnText) submitBtnText.textContent = `Menyimpan Jawaban Kasus ${currentCase.caseNumber}...`;
      }
      if (statusMsg) {
        statusMsg.textContent = '';
        statusMsg.className = 'status-msg';
      }

      const payload = {
        caseStudyId: activeCaseId,
        recipientTo: toInput?.value || '',
        recipientCc: ccInput?.value || '',
        subjectText: subjectInput?.value || '',
        bodyText: bodyInput?.value || '',
        attachmentName: attNameInput?.value || '',
        attachmentLink: attLinkInput?.value || ''
      };

      try {
        const res = await fetch('/api/lkpd/submit-email', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (res.ok && data.success) {
          clientSubmissions[activeCaseId] = {
            ...clientSubmissions[activeCaseId],
            ...payload,
            updated_at: new Date().toISOString()
          };

          // Update current step card UI
          const currentStepBtn = document.getElementById(`btn-step-${activeCaseId}`);
          if (currentStepBtn) {
            currentStepBtn.classList.add('step-completed');
            const statusEl = currentStepBtn.querySelector('.step-status');
            if (statusEl) {
              statusEl.innerHTML = '<span class="status-pill pill-waiting">⏳ Terkirim (Menunggu Guru)</span>';
            }
          }

          // Check if there are other unsubmitted cases
          const currentIndex = caseStudiesData.findIndex(c => c.id === activeCaseId);
          const nextUnsubmittedCase = caseStudiesData.find((c, idx) => idx > currentIndex && !clientSubmissions[c.id]?.recipient_to) 
                                     || caseStudiesData.find(c => !clientSubmissions[c.id]?.recipient_to);

          if (nextUnsubmittedCase) {
            alert(`✅ Jawaban Kasus ${currentCase.caseNumber} berhasil disimpan!\n\nMelanjutkan ke Kasus ${nextUnsubmittedCase.caseNumber}: ${nextUnsubmittedCase.shortTitle}...`);
            switchActiveCase(nextUnsubmittedCase.id);
          } else {
            alert('🎉 Luar biasa! Seluruh 3 Studi Kasus Simulasi Email berhasil Anda selesaikan dan dikirimkan ke Guru.');
            window.location.reload();
          }
        } else {
          if (statusMsg) {
            statusMsg.className = 'status-msg status-error';
            statusMsg.textContent = '❌ ' + (data.error || 'Gagal mengirim email.');
          }
          if (submitBtn) {
            submitBtn.disabled = false;
            if (submitBtnText) submitBtnText.textContent = `🚀 Simpan & Kirim Jawaban Kasus ${currentCase.caseNumber}`;
          }
        }
      } catch (err) {
        if (statusMsg) {
          statusMsg.className = 'status-msg status-error';
          statusMsg.textContent = '❌ Terjadi kesalahan jaringan saat menyimpan.';
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          if (submitBtnText) submitBtnText.textContent = `🚀 Simpan & Kirim Jawaban Kasus ${currentCase.caseNumber}`;
        }
      }
    });
  });
</script>

