---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { query } from '../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

let enrolledCourseIds: string[] = [];

if (user) {
  try {
    const enrollRes = await query(
      `SELECT course_id FROM course_enrollments WHERE user_id = $1`,
      [user.id]
    );
    if (enrollRes.rows) {
      enrolledCourseIds = enrollRes.rows.map((r: any) => String(r.course_id).toLowerCase());
    }

    // Auto-sync if student has existing progress in LKPD or SQL
    const [bkRes, tikRes, sqlRes] = await Promise.all([
      query(`SELECT id FROM lkpd_submissions WHERE user_id = $1 LIMIT 1`, [user.id]),
      query(`SELECT id FROM lkpd_tik_submissions WHERE user_id = $1 LIMIT 1`, [user.id]),
      query(`SELECT id FROM user_progress WHERE user_id = $1 LIMIT 1`, [user.id]),
    ]);

    if (bkRes.rows && bkRes.rows.length > 0 && !enrolledCourseIds.includes('bk')) {
      enrolledCourseIds.push('bk');
      await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'bk') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]).catch(() => {});
    }
    if (tikRes.rows && tikRes.rows.length > 0 && !enrolledCourseIds.includes('tik')) {
      enrolledCourseIds.push('tik');
      await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'tik') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]).catch(() => {});
    }
    if (sqlRes.rows && sqlRes.rows.length > 0 && !enrolledCourseIds.includes('sql')) {
      enrolledCourseIds.push('sql');
      await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'sql') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]).catch(() => {});
    }
  } catch (err) {
    console.warn('Could not fetch course_enrollments in catalog:', err);
  }
}

