---

<MainLayout
  title="Pusat Pembelajaran & Kurikulum Vokasi RPL | Suhendar Aryadi, S.Pd.,Gr."
  description="Kumpulan kurikulum dan modul pembelajaran interaktif Rekayasa Perangkat Lunak (RPL) SMK."
>
  <div class="curriculum-container">
    <div class="curriculum-header">
      <span class="badge badge-cyan">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
          <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
        </svg>
        Kurikulum Pembelajaran RPL
      </span>
      <h1 class="page-title">Pusat Pembelajaran <span class="text-gradient">Pemrograman</span></h1>
      <p class="page-subtitle">
        Pilih modul dan alur kurikulum Rekayasa Perangkat Lunak SMK. Tingkatkan keahlian coding secara praktis dan interaktif.
      </p>
    </div>

    <div class="curriculum-grid">
      {curricula.map((item) => {
        const isEnrolled = item.status === 'active' && (
          item.id === 'informatika'
            ? (enrolledCourseIds.length > 0 || enrolledCourseIds.includes('informatika'))
            : enrolledCourseIds.includes(item.id)
        );

        let badgeLabel = item.statusLabel;
        let badgeClass = 'badge-status-coming';

        if (item.status === 'active') {
          if (!user) {
            badgeLabel = 'SIAP & AKTIF';
            badgeClass = 'badge-status-active';
          } else if (isEnrolled) {
            badgeLabel = '✓ TERDAFTAR';
            badgeClass = 'badge-status-enrolled';
          } else {
            badgeLabel = '🔒 BELUM ENROLL';
            badgeClass = 'badge-status-locked';
          }
        }

        return (
          <div class={`glass-card curriculum-card ${item.status === 'active' ? 'card-active' : 'card-disabled'}`}>
            <div class="card-thumb" style={`background: ${item.gradient}`}>
              <div class="thumb-pattern"></div>
              <div class="thumb-icon-box">
                {item.icon === 'cpu' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                    <rect x="9" y="9" width="6" height="6"></rect>
                    <line x1="9" y1="1" x2="9" y2="4"></line>
                    <line x1="15" y1="1" x2="15" y2="4"></line>
                    <line x1="9" y1="20" x2="9" y2="23"></line>
                    <line x1="15" y1="20" x2="15" y2="23"></line>
                    <line x1="20" y1="9" x2="23" y2="9"></line>
                    <line x1="20" y1="15" x2="23" y2="15"></line>
                    <line x1="1" y1="9" x2="4" y2="9"></line>
                    <line x1="1" y1="15" x2="4" y2="15"></line>
                  </svg>
                )}
                {item.icon === 'database' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                    <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                    <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
                  </svg>
                )}
                {item.icon === 'layout' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                    <line x1="3" y1="9" x2="21" y2="9"></line>
                    <line x1="9" y1="21" x2="9" y2="9"></line>
                  </svg>
                )}
                {item.icon === 'code' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="16 18 22 12 16 6"></polyline>
                    <polyline points="8 6 2 12 8 18"></polyline>
                  </svg>
                )}
                {item.icon === 'server' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
                    <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
                    <line x1="6" y1="6" x2="6.01" y2="6"></line>
                    <line x1="6" y1="18" x2="6.01" y2="18"></line>
                  </svg>
                )}
                {item.icon === 'terminal' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="4 17 10 11 4 5"></polyline>
                    <line x1="12" y1="19" x2="20" y2="19"></line>
                  </svg>
                )}
              </div>
              <span class={`status-badge ${badgeClass}`}>
                {badgeLabel}
              </span>
            </div>

            <div class="card-body">
              <div class="card-meta">
                <span class="category-pill">{item.category}</span>
                <span class="module-count">{item.moduleCount}</span>
              </div>

              <h2 class="card-title">{item.title}</h2>
              <p class="card-desc">{item.description}</p>

              <div class="card-tags">
                {item.tags.map((tag) => (
                  <span class="tag-item">#{tag}</span>
                ))}
              </div>

              <div class="card-footer">
                {item.status === 'active' ? (
                  isEnrolled ? (
                    <a href={item.link} class="btn btn-primary btn-full">
                      <span>{item.btnText} →</span>
                    </a>
                  ) : user ? (
                    <button
                      type="button"
                      class="btn btn-outline btn-full btn-enroll-trigger"
                      data-course-id={item.id}
                      data-course-title={item.title}
                    >
                      <span>🔒 Enroll Modul (Kode Akses)</span>
                    </button>
                  ) : (
                    <a href={`/auth/login?redirect=/belajar`} class="btn btn-primary btn-full">
                      <span>Login untuk Enroll →</span>
                    </a>
                  )
                ) : (
                  <button class="btn btn-secondary btn-full" disabled type="button">
                    <span>Segera Hadir</span>
                  </button>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- Modal Access Code / Enroll Modul -->
  <div id="enroll-access-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card glass-card">
      <div class="modal-header">
        <div class="modal-title-group">
          <div class="modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div>
            <h2 class="modal-title">Enroll Modul Pembelajaran</h2>
            <p class="modal-sub">Masukkan kode akses dari Guru untuk membuka modul ini.</p>
          </div>
        </div>
        <button id="close-enroll-modal-btn" class="modal-close" type="button" aria-label="Tutup Modal">&times;</button>
      </div>

      <div id="enroll-error-banner" class="alert alert-error" style="display: none;"></div>
      <div id="enroll-success-banner" class="alert alert-success" style="display: none;"></div>

      <form id="enroll-access-form" class="modal-form">
        <input type="hidden" id="enroll-course-id" name="courseId" value="" />
        <div class="form-group">
          <label for="enroll-course-title">Modul Pembelajaran</label>
          <input
            type="text"
            id="enroll-course-title"
            readonly
            class="form-input-readonly"
          />
        </div>

        <div class="form-group">
          <label for="enroll-access-code">Kode Akses dari Guru</label>
          <input
            type="text"
            id="enroll-access-code"
            name="accessCode"
            placeholder="Contoh: BK2026, TIK2026, SQL2026, atau RPL2026"
            required
            autocomplete="off"
          />
        </div>

        <div class="modal-footer">
          <button id="cancel-enroll-modal-btn" class="btn btn-secondary" type="button">Batal</button>
          <button type="submit" id="save-enroll-btn" class="btn btn-primary">
            <span>Daftar Modul</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  const enrollModal = document.getElementById('enroll-access-modal');
  const closeEnrollModalBtn = document.getElementById('close-enroll-modal-btn');
  const cancelEnrollModalBtn = document.getElementById('cancel-enroll-modal-btn');
  const enrollForm = document.getElementById('enroll-access-form') as HTMLFormElement | null;
  const enrollCourseIdInput = document.getElementById('enroll-course-id') as HTMLInputElement | null;
  const enrollCourseTitleInput = document.getElementById('enroll-course-title') as HTMLInputElement | null;
  const enrollCodeInput = document.getElementById('enroll-access-code') as HTMLInputElement | null;
  const enrollErrorBanner = document.getElementById('enroll-error-banner');
  const enrollSuccessBanner = document.getElementById('enroll-success-banner');

  document.querySelectorAll('.btn-enroll-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const courseId = target.getAttribute('data-course-id') || '';
      const courseTitle = target.getAttribute('data-course-title') || '';

      if (enrollCourseIdInput) enrollCourseIdInput.value = courseId;
      if (enrollCourseTitleInput) enrollCourseTitleInput.value = courseTitle;
      if (enrollCodeInput) enrollCodeInput.value = '';
      if (enrollErrorBanner) enrollErrorBanner.style.display = 'none';
      if (enrollSuccessBanner) enrollSuccessBanner.style.display = 'none';

      if (enrollModal) enrollModal.style.display = 'flex';
    });
  });

  function toggleEnrollModal(show: boolean) {
    if (enrollModal) enrollModal.style.display = show ? 'flex' : 'none';
  }

  closeEnrollModalBtn?.addEventListener('click', () => toggleEnrollModal(false));
  cancelEnrollModalBtn?.addEventListener('click', () => toggleEnrollModal(false));
  enrollModal?.addEventListener('click', (e) => {
    if (e.target === enrollModal) toggleEnrollModal(false);
  });

  enrollForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-enroll-btn') as HTMLButtonElement | null;
    if (enrollErrorBanner) enrollErrorBanner.style.display = 'none';
    if (enrollSuccessBanner) enrollSuccessBanner.style.display = 'none';

    const courseId = enrollCourseIdInput?.value || '';
    const accessCode = enrollCodeInput?.value || '';

    if (saveBtn) saveBtn.disabled = true;

    try {
      const res = await fetch('/api/courses/enroll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ courseId, accessCode })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal mendaftar modul.');

      if (enrollSuccessBanner) {
        enrollSuccessBanner.textContent = data.message || 'Berhasil mendaftar modul!';
        enrollSuccessBanner.style.display = 'block';
      }
      setTimeout(() => {
        window.location.reload();
      }, 1000);
    } catch (err: any) {
      if (enrollErrorBanner) {
        enrollErrorBanner.textContent = err.message || 'Terjadi kesalahan.';
        enrollErrorBanner.style.display = 'block';
      }
    } finally {
      if (saveBtn) saveBtn.disabled = false;
    }
  });
</script>

<style>
  .curriculum-container {
    margin-top: 1rem;
    margin-bottom: 4rem;
  }

  .curriculum-header {
    text-align: center;
    max-width: 720px;
    margin: 0 auto 3rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0.75rem 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.875rem;
    }
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .curriculum-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .curriculum-grid {
      grid-template-columns: 1fr;
    }
  }

  .curriculum-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xl);
    transition: transform var(--transition-normal), box-shadow var(--transition-normal);
  }

  .card-active:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg), var(--shadow-glow);
  }

  .card-disabled {
    opacity: 0.85;
  }

  /* Thumbnail Header */
  .card-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .thumb-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(#ffffff 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .thumb-icon-box {
    position: relative;
    z-index: 2;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .status-badge {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
