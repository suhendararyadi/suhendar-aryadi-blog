---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { seedLessons } from '../../lib/seedLessons';
import { query } from '../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const currentUser = await getSessionUser(sessionId);

if (!currentUser) {
  return Astro.redirect('/auth/login?redirect=/belajar/leaderboard');
}

const isTeacherOrAdmin = currentUser.role === 'teacher' || currentUser.role === 'admin' || (currentUser.email && currentUser.email.toLowerCase().includes('suhendar'));

let isEnrolledInAnyCourse = false;
try {
  const eRes = await query(`SELECT COUNT(*) FROM course_enrollments WHERE user_id = $1`, [currentUser.id]);
  if (eRes.rows && parseInt(eRes.rows[0].count, 10) > 0) {
    isEnrolledInAnyCourse = true;
  }
} catch (err) {
  console.warn('Error checking course_enrollments for user:', err);
}

const canViewLeaderboard = isTeacherOrAdmin || isEnrolledInAnyCourse;

const totalLessonsCount = seedLessons.length || 40;

const COURSE_MAP: Record<string, { label: string; codes: string[] }> = {
  rpl_web_sql: { label: 'Basis Data & Web SQL', codes: ['rpl_web_sql', 'sql'] },
  informatika: { label: 'Informatika SMK', codes: ['informatika', 'bk', 'tik', 'sk', 'ap'] },
  pbo: { label: 'Pemrograman Berorientasi Objek (PBO)', codes: ['pbo'] },
  all: { label: 'Semua Mata Pelajaran', codes: [] }
};

const selectedCourse = Astro.url.searchParams.get('course') || 'rpl_web_sql';
const rawSelectedClass = Astro.url.searchParams.get('class');
const selectedClass = rawSelectedClass !== null ? rawSelectedClass : (currentUser.class_name || 'all');

let activeClasses: string[] = [];
try {
  const cRes = await query(
    `SELECT DISTINCT class_name FROM users WHERE role = 'student' AND class_name IS NOT NULL AND class_name != '' ORDER BY class_name ASC`
  );
  if (cRes.rows) {
    activeClasses = cRes.rows.map((r: any) => r.class_name);
  }
} catch (e) {
  console.warn('Error fetching active classes for leaderboard:', e);
}

interface LeaderboardUser {
  id: number;
  name: string;
  email: string;
  role: string;
  class_name: string;
  completed_count: number;
  last_completed_at: string | null;
  percentage: number;
  rankTitle: string;
  badgeClass: string;
}

let leaderboard: LeaderboardUser[] = [];

if (canViewLeaderboard) {
  try {
    const targetCourseConfig = COURSE_MAP[selectedCourse] || COURSE_MAP['rpl_web_sql'];
    const courseCodes = targetCourseConfig.codes;

    let sqlQuery = '';
    let sqlParams: any[] = [];

    if (courseCodes.length > 0) {
      if (selectedClass !== 'all') {
        sqlQuery = `
          SELECT u.id, u.name, u.email, u.role, u.class_name,
                 COUNT(DISTINCT up.lesson_id) as completed_count,
                 MAX(up.completed_at) as last_completed_at
          FROM users u
          JOIN course_enrollments ce ON u.id = ce.user_id AND ce.course_id = ANY($1::text[])
          LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
          WHERE u.role = 'student' AND u.class_name = $2
          GROUP BY u.id, u.name, u.email, u.role, u.class_name
          ORDER BY completed_count DESC, last_completed_at ASC, u.id ASC
        `;
        sqlParams = [courseCodes, selectedClass];
      } else {
        sqlQuery = `
          SELECT u.id, u.name, u.email, u.role, u.class_name,
                 COUNT(DISTINCT up.lesson_id) as completed_count,
                 MAX(up.completed_at) as last_completed_at
          FROM users u
          JOIN course_enrollments ce ON u.id = ce.user_id AND ce.course_id = ANY($1::text[])
          LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
          WHERE u.role = 'student'
          GROUP BY u.id, u.name, u.email, u.role, u.class_name
          ORDER BY completed_count DESC, last_completed_at ASC, u.id ASC
        `;
        sqlParams = [courseCodes];
      }
    } else {
      // All courses
      if (selectedClass !== 'all') {
        sqlQuery = `
          SELECT u.id, u.name, u.email, u.role, u.class_name,
                 COUNT(DISTINCT up.lesson_id) as completed_count,
                 MAX(up.completed_at) as last_completed_at
          FROM users u
          LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
          WHERE u.role = 'student' AND u.class_name = $1
          GROUP BY u.id, u.name, u.email, u.role, u.class_name
          ORDER BY completed_count DESC, last_completed_at ASC, u.id ASC
        `;
        sqlParams = [selectedClass];
      } else {
        sqlQuery = `
          SELECT u.id, u.name, u.email, u.role, u.class_name,
                 COUNT(DISTINCT up.lesson_id) as completed_count,
                 MAX(up.completed_at) as last_completed_at
          FROM users u
          LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
          WHERE u.role = 'student'
          GROUP BY u.id, u.name, u.email, u.role, u.class_name
          ORDER BY completed_count DESC, last_completed_at ASC, u.id ASC
        `;
        sqlParams = [];
      }
    }

    const res = await query(sqlQuery, sqlParams);

    if (res.rows) {
      leaderboard = res.rows.map((row: any) => {
        const count = parseInt(row.completed_count || '0', 10);
        const percentage = Math.round((count / totalLessonsCount) * 100);

        let rankTitle = 'SQL Novice';
        let badgeClass = 'badge-novice';

        if (count >= 40) {
          rankTitle = 'Master SQL Engineer';
          badgeClass = 'badge-master';
        } else if (count >= 25) {
          rankTitle = 'SQL Advanced';
          badgeClass = 'badge-advanced';
        } else if (count >= 11) {
          rankTitle = 'SQL Intermediate';
          badgeClass = 'badge-intermediate';
        }

        return {
          id: row.id,
          name: row.name,
          email: row.email,
          role: row.role,
          class_name: row.class_name || '-',
          completed_count: count,
          last_completed_at: row.last_completed_at,
          percentage,
          rankTitle,
          badgeClass
        };
      });
    }
  } catch (err) {
    console.warn('Leaderboard db query error:', err);
  }
}

const top3 = leaderboard.slice(0, 3);
---

<MainLayout 
  title="Leaderboard Siswa Vokasi RPL & Informatika | Suhendar Aryadi"
  description="Papan peringkat kelulusan modul pembelajaran siswa SMK RPL & Informatika."
>
  <div class="container leaderboard-container">
    <div class="header-banner glass-card">
      <div class="header-content">
        <span class="badge badge-cyan">Papan Peringkat Pembelajaran</span>
        <h1 class="header-title">Leaderboard <span class="text-gradient">Vokasi RPL &amp; Informatika</span></h1>
        <p class="header-sub">
          Peringkat ketercapaian modul pembelajaran oleh seluruh siswa SMK. Selesaikan latihan dan tingkatkan peringkat kelulusan Anda!
        </p>
        <div class="header-actions">
          <a href="/belajar" class="btn btn-primary btn-sm">Katalog Mata Pelajaran</a>
          {currentUser && (
            <a href="/dashboard" class="btn btn-outline btn-sm">Dashboard Saya</a>
          )}
        </div>
      </div>
    </div>

    {!canViewLeaderboard ? (
      <!-- Locked State Card if student not enrolled in any course -->
      <div class="locked-leaderboard-card glass-card text-center">
        <div class="locked-icon-box">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-amber);">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h2 class="locked-title">Akses Papan Peringkat Terkunci</h2>
        <p class="locked-desc">
          Papan Peringkat (Leaderboard) hanya dapat diakses oleh siswa yang telah terdaftar pada minimal satu Mata Pelajaran (Informatika, RPL Basis Data &amp; Web SQL, atau PBO).
        </p>
        <div class="locked-actions margin-top">
          <a href="/belajar" class="btn btn-enroll-trigger btn-lg">
            Enroll Mata Pelajaran Sekarang (Kode Akses)
          </a>
        </div>
      </div>
    ) : (
      <>
        <!-- Filter Controls Bar -->
        <div class="filter-controls-card glass-card">
          <div class="filter-group-left">
            <span class="filter-label">Mata Pelajaran:</span>
            <div class="course-tabs">
              {Object.entries(COURSE_MAP).map(([key, config]) => (
                <a
                  href={`/belajar/leaderboard?course=${key}&class=${encodeURIComponent(selectedClass)}`}
                  class={`tab-btn ${selectedCourse === key ? 'active' : ''}`}
                >
                  {config.label}
                </a>
              ))}
            </div>
          </div>

          <div class="filter-group-right">
            <label for="class-select-filter" class="filter-label">Kelas Rombel:</label>
            <select id="class-select-filter" class="filter-select">
              <option value="all" selected={selectedClass === 'all'}>Semua Kelas Rombel</option>
              {activeClasses.map(cls => (
                <option value={cls} selected={selectedClass === cls}>{cls}</option>
              ))}
            </select>
          </div>
        </div>

        <!-- Podium Top 3 -->
        {top3.length > 0 && (
          <div class="podium-grid">
            {/* Juara 2 */}
            {top3[1] ? (
              <div class="podium-card rank-2 glass-card">
                <div class="podium-badge">🥈 #2</div>
                <div class="podium-avatar">{top3[1].name.charAt(0).toUpperCase()}</div>
                <h3 class="podium-name">{top3[1].name}</h3>
                <span class="badge badge-outline" style="margin-bottom: 0.35rem;">{top3[1].class_name}</span>
                <span class={`badge ${top3[1].badgeClass}`}>{top3[1].rankTitle}</span>
                <div class="podium-score">
                  <strong>{top3[1].completed_count}</strong> / {totalLessonsCount} Modul
                </div>
                <div class="podium-bar-track">
                  <div class="podium-bar-fill" style={`width: ${top3[1].percentage}%`}></div>
                </div>
              </div>
            ) : (
              <div class="podium-card rank-empty glass-card">
                <div class="podium-badge">🥈 #2</div>
                <p class="empty-podium-text">Belum ada posisi 2</p>
              </div>
            )}

            {/* Juara 1 */}
            {top3[0] ? (
              <div class="podium-card rank-1 glass-card">
                <div class="podium-badge top-gold">🥇 #1 Champion</div>
                <div class="podium-avatar gold-avatar">{top3[0].name.charAt(0).toUpperCase()}</div>
                <h3 class="podium-name gold-name">{top3[0].name}</h3>
                <span class="badge badge-outline" style="margin-bottom: 0.35rem;">{top3[0].class_name}</span>
                <span class={`badge ${top3[0].badgeClass}`}>{top3[0].rankTitle}</span>
                <div class="podium-score gold-score">
                  <strong>{top3[0].completed_count}</strong> / {totalLessonsCount} Modul Selesai
                </div>
                <div class="podium-bar-track">
                  <div class="podium-bar-fill gold-fill" style={`width: ${top3[0].percentage}%`}></div>
                </div>
              </div>
            ) : (
              <div class="podium-card rank-empty glass-card">
                <div class="podium-badge">🥇 #1</div>
                <p class="empty-podium-text">Belum ada posisi 1</p>
              </div>
            )}

            {/* Juara 3 */}
            {top3[2] ? (
              <div class="podium-card rank-3 glass-card">
                <div class="podium-badge">🥉 #3</div>
                <div class="podium-avatar">{top3[2].name.charAt(0).toUpperCase()}</div>
                <h3 class="podium-name">{top3[2].name}</h3>
                <span class="badge badge-outline" style="margin-bottom: 0.35rem;">{top3[2].class_name}</span>
                <span class={`badge ${top3[2].badgeClass}`}>{top3[2].rankTitle}</span>
                <div class="podium-score">
                  <strong>{top3[2].completed_count}</strong> / {totalLessonsCount} Modul
                </div>
                <div class="podium-bar-track">
                  <div class="podium-bar-fill" style={`width: ${top3[2].percentage}%`}></div>
                </div>
              </div>
            ) : (
              <div class="podium-card rank-empty glass-card">
                <div class="podium-badge">🥉 #3</div>
                <p class="empty-podium-text">Belum ada posisi 3</p>
              </div>
            )}
          </div>
        )}

        <!-- Full Leaderboard Table -->
        <div class="table-section glass-card">
          <div class="table-header">
            <div>
              <h2>Peringkat Siswa — {COURSE_MAP[selectedCourse]?.label || 'Semua Mata Pelajaran'}</h2>
              <p class="table-sub-info">
                Filter Kelas: <strong>{selectedClass === 'all' ? 'Semua Kelas' : selectedClass}</strong>
              </p>
            </div>
            <span class="total-students">{leaderboard.length} Siswa Terdaftar</span>
          </div>

          {leaderboard.length > 0 ? (
            <div class="table-wrapper">
              <table class="leaderboard-table">
                <thead>
                  <tr>
                    <th>Peringkat</th>
                    <th>Siswa</th>
                    <th>Kelas</th>
                    <th>Tingkat Rank</th>
                    <th>Progres Modul</th>
                    <th>Persentase</th>
                    <th>Terakhir Aktif</th>
                  </tr>
                </thead>
                <tbody>
                  {leaderboard.map((item, index) => {
                    const isCurrentUser = currentUser && currentUser.id === item.id;
                    return (
                      <tr class:list={[{ 'current-user-row': isCurrentUser }]}>
                        <td class="rank-col">
                          <span class:list={['rank-number', { 'top-3-rank': index < 3 }]}>
                            #{index + 1}
                          </span>
                        </td>
                        <td>
                          <div class="student-name-wrap">
                            <span class="user-avatar-sm">{item.name.charAt(0).toUpperCase()}</span>
                            <div>
                              <strong class="student-name">{item.name} {isCurrentUser ? '(Anda)' : ''}</strong>
                              <span class="student-role">{item.role.toUpperCase()}</span>
                            </div>
                          </div>
                        </td>
                        <td>
                          <span class="badge badge-purple">{item.class_name}</span>
                        </td>
                        <td>
                          <span class={`badge ${item.badgeClass}`}>{item.rankTitle}</span>
                        </td>
                        <td>
                          <span class="module-score font-mono">
                            <strong>{item.completed_count}</strong> / {totalLessonsCount}
                          </span>
                        </td>
                        <td class="pct-col">
                          <div class="tbl-progress-wrap">
                            <div class="tbl-progress-track">
                              <div class="tbl-progress-fill" style={`width: ${item.percentage}%`}></div>
                            </div>
                            <span class="pct-text">{item.percentage}%</span>
                          </div>
                        </td>
                        <td class="date-col">
                          {item.last_completed_at ? new Date(item.last_completed_at).toLocaleDateString('id-ID', {
                            day: 'numeric', month: 'short', year: 'numeric'
                          }) : 'Belum Mulai'}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <div class="empty-state">
              <p>Belum ada data siswa terdaftar pada filter mata pelajaran dan kelas ini.</p>
            </div>
          )}
        </div>
      </>
    )}
  </div>
</MainLayout>

<script is:inline define:vars={{ selectedCourse }}>
  document.addEventListener('DOMContentLoaded', () => {
    const classSelect = document.getElementById('class-select-filter');
    classSelect?.addEventListener('change', (e) => {
      const classVal = e.target.value;
      const url = new URL(window.location.href);
      url.searchParams.set('course', selectedCourse);
      url.searchParams.set('class', classVal);
      window.location.href = url.toString();
    });
  });
</script>

