---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';
import { sqlTryoutQuestions } from '../../../data/sqlTryoutQuestions';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

let pastAttempts: any[] = [];
if (user) {
  try {
    const res = await query(
      `SELECT id, token_used, total_questions, correct_answers, score, duration_seconds, created_at 
       FROM sql_tryout_submissions 
       WHERE user_id = $1 
       ORDER BY created_at DESC 
       LIMIT 10`,
      [user.id]
    );
    pastAttempts = res.rows || [];
  } catch (e) {
    console.warn('Could not fetch past attempts:', e);
  }
}

// Prepare questions for frontend (without answers in token gate)
const initialQuestions = sqlTryoutQuestions.map((q) => ({
  id: q.id,
  category: q.category,
  question: q.question,
  codeSnippet: q.codeSnippet || null,
  options: q.options
}));
---

<MainLayout
  title="Try Out Ujian SQL & Basis Data Relasional (CBT 5 Opsi) | SMK RPL"
  description="Simulasi Try Out Ujian SQL dan Basis Data Relasional berbasis CBT dengan 25 soal pilihan ganda 5 opsi (A-E), validasi token ujian, timer countdown, penilaian instan, dan pembahasan lengkap."
>
  <div class="m3-tryout-page">
    <div class="m3-tryout-container">
      <!-- M3 Breadcrumb -->
      <nav class="m3-breadcrumb">
        <a href="/">Beranda</a>
        <span class="m3-breadcrumb-sep">/</span>
        <a href="/belajar/sql">Belajar SQL</a>
        <span class="m3-breadcrumb-sep">/</span>
        <span class="m3-breadcrumb-current">Try Out Ujian CBT</span>
      </nav>

      {/* =========================================================
          SCREEN 1: TOKEN GATE & BRIEFING (M3 Card Container)
          ========================================================= */}
      <div id="screen-gate" class="m3-screen active">
        <div class="m3-card m3-card-elevated m3-gate-card">
          <div class="m3-chip-row">
            <span class="m3-chip m3-chip-tonal-primary">SIMULASI MANDIRI CBT</span>
            <span class="m3-chip m3-chip-tonal-secondary">STANDAR SMK RPL</span>
          </div>

          <h1 class="m3-title-large">Try Out Ujian SQL &amp; Basis Data Relasional</h1>
          <p class="m3-body-large text-secondary">
            Uji kesiapan kompetensi Anda sebelum menghadapi ujian resmi dengan simulasi CBT pilihan ganda 5 opsi jawaban (A, B, C, D, E), dilengkapi timer otomatis, penilaian instan, dan pembahasan analitis.
          </p>

          <!-- M3 Info Specs Cards -->
          <div class="m3-specs-grid">
            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Jumlah Soal</span>
                <strong class="m3-title-medium">25 Pilihan Ganda</strong>
                <span class="m3-body-small text-secondary">5 Opsi (A, B, C, D, E)</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Durasi Waktu</span>
                <strong class="m3-title-medium">45 Menit</strong>
                <span class="m3-body-small text-secondary">Timer Countdown Otomatis</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Standar KKM</span>
                <strong class="m3-title-medium">Nilai 75 / 100</strong>
                <span class="m3-body-small text-secondary">Minimal 19 Jawaban Benar</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Evaluasi Hasil</span>
                <strong class="m3-title-medium">Nilai &amp; Pembahasan</strong>
                <span class="m3-body-small text-secondary">Tampil Instan Setelah Selesai</span>
              </div>
            </div>
          </div>

          {/* User Auth Gate Check */}
          {!user ? (
            <div class="m3-banner m3-banner-error margin-top-md">
              <div class="m3-banner-body">
                <h4 class="m3-title-small text-error">Akun Siswa Diperlukan</h4>
                <p class="m3-body-medium text-secondary">
                  Silakan masuk menggunakan akun siswa Anda agar hasil dan riwayat nilai Try Out tersimpan secara permanen ke dashboard pembelajaran.
                </p>
                <div class="m3-banner-actions margin-top-sm">
                  <a href="/login?redirect=/belajar/sql/tryout" class="m3-btn m3-btn-filled">
                    Masuk Akun Siswa &rarr;
                  </a>
                  <a href="/register?redirect=/belajar/sql/tryout" class="m3-btn m3-btn-outlined">
                    Daftar Akun Baru
                  </a>
                </div>
              </div>
            </div>
          ) : (
            <div class="m3-card m3-card-outlined m3-participant-card margin-top-md">
              <div class="m3-participant-header">
                <div class="m3-avatar">
                  {user.name.charAt(0).toUpperCase()}
                </div>
                <div class="m3-participant-text">
                  <span class="m3-label-small text-primary">PESERTA UJIAN TERVERIFIKASI</span>
                  <h3 class="m3-title-medium">{user.name}</h3>
                  <span class="m3-body-small font-mono text-muted">{user.email}</span>
                </div>
              </div>

              <!-- Token Input Form -->
              <form id="token-form" class="m3-token-form margin-top-md">
                <div class="m3-token-group">
                  <label for="input-token" class="m3-label-large">
                    Masukkan Token Ujian:
                  </label>
                  <div class="m3-token-field-row">
                    <input
                      type="text"
                      id="input-token"
                      name="token"
                      placeholder="Contoh: TRYOUTSQL2026"
                      class="m3-text-field font-mono"
                      maxlength="30"
                      required
                      autocomplete="off"
                    />
                    <button type="submit" id="btn-start-exam" class="m3-btn m3-btn-filled m3-btn-lg">
                      Mulai Mengerjakan Ujian &rarr;
                    </button>
                  </div>
                  <div id="token-error" class="m3-alert m3-alert-error" style="display: none;"></div>
                  <div class="m3-helper-box">
                    <span>
                      Token simulasi aktif: <strong class="font-mono text-primary">TRYOUTSQL2026</strong> atau <strong class="font-mono text-primary">SQL2026</strong> (atau tanyakan pada Guru Pengampu).
                    </span>
                  </div>
                </div>
              </form>
            </div>
          )}

          <!-- Riwayat Pengerjaan Try Out Sebelumnya -->
          {user && pastAttempts.length > 0 && (
            <div class="m3-history-section margin-top-lg">
              <div class="m3-history-header">
                <h4 class="m3-title-medium">Riwayat Hasil Try Out Sebelumnya</h4>
              </div>
              <div class="table-responsive margin-top-xs">
                <table class="m3-table">
                  <thead>
                    <tr>
                      <th>Waktu Ujian</th>
                      <th>Token Digunakan</th>
                      <th>Jawaban Benar</th>
                      <th>Durasi Pengerjaan</th>
                      <th>Skor Akhir</th>
                      <th>Status KKM</th>
                    </tr>
                  </thead>
                  <tbody>
                    {pastAttempts.map((att) => {
                      const isPassed = att.score >= 75;
                      const mins = Math.floor((att.duration_seconds || 0) / 60);
                      const secs = (att.duration_seconds || 0) % 60;
                      return (
                        <tr>
                          <td>{new Date(att.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })}</td>
                          <td><code class="font-mono">{att.token_used}</code></td>
                          <td>{att.correct_answers} / {att.total_questions} Soal</td>
                          <td>{mins}m {secs}s</td>
                          <td><strong class={isPassed ? 'text-success' : 'text-error'}>{att.score} / 100</strong></td>
                          <td>
                            {isPassed ? (
                              <span class="m3-chip m3-chip-tonal-success">TUNTAS</span>
                            ) : (
                              <span class="m3-chip m3-chip-tonal-error">BELUM TUNTAS</span>
                            )}
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* =========================================================
          SCREEN 2: CBT EXAMINATION WORKSPACE (M3 Layout)
          ========================================================= */}
      <div id="screen-cbt" class="m3-screen" style="display: none;">
        <!-- M3 Top App Bar -->
        <header class="m3-top-app-bar">
          <div class="m3-app-bar-top-row">
            <div class="m3-app-bar-leading">
              <span class="m3-badge-tonal">CBT SQL</span>
              <span class="material-symbols-rounded icon-sm text-secondary">person</span>
              <span class="m3-title-small m3-app-bar-title" id="cbt-user-name">{user?.name || 'Peserta Siswa'}</span>
            </div>

            <div class="m3-timer-container">
              <span class="material-symbols-rounded icon-sm timer-icon">timer</span>
              <span class="m3-label-small timer-label text-secondary">Sisa:</span>
              <span class="m3-title-medium font-mono m3-timer-text" id="cbt-timer">45:00</span>
            </div>
          </div>

          <div class="m3-app-bar-actions">
            <button type="button" id="btn-mobile-palette-toggle" class="m3-btn m3-btn-tonal m3-mobile-only" title="Daftar Nomor Soal">
              <span class="material-symbols-rounded icon-sm">grid_view</span>
              <span>Daftar Soal (<span id="mobile-palette-badge">1/25</span>)</span>
            </button>
            <button type="button" id="btn-submit-exam" class="m3-btn m3-btn-filled m3-btn-success" title="Selesai &amp; Kumpulkan">
              <span class="material-symbols-rounded icon-sm">check_circle</span>
              <span class="m3-btn-label">Kumpulkan</span>
            </button>
          </div>
        </header>

        <!-- Main CBT Layout Grid -->
        <div class="m3-cbt-layout margin-top-md">
          <!-- Area Soal Aktif (Kiri) -->
          <main class="m3-card m3-card-elevated m3-question-card">
            <div class="m3-question-header">
              <div class="m3-chip-row">
                <span class="m3-chip m3-chip-tonal-primary" id="question-num-badge">SOAL NO. 1 DARI 25</span>
                <span class="m3-chip m3-chip-tonal-secondary" id="question-category-badge">DASAR DML</span>
              </div>
              <button type="button" id="btn-toggle-doubt" class="m3-chip-filter" aria-pressed="false">
                <span class="m3-chip-checkbox"></span>
                <span id="doubt-btn-text">Ragu-Ragu</span>
              </button>
            </div>

            <!-- Question Body -->
            <div class="m3-question-content margin-top-md">
              <h2 class="m3-title-large m3-question-title" id="question-text">Memuat pertanyaan...</h2>
              
              <div id="question-code-wrap" class="m3-code-container margin-top-sm" style="display: none;">
                <div class="m3-code-header">
                  <span class="m3-label-small font-mono">KODE SQL / SKENARIO:</span>
                </div>
                <pre class="m3-code-block font-mono"><code id="question-code"></code></pre>
              </div>

              <!-- 5 Options Form -->
              <div class="m3-options-group margin-top-md" id="options-container">
                <!-- Rendered dynamically via JS -->
              </div>
            </div>

            <!-- Bottom Navigation Controls -->
            <footer class="m3-question-footer margin-top-lg">
              <button type="button" id="btn-prev-q" class="m3-btn m3-btn-outlined">
                &larr; Soal Sebelumnya
              </button>
              <span class="m3-label-medium text-secondary" id="nav-indicator-text">1 dari 25 Soal</span>
              <button type="button" id="btn-next-q" class="m3-btn m3-btn-filled">
                Soal Berikutnya &rarr;
              </button>
            </footer>
          </main>

          <!-- Sidebar Navigation Palette (Kanan) -->
          <aside class="m3-card m3-card-elevated m3-palette-card">
            <div class="m3-palette-header">
              <h3 class="m3-title-medium">Navigasi Nomor Soal</h3>
              <span class="m3-body-small text-secondary">Pilih nomor untuk melompat langsung</span>
            </div>

            <!-- Status Legend -->
            <div class="m3-palette-legend">
              <div class="m3-legend-item"><span class="m3-legend-box m3-box-answered"></span> Terjawab</div>
              <div class="m3-legend-item"><span class="m3-legend-box m3-box-doubt"></span> Ragu-ragu</div>
              <div class="m3-legend-item"><span class="m3-legend-box m3-box-unanswered"></span> Belum diisi</div>
            </div>

            <!-- Question Numbers Grid (1-25) -->
            <div class="m3-palette-grid margin-top-sm" id="palette-grid">
              <!-- Rendered via JS: buttons 1..25 -->
            </div>

            <div class="m3-palette-summary margin-top-md" id="palette-summary">
              <span>0 Terjawab</span> &bull; <span>0 Ragu</span> &bull; <span>25 Belum</span>
            </div>
          </aside>
        </div>
      </div>

      {/* =========================================================
          SCREEN 3: RESULT & COMPREHENSIVE REVIEW (M3 Evaluation)
          ========================================================= */}
      <div id="screen-result" class="m3-screen" style="display: none;">
        <div class="m3-card m3-card-elevated m3-result-card">
          <div class="m3-chip-row">
            <span class="m3-chip m3-chip-tonal-primary">HASIL TRY OUT CBT</span>
            <span class="m3-chip m3-chip-tonal-secondary">EVALUASI AKHIR</span>
          </div>

          <div class="m3-result-hero-banner margin-top-md">
            <div class="m3-score-gauge-wrap">
              <div class="m3-score-value font-mono" id="result-score">0</div>
              <span class="m3-label-small text-secondary">/ 100</span>
            </div>

            <div class="m3-result-info">
              <div id="result-status-badge" class="m3-chip m3-chip-tonal-success m3-chip-lg">TUNTAS</div>
              <h2 class="m3-title-large" id="result-heading">Hasil Evaluasi Try Out</h2>
              <p class="m3-body-medium text-secondary" id="result-desc">
                Memuat ulasan performa dan rekomendasi pembelajaran...
              </p>

              <div class="m3-stats-row margin-top-sm">
                <div class="m3-stat-item">
                  <span class="m3-body-small">Benar: <strong id="result-correct-count" class="text-success">0</strong></span>
                </div>
                <div class="m3-stat-item">
                  <span class="m3-body-small">Salah: <strong id="result-wrong-count" class="text-error">0</strong></span>
                </div>
                <div class="m3-stat-item">
                  <span class="m3-body-small">Durasi: <strong id="result-duration">0m 0s</strong></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Action CTAs -->
          <div class="m3-result-actions margin-top-md">
            <button type="button" id="btn-retake-tryout" class="m3-btn m3-btn-filled">
              Ulangi Try Out (Simulasi Baru)
            </button>
            <a href="/belajar/sql" class="m3-btn m3-btn-tonal">
              Kembali ke Modul SQL
            </a>
            <a href="/dashboard" class="m3-btn m3-btn-outlined">
              Buka Dashboard Siswa
            </a>
          </div>

          <!-- Comprehensive Question-by-Question Review -->
          <div class="m3-review-section margin-top-xl">
            <div class="m3-review-header">
              <div>
                <h3 class="m3-title-large">Analisis &amp; Pembahasan Lengkap Soal</h3>
                <p class="m3-body-medium text-secondary">Pelajari pembahasan konseptual dari setiap butir soal untuk memperkuat pemahaman materi.</p>
              </div>
              
              <div class="m3-segmented-button-group">
                <button type="button" class="m3-segmented-btn active" data-filter="all">Semua Soal (<span id="tab-count-all">25</span>)</button>
                <button type="button" class="m3-segmented-btn" data-filter="correct">Jawaban Benar (<span id="tab-count-correct">0</span>)</button>
                <button type="button" class="m3-segmented-btn" data-filter="wrong">Jawaban Salah (<span id="tab-count-wrong">0</span>)</button>
              </div>
            </div>

            <div class="m3-review-list margin-top-md" id="review-list-container">
              <!-- Rendered dynamically via JS -->
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- M3 Mobile Bottom Sheet Drawer for Palette Navigation -->
    <div id="mobile-palette-modal" class="m3-scrim-backdrop mobile-palette-backdrop" style="display: none;">
      <div class="m3-bottom-sheet">
        <div class="m3-sheet-drag-handle"></div>
        <div class="m3-sheet-header">
          <div>
            <h4 class="m3-title-medium">Daftar Nomor Soal (1–25)</h4>
            <span class="m3-body-small text-secondary">Pilih nomor untuk melompat langsung ke soal</span>
          </div>
          <button type="button" id="btn-close-mobile-palette" class="m3-icon-btn" aria-label="Tutup">
            &times;
          </button>
        </div>

        <div class="m3-palette-legend margin-top-xs">
          <div class="m3-legend-item"><span class="m3-legend-box m3-box-answered"></span> Terjawab</div>
          <div class="m3-legend-item"><span class="m3-legend-box m3-box-doubt"></span> Ragu-ragu</div>
          <div class="m3-legend-item"><span class="m3-legend-box m3-box-unanswered"></span> Belum diisi</div>
        </div>

        <div class="m3-palette-grid margin-top-sm" id="mobile-palette-grid">
          <!-- Rendered via JS -->
        </div>

        <div class="m3-palette-summary margin-top-sm" id="mobile-palette-summary">
          <span>0 Terjawab</span> &bull; <span>0 Ragu</span> &bull; <span>25 Belum</span>
        </div>
      </div>
    </div>

    <!-- M3 Confirmation Modal Dialog -->
    <div id="confirm-modal" class="m3-scrim-backdrop" style="display: none;">
      <div class="m3-dialog">
        <h3 class="m3-dialog-title">Konfirmasi Pengumpulan Jawaban</h3>
        <p id="modal-summary-text" class="m3-dialog-body margin-top-xs">
          Anda telah menjawab <strong>25 dari 25 soal</strong>. Apakah Anda yakin ingin menyelesaikan dan mengumpulkan try out ini sekarang?
        </p>
        <div id="modal-unanswered-warning" class="m3-alert m3-alert-warning margin-top-xs" style="display: none;">
          Perhatian: Masih ada butir soal yang belum dijawab atau ditandai ragu-ragu!
        </div>
        <div class="m3-dialog-actions margin-top-md">
          <button type="button" id="btn-modal-cancel" class="m3-btn m3-btn-text">
            Periksa Kembali
          </button>
          <button type="button" id="btn-modal-confirm" class="m3-btn m3-btn-filled m3-btn-success">
            Ya, Kumpulkan Sekarang
          </button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<!-- Client JavaScript for CBT Interactive System -->
<script define:vars={{ initialQuestions, user }}>
  const QUESTIONS = initialQuestions;
  const TOTAL_Q = QUESTIONS.length;
  const TOTAL_DURATION_SECS = 45 * 60; // 45 minutes

  // State
  let activeToken = '';
  let currentQIndex = 0;
  let userAnswers = {}; // { questionId: 'A' | 'B' | 'C' | 'D' | 'E' }
  let userDoubt = {}; // { questionId: boolean }
  let timerInterval = null;
  let secondsRemaining = TOTAL_DURATION_SECS;
  let examStartTime = null;
  let activeFilter = 'all';
  let reviewData = null;

  // DOM Elements
  const screenGate = document.getElementById('screen-gate');
  const screenCbt = document.getElementById('screen-cbt');
  const screenResult = document.getElementById('screen-result');

  // Token Form
  const tokenForm = document.getElementById('token-form');
  const inputToken = document.getElementById('input-token');
  const btnStartExam = document.getElementById('btn-start-exam');
  const tokenError = document.getElementById('token-error');

  // CBT Interface
  const cbtTimer = document.getElementById('cbt-timer');
  const btnSubmitExam = document.getElementById('btn-submit-exam');
  const qNumBadge = document.getElementById('question-num-badge');
  const qCatBadge = document.getElementById('question-category-badge');
  const btnToggleDoubt = document.getElementById('btn-toggle-doubt');
  const doubtBtnText = document.getElementById('doubt-btn-text');
  const qText = document.getElementById('question-text');
  const qCodeWrap = document.getElementById('question-code-wrap');
  const qCode = document.getElementById('question-code');
  const optionsContainer = document.getElementById('options-container');
  const btnPrevQ = document.getElementById('btn-prev-q');
  const btnNextQ = document.getElementById('btn-next-q');
  const navIndicatorText = document.getElementById('nav-indicator-text');
  const paletteGrid = document.getElementById('palette-grid');
  const paletteSummary = document.getElementById('palette-summary');

  // Modal
  const confirmModal = document.getElementById('confirm-modal');
  const btnModalCancel = document.getElementById('btn-modal-cancel');
  const btnModalConfirm = document.getElementById('btn-modal-confirm');
  const modalSummaryText = document.getElementById('modal-summary-text');
  const modalUnansweredWarn = document.getElementById('modal-unanswered-warning');

  // Result Elements
  const resultScore = document.getElementById('result-score');
  const resultStatusBadge = document.getElementById('result-status-badge');
  const resultHeading = document.getElementById('result-heading');
  const resultDesc = document.getElementById('result-desc');
  const resultCorrectCount = document.getElementById('result-correct-count');
  const resultWrongCount = document.getElementById('result-wrong-count');
  const resultDuration = document.getElementById('result-duration');
  const btnRetakeTryout = document.getElementById('btn-retake-tryout');
  const reviewListContainer = document.getElementById('review-list-container');
  const tabCountAll = document.getElementById('tab-count-all');
  const tabCountCorrect = document.getElementById('tab-count-correct');
  const tabCountWrong = document.getElementById('tab-count-wrong');

  // Mobile Palette Drawer
  const btnMobilePaletteToggle = document.getElementById('btn-mobile-palette-toggle');
  const mobilePaletteModal = document.getElementById('mobile-palette-modal');
  const btnCloseMobilePalette = document.getElementById('btn-close-mobile-palette');
  const mobilePaletteGrid = document.getElementById('mobile-palette-grid');
  const mobilePaletteSummary = document.getElementById('mobile-palette-summary');
  const mobilePaletteBadge = document.getElementById('mobile-palette-badge');

  // Initialize
  const init = () => {
    tokenForm?.addEventListener('submit', handleTokenSubmit);
    btnPrevQ?.addEventListener('click', () => navigateQuestion(currentQIndex - 1));
    btnNextQ?.addEventListener('click', () => navigateQuestion(currentQIndex + 1));
    btnToggleDoubt?.addEventListener('click', toggleDoubt);
    btnSubmitExam?.addEventListener('click', openConfirmModal);
    btnModalCancel?.addEventListener('click', closeConfirmModal);
    btnModalConfirm?.addEventListener('click', submitExamAnswers);
    btnRetakeTryout?.addEventListener('click', resetToGate);

    // Mobile Palette Drawer toggles
    btnMobilePaletteToggle?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'flex';
    });
    btnCloseMobilePalette?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
    });
    mobilePaletteModal?.addEventListener('click', (e) => {
      if (e.target === mobilePaletteModal) {
        mobilePaletteModal.style.display = 'none';
      }
    });

    // Setup review filter segmented buttons
    document.querySelectorAll('.m3-segmented-btn').forEach((tab) => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.m3-segmented-btn').forEach((t) => t.classList.remove('active'));
        const target = e.currentTarget;
        target.classList.add('active');
        activeFilter = target.getAttribute('data-filter') || 'all';
        renderReviewList();
      });
    });
  };

  // 1. Verify Token and Start CBT
  const handleTokenSubmit = async (e) => {
    e.preventDefault();
    if (!inputToken) return;

    const token = inputToken.value.trim().toUpperCase();
    if (!token) return;

    if (btnStartExam) {
      btnStartExam.disabled = true;
      btnStartExam.textContent = 'Memverifikasi Token...';
    }
    if (tokenError) tokenError.style.display = 'none';

    try {
      const res = await fetch('/api/sql/tryout/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (tokenError) {
          tokenError.textContent = data.error || 'Token tidak valid. Silakan coba lagi.';
          tokenError.style.display = 'block';
        }
        if (btnStartExam) {
          btnStartExam.disabled = false;
          btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
        }
        return;
      }

      activeToken = token;
      startCbtExam();
    } catch (err) {
      if (tokenError) {
        tokenError.textContent = 'Terjadi gangguan jaringan saat memvalidasi token.';
        tokenError.style.display = 'block';
      }
      if (btnStartExam) {
        btnStartExam.disabled = false;
        btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
      }
    }
  };

  // 2. Start CBT Exam Session
  const startCbtExam = () => {
    userAnswers = {};
    userDoubt = {};
    currentQIndex = 0;
    secondsRemaining = TOTAL_DURATION_SECS;
    examStartTime = Date.now();

    // Switch Screens
    screenGate.style.display = 'none';
    screenResult.style.display = 'none';
    screenCbt.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });

    buildPaletteGrid();
    renderActiveQuestion();
    startTimer();
  };

  // 3. Timer Countdown
  const startTimer = () => {
    clearInterval(timerInterval);
    updateTimerDisplay();

    timerInterval = setInterval(() => {
      secondsRemaining--;
      updateTimerDisplay();

      if (secondsRemaining <= 0) {
        clearInterval(timerInterval);
        alert('Waktu ujian telah habis. Jawaban Anda akan otomatis dikumpulkan.');
        submitExamAnswers();
      }
    }, 1000);
  };

  const updateTimerDisplay = () => {
    if (!cbtTimer) return;
    const mins = Math.floor(secondsRemaining / 60);
    const secs = secondsRemaining % 60;
    cbtTimer.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

    if (secondsRemaining <= 300) {
      cbtTimer.classList.add('timer-warning');
    } else {
      cbtTimer.classList.remove('timer-warning');
    }
  };

  // 4. Build Navigation Palette (Desktop + Mobile Sheet)
  const buildPaletteGrid = () => {
    const buildInto = (container) => {
      if (!container) return;
      container.innerHTML = '';
      QUESTIONS.forEach((q, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'm3-palette-btn';
        btn.setAttribute('data-qid', String(q.id));
        btn.textContent = String(q.id);
        btn.addEventListener('click', () => {
          navigateQuestion(idx);
          if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
        });
        container.appendChild(btn);
      });
    };

    buildInto(paletteGrid);
    buildInto(mobilePaletteGrid);
    updatePaletteStatus();
  };

  const updatePaletteStatus = () => {
    let answeredCount = 0;
    let doubtCount = 0;

    const syncButtons = (container) => {
      if (!container) return;
      QUESTIONS.forEach((q, idx) => {
        const btn = container.querySelector(`[data-qid="${q.id}"]`);
        if (!btn) return;

        btn.className = 'm3-palette-btn';

        if (idx === currentQIndex) {
          btn.classList.add('active');
        }

        if (userDoubt[q.id]) {
          btn.classList.add('doubtful');
        } else if (userAnswers[q.id]) {
          btn.classList.add('answered');
        }
      });
    };

    QUESTIONS.forEach((q) => {
      if (userDoubt[q.id]) {
        doubtCount++;
      } else if (userAnswers[q.id]) {
        answeredCount++;
      }
    });

    syncButtons(paletteGrid);
    syncButtons(mobilePaletteGrid);

    const summaryHtml = `<span><strong>${answeredCount}</strong> Terjawab</span> &bull; <span><strong>${doubtCount}</strong> Ragu</span> &bull; <span><strong>${TOTAL_Q - (answeredCount + doubtCount)}</strong> Belum</span>`;
    if (paletteSummary) paletteSummary.innerHTML = summaryHtml;
    if (mobilePaletteSummary) mobilePaletteSummary.innerHTML = summaryHtml;
    if (mobilePaletteBadge) mobilePaletteBadge.textContent = `${currentQIndex + 1}/${TOTAL_Q}`;
  };

  // 5. Render Active Question
  const renderActiveQuestion = () => {
    const q = QUESTIONS[currentQIndex];
    if (!q) return;

    if (qNumBadge) qNumBadge.textContent = `SOAL NO. ${q.id} DARI ${TOTAL_Q}`;
    if (qCatBadge) qCatBadge.textContent = q.category.toUpperCase();
    if (qText) qText.textContent = q.question;

    if (qCodeWrap && qCode) {
      if (q.codeSnippet) {
        qCode.textContent = q.codeSnippet;
        qCodeWrap.style.display = 'block';
      } else {
        qCodeWrap.style.display = 'none';
      }
    }

    // Toggle Doubt button state
    if (btnToggleDoubt && doubtBtnText) {
      if (userDoubt[q.id]) {
        btnToggleDoubt.classList.add('is-doubt');
        btnToggleDoubt.setAttribute('aria-pressed', 'true');
        doubtBtnText.textContent = 'Ragu-Ragu (Ditandai)';
      } else {
        btnToggleDoubt.classList.remove('is-doubt');
        btnToggleDoubt.setAttribute('aria-pressed', 'false');
        doubtBtnText.textContent = 'Tandai Ragu-Ragu';
      }
    }

    // Render Options in M3 Selection Cards
    if (optionsContainer) {
      optionsContainer.innerHTML = '';

      q.options.forEach((opt) => {
        const isChecked = userAnswers[q.id] === opt.key;
        const optCard = document.createElement('label');
        optCard.className = `m3-option-card ${isChecked ? 'selected' : ''}`;

        optCard.innerHTML = `
          <input type="radio" name="option_q_${q.id}" value="${opt.key}" ${isChecked ? 'checked' : ''} class="m3-radio-hidden" />
          <div class="m3-option-circle">${opt.key}</div>
          <div class="m3-option-text">${escapeHtml(opt.text)}</div>
        `;

        optCard.querySelector('input')?.addEventListener('change', () => {
          userAnswers[q.id] = opt.key;
          renderActiveQuestion();
          updatePaletteStatus();
        });

        optionsContainer.appendChild(optCard);
      });
    }

    // Update Bottom Nav state
    if (btnPrevQ) btnPrevQ.disabled = currentQIndex === 0;
    if (btnNextQ) {
      if (currentQIndex === TOTAL_Q - 1) {
        btnNextQ.textContent = 'Selesai & Kumpulkan →';
      } else {
        btnNextQ.textContent = 'Soal Berikutnya →';
      }
    }
    if (navIndicatorText) {
      navIndicatorText.textContent = `${currentQIndex + 1} dari ${TOTAL_Q} Soal`;
    }

    updatePaletteStatus();
  };

  // 6. Navigation Handlers
  const navigateQuestion = (targetIndex) => {
    if (targetIndex < 0) return;
    if (targetIndex >= TOTAL_Q) {
      openConfirmModal();
      return;
    }
    currentQIndex = targetIndex;
    renderActiveQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  const toggleDoubt = () => {
    const q = QUESTIONS[currentQIndex];
    if (!q) return;
    userDoubt[q.id] = !userDoubt[q.id];
    renderActiveQuestion();
  };

  // 7. Submit Confirmation Modal & Processing
  const openConfirmModal = () => {
    const answeredCount = Object.keys(userAnswers).length;
    const doubtCount = Object.values(userDoubt).filter(Boolean).length;
    const unanswered = TOTAL_Q - answeredCount;

    if (modalSummaryText) {
      modalSummaryText.innerHTML = `Anda telah menjawab <strong>${answeredCount} dari ${TOTAL_Q} soal</strong>. Apakah Anda yakin ingin menyelesaikan dan mengumpulkan try out ini sekarang?`;
    }

    if (modalUnansweredWarn) {
      if (unanswered > 0 || doubtCount > 0) {
        modalUnansweredWarn.innerHTML = `Perhatian: Ada <strong>${unanswered} soal belum diisi</strong> dan <strong>${doubtCount} soal ditandai ragu-ragu</strong>.`;
        modalUnansweredWarn.style.display = 'block';
      } else {
        modalUnansweredWarn.style.display = 'none';
      }
    }

    if (confirmModal) confirmModal.style.display = 'flex';
  };

  const closeConfirmModal = () => {
    if (confirmModal) confirmModal.style.display = 'none';
  };

  const submitExamAnswers = async () => {
    closeConfirmModal();
    clearInterval(timerInterval);

    if (btnSubmitExam) {
      btnSubmitExam.disabled = true;
      btnSubmitExam.textContent = 'Memproses Skor...';
    }

    const durationSeconds = Math.floor((Date.now() - examStartTime) / 1000);

    try {
      const res = await fetch('/api/sql/tryout/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: activeToken,
          answers: userAnswers,
          durationSeconds: durationSeconds
        })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        alert(data.error || 'Gagal mengirim jawaban try out.');
        if (btnSubmitExam) {
          btnSubmitExam.disabled = false;
          btnSubmitExam.textContent = 'Selesai & Kumpulkan';
        }
        return;
      }

      reviewData = data;
      displayResults(data);
    } catch (err) {
      console.error(err);
      alert('Terjadi kesalahan jaringan saat mengirimkan jawaban ujian.');
      if (btnSubmitExam) {
        btnSubmitExam.disabled = false;
        btnSubmitExam.textContent = 'Selesai & Kumpulkan';
      }
    }
  };

  // 8. Display Results & Detailed Review
  const displayResults = (data) => {
    screenCbt.style.display = 'none';
    screenGate.style.display = 'none';
    screenResult.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });

    if (resultScore) resultScore.textContent = String(data.score);
    if (resultCorrectCount) resultCorrectCount.textContent = String(data.correctCount);
    if (resultWrongCount) resultWrongCount.textContent = String(data.wrongCount);

    const mins = Math.floor(data.durationSeconds / 60);
    const secs = data.durationSeconds % 60;
    if (resultDuration) resultDuration.textContent = `${mins}m ${secs}s`;

    if (resultStatusBadge && resultHeading && resultDesc) {
      if (data.isPassed) {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-success m3-chip-lg';
        resultStatusBadge.textContent = 'TUNTAS (MEMENUHI KKM 75)';
        resultHeading.textContent = 'Luar Biasa! Pemahaman SQL Anda Sangat Baik';
        resultDesc.textContent = `Selamat ${data.userName}! Anda berhasil melampaui standar KKM dengan skor ${data.score}/100. Anda sudah sangat siap menghadapi ujian sesungguhnya.`;
      } else {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-error m3-chip-lg';
        resultStatusBadge.textContent = 'BELUM TUNTAS (PERLU PENGAYAAN)';
        resultHeading.textContent = 'Perlu Belajar Lebih Lanjut & Coba Lagi';
        resultDesc.textContent = `Skor Anda saat ini adalah ${data.score}/100 (KKM 75). Jangan berkecil hati, pelajari rincian pembahasan materi di bawah ini lalu ulangi Try Out!`;
      }
    }

    if (tabCountAll) tabCountAll.textContent = String(data.totalQuestions);
    if (tabCountCorrect) tabCountCorrect.textContent = String(data.correctCount);
    if (tabCountWrong) tabCountWrong.textContent = String(data.wrongCount);

    renderReviewList();
  };

  // 9. Render Review Items
  const renderReviewList = () => {
    if (!reviewListContainer || !reviewData || !reviewData.review) return;

    reviewListContainer.innerHTML = '';

    const filtered = reviewData.review.filter((item) => {
      if (activeFilter === 'correct') return item.isCorrect;
      if (activeFilter === 'wrong') return !item.isCorrect;
      return true;
    });

    if (filtered.length === 0) {
      reviewListContainer.innerHTML = '<div class="m3-empty-state">Tidak ada butir soal pada filter ini.</div>';
      return;
    }

    filtered.forEach((item) => {
      const card = document.createElement('div');
      card.className = `m3-card m3-card-outlined m3-review-item ${item.isCorrect ? 'item-correct' : 'item-wrong'}`;

      const codeHtml = item.codeSnippet
        ? `<div class="m3-code-container margin-top-xs">
            <pre class="m3-code-block font-mono"><code>${escapeHtml(item.codeSnippet)}</code></pre>
           </div>`
        : '';

      const optionsHtml = item.options
        .map((opt) => {
          const isUserChoice = item.selectedAnswer === opt.key;
          const isKeyAnswer = item.correctAnswer === opt.key;
          let optClass = 'm3-review-opt';

          if (isKeyAnswer) optClass += ' opt-is-correct-key';
          if (isUserChoice && !isKeyAnswer) optClass += ' opt-is-user-wrong';

          return `
            <div class="${optClass}">
              <div class="m3-option-circle">${opt.key}</div>
              <div class="m3-option-text">${escapeHtml(opt.text)}</div>
              ${isKeyAnswer ? '<span class="m3-tag m3-tag-success">KUNCI JAWABAN</span>' : ''}
              ${isUserChoice && !isKeyAnswer ? '<span class="m3-tag m3-tag-error">JAWABAN ANDA</span>' : ''}
              ${isUserChoice && isKeyAnswer ? '<span class="m3-tag m3-tag-success">JAWABAN ANDA (BENAR)</span>' : ''}
            </div>
          `;
        })
        .join('');

      card.innerHTML = `
        <div class="m3-review-item-header">
          <div class="m3-chip-row">
            <span class="m3-chip ${item.isCorrect ? 'm3-chip-tonal-success' : 'm3-chip-tonal-error'}">SOAL NO. ${item.id}</span>
            <span class="m3-chip m3-chip-tonal-primary">${item.category.toUpperCase()}</span>
          </div>
          <span class="m3-chip ${item.isCorrect ? 'm3-chip-tonal-success' : 'm3-chip-tonal-error'}">
            ${item.isCorrect ? 'JAWABAN BENAR' : 'JAWABAN SALAH'}
          </span>
        </div>

        <h3 class="m3-title-medium margin-top-xs">${escapeHtml(item.question)}</h3>
        ${codeHtml}

        <div class="m3-options-group margin-top-sm">
          ${optionsHtml}
        </div>

        <div class="m3-explanation-box margin-top-sm">
          <div class="m3-label-medium text-primary">Pembahasan Analisis Konsep:</div>
          <p class="m3-body-medium text-secondary margin-top-xs">${escapeHtml(item.explanation)}</p>
        </div>
      `;

      reviewListContainer.appendChild(card);
    });
  };

  const escapeHtml = (str) => {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  };

  const resetToGate = () => {
    clearInterval(timerInterval);
    screenResult.style.display = 'none';
    screenCbt.style.display = 'none';
    screenGate.style.display = 'block';
    if (btnStartExam) {
      btnStartExam.disabled = false;
      btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

