---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';
import { sqlTryoutQuestions } from '../../../data/sqlTryoutQuestions';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

let pastAttempts: any[] = [];
if (user) {
  try {
    const res = await query(
      `SELECT id, token_used, total_questions, correct_answers, score, duration_seconds, created_at 
       FROM sql_tryout_submissions 
       WHERE user_id = $1 
       ORDER BY created_at DESC 
       LIMIT 10`,
      [user.id]
    );
    pastAttempts = res.rows || [];
  } catch (e) {
    console.warn('Could not fetch past attempts:', e);
  }
}

// Prepare questions for frontend (without answers in token gate)
const initialQuestions = sqlTryoutQuestions.map((q) => ({
  id: q.id,
  category: q.category,
  question: q.question,
  codeSnippet: q.codeSnippet || null,
  options: q.options
}));
---

<MainLayout
  title="Try Out Ujian SQL & Basis Data Relasional (CBT 5 Opsi) | SMK RPL"
  description="Simulasi Try Out Ujian SQL dan Basis Data Relasional berbasis CBT dengan 25 soal pilihan ganda 5 opsi (A-E), validasi token ujian, timer countdown, penilaian instan, dan pembahasan lengkap."
>
  <div class="tryout-container">
    <!-- Breadcrumb -->
    <nav class="breadcrumb-nav">
      <a href="/">Beranda</a>
      <span class="separator">/</span>
      <a href="/belajar/sql">Belajar SQL</a>
      <span class="separator">/</span>
      <span class="current">Try Out Ujian CBT</span>
    </nav>

    {/* =========================================================
        SCREEN 1: TOKEN GATE & BRIEFING (Layar Konfirmasi Peserta)
        ========================================================= */}
    <div id="screen-gate" class="tryout-screen active">
      <div class="gate-hero-card glass-card">
        <div class="gate-badge-wrap">
          <span class="badge badge-purple">SIMULASI MANDIRI CBT</span>
          <span class="badge badge-cyan">STANDAR SMK RPL</span>
        </div>

        <h1 class="gate-title">Try Out Ujian SQL &amp; Basis Data Relasional</h1>
        <p class="gate-subtitle">
          Uji pemahaman dan kesiapan Anda sebelum menghadapi ujian resmi dengan simulasi CBT pilihan ganda 5 opsi jawaban (A, B, C, D, E), dilengkapi penilaian otomatis dan pembahasan mendalam.
        </p>

        <!-- Info Specs Cards -->
        <div class="specs-grid">
          <div class="spec-card">
            <span class="spec-icon">📝</span>
            <div class="spec-info">
              <span class="spec-label">Jumlah Soal</span>
              <strong class="spec-val">25 Pilihan Ganda</strong>
              <span class="spec-sub">5 Opsi (A, B, C, D, E)</span>
            </div>
          </div>

          <div class="spec-card">
            <span class="spec-icon">⏱️</span>
            <div class="spec-info">
              <span class="spec-label">Durasi Waktu</span>
              <strong class="spec-val">45 Menit</strong>
              <span class="spec-sub">Timer Countdown Otomatis</span>
            </div>
          </div>

          <div class="spec-card">
            <span class="spec-icon">🎯</span>
            <div class="spec-info">
              <span class="spec-label">Standar KKM</span>
              <strong class="spec-val">Nilai 75 / 100</strong>
              <span class="spec-sub">Minimal 19 Jawaban Benar</span>
            </div>
          </div>

          <div class="spec-card">
            <span class="spec-icon">💡</span>
            <div class="spec-info">
              <span class="spec-label">Umpan Balik</span>
              <strong class="spec-val">Nilai &amp; Pembahasan</strong>
              <span class="spec-sub">Langsung Tampil di Akhir</span>
            </div>
          </div>
        </div>

        {/* User Auth Gate Check */}
        {!user ? (
          <div class="auth-warning-box margin-top-md">
            <span class="warn-icon">🔒</span>
            <div class="warn-body">
              <h4>Akun Siswa Diperlukan untuk Mengerjakan Try Out</h4>
              <p>
                Silakan masuk menggunakan akun siswa Anda agar hasil dan riwayat nilai Try Out tersimpan secara permanen ke dashboard pembelajaran.
              </p>
              <div class="auth-btns margin-top-sm">
                <a href="/login?redirect=/belajar/sql/tryout" class="btn btn-primary btn-md">
                  Masuk / Login Akun &rarr;
                </a>
                <a href="/register?redirect=/belajar/sql/tryout" class="btn btn-outline btn-md">
                  Daftar Akun Siswa Baru
                </a>
              </div>
            </div>
          </div>
        ) : (
          <div class="participant-panel margin-top-md">
            <div class="participant-info-card">
              <div class="user-avatar-badge">👤</div>
              <div class="user-text">
                <span class="user-role-tag">PESERTA UJIAN TERVERIFIKASI</span>
                <h3 class="user-display-name">{user.name}</h3>
                <span class="user-email font-mono">{user.email}</span>
              </div>
            </div>

            <!-- Token Input Form -->
            <form id="token-form" class="token-form-wrap margin-top-md">
              <div class="token-input-group">
                <label for="input-token" class="token-label">
                  <strong>Masukkan Token Ujian:</strong>
                </label>
                <div class="token-field-row">
                  <input
                    type="text"
                    id="input-token"
                    name="token"
                    placeholder="Contoh: TRYOUTSQL2026"
                    class="token-input font-mono"
                    maxlength="30"
                    required
                    autocomplete="off"
                  />
                  <button type="submit" id="btn-start-exam" class="btn btn-primary btn-lg">
                    Mulai Mengerjakan Ujian &rarr;
                  </button>
                </div>
                <div id="token-error" class="token-alert error-msg" style="display: none;"></div>
                <div class="token-hint-box">
                  <span class="hint-icon">🔑</span>
                  <span>
                    Token simulasi Try Out mandiri: <strong class="font-mono text-cyan">TRYOUTSQL2026</strong> atau <strong class="font-mono text-cyan">SQL2026</strong> (atau tanyakan token aktif pada Guru Pengampu).
                  </span>
                </div>
              </div>
            </form>
          </div>
        )}

        <!-- Riwayat Pengerjaan Try Out Sebelumnya -->
        {user && pastAttempts.length > 0 && (
          <div class="history-section margin-top-lg">
            <div class="history-header">
              <span class="history-icon">📊</span>
              <h4>Riwayat Hasil Try Out Anda Sebelumnya</h4>
            </div>
            <div class="table-responsive margin-top-xs">
              <table class="data-table">
                <thead>
                  <tr>
                    <th>Waktu Ujian</th>
                    <th>Token</th>
                    <th>Jawaban Benar</th>
                    <th>Durasi</th>
                    <th>Skor Akhir</th>
                    <th>Status KKM</th>
                  </tr>
                </thead>
                <tbody>
                  {pastAttempts.map((att) => {
                    const isPassed = att.score >= 75;
                    const mins = Math.floor((att.duration_seconds || 0) / 60);
                    const secs = (att.duration_seconds || 0) % 60;
                    return (
                      <tr>
                        <td>{new Date(att.created_at).toLocaleString('id-ID', { dateStyle: 'medium', timeStyle: 'short' })}</td>
                        <td><code class="font-mono">{att.token_used}</code></td>
                        <td>{att.correct_answers} / {att.total_questions} Soal</td>
                        <td>{mins}m {secs}s</td>
                        <td><strong class={isPassed ? 'text-green' : 'text-red'}>{att.score} / 100</strong></td>
                        <td>
                          {isPassed ? (
                            <span class="badge badge-emerald">TUNTAS</span>
                          ) : (
                            <span class="badge badge-red">BELUM TUNTAS</span>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        )}
      </div>
    </div>

    {/* =========================================================
        SCREEN 2: CBT EXAMINATION WORKSPACE (Layar Pengerjaan CBT)
        ========================================================= */}
    <div id="screen-cbt" class="tryout-screen" style="display: none;">
      <!-- Sticky Top Bar CBT Header -->
      <div class="cbt-topbar glass-card">
        <div class="cbt-student-info">
          <span class="cbt-tag">CBT EXAM</span>
          <span class="cbt-name" id="cbt-user-name">{user?.name || 'Peserta Siswa'}</span>
        </div>

        <div class="cbt-timer-wrap">
          <span class="timer-icon">⏱️</span>
          <div class="timer-display font-mono" id="cbt-timer">45:00</div>
        </div>

        <div class="cbt-actions">
          <button type="button" id="btn-mobile-palette-toggle" class="btn btn-outline-cyan btn-sm mobile-only-btn" title="Buka Daftar Soal">
            📋 <span id="mobile-palette-badge">1/25</span>
          </button>
          <button type="button" id="btn-submit-exam" class="btn btn-emerald btn-md">
            <span class="submit-btn-text">Selesai &amp; Kumpulkan</span> &check;
          </button>
        </div>
      </div>

      <!-- Main CBT Grid Layout -->
      <div class="cbt-layout margin-top-md">
        <!-- Area Soal Aktif (Kiri) -->
        <main class="cbt-question-area glass-card">
          <div class="question-header">
            <div class="question-badge-group">
              <span class="badge badge-purple" id="question-num-badge">SOAL NO. 1</span>
              <span class="badge badge-cyan" id="question-category-badge">KATEGORI: DASAR DML</span>
            </div>
            <button type="button" id="btn-toggle-doubt" class="btn btn-outline-warning btn-sm">
              <span class="doubt-icon">⚠️</span> <span id="doubt-btn-text">Tandai Ragu-Ragu</span>
            </button>
          </div>

          <!-- Question Body -->
          <div class="question-content margin-top-md">
            <h3 class="question-title" id="question-text">Memuat pertanyaan...</h3>
            
            <div id="question-code-wrap" class="code-example-block margin-top-sm" style="display: none;">
              <div class="code-example-header">
                <span class="code-badge badge-purple">KODE SQL / SKENARIO:</span>
              </div>
              <pre class="code-snippet font-mono"><code id="question-code"></code></pre>
            </div>

            <!-- 5 Options Form -->
            <div class="options-container margin-top-md" id="options-container">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- Bottom Navigation Controls -->
          <div class="question-nav-footer margin-top-lg">
            <button type="button" id="btn-prev-q" class="btn btn-outline btn-md">
              &larr; Soal Sebelumnya
            </button>
            <span class="nav-indicator" id="nav-indicator-text">1 dari 25 Soal</span>
            <button type="button" id="btn-next-q" class="btn btn-primary btn-md">
              Soal Berikutnya &rarr;
            </button>
          </div>
        </main>

        <!-- Sidebar Navigation Palette (Kanan) -->
        <aside class="cbt-palette-sidebar glass-card">
          <div class="palette-header">
            <h4>Navigasi Nomor Soal</h4>
            <span class="palette-subtitle">Klik nomor untuk melompat langsung</span>
          </div>

          <!-- Status Legend -->
          <div class="palette-legend">
            <div class="legend-item"><span class="legend-dot dot-answered"></span> Terjawab</div>
            <div class="legend-item"><span class="legend-dot dot-doubt"></span> Ragu-ragu</div>
            <div class="legend-item"><span class="legend-dot dot-unanswered"></span> Belum diisi</div>
          </div>

          <!-- Question Numbers Grid (1-25) -->
          <div class="palette-grid margin-top-sm" id="palette-grid">
            <!-- Rendered via JS: buttons 1..25 -->
          </div>

          <div class="palette-summary margin-top-md" id="palette-summary">
            <span>0 Terjawab</span> &bull; <span>0 Ragu</span> &bull; <span>25 Belum</span>
          </div>
        </aside>
      </div>
    </div>

    {/* =========================================================
        SCREEN 3: RESULT & COMPREHENSIVE REVIEW (Layar Hasil)
        ========================================================= */}
    <div id="screen-result" class="tryout-screen" style="display: none;">
      <div class="result-hero-card glass-card">
        <div class="result-badge-wrap">
          <span class="badge badge-purple">HASIL SIMULASI TRY OUT</span>
          <span class="badge badge-cyan">EVALUASI CBT</span>
        </div>

        <div class="result-score-banner margin-top-md">
          <div class="score-circle-wrap">
            <div class="score-big font-mono" id="result-score">0</div>
            <span class="score-max">/ 100</span>
          </div>

          <div class="result-feedback-wrap">
            <div id="result-status-badge" class="badge badge-emerald badge-lg">TUNTAS</div>
            <h2 class="result-heading" id="result-heading">Hasil Evaluasi Try Out</h2>
            <p class="result-desc" id="result-desc">
              Memuat ulasan performa dan rekomendasi pembelajaran...
            </p>

            <div class="result-stats-row margin-top-sm">
              <div class="stat-pill">
                <span class="stat-icon">✅</span>
                <span>Benar: <strong id="result-correct-count">0</strong></span>
              </div>
              <div class="stat-pill">
                <span class="stat-icon">❌</span>
                <span>Salah: <strong id="result-wrong-count">0</strong></span>
              </div>
              <div class="stat-pill">
                <span class="stat-icon">⏱️</span>
                <span>Waktu: <strong id="result-duration">0m 0s</strong></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Action CTAs -->
        <div class="result-actions margin-top-md">
          <button type="button" id="btn-retake-tryout" class="btn btn-primary btn-md">
            🔄 Ulangi Try Out (Simulasi Baru)
          </button>
          <a href="/belajar/sql" class="btn btn-outline btn-md">
            📚 Kembali ke Katalog Modul SQL
          </a>
          <a href="/dashboard" class="btn btn-outline btn-md">
            👤 Buka Dashboard Siswa
          </a>
        </div>

        <!-- Comprehensive Question-by-Question Review -->
        <div class="review-section margin-top-xl">
          <div class="review-header-row">
            <div>
              <h3>Analisis &amp; Pembahasan Lengkap Seluruh Soal</h3>
              <p class="text-secondary">Pelajari pembahasan konseptual dari setiap butir soal untuk memperkuat pemahaman Anda.</p>
            </div>
            
            <div class="review-filter-tabs">
              <button type="button" class="filter-tab active" data-filter="all">Semua Soal (<span id="tab-count-all">25</span>)</button>
              <button type="button" class="filter-tab" data-filter="correct">Benar (<span id="tab-count-correct">0</span>)</button>
              <button type="button" class="filter-tab" data-filter="wrong">Salah (<span id="tab-count-wrong">0</span>)</button>
            </div>
          </div>

          <div class="review-list margin-top-md" id="review-list-container">
            <!-- Rendered via JS -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Palette Bottom Sheet Drawer -->
  <div id="mobile-palette-modal" class="cbt-modal-backdrop mobile-palette-backdrop" style="display: none;">
    <div class="mobile-palette-sheet glass-card">
      <div class="sheet-header">
        <div class="sheet-title-wrap">
          <h4>Daftar Nomor Soal (1–25)</h4>
          <span class="sheet-sub">Pilih nomor untuk melompat langsung ke soal</span>
        </div>
        <button type="button" id="btn-close-mobile-palette" class="btn-sheet-close" aria-label="Tutup">
          &times;
        </button>
      </div>

      <div class="palette-legend margin-top-xs">
        <div class="legend-item"><span class="legend-dot dot-answered"></span> Terjawab</div>
        <div class="legend-item"><span class="legend-dot dot-doubt"></span> Ragu-ragu</div>
        <div class="legend-item"><span class="legend-dot dot-unanswered"></span> Belum diisi</div>
      </div>

      <div class="palette-grid margin-top-sm" id="mobile-palette-grid">
        <!-- Rendered via JS -->
      </div>

      <div class="palette-summary margin-top-sm" id="mobile-palette-summary">
        <span>0 Terjawab</span> &bull; <span>0 Ragu</span> &bull; <span>25 Belum</span>
      </div>
    </div>
  </div>

  <!-- Modal Konfirmasi Submit Ujian -->
  <div id="confirm-modal" class="cbt-modal-backdrop" style="display: none;">
    <div class="cbt-modal glass-card">
      <div class="modal-icon">📋</div>
      <h3>Konfirmasi Pengumpulan Jawaban</h3>
      <p id="modal-summary-text" class="margin-top-xs">
        Anda telah menjawab <strong>25 dari 25 soal</strong>. Apakah Anda yakin ingin menyelesaikan dan mengumpulkan try out ini sekarang?
      </p>
      <div id="modal-unanswered-warning" class="modal-warn-alert" style="display: none;">
        ⚠️ Perhatian: Masih ada soal yang belum Anda jawab atau masih ditandai ragu-ragu!
      </div>
      <div class="modal-actions margin-top-md">
        <button type="button" id="btn-modal-cancel" class="btn btn-outline btn-md">
          Periksa Kembali
        </button>
        <button type="button" id="btn-modal-confirm" class="btn btn-emerald btn-md">
          Ya, Kumpulkan Sekarang &check;
        </button>
      </div>
    </div>
  </div>
</MainLayout>

<!-- Client JavaScript for CBT Interactive System -->
<script define:vars={{ initialQuestions, user }}>
  const QUESTIONS = initialQuestions;
  const TOTAL_Q = QUESTIONS.length;
  const TOTAL_DURATION_SECS = 45 * 60; // 45 minutes

  // State
  let activeToken = '';
  let currentQIndex = 0;
  let userAnswers = {}; // { questionId: 'A' | 'B' | 'C' | 'D' | 'E' }
  let userDoubt = {}; // { questionId: boolean }
  let timerInterval = null;
  let secondsRemaining = TOTAL_DURATION_SECS;
  let examStartTime = null;
  let activeFilter = 'all';
  let reviewData = null;

  // DOM Elements
  const screenGate = document.getElementById('screen-gate');
  const screenCbt = document.getElementById('screen-cbt');
  const screenResult = document.getElementById('screen-result');

  // Token Form
  const tokenForm = document.getElementById('token-form');
  const inputToken = document.getElementById('input-token');
  const btnStartExam = document.getElementById('btn-start-exam');
  const tokenError = document.getElementById('token-error');

  // CBT Interface
  const cbtTimer = document.getElementById('cbt-timer');
  const btnSubmitExam = document.getElementById('btn-submit-exam');
  const qNumBadge = document.getElementById('question-num-badge');
  const qCatBadge = document.getElementById('question-category-badge');
  const btnToggleDoubt = document.getElementById('btn-toggle-doubt');
  const doubtBtnText = document.getElementById('doubt-btn-text');
  const qText = document.getElementById('question-text');
  const qCodeWrap = document.getElementById('question-code-wrap');
  const qCode = document.getElementById('question-code');
  const optionsContainer = document.getElementById('options-container');
  const btnPrevQ = document.getElementById('btn-prev-q');
  const btnNextQ = document.getElementById('btn-next-q');
  const navIndicatorText = document.getElementById('nav-indicator-text');
  const paletteGrid = document.getElementById('palette-grid');
  const paletteSummary = document.getElementById('palette-summary');

  // Modal
  const confirmModal = document.getElementById('confirm-modal');
  const btnModalCancel = document.getElementById('btn-modal-cancel');
  const btnModalConfirm = document.getElementById('btn-modal-confirm');
  const modalSummaryText = document.getElementById('modal-summary-text');
  const modalUnansweredWarn = document.getElementById('modal-unanswered-warning');

  // Result Elements
  const resultScore = document.getElementById('result-score');
  const resultStatusBadge = document.getElementById('result-status-badge');
  const resultHeading = document.getElementById('result-heading');
  const resultDesc = document.getElementById('result-desc');
  const resultCorrectCount = document.getElementById('result-correct-count');
  const resultWrongCount = document.getElementById('result-wrong-count');
  const resultDuration = document.getElementById('result-duration');
  const btnRetakeTryout = document.getElementById('btn-retake-tryout');
  const reviewListContainer = document.getElementById('review-list-container');
  const tabCountAll = document.getElementById('tab-count-all');
  const tabCountCorrect = document.getElementById('tab-count-correct');
  const tabCountWrong = document.getElementById('tab-count-wrong');

  // Mobile Palette Drawer
  const btnMobilePaletteToggle = document.getElementById('btn-mobile-palette-toggle');
  const mobilePaletteModal = document.getElementById('mobile-palette-modal');
  const btnCloseMobilePalette = document.getElementById('btn-close-mobile-palette');
  const mobilePaletteGrid = document.getElementById('mobile-palette-grid');
  const mobilePaletteSummary = document.getElementById('mobile-palette-summary');
  const mobilePaletteBadge = document.getElementById('mobile-palette-badge');

  // Initialize
  const init = () => {
    tokenForm?.addEventListener('submit', handleTokenSubmit);
    btnPrevQ?.addEventListener('click', () => navigateQuestion(currentQIndex - 1));
    btnNextQ?.addEventListener('click', () => navigateQuestion(currentQIndex + 1));
    btnToggleDoubt?.addEventListener('click', toggleDoubt);
    btnSubmitExam?.addEventListener('click', openConfirmModal);
    btnModalCancel?.addEventListener('click', closeConfirmModal);
    btnModalConfirm?.addEventListener('click', submitExamAnswers);
    btnRetakeTryout?.addEventListener('click', resetToGate);

    // Mobile Palette Drawer toggles
    btnMobilePaletteToggle?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'flex';
    });
    btnCloseMobilePalette?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
    });
    mobilePaletteModal?.addEventListener('click', (e) => {
      if (e.target === mobilePaletteModal) {
        mobilePaletteModal.style.display = 'none';
      }
    });

    // Setup review filter tabs
    document.querySelectorAll('.filter-tab').forEach((tab) => {
      tab.addEventListener('click', (e) => {
        document.querySelectorAll('.filter-tab').forEach((t) => t.classList.remove('active'));
        const target = e.currentTarget;
        target.classList.add('active');
        activeFilter = target.getAttribute('data-filter') || 'all';
        renderReviewList();
      });
    });
  };

  // 1. Verify Token and Start CBT
  const handleTokenSubmit = async (e) => {
    e.preventDefault();
    if (!inputToken) return;

    const token = inputToken.value.trim().toUpperCase();
    if (!token) return;

    if (btnStartExam) {
      btnStartExam.disabled = true;
      btnStartExam.textContent = 'Memverifikasi Token...';
    }
    if (tokenError) tokenError.style.display = 'none';

    try {
      const res = await fetch('/api/sql/tryout/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (tokenError) {
          tokenError.textContent = data.error || 'Token tidak valid. Silakan coba lagi.';
          tokenError.style.display = 'block';
        }
        if (btnStartExam) {
          btnStartExam.disabled = false;
          btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
        }
        return;
      }

      activeToken = token;
      startCbtExam();
    } catch (err) {
      if (tokenError) {
        tokenError.textContent = 'Terjadi gangguan jaringan saat memvalidasi token.';
        tokenError.style.display = 'block';
      }
      if (btnStartExam) {
        btnStartExam.disabled = false;
        btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
      }
    }
  };

  // 2. Start CBT Exam Session
  const startCbtExam = () => {
    userAnswers = {};
    userDoubt = {};
    currentQIndex = 0;
    secondsRemaining = TOTAL_DURATION_SECS;
    examStartTime = Date.now();

    // Switch Screens
    screenGate.style.display = 'none';
    screenResult.style.display = 'none';
    screenCbt.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });

    buildPaletteGrid();
    renderActiveQuestion();
    startTimer();
  };

  // 3. Timer Countdown
  const startTimer = () => {
    clearInterval(timerInterval);
    updateTimerDisplay();

    timerInterval = setInterval(() => {
      secondsRemaining--;
      updateTimerDisplay();

      if (secondsRemaining <= 0) {
        clearInterval(timerInterval);
        alert('⏰ Waktu ujian telah habis! Jawaban Anda akan otomatis dikumpulkan.');
        submitExamAnswers();
      }
    }, 1000);
  };

  const updateTimerDisplay = () => {
    if (!cbtTimer) return;
    const mins = Math.floor(secondsRemaining / 60);
    const secs = secondsRemaining % 60;
    cbtTimer.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

    if (secondsRemaining <= 300) {
      cbtTimer.classList.add('timer-warning');
    } else {
      cbtTimer.classList.remove('timer-warning');
    }
  };

  // 4. Build Navigation Palette (Desktop + Mobile Sheet)
  const buildPaletteGrid = () => {
    const buildInto = (container) => {
      if (!container) return;
      container.innerHTML = '';
      QUESTIONS.forEach((q, idx) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'palette-btn';
        btn.setAttribute('data-qid', String(q.id));
        btn.textContent = String(q.id);
        btn.addEventListener('click', () => {
          navigateQuestion(idx);
          if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
        });
        container.appendChild(btn);
      });
    };

    buildInto(paletteGrid);
    buildInto(mobilePaletteGrid);
    updatePaletteStatus();
  };

  const updatePaletteStatus = () => {
    let answeredCount = 0;
    let doubtCount = 0;

    const syncButtons = (container) => {
      if (!container) return;
      QUESTIONS.forEach((q, idx) => {
        const btn = container.querySelector(`[data-qid="${q.id}"]`);
        if (!btn) return;

        btn.className = 'palette-btn';

        if (idx === currentQIndex) {
          btn.classList.add('active');
        }

        if (userDoubt[q.id]) {
          btn.classList.add('doubtful');
        } else if (userAnswers[q.id]) {
          btn.classList.add('answered');
        }
      });
    };

    QUESTIONS.forEach((q) => {
      if (userDoubt[q.id]) {
        doubtCount++;
      } else if (userAnswers[q.id]) {
        answeredCount++;
      }
    });

    syncButtons(paletteGrid);
    syncButtons(mobilePaletteGrid);

    const summaryHtml = `<span><strong>${answeredCount}</strong> Terjawab</span> &bull; <span><strong>${doubtCount}</strong> Ragu</span> &bull; <span><strong>${TOTAL_Q - (answeredCount + doubtCount)}</strong> Belum</span>`;
    if (paletteSummary) paletteSummary.innerHTML = summaryHtml;
    if (mobilePaletteSummary) mobilePaletteSummary.innerHTML = summaryHtml;
    if (mobilePaletteBadge) mobilePaletteBadge.textContent = `${currentQIndex + 1}/${TOTAL_Q}`;
  };

  // 5. Render Active Question
  const renderActiveQuestion = () => {
    const q = QUESTIONS[currentQIndex];
    if (!q) return;

    if (qNumBadge) qNumBadge.textContent = `SOAL NO. ${q.id} DARI ${TOTAL_Q}`;
    if (qCatBadge) qCatBadge.textContent = `KATEGORI: ${q.category.toUpperCase()}`;
    if (qText) qText.textContent = q.question;

    if (qCodeWrap && qCode) {
      if (q.codeSnippet) {
        qCode.textContent = q.codeSnippet;
        qCodeWrap.style.display = 'block';
      } else {
        qCodeWrap.style.display = 'none';
      }
    }

    // Toggle Doubt button state
    if (btnToggleDoubt && doubtBtnText) {
      if (userDoubt[q.id]) {
        btnToggleDoubt.classList.add('is-doubt');
        doubtBtnText.textContent = 'Batalkan Ragu-Ragu';
      } else {
        btnToggleDoubt.classList.remove('is-doubt');
        doubtBtnText.textContent = 'Tandai Ragu-Ragu';
      }
    }

    // Render Options
    if (optionsContainer) {
      optionsContainer.innerHTML = '';

      q.options.forEach((opt) => {
        const isChecked = userAnswers[q.id] === opt.key;
        const optCard = document.createElement('label');
        optCard.className = `option-card ${isChecked ? 'selected' : ''}`;

        optCard.innerHTML = `
          <input type="radio" name="option_q_${q.id}" value="${opt.key}" ${isChecked ? 'checked' : ''} class="option-radio" />
          <div class="option-key-circle">${opt.key}</div>
          <div class="option-text">${opt.text}</div>
        `;

        optCard.querySelector('input')?.addEventListener('change', () => {
          userAnswers[q.id] = opt.key;
          renderActiveQuestion();
          updatePaletteStatus();
        });

        optionsContainer.appendChild(optCard);
      });
    }

    // Nav Footer Controls
    if (btnPrevQ) btnPrevQ.disabled = currentQIndex === 0;
    if (btnNextQ) {
      if (currentQIndex === TOTAL_Q - 1) {
        btnNextQ.textContent = 'Selesai & Kumpulkan';
        btnNextQ.className = 'btn btn-emerald btn-md';
      } else {
        btnNextQ.textContent = 'Soal Berikutnya →';
        btnNextQ.className = 'btn btn-primary btn-md';
      }
    }
    if (navIndicatorText) {
      navIndicatorText.textContent = `${currentQIndex + 1} dari ${TOTAL_Q} Soal`;
    }

    updatePaletteStatus();
  };

  const navigateQuestion = (targetIndex) => {
    if (targetIndex < 0) return;
    if (targetIndex >= TOTAL_Q) {
      openConfirmModal();
      return;
    }
    currentQIndex = targetIndex;
    renderActiveQuestion();
    window.scrollTo({ top: 120, behavior: 'smooth' });
  };

  const toggleDoubt = () => {
    const q = QUESTIONS[currentQIndex];
    if (!q) return;

    userDoubt[q.id] = !userDoubt[q.id];
    renderActiveQuestion();
  };

  // 6. Confirm Modal
  const openConfirmModal = () => {
    const answeredCount = Object.keys(userAnswers).length;
    const unanswered = TOTAL_Q - answeredCount;
    const doubtCount = Object.values(userDoubt).filter(Boolean).length;

    if (modalSummaryText) {
      modalSummaryText.innerHTML = `Anda telah menjawab <strong>${answeredCount} dari ${TOTAL_Q} soal</strong>. (Ragu-ragu: <strong>${doubtCount}</strong>, Belum diisi: <strong>${unanswered}</strong>).`;
    }

    if (modalUnansweredWarn) {
      if (unanswered > 0 || doubtCount > 0) {
        modalUnansweredWarn.style.display = 'block';
      } else {
        modalUnansweredWarn.style.display = 'none';
      }
    }

    if (confirmModal) confirmModal.style.display = 'flex';
  };

  const closeConfirmModal = () => {
    if (confirmModal) confirmModal.style.display = 'none';
  };

  // 7. Submit Answers to Backend API
  const submitExamAnswers = async () => {
    closeConfirmModal();
    clearInterval(timerInterval);

    const durationSpent = Math.max(1, Math.round((Date.now() - examStartTime) / 1000));

    if (btnSubmitExam) {
      btnSubmitExam.disabled = true;
      btnSubmitExam.textContent = 'Menghitung Skor...';
    }

    try {
      const res = await fetch('/api/sql/tryout/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: activeToken,
          answers: userAnswers,
          durationSeconds: durationSpent
        })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        alert(data.error || 'Gagal mengirim jawaban try out.');
        if (btnSubmitExam) {
          btnSubmitExam.disabled = false;
          btnSubmitExam.textContent = 'Selesai & Kumpulkan ✓';
        }
        return;
      }

      reviewData = data;
      displayResults(data);
    } catch (err) {
      console.error(err);
      alert('Terjadi kesalahan jaringan saat mengirimkan jawaban ujian.');
      if (btnSubmitExam) {
        btnSubmitExam.disabled = false;
        btnSubmitExam.textContent = 'Selesai & Kumpulkan ✓';
      }
    }
  };

  // 8. Display Results & Detailed Review
  const displayResults = (data) => {
    screenCbt.style.display = 'none';
    screenGate.style.display = 'none';
    screenResult.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });

    if (resultScore) resultScore.textContent = String(data.score);
    if (resultCorrectCount) resultCorrectCount.textContent = String(data.correctCount);
    if (resultWrongCount) resultWrongCount.textContent = String(data.wrongCount);

    const mins = Math.floor(data.durationSeconds / 60);
    const secs = data.durationSeconds % 60;
    if (resultDuration) resultDuration.textContent = `${mins}m ${secs}s`;

    if (resultStatusBadge && resultHeading && resultDesc) {
      if (data.isPassed) {
        resultStatusBadge.className = 'badge badge-emerald badge-lg';
        resultStatusBadge.textContent = '🎉 TUNTAS (MEMENUHI KKM 75)';
        resultHeading.textContent = 'Luar Biasa! Pemahaman SQL Anda Sangat Baik';
        resultDesc.textContent = `Selamat ${data.userName}! Anda berhasil melampaui standar KKM dengan skor ${data.score}/100. Anda sudah sangat siap menghadapi ujian sesungguhnya.`;
      } else {
        resultStatusBadge.className = 'badge badge-red badge-lg';
        resultStatusBadge.textContent = '📖 BELUM TUNTAS (PERLU PENGAYAAN)';
        resultHeading.textContent = 'Perlu Belajar Lebih Lanjut & Coba Lagi';
        resultDesc.textContent = `Skor Anda saat ini adalah ${data.score}/100 (KKM 75). Jangan berkecil hati, pelajari rincian pembahasan materi di bawah ini lalu ulangi Try Out!`;
      }
    }

    if (tabCountAll) tabCountAll.textContent = String(data.totalQuestions);
    if (tabCountCorrect) tabCountCorrect.textContent = String(data.correctCount);
    if (tabCountWrong) tabCountWrong.textContent = String(data.wrongCount);

    renderReviewList();
  };

  // 9. Render Review Items
  const renderReviewList = () => {
    if (!reviewListContainer || !reviewData || !reviewData.review) return;

    reviewListContainer.innerHTML = '';

    const filtered = reviewData.review.filter((item) => {
      if (activeFilter === 'correct') return item.isCorrect;
      if (activeFilter === 'wrong') return !item.isCorrect;
      return true;
    });

    if (filtered.length === 0) {
      reviewListContainer.innerHTML = '<div class="empty-filter-msg">Tidak ada butir soal pada filter ini.</div>';
      return;
    }

    filtered.forEach((item) => {
      const card = document.createElement('div');
      card.className = `review-item-card ${item.isCorrect ? 'item-correct' : 'item-wrong'}`;

      const codeHtml = item.codeSnippet
        ? `<div class="code-example-block margin-top-xs">
            <pre class="code-snippet font-mono"><code>${escapeHtml(item.codeSnippet)}</code></pre>
           </div>`
        : '';

      const optionsHtml = item.options
        .map((opt) => {
          const isUserChoice = item.selectedAnswer === opt.key;
          const isKeyAnswer = item.correctAnswer === opt.key;
          let optClass = 'review-opt';

          if (isKeyAnswer) optClass += ' opt-is-correct-key';
          if (isUserChoice && !isKeyAnswer) optClass += ' opt-is-user-wrong';

          return `
            <div class="${optClass}">
              <span class="opt-badge">${opt.key}</span>
              <span class="opt-txt">${escapeHtml(opt.text)}</span>
              ${isKeyAnswer ? '<span class="opt-tag tag-green">KUNCI JAWABAN</span>' : ''}
              ${isUserChoice && !isKeyAnswer ? '<span class="opt-tag tag-red">JAWABAN ANDA</span>' : ''}
              ${isUserChoice && isKeyAnswer ? '<span class="opt-tag tag-green">JAWABAN ANDA ✓</span>' : ''}
            </div>
          `;
        })
        .join('');

      card.innerHTML = `
        <div class="review-item-header">
          <div class="review-meta">
            <span class="badge ${item.isCorrect ? 'badge-emerald' : 'badge-red'}">SOAL NO. ${item.id}</span>
            <span class="badge badge-purple">${item.category.toUpperCase()}</span>
          </div>
          <span class="review-status-pill ${item.isCorrect ? 'pill-green' : 'pill-red'}">
            ${item.isCorrect ? '✅ JAWABAN TEPAT' : '❌ KURANG TEPAT'}
          </span>
        </div>

        <h4 class="review-question-title margin-top-xs">${escapeHtml(item.question)}</h4>
        ${codeHtml}

        <div class="review-options-list margin-top-sm">
          ${optionsHtml}
        </div>

        <div class="review-explanation-box margin-top-sm">
          <div class="exp-title">💡 Pembahasan Konsep &amp; Analisis Guru:</div>
          <p class="exp-text">${escapeHtml(item.explanation)}</p>
        </div>
      `;

      reviewListContainer.appendChild(card);
    });
  };

  const escapeHtml = (str) => {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  };

  const resetToGate = () => {
    clearInterval(timerInterval);
    screenResult.style.display = 'none';
    screenCbt.style.display = 'none';
    screenGate.style.display = 'block';
    if (btnStartExam) {
      btnStartExam.disabled = false;
      btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
    }
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

