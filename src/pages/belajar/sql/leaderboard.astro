    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* Filter Controls Card */
  .filter-controls-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-xl);
    flex-wrap: wrap;
  }

  .filter-group-left, .filter-group-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filter-label {
