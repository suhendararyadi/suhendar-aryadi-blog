---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { seedLessons, type SQLLesson } from '../../../lib/seedLessons';
import { query } from '../../../lib/db';

const { slug } = Astro.params;

let lesson: SQLLesson | undefined;
try {
  const dbRes = await query('SELECT * FROM sql_lessons WHERE slug = $1', [slug]);
  if (dbRes.rows && dbRes.rows.length > 0) {
    lesson = dbRes.rows[0] as SQLLesson;
  }
} catch (err) {
  console.warn('Fallback to seedLessons for slug lookup:', err);
}

if (!lesson) {
  lesson = seedLessons.find((l) => l.slug === slug);
}

if (!lesson) {
  return Astro.redirect('/belajar/sql');
}

let allLessons: SQLLesson[] = seedLessons;
try {
  const dbAll = await query('SELECT * FROM sql_lessons ORDER BY order_index ASC');
  if (dbAll.rows && dbAll.rows.length > 0) {
    allLessons = dbAll.rows as SQLLesson[];
  }
} catch (err) {
  // fallback to seedLessons
}

allLessons = [...allLessons].sort((a, b) => (a.order_index || 0) - (b.order_index || 0));

const currentIdx = allLessons.findIndex((l) => l.id === lesson!.id || l.slug === lesson!.slug);
const nextLesson = currentIdx !== -1 && currentIdx < allLessons.length - 1 ? allLessons[currentIdx + 1] : null;
const prevLesson = currentIdx > 0 ? allLessons[currentIdx - 1] : null;

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect(`/auth/login?redirect=/belajar/sql/${slug}`);
}

// Simple markdown formatter helper for Astro template
function formatMarkdown(text: string): string {
  if (!text) return '';
  return text
    .replace(/^### (.*$)/gim, '<h3>$1</h3>')
    .replace(/^## (.*$)/gim, '<h2>$1</h2>')
    .replace(/^# (.*$)/gim, '<h1>$1</h1>')
    .replace(/^> (.*$)/gim, '<blockquote>$1</blockquote>')
    .replace(/```sql\n([\s\S]*?)\n```/gim, '<pre><code class="language-sql">$1</code></pre>')
    .replace(/```\n([\s\S]*?)\n```/gim, '<pre><code>$1</code></pre>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
    .replace(/\*(.*?)\*/g, '<em>$1</em>')
    .replace(/\n\n/g, '</p><p>')
    .replace(/\n/g, '<br/>');
}

const formattedTheory = formatMarkdown(lesson.theory_markdown);
const formattedInstructions = formatMarkdown(lesson.instructions_markdown);
---

<MainLayout 
  title={`${lesson.title} | Workspace Belajar SQL Interaktif`}
  description={`Latihan coding SQL interaktif: ${lesson.title}. Selesaikan tantangan dan uji pemahaman query database.`}
>
  <div class="workspace-page">
    <div class="workspace-nav">
      <div class="nav-left">
        <a href="/belajar/sql" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
          </svg>
          Katalog Modul
        </a>
        <span class="nav-separator">/</span>
        <span class="nav-current">{lesson.title}</span>
      </div>

      <div class="nav-right">
        {user && (
          <a href="/dashboard" class="btn btn-outline btn-xs" title="Dashboard Siswa">
            {user.name}
          </a>
        )}
        {prevLesson && (
          <a href={`/belajar/sql/${prevLesson.slug}`} class="btn btn-secondary btn-xs" title="Modul Sebelumnya">
            Modul Sebelumnya
          </a>
        )}
        {nextLesson && (
          <a href={`/belajar/sql/${nextLesson.slug}`} class="btn btn-secondary btn-xs" title="Modul Selanjutnya">
            Modul Selanjutnya
          </a>
        )}
      </div>
    </div>

    <div class="workspace-grid">
      <!-- PANEL KIRI: Teori & Instruksi Tugas -->
      <div class="panel panel-instructions glass-card">
        <div class="panel-header">
          <div class="badge-group">
            <span class="badge badge-cyan">{lesson.category}</span>
            <span class={`badge ${lesson.evaluator_type === 'schema_match' ? 'badge-purple' : 'badge-cyan'}`}>
              {lesson.evaluator_type === 'schema_match' ? 'Schema Match' : 'Data Match'}
            </span>
          </div>
          <span class="module-tag">Modul #{lesson.order_index}</span>
        </div>

        <h1 class="lesson-heading">{lesson.title}</h1>

        <div class="panel-section">
          <h2 class="section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
              <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
            </svg>
            Teori & Penjelasan
          </h2>
          <div class="prose theory-content" set:html={formattedTheory} />
        </div>

        <div class="panel-section instruction-section">
          <h2 class="section-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="16" x2="12" y2="12"></line>
              <line x1="12" y1="8" x2="12.01" y2="8"></line>
            </svg>
            Instruksi Tugas
          </h2>
          <div class="instruction-box">
            <div class="prose" set:html={formattedInstructions} />
          </div>
        </div>

        <!-- Evaluation Banner Status -->
        <div id="eval-status" class="eval-banner" style="display: none;"></div>
      </div>

      <!-- PANEL KANAN: Editor SQL & Tabel Hasil Exec -->
      <div class="panel panel-editor">
        <!-- Header Controls Editor -->
        <div class="editor-header glass-card">
          <div class="editor-title">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
            <strong>SQL Editor</strong>
            <span class={`badge ${lesson.evaluator_type === 'schema_match' ? 'badge-purple' : 'badge-cyan'}`}>
              {lesson.evaluator_type === 'schema_match' ? 'Schema Match' : 'Data Match'}
            </span>
          </div>

          <div class="editor-actions">
            <div class="utility-btns">
              <button id="reset-btn" class="btn btn-outline btn-sm" type="button" title="Kembalikan kode ke instruksi awal">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="1 4 1 10 7 10"></polyline>
                  <path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"></path>
                </svg>
                <span>Reset</span>
              </button>
              <button id="hint-btn" class="btn btn-secondary btn-sm" type="button" title="Tampilkan petunjuk kunci">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="12" cy="12" r="10"></circle>
                  <line x1="12" y1="16" x2="12" y2="12"></line>
                  <line x1="12" y1="8" x2="12.01" y2="8"></line>
                </svg>
                <span>Hint</span>
              </button>
            </div>

            <div class="primary-btns">
              <button id="run-btn" class="btn btn-secondary btn-sm" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
                <span>Run Query</span>
              </button>
              <button id="submit-btn" class="btn btn-primary btn-sm" type="button">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="22" y1="2" x2="11" y2="13"></line>
                  <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
                </svg>
                <span>Submit Answer</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Editor Input Textarea -->
        <div class="editor-container glass-card">
          <div class="editor-wrapper">
            <textarea 
              id="sql-input" 
              class="sql-code-editor" 
              placeholder="-- Tulis query SQL Anda di sini..."
              spellcheck="false"
              autocomplete="off"
              autocorrect="off"
              autocapitalize="off"
            >{lesson.initial_code}</textarea>
          </div>
        </div>

        <!-- Output Result Table Panel -->
        <div class="result-panel glass-card">
          <div class="result-header">
            <span class="result-title">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="20" x2="18" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="6" y1="20" x2="6" y2="14"></line>
              </svg>
              Hasil Query (Result Set)
            </span>
            <span id="rows-count" class="rows-count"></span>
          </div>

          <div id="output-table-container" class="output-container">
            <p class="placeholder-text">
              Klik <strong>Run Query</strong> untuk mengeksekusi sintaks SQL atau <strong>Submit Answer</strong> untuk menguji kebenaran jawaban Anda.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ 
  seedSql: lesson.seed_sql, 
  expectedSql: lesson.expected_sql, 
  initialCode: lesson.initial_code,
  lessonId: lesson.id,
  evaluatorType: lesson.evaluator_type || 'data_match',
  nextSlug: nextLesson ? nextLesson.slug : null
}}>
  const runBtn = document.getElementById('run-btn');
  const submitBtn = document.getElementById('submit-btn');
  const resetBtn = document.getElementById('reset-btn');
  const hintBtn = document.getElementById('hint-btn');
  const sqlInput = document.getElementById('sql-input');
  const tableContainer = document.getElementById('output-table-container');
  const rowsCountEl = document.getElementById('rows-count');
  const evalStatus = document.getElementById('eval-status');

  // Reset Code handler
  resetBtn?.addEventListener('click', () => {
    if (!sqlInput) return;
    if (confirm('Kembalikan kode editor ke instruksi awal?')) {
      sqlInput.value = initialCode || '';
      if (evalStatus) evalStatus.style.display = 'none';
      if (tableContainer) {
        tableContainer.innerHTML = '<p class="placeholder-text">Kode berhasil di-reset. Klik <strong>Run Query</strong> untuk mengeksekusi.</p>';
      }
    }
  });

  // Hint handler: Generates structured SQL clue without giving away full answer
  hintBtn?.addEventListener('click', () => {
    if (!evalStatus) return;
    evalStatus.style.display = 'block';
    evalStatus.className = 'eval-banner eval-hint';
    
    // Create structured clue from expectedSql
    let clueText = '';
    const uppercaseExpected = (expectedSql || '').trim();
    if (uppercaseExpected.toUpperCase().startsWith('SELECT')) {
      const match = uppercaseExpected.match(/SELECT\s+(.*?)\s+FROM\s+([^\s;]+)(?:\s+WHERE\s+([^\s;]+(?:\s+.*)?))?/i);
      if (match) {
        clueText = `Struktur Query: SELECT ${match[1]} FROM ${match[2]}${match[3] ? ' WHERE ...' : ''}`;
      } else {
        clueText = `Gunakan klausa SELECT dan FROM pada tabel target.`;
      }
    } else if (uppercaseExpected.toUpperCase().startsWith('CREATE TABLE')) {
      const match = uppercaseExpected.match(/CREATE TABLE\s+([^\s(]+)/i);
      clueText = `Gunakan klausa CREATE TABLE ${match ? match[1] : 'nama_tabel'} (kolom tipe_data ...);`;
    } else if (uppercaseExpected.toUpperCase().startsWith('INSERT')) {
      clueText = `Gunakan klausa INSERT INTO nama_tabel VALUES (...);`;
    } else {
      clueText = `Perhatikan kata kunci utama pada teori dan instruksi di panel kiri.`;
    }

    evalStatus.innerHTML = `
      <div class="eval-content">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eval-icon" style="color: #f59e0b;">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <div>
          <strong style="color: #f59e0b;">Petunjuk Kunci (Hint)</strong>
          <p>${escapeHtml(clueText)}</p>
        </div>
      </div>
    `;
    evalStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  });

  // Support Tab key indentation inside textarea
  sqlInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') {
      e.preventDefault();
      const start = sqlInput.selectionStart;
      const end = sqlInput.selectionEnd;
      sqlInput.value = sqlInput.value.substring(0, start) + '  ' + sqlInput.value.substring(end);
      sqlInput.selectionStart = sqlInput.selectionEnd = start + 2;
    }
  });

  runBtn?.addEventListener('click', async () => {
    if (!sqlInput) return;
    const userSql = sqlInput.value;
    
    setLoadingState(true);
    if (evalStatus) evalStatus.style.display = 'none';

    try {
      const res = await fetch('/api/sql/execute', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ seedSql, userSql })
      });
      const data = await res.json();
      renderTable(data);
    } catch (err) {
      if (tableContainer) {
        tableContainer.innerHTML = `<div class="error-alert">Gagal terhubung ke server: ${err.message}</div>`;
      }
    } finally {
      setLoadingState(false);
    }
  });

  submitBtn?.addEventListener('click', async () => {
    if (!sqlInput) return;
    const userSql = sqlInput.value;

    setLoadingState(true);

    try {
      const res = await fetch('/api/sql/evaluate', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ lessonId, seedSql, expectedSql, userSql, evaluatorType })
      });
      const data = await res.json();

      if (data.userResult) {
        renderTable(data.userResult);
      }

      if (evalStatus) {
        evalStatus.style.display = 'block';
        const isSchema = evaluatorType === 'schema_match';

        if (data.passed) {
          evalStatus.className = 'eval-banner eval-success';
          let nextBtnHtml = '';
          if (nextSlug) {
            nextBtnHtml = `<div class="next-lesson-action"><a href="/belajar/sql/${nextSlug}" class="btn btn-primary btn-sm">Modul Selanjutnya</a></div>`;
          }
          evalStatus.innerHTML = `
            <div class="eval-content">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eval-icon">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
              <div>
                <strong>${escapeHtml(data.message || 'Jawaban Anda Benar!')}</strong>
                <p>${isSchema ? '<strong>Schema Verified:</strong> Struktur tabel, view, tipe data kolom, dan constraint (PK/FK/UNIQUE/DEFAULT) berhasil diverifikasi!' : 'Selamat, query SQL Anda berhasil mengembalikan data yang tepat!'}</p>
              </div>
            </div>
            ${nextBtnHtml}
          `;
        } else {
          evalStatus.className = 'eval-banner eval-error';
          const errorMsg = data.message || data.error || 'Hasil query belum sesuai.';
          evalStatus.innerHTML = `
            <div class="eval-content">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="eval-icon">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
              <div>
                <strong>${isSchema ? 'Evaluasi Schema DDL Belum Sesuai' : 'Hasil query belum sesuai.'}</strong>
                <p class="eval-detail">${escapeHtml(errorMsg)}</p>
                ${isSchema ? '<div class="schema-feedback-tip"><strong>Petunjuk DDL:</strong> Pastikan nama tabel/view, nama kolom, tipe data, dan constraint (PRIMARY KEY, FOREIGN KEY, UNIQUE, DEFAULT, NOT NULL) sudah sesuai instruksi.</div>' : '<p>Coba periksa kembali klausa SQL, nama kolom, atau kondisi WHERE Anda.</p>'}
              </div>
            </div>
          `;
        }
        evalStatus.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
    } catch (err) {
      if (evalStatus) {
        evalStatus.style.display = 'block';
        evalStatus.className = 'eval-banner eval-error';
        evalStatus.innerHTML = `Terjadi kesalahan saat mengevaluasi jawaban: ${err.message}`;
      }
    } finally {
      setLoadingState(false);
    }
  });

  function setLoadingState(isLoading) {
    if (runBtn) runBtn.disabled = isLoading;
    if (submitBtn) submitBtn.disabled = isLoading;
    if (isLoading && tableContainer) {
      tableContainer.innerHTML = '<div class="loading-spinner">Mengeksekusi query SQL...</div>';
    }
  }

  function renderTable(data) {
    if (!tableContainer) return;

    const isSchema = evaluatorType === 'schema_match';

    if (data.error) {
      if (rowsCountEl) rowsCountEl.innerText = '';
      tableContainer.innerHTML = `
        <div class="error-alert">
          <strong>SQL Syntax Error:</strong>
          <pre class="error-code">${escapeHtml(data.error)}</pre>
        </div>
      `;
      return;
    }

    if (!data.columns || data.columns.length === 0) {
      if (rowsCountEl) rowsCountEl.innerText = '0 baris';
      tableContainer.innerHTML = `<p class="placeholder-text">${isSchema ? 'Query DDL berhasil dieksekusi! Klik <strong>Submit Answer</strong> untuk memverifikasi struktur schema database.' : 'Query berhasil dieksekusi tetapi tidak ada baris data yang dikembalikan.'}</p>`;
      return;
    }

    if (rowsCountEl) {
      rowsCountEl.innerText = `${data.values ? data.values.length : 0} ${isSchema ? 'objek schema' : 'baris data'}`;
    }

    let html = '<div class="table-wrapper"><table class="data-table"><thead><tr>';
    data.columns.forEach(col => {
      const colLabel = isSchema ? (col === 'type' ? 'Tipe Objek' : col === 'name' ? 'Nama Objek' : col === 'sql' ? 'Sintaks DDL (Schema)' : col) : col;
      html += `<th>${escapeHtml(colLabel)}</th>`;
    });
    html += '</tr></thead><tbody>';

    if (data.values && data.values.length > 0) {
      data.values.forEach(row => {
        html += '<tr>';
        row.forEach((val, idx) => {
          if (isSchema && data.columns[idx] === 'sql' && val) {
            html += `<td><code class="sql-schema-code">${escapeHtml(String(val))}</code></td>`;
          } else {
            html += `<td>${val === null ? '<span class="null-val">NULL</span>' : escapeHtml(String(val))}</td>`;
          }
        });
        html += '</tr>';
      });
    } else {
      html += `<tr><td colspan="${data.columns.length}" style="text-align: center; color: var(--text-muted);">Tidak ada baris</td></tr>`;
    }

    html += '</tbody></table></div>';
    tableContainer.innerHTML = html;
  }

  function escapeHtml(str) {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }
</script>

<style>
  .workspace-page {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: calc(100vh - 120px);
  }

  .workspace-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.25rem;
  }

  .nav-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
  }

  .back-link {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .nav-separator {
    color: var(--text-muted);
  }

  .nav-current {
    color: var(--text-primary);
    font-weight: 600;
  }

  .nav-right {
    display: flex;
    gap: 0.5rem;
  }

  .btn-xs {
    padding: 0.3rem 0.65rem;
    font-size: 0.8rem;
  }

  .workspace-grid {
    display: grid;
    grid-template-columns: 45% 55%;
    gap: 1.25rem;
    align-items: start;
  }

  /* PANEL KIRI */
  .panel-instructions {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .panel-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .module-tag {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .lesson-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .panel-section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    font-weight: 700;
    color: var(--accent-cyan);
  }

  .theory-content {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .instruction-box {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent-primary);
    border-radius: var(--radius-md);
    padding: 1rem 1.25rem;
    font-size: 0.925rem;
  }

  .badge-group {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge-purple {
    background-color: rgba(168, 85, 247, 0.12);
    color: #c084fc;
    border-color: rgba(168, 85, 247, 0.3);
