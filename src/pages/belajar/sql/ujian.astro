---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';
import { sqlExamQuestions } from '../../../data/sqlExamQuestions';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

let pastSubmission: any = null;
if (user) {
  try {
    const res = await query(
      `SELECT id, token_used, total_questions, correct_answers, score, duration_seconds, violation_count, is_disqualified, disqualification_reason, created_at 
       FROM sql_exam_submissions 
       WHERE user_id = $1 
       ORDER BY created_at DESC 
       LIMIT 1`,
      [user.id]
    );
    if (res.rows && res.rows.length > 0) {
      pastSubmission = res.rows[0];
    }
  } catch (e) {
    console.warn('Could not fetch past exam submission:', e);
  }
}

const isTeacherOrAdmin = user?.role === 'teacher' || user?.role === 'admin' || (user?.email && user.email.toLowerCase().includes('suhendar'));

// Prepare questions for frontend securely (NEVER leak correctAnswer and explanation to regular students)
const initialExamQuestions = sqlExamQuestions.map((q) => ({
  id: q.id,
  category: q.category,
  question: q.question,
  codeSnippet: q.codeSnippet || null,
  options: q.options,
  ...(isTeacherOrAdmin ? { correctAnswer: q.correctAnswer, explanation: q.explanation } : {})
}));
---

<MainLayout
  title="Ujian Evaluasi Resmi SQL & Basis Data Relasional (CBT 30 Soal) | SMK RPL"
  description="Ujian evaluasi resmi kompetensi Basis Data Relasional dan SQL standar SMK RPL dengan 30 soal pilihan ganda 5 opsi, durasi 60 menit, pengawasan keamanan tinggi (Anti-Cheat 3 Tahap, Layar Penuh, dan Kunci 5 Menit)."
>
  <!-- Immediate Data Injection for Client Engine Before Render -->
  <script is:inline define:vars={{ initialExamQuestions, user, isTeacherOrAdmin }}>
    window.__EXAM_QUESTIONS__ = initialExamQuestions;
    window.__CURRENT_USER__ = user;
    window.__IS_TEACHER_OR_ADMIN__ = Boolean(isTeacherOrAdmin);
  </script>

  <div class="m3-exam-page">
    <div class="m3-exam-container">
      <!-- M3 Breadcrumb -->
      <nav class="m3-breadcrumb">
        <a href="/">Beranda</a>
        <span class="m3-breadcrumb-sep">/</span>
        <a href="/belajar/sql">Belajar SQL</a>
        <span class="m3-breadcrumb-sep">/</span>
        <span class="m3-breadcrumb-current">Ujian Evaluasi Resmi (CBT)</span>
      </nav>

      {/* =========================================================
          SCREEN 1: TOKEN GATE & BRIEFING (High-Security Exam Gate)
          ========================================================= */}
      <div id="screen-gate" class="m3-screen active">
        <div class="m3-card m3-card-elevated m3-gate-card">
          <div class="m3-chip-row">
            <span class="m3-chip m3-chip-error-tonal">
              <span class="material-symbols-rounded icon-xs">security</span>
              PENGAWASAN KEAMANAN TINGGI
            </span>
            <span class="m3-chip m3-chip-tonal-primary">30 SOAL EVALUASI AKHIR</span>
            <span class="m3-chip m3-chip-tonal-secondary">STANDAR SMK RPL</span>
          </div>

          <h1 class="m3-title-large margin-top-xs">Ujian Evaluasi Resmi: SQL &amp; Basis Data Relasional</h1>
          <p class="m3-body-large text-secondary">
            Asesmen sumatif resmi untuk menguji penguasaan konsep relasional, DDL, DML, Agregasi, JOIN multi-tabel, Subquery, Normalisasi 1NF-3NF, dan Transaksi ACID. Ujian ini diawasi secara digital dengan sistem deteksi kecurangan otomatis.
          </p>

          <!-- M3 Info Specs Cards -->
          <div class="m3-specs-grid margin-top-md">
            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-icon-wrap bg-primary-container">
                <span class="material-symbols-rounded text-primary">format_list_numbered</span>
              </div>
              <div class="m3-spec-info">
                <span class="m3-label-small">Jumlah Soal</span>
                <strong class="m3-title-medium">30 Pilihan Ganda</strong>
                <span class="m3-body-small text-secondary">5 Opsi Jawaban (A, B, C, D, E)</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-icon-wrap bg-secondary-container">
                <span class="material-symbols-rounded text-secondary">timer</span>
              </div>
              <div class="m3-spec-info">
                <span class="m3-label-small">Durasi Pengerjaan</span>
                <strong class="m3-title-medium">60 Menit</strong>
                <span class="m3-body-small text-secondary">Hitung Mundur 3.600 Detik</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-icon-wrap bg-tertiary-container">
                <span class="material-symbols-rounded text-tertiary">grade</span>
              </div>
              <div class="m3-spec-info">
                <span class="m3-label-small">Standar KKM</span>
                <strong class="m3-title-medium">Nilai 75 / 100</strong>
                <span class="m3-body-small text-secondary">Minimal 23 Jawaban Benar</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-icon-wrap bg-error-container">
                <span class="material-symbols-rounded text-error">gavel</span>
              </div>
              <div class="m3-spec-info">
                <span class="m3-label-small">Aturan Anti-Cheat</span>
                <strong class="m3-title-medium">3-Stage Lockout</strong>
                <span class="m3-body-small text-secondary">Wajib Layar Penuh &amp; Kunci 5 Mnt</span>
              </div>
            </div>
          </div>

          <!-- Security Policy Notice Card -->
          <div class="m3-security-rules-box margin-top-md">
            <div class="m3-rules-header">
              <span class="material-symbols-rounded text-error">shield</span>
              <h3 class="m3-title-small text-error">Protokol Keamanan &amp; Tata Tertib Ujian Digital:</h3>
            </div>
            <ul class="m3-rules-list">
              <li>
                <strong>Wajib Mode Layar Penuh (Fullscreen)</strong>: Ujian hanya dapat dikerjakan dalam mode fullscreen peramban.
              </li>
              <li>
                <strong>Pelanggaran Ke-1 (Peringatan Keras)</strong>: Pindah tab, membuka jendela lain, atau meminimalkan browser akan memicu peringatan resmi dari sistem.
              </li>
              <li>
                <strong>Pelanggaran Ke-2 (Layar Terkunci 5 Menit)</strong>: Pindah layar untuk kedua kalinya akan <strong>MENGUNCI LAYAR UJIAN SELAMA 5 MENIT (300 detik)</strong>. Timer waktu ujian 60 menit tetap berjalan di latar belakang tanpa kompensasi!
              </li>
              <li>
                <strong>Pelanggaran Ke-3 (Diskualifikasi Langsung)</strong>: Pelanggaran ketiga akan menghentikan ujian seketika, dan jawaban Anda otomatis dikirim dengan status <strong>DISKUALIFIKASI KECURANGAN</strong>.
              </li>
              <li>
                <strong>Satu Kali Pengerjaan (Single Attempt)</strong>: Setelah lembar ujian dikirim, Anda tidak dapat mengulang ujian kembali.
              </li>
            </ul>
          </div>

          {/* User Auth Gate Check */}
          {!user ? (
            <div class="m3-banner m3-banner-error margin-top-md">
              <div class="m3-banner-body">
                <h4 class="m3-title-small text-error">Akun Siswa Diperlukan</h4>
                <p class="m3-body-medium text-secondary">
                  Anda wajib masuk ke akun siswa resmi terlebih dahulu agar nilai ujian evaluasi dapat diaudit dan dicatat ke buku nilai guru.
                </p>
                <div class="m3-banner-actions margin-top-sm">
                  <a href="/login?redirect=/belajar/sql/ujian" class="m3-btn m3-btn-filled">
                    Masuk Akun Siswa &rarr;
                  </a>
                  <a href="/register?redirect=/belajar/sql/ujian" class="m3-btn m3-btn-outlined">
                    Daftar Akun Baru
                  </a>
                </div>
              </div>
            </div>
          ) : (pastSubmission && !isTeacherOrAdmin) ? (
            /* Student Has Already Completed The Exam (Single Attempt View) */
            <div class="m3-card m3-card-outlined m3-already-submitted-card margin-top-md">
              <div class="m3-sub-status-header">
                <div class={`m3-status-icon-circle ${pastSubmission.is_disqualified ? 'status-disqualified' : pastSubmission.score >= 75 ? 'status-passed' : 'status-failed'}`}>
                  <span class="material-symbols-rounded">
                    {pastSubmission.is_disqualified ? 'cancel' : pastSubmission.score >= 75 ? 'verified' : 'pending_actions'}
                  </span>
                </div>
                <div>
                  <span class="m3-label-small text-secondary">STATUS EVALUASI RESMI</span>
                  <h3 class="m3-title-medium">Anda Sudah Menyelesaikan Ujian Ini</h3>
                  <span class="m3-body-small text-muted">
                    Dikerjakan pada {new Date(pastSubmission.created_at).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })}
                  </span>
                </div>
              </div>

              <div class="m3-result-metrics-grid margin-top-md">
                <div class="m3-metric-box">
                  <span class="m3-label-small">Skor Akhir</span>
                  <strong class={`metric-val ${pastSubmission.is_disqualified ? 'text-error' : pastSubmission.score >= 75 ? 'text-success' : 'text-warning'}`}>
                    {pastSubmission.score} / 100
                  </strong>
                </div>
                <div class="m3-metric-box">
                  <span class="m3-label-small">Jawaban Benar</span>
                  <strong class="metric-val">{pastSubmission.correct_answers} / {pastSubmission.total_questions}</strong>
                </div>
                <div class="m3-metric-box">
                  <span class="m3-label-small">Durasi Ujian</span>
                  <strong class="metric-val">
                    {Math.floor((pastSubmission.duration_seconds || 0) / 60)}m {(pastSubmission.duration_seconds || 0) % 60}s
                  </strong>
                </div>
                <div class="m3-metric-box">
                  <span class="m3-label-small">Audit Integritas</span>
                  <strong class={`metric-val ${pastSubmission.violation_count > 0 ? 'text-error' : 'text-success'}`}>
                    {pastSubmission.is_disqualified 
                      ? 'DISKUALIFIKASI' 
                      : pastSubmission.violation_count === 0 
                        ? 'Jujur (0 Pelanggaran)' 
                        : `${pastSubmission.violation_count} Pelanggaran`}
                  </strong>
                </div>
              </div>

              <div class="m3-helper-box margin-top-md">
                <span class="material-symbols-rounded icon-sm text-secondary">info</span>
                <span>
                  Ujian evaluasi resmi bersifat <strong>sekali tempuh (single attempt)</strong>. Nilai di atas telah tersimpan permanen di basis data sekolah. Hubungi Guru Pengampu jika Anda memerlukan sesi remedial khusus.
                </span>
              </div>

              <div class="m3-action-row margin-top-md">
                <a href="/dashboard" class="m3-btn m3-btn-filled">
                  Ke Dashboard Siswa &rarr;
                </a>
                <a href="/belajar/sql/tryout" class="m3-btn m3-btn-tonal">
                  Buka Try Out Latihan
                </a>
              </div>
            </div>
          ) : (
            /* Active Participant View with Admin Hub if Teacher */
            <>
              {isTeacherOrAdmin && (
                <div class="m3-card m3-card-outlined m3-admin-hub-card margin-top-md">
                  <div class="m3-admin-hub-header">
                    <div class="m3-admin-hub-icon">
                      <span class="material-symbols-rounded">admin_panel_settings</span>
                    </div>
                    <div class="m3-admin-hub-info">
                      <span class="m3-chip m3-chip-tonal-primary m3-chip-compact">AKSES KHUSUS GURU &amp; ADMINISTRATOR</span>
                      <h3 class="m3-title-medium margin-top-2xs">Mode Pengujian &amp; Telaah Soal Ujian (CBT 30 Soal)</h3>
                      <p class="m3-body-small text-secondary">
                        Sebagai Guru Pengampu / Admin, Anda dapat mencoba seluruh 30 butir soal secara langsung tanpa batasan pengerjaan, bebas dari penguncian anti-cheat, serta dapat membuka kunci jawaban resmi untuk memeriksa akurasi butir soal.
                      </p>
                      {pastSubmission && (
                        <div class="m3-helper-box margin-top-xs">
                          <span class="material-symbols-rounded icon-xs text-primary">history</span>
                          <span>Sesi pengujian terakhir Anda tersimpan dengan skor: <strong>{pastSubmission.score}/100</strong> ({pastSubmission.correct_answers}/30 benar).</span>
                        </div>
                      )}
                    </div>
                  </div>
                  <div class="m3-admin-hub-actions margin-top-md">
                    <button type="button" id="btn-admin-direct-start" class="m3-btn m3-btn-filled m3-btn-primary">
                      <span class="material-symbols-rounded icon-sm">play_arrow</span>
                      <span>Mulai Uji Coba Ujian (Bypass Token &amp; Anti-Cheat) &rarr;</span>
                    </button>
                    {pastSubmission && (
                      <button type="button" id="btn-admin-reset-past" class="m3-btn m3-btn-outlined m3-btn-error">
                        <span class="material-symbols-rounded icon-sm">restart_alt</span>
                        <span>Reset Riwayat Uji Coba Saya</span>
                      </button>
                    )}
                  </div>
                </div>
              )}

              <div class="m3-card m3-card-outlined m3-participant-card margin-top-md">
                <div class="m3-participant-header">
                  <div class="m3-avatar">
                    {user.name.charAt(0).toUpperCase()}
                  </div>
                  <div class="m3-participant-text">
                    <span class="m3-label-small text-primary">
                      {isTeacherOrAdmin ? 'GURU PENGAMPU / ADMIN' : 'PESERTA UJIAN TERDAFTAR'}
                    </span>
                    <h3 class="m3-title-medium">{user.name}</h3>
                    <span class="m3-body-small font-mono text-muted">{user.email}</span>
                  </div>
                </div>

                <!-- Token Input Form -->
                <form id="token-form" class="m3-token-form margin-top-md">
                  <div class="m3-token-group">
                    <label for="input-token" class="m3-label-large">
                      Masukkan Token Ujian Resmi:
                    </label>
                    <div class="m3-token-field-row">
                      <input
                        type="text"
                        id="input-token"
                        name="token"
                        value={isTeacherOrAdmin ? 'UJIAN-SQL-2026' : ''}
                        placeholder="Contoh: UJIAN-SQL-2026"
                        class="m3-text-field font-mono"
                        maxlength="30"
                        required
                        autocomplete="off"
                      />
                      <button type="submit" id="btn-start-exam" class="m3-btn m3-btn-filled m3-btn-lg">
                        <span class="material-symbols-rounded icon-sm">fullscreen</span>
                        <span>Mulai Ujian Layar Penuh &rarr;</span>
                      </button>
                    </div>
                    <div id="token-error" class="m3-alert m3-alert-error" style="display: none;"></div>
                    <div class="m3-helper-box">
                      <span>
                        Token resmi diberikan oleh Guru Pengampu di ruang ujian (Token default: <strong class="font-mono text-primary">UJIAN-SQL-2026</strong> atau <strong class="font-mono text-primary">EVALUASI-SQL</strong>).
                      </span>
                    </div>
                  </div>
                </form>
              </div>
            </>
          )}
        </div>
      </div>

      {/* =========================================================
          SCREEN 2: HIGH-SECURITY CBT EXAMINATION ARENA
          ========================================================= */}
      <div id="screen-cbt" class="m3-screen" style="display: none;">
        <!-- M3 Top App Bar with Live Security Status -->
        <header class="m3-top-app-bar">
          <div class="m3-app-bar-top-row">
            <div class="m3-app-bar-leading">
              <span class="m3-badge-tonal">EVALUASI RESMI</span>
              <span class="material-symbols-rounded icon-sm text-secondary">person</span>
              <span class="m3-title-small m3-app-bar-title" id="cbt-user-name">{user?.name || 'Peserta Siswa'}</span>
            </div>

            <!-- Security & Violation Badge -->
            <div class="m3-security-pill" id="security-status-pill">
              <span class="material-symbols-rounded icon-xs" id="security-icon">verified_user</span>
              <span id="security-text">Status: Aman (0/3)</span>
            </div>

            <!-- Main Countdown Timer -->
            <div class="m3-timer-container">
              <span class="material-symbols-rounded icon-sm timer-icon">timer</span>
              <span class="m3-label-small timer-label text-secondary">Sisa:</span>
              <span class="m3-title-medium font-mono m3-timer-text" id="cbt-timer">60:00</span>
            </div>
          </div>

          <div class="m3-app-bar-actions">
            <button type="button" id="btn-mobile-palette-toggle" class="m3-btn m3-btn-tonal m3-mobile-only" title="Daftar Nomor Soal">
              <span class="material-symbols-rounded icon-sm">grid_view</span>
              <span>Daftar Soal (<span id="mobile-palette-badge">1/30</span>)</span>
            </button>
            <button type="button" id="btn-submit-exam" class="m3-btn m3-btn-filled m3-btn-success" title="Selesai &amp; Kumpulkan">
              <span class="material-symbols-rounded icon-sm">check_circle</span>
              <span class="m3-btn-label">Selesai Ujian</span>
            </button>
          </div>
        </header>

        <!-- Main CBT Layout Grid -->
        <div class="m3-cbt-layout margin-top-md">
          <!-- Area Soal Aktif (Kiri) -->
          <main class="m3-card m3-card-elevated m3-question-card">
            <div class="m3-question-header">
              <div class="m3-chip-row">
                <span class="m3-chip m3-chip-tonal-primary" id="question-num-badge">SOAL NO. 1 DARI 30</span>
                <span class="m3-chip m3-chip-tonal-secondary" id="question-category-badge">KONSEP BASIS DATA</span>
                {isTeacherOrAdmin && (
                  <button type="button" id="btn-toggle-admin-key" class="m3-chip m3-chip-tonal-tertiary" title="Buka Kunci Guru">
                    <span class="material-symbols-rounded icon-xs">key</span>
                    <span id="admin-key-btn-text">Kunci Guru: OFF</span>
                  </button>
                )}
              </div>
              <button type="button" id="btn-toggle-doubt" class="m3-chip-filter" aria-pressed="false">
                <span class="m3-chip-checkbox"></span>
                <span id="doubt-btn-text">Ragu-Ragu</span>
              </button>
            </div>

            <!-- Question Body -->
            <div class="m3-question-content margin-top-md">
              <h2 class="m3-title-large m3-question-title" id="question-text">Memuat pertanyaan...</h2>
              
              <div id="question-code-wrap" class="m3-code-container margin-top-sm" style="display: none;">
                <div class="m3-code-header">
                  <span class="m3-label-small font-mono">SKENARIO / KODE SQL:</span>
                </div>
                <pre class="m3-code-block font-mono"><code id="question-code"></code></pre>
              </div>

              <!-- 5 Options Form -->
              <div class="m3-options-group margin-top-md" id="options-container">
                <!-- Rendered dynamically via JS -->
              </div>

              <!-- Admin Teacher Explanation & Key Box (Visible only when showAdminKey is active) -->
              <div id="admin-explanation-box" class="m3-admin-explanation-box margin-top-md" style="display: none;">
                <div class="m3-admin-explanation-header">
                  <span class="material-symbols-rounded icon-sm text-primary">lightbulb</span>
                  <strong class="m3-label-large">Kunci Guru &amp; Pembahasan Soal:</strong>
                </div>
                <p class="m3-body-medium margin-top-2xs" id="admin-explanation-text"></p>
              </div>
            </div>

            <!-- Bottom Navigation Controls -->
            <footer class="m3-question-footer margin-top-lg">
              <button type="button" id="btn-prev-q" class="m3-btn m3-btn-outlined">
                &larr; Soal Sebelumnya
              </button>
              <span class="m3-label-medium text-secondary" id="nav-indicator-text">1 dari 30 Soal</span>
              <button type="button" id="btn-next-q" class="m3-btn m3-btn-filled">
                Soal Berikutnya &rarr;
              </button>
            </footer>
          </main>

          <!-- Sidebar Navigation Palette (Kanan) -->
          <aside class="m3-card m3-card-elevated m3-palette-card">
            <div class="m3-palette-header">
              <h3 class="m3-title-medium">Navigasi 30 Nomor Soal</h3>
              <span class="m3-body-small text-secondary">Klik nomor untuk berpindah soal langsung</span>
            </div>

            <!-- Status Legend -->
            <div class="m3-palette-legend">
              <div class="m3-legend-item"><span class="m3-legend-box m3-box-answered"></span> Terjawab</div>
              <div class="m3-legend-item"><span class="m3-legend-box m3-box-doubt"></span> Ragu-ragu</div>
              <div class="m3-legend-item"><span class="m3-legend-box m3-box-unanswered"></span> Belum diisi</div>
            </div>

            <!-- 30 Question Number Buttons Grid -->
            <div class="m3-palette-grid margin-top-sm" id="palette-grid">
              <!-- Rendered via JS -->
            </div>

            <!-- Palette Summary Statistics -->
            <div class="m3-palette-summary margin-top-md" id="palette-summary">
              <div class="m3-summary-item">
                <span class="m3-body-small text-secondary">Terjawab:</span>
                <strong id="summary-answered-count">0 / 30</strong>
              </div>
              <div class="m3-summary-item">
                <span class="m3-body-small text-secondary">Ragu-ragu:</span>
                <strong id="summary-doubt-count" class="text-warning">0</strong>
              </div>
            </div>

            <!-- High Security Watermark -->
            <div class="m3-security-watermark margin-top-md">
              <span class="material-symbols-rounded icon-xs text-secondary">lock</span>
              <span class="m3-label-small text-secondary">Protokol Keamanan Aktif</span>
            </div>
          </aside>
        </div>

        <!-- Mobile Sticky Bottom Action Bar (Ergonomic thumb controls on phones) -->
        <nav class="m3-mobile-bottom-bar" id="mobile-bottom-bar" aria-label="Navigasi Soal Ponsel">
          <button type="button" id="btn-mobile-prev-q" class="m3-mobile-nav-btn" aria-label="Soal Sebelumnya">
            <span class="material-symbols-rounded">arrow_back</span>
            <span class="mobile-nav-label">Sebelumnya</span>
          </button>

          <button type="button" id="btn-mobile-palette-trigger" class="m3-mobile-nav-btn palette-trigger" aria-label="Daftar Soal">
            <span class="material-symbols-rounded">grid_view</span>
            <span class="mobile-nav-label font-mono" id="mobile-bottom-indicator">1 / 30</span>
          </button>

          <button type="button" id="btn-mobile-doubt-trigger" class="m3-mobile-nav-btn doubt-trigger" aria-label="Tandai Ragu-ragu">
            <span class="material-symbols-rounded" id="mobile-doubt-icon">bookmark_border</span>
            <span class="mobile-nav-label" id="mobile-doubt-label">Ragu</span>
          </button>

          <button type="button" id="btn-mobile-next-q" class="m3-mobile-nav-btn primary" aria-label="Soal Berikutnya">
            <span class="mobile-nav-label" id="mobile-next-label">Berikutnya</span>
            <span class="material-symbols-rounded" id="mobile-next-icon">arrow_forward</span>
          </button>
        </nav>
      </div>

      {/* =========================================================
          SCREEN 3: EVALUATION RESULT & AUDIT SUMMARY
          ========================================================= */}
      <div id="screen-result" class="m3-screen" style="display: none;">
        <div class="m3-card m3-card-elevated m3-result-card">
          <!-- Header Banner Status -->
          <div class="m3-result-header text-center">
            <div class="m3-result-badge-wrap">
              <span class="m3-chip m3-chip-tonal-primary" id="result-status-badge">HASIL EVALUASI RESMI</span>
