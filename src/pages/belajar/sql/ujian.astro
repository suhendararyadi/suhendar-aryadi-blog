---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { query } from '../../../lib/db';
import { sqlExamQuestions } from '../../../data/sqlExamQuestions';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

let pastSubmission: any = null;
if (user) {
  try {
    const res = await query(
      `SELECT id, token_used, total_questions, correct_answers, score, duration_seconds, violation_count, is_disqualified, disqualification_reason, created_at 
       FROM sql_exam_submissions 
       WHERE user_id = $1 
       ORDER BY created_at DESC 
       LIMIT 1`,
      [user.id]
    );
    if (res.rows && res.rows.length > 0) {
      pastSubmission = res.rows[0];
    }
  } catch (e) {
    console.warn('Could not fetch past exam submission:', e);
  }
}

const isTeacherOrAdmin = user?.role === 'teacher' || user?.role === 'admin' || (user?.email && user.email.toLowerCase().includes('suhendar'));

// Prepare questions for frontend securely (NEVER leak correctAnswer and explanation to regular students)
const initialExamQuestions = sqlExamQuestions.map((q) => ({
  id: q.id,
  category: q.category,
  question: q.question,
  codeSnippet: q.codeSnippet || null,
  options: q.options,
  ...(isTeacherOrAdmin ? { correctAnswer: q.correctAnswer, explanation: q.explanation } : {})
}));
---

<MainLayout
  title="Ujian Evaluasi Resmi SQL & Basis Data Relasional (CBT 30 Soal) | SMK RPL"
  description="Ujian evaluasi resmi kompetensi Basis Data Relasional dan SQL standar SMK RPL dengan 30 soal pilihan ganda 5 opsi, durasi 60 menit, pengawasan keamanan tinggi (Anti-Cheat 3 Tahap, Layar Penuh, dan Kunci 5 Menit)."
>
  <!-- Immediate Data Injection for Client Engine Before Render -->
  <script is:inline define:vars={{ initialExamQuestions, user, isTeacherOrAdmin }}>
    window.__EXAM_QUESTIONS__ = initialExamQuestions;
    window.__CURRENT_USER__ = user;
    window.__IS_TEACHER_OR_ADMIN__ = Boolean(isTeacherOrAdmin);
  </script>

  <div class="m3-tryout-page m3-exam-page">
    <div class="m3-tryout-container m3-exam-container">
      <!-- M3 Breadcrumb -->
      <nav class="m3-breadcrumb">
        <a href="/">Beranda</a>
        <span class="m3-breadcrumb-sep">/</span>
        <a href="/belajar/sql">Belajar SQL</a>
        <span class="m3-breadcrumb-sep">/</span>
        <span class="m3-breadcrumb-current">Ujian Evaluasi Resmi CBT</span>
      </nav>

      {/* =========================================================
          SCREEN 1: TOKEN GATE & BRIEFING (M3 Card Container)
          ========================================================= */}
      <div id="screen-gate" class="m3-screen active">
        <div class="m3-card m3-card-elevated m3-gate-card">
          <div class="m3-chip-row">
            <span class="m3-chip m3-chip-tonal-error">PENGAWASAN KEAMANAN TINGGI</span>
            <span class="m3-chip m3-chip-tonal-primary">30 SOAL EVALUASI AKHIR</span>
            <span class="m3-chip m3-chip-tonal-secondary">STANDAR SMK RPL</span>
          </div>

          <h1 class="m3-title-large">Ujian Evaluasi Resmi: SQL &amp; Basis Data Relasional</h1>
          <p class="m3-body-large text-secondary">
            Asesmen sumatif resmi untuk menguji penguasaan konsep relasional, DDL, DML, Agregasi, JOIN multi-tabel, Subquery, Normalisasi 1NF-3NF, dan Transaksi ACID. Ujian ini diawasi secara digital dengan sistem deteksi kecurangan otomatis.
          </p>

          <!-- M3 Info Specs Cards -->
          <div class="m3-specs-grid">
            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Jumlah Soal</span>
                <strong class="m3-title-medium">30 Pilihan Ganda</strong>
                <span class="m3-body-small text-secondary">5 Opsi (A, B, C, D, E)</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Durasi Waktu</span>
                <strong class="m3-title-medium">60 Menit</strong>
                <span class="m3-body-small text-secondary">Timer Countdown Otomatis</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Standar KKM</span>
                <strong class="m3-title-medium">Nilai 75 / 100</strong>
                <span class="m3-body-small text-secondary">Minimal 23 Jawaban Benar</span>
              </div>
            </div>

            <div class="m3-card m3-card-outlined m3-spec-card">
              <div class="m3-spec-info">
                <span class="m3-label-small">Aturan Anti-Cheat</span>
                <strong class="m3-title-medium">3-Stage Lockout</strong>
                <span class="m3-body-small text-secondary">Wajib Layar Penuh &amp; Kunci 5 Mnt</span>
              </div>
            </div>
          </div>

          <!-- Security Policy Notice Card -->
          <div class="m3-helper-box margin-top-xs" style="border-left: 4px solid var(--m3-error); background: var(--m3-surface-container);">
            <div style="display: flex; align-items: center; gap: 0.5rem;">
              <span class="material-symbols-rounded text-error" style="font-size: 1.15rem;">shield</span>
              <strong class="text-error">Tata Tertib &amp; Protokol Keamanan Ujian Digital:</strong>
            </div>
            <ul style="margin: 0.4rem 0 0; padding-left: 1.25rem; font-size: 0.8125rem; line-height: 1.6;">
              <li><strong>Wajib Mode Layar Penuh (Fullscreen)</strong>: Peramban otomatis meminta layar penuh saat memulai ujian.</li>
              <li><strong>Pelanggaran Ke-1 (Peringatan Keras)</strong>: Pindah tab, membuka jendela lain, atau keluar fullscreen memicu peringatan resmi dari sistem.</li>
              <li><strong>Pelanggaran Ke-2 (Layar Terkunci 5 Menit)</strong>: Pindah layar untuk kedua kalinya <strong>MENGUNCI LAYAR SELAMA 5 MENIT (300 detik)</strong>. Timer 60 menit tetap berjalan tanpa kompensasi!</li>
              <li><strong>Pelanggaran Ke-3 (Diskualifikasi Langsung)</strong>: Ujian seketika dihentikan dan jawaban otomatis dikirim dengan status <strong>DISKUALIFIKASI KECURANGAN</strong>.</li>
              <li><strong>Satu Kali Pengerjaan (Single Attempt)</strong>: Lembar ujian yang telah dikirim tersimpan permanen dan tidak dapat diulang.</li>
            </ul>
          </div>

          {/* User Auth Gate Check */}
          {!user ? (
            <div class="m3-alert m3-alert-error margin-top-md">
              <h4 class="m3-title-small text-error">Akun Siswa Diperlukan</h4>
              <p class="m3-body-medium text-secondary margin-top-xs">
                Anda wajib masuk menggunakan akun siswa Anda agar nilai ujian evaluasi resmi dapat diaudit dan dicatat ke buku nilai guru.
              </p>
              <div style="display: flex; gap: 0.5rem; margin-top: 0.75rem;">
                <a href="/login?redirect=/belajar/sql/ujian" class="m3-btn m3-btn-filled">
                  Masuk Akun Siswa &rarr;
                </a>
                <a href="/register?redirect=/belajar/sql/ujian" class="m3-btn m3-btn-outlined">
                  Daftar Akun Baru
                </a>
              </div>
            </div>
          ) : (pastSubmission && !isTeacherOrAdmin) ? (
            /* Student Has Already Completed The Exam (Single Attempt View) */
            <div class="m3-card m3-card-outlined margin-top-md">
              <div class="m3-participant-header">
                <div class="m3-avatar" style={pastSubmission.is_disqualified ? 'background: var(--m3-error);' : pastSubmission.score >= 75 ? 'background: var(--m3-success);' : 'background: var(--m3-warning);'}>
                  <span class="material-symbols-rounded">{pastSubmission.is_disqualified ? 'cancel' : pastSubmission.score >= 75 ? 'verified' : 'pending_actions'}</span>
                </div>
                <div class="m3-participant-text">
                  <span class="m3-label-small text-secondary">STATUS EVALUASI RESMI</span>
                  <h3 class="m3-title-medium">Anda Sudah Menyelesaikan Ujian Ini</h3>
                  <span class="m3-body-small text-muted">
                    Dikerjakan pada {new Date(pastSubmission.created_at).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })}
                  </span>
                </div>
              </div>

              <div class="m3-stats-row margin-top-md" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                <div class="m3-stat-item">
                  <span class="m3-body-small">Skor: <strong class={pastSubmission.is_disqualified ? 'text-error' : pastSubmission.score >= 75 ? 'text-success' : 'text-error'}>{pastSubmission.score} / 100</strong></span>
                </div>
                <div class="m3-stat-item">
                  <span class="m3-body-small">Benar: <strong>{pastSubmission.correct_answers} / {pastSubmission.total_questions} Soal</strong></span>
                </div>
                <div class="m3-stat-item">
                  <span class="m3-body-small">Durasi: <strong>{Math.floor((pastSubmission.duration_seconds || 0) / 60)}m {(pastSubmission.duration_seconds || 0) % 60}s</strong></span>
                </div>
                <div class="m3-stat-item">
                  <span class="m3-body-small">Integritas: <strong class={pastSubmission.violation_count > 0 ? 'text-error' : 'text-success'}>{pastSubmission.is_disqualified ? 'DISKUALIFIKASI' : pastSubmission.violation_count === 0 ? '0 Pelanggaran (Jujur)' : `${pastSubmission.violation_count} Pelanggaran`}</strong></span>
                </div>
              </div>

              <div class="m3-helper-box margin-top-md">
                <span>
                  Ujian evaluasi resmi bersifat <strong>sekali tempuh (single attempt)</strong>. Nilai di atas telah tersimpan permanen di buku nilai guru. Hubungi Guru Pengampu jika Anda memerlukan sesi remedial khusus.
                </span>
              </div>

              <div class="m3-result-actions margin-top-md">
                <a href="/dashboard" class="m3-btn m3-btn-filled">
                  Ke Dashboard Siswa &rarr;
                </a>
                <a href="/belajar/sql/tryout" class="m3-btn m3-btn-tonal">
                  Buka Try Out Latihan
                </a>
              </div>
            </div>
          ) : (
            <>
              {/* Teacher/Admin Test Mode Card */}
              {isTeacherOrAdmin && (
                <>
                <div class="m3-card m3-card-outlined margin-top-md" style="background: var(--m3-primary-container); border: 1.5px solid var(--m3-primary);">
                  <div class="m3-participant-header" style="border-bottom: none; padding-bottom: 0;">
                    <div class="m3-avatar" style="background: var(--m3-primary); color: var(--m3-on-primary);">
                      <span class="material-symbols-rounded">admin_panel_settings</span>
                    </div>
                    <div class="m3-participant-text">
                      <span class="m3-chip m3-chip-tonal-primary" style="background: var(--m3-primary); color: var(--m3-on-primary);">AKSES KHUSUS GURU &amp; ADMIN</span>
                      <h3 class="m3-title-medium margin-top-xs">Mode Pengujian &amp; Telaah Soal Ujian (30 Soal)</h3>
                      <p class="m3-body-small text-secondary margin-top-xs">
                        Sebagai Guru Pengampu / Admin, Anda dapat mencoba seluruh 30 butir soal secara langsung tanpa batasan pengerjaan, bebas dari penguncian anti-cheat, serta dapat membuka kunci jawaban resmi.
                      </p>
                      {pastSubmission && (
                        <div class="m3-helper-box margin-top-xs" style="background: rgba(255,255,255,0.6);">
                          <span>Sesi pengujian terakhir Anda tersimpan dengan skor: <strong>{pastSubmission.score}/100</strong> ({pastSubmission.correct_answers}/30 benar).</span>
                        </div>
                      )}
                    </div>
                  </div>
                  <div class="margin-top-sm" style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
                    <button type="button" id="btn-admin-direct-start" class="m3-btn m3-btn-filled">
                      Mulai Uji Coba Ujian (Bypass Token &amp; Anti-Cheat) &rarr;
                    </button>
                    <a href="/admin/ujian/monitoring" class="m3-btn m3-btn-tonal" style="display: inline-flex; align-items: center; gap: 0.4rem; text-decoration: none; background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; font-weight: 600;">
                      <span class="material-symbols-rounded" style="font-size: 1.15rem;">monitoring</span>
                      Konsol Pengawas Layar Penuh &rarr;
                    </a>
                    {pastSubmission && (
                      <button type="button" id="btn-admin-reset-past" class="m3-btn m3-btn-outlined" style="color: var(--m3-error); border-color: var(--m3-error);">
                        Reset Riwayat Uji Coba Saya
                      </button>
                    )}
                  </div>
                </div>

                {/* Teacher/Admin Embedded Live Monitoring Panel */}
                <div id="admin-embedded-monitoring-card" class="m3-card m3-card-elevated margin-top-md" style="border: 1.5px solid var(--m3-primary); background: #ffffff; padding: 1.25rem;">
                  <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
                    <div>
                      <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.25rem;">
                        <span class="m3-chip m3-chip-tonal-primary" style="background: #ecfdf5; color: #065f46; border: 1px solid #a7f3d0; font-size: 0.75rem; font-weight: 700;">
                          <span style="display: inline-block; width: 8px; height: 8px; background: #10b981; border-radius: 50%; margin-right: 4px;"></span>
                          LIVE TELEMETRY
                        </span>
                        <span class="m3-chip m3-chip-tonal-secondary" style="font-size: 0.75rem;">KONSOL PENGAWAS CBT</span>
                      </div>
                      <h3 class="m3-title-medium" style="margin: 0;">Live Monitoring Pengerjaan Siswa (Real-Time)</h3>
                      <p class="m3-body-small text-secondary" style="margin: 0.2rem 0 0 0;">
                        Pemantauan langsung progres butir soal, status penguncian layar 5 menit, dan tombol remote unlock.
                      </p>
                    </div>
                    <div style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                      <button type="button" id="btn-emb-refresh" class="m3-btn m3-btn-outlined" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.35rem;">
                        <span class="material-symbols-rounded" style="font-size: 1rem;">sync</span>
                        Refresh
                      </button>
                      <a href="/admin/ujian/monitoring" target="_blank" class="m3-btn m3-btn-filled" style="padding: 0.35rem 0.75rem; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 0.35rem; text-decoration: none;">
                        <span class="material-symbols-rounded" style="font-size: 1rem;">open_in_new</span>
                        Buka di Tab Terpisah
                      </a>
                    </div>
                  </div>

                  <!-- Quick KPI Row -->
                  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 0.75rem; margin-bottom: 1rem;">
                    <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.5rem; padding: 0.65rem; text-align: center;">
                      <div style="font-size: 0.7rem; font-weight: 600; color: #64748b;">TOTAL SISWA</div>
                      <div id="emb-kpi-total" style="font-size: 1.4rem; font-weight: 800; color: #0f172a;">-</div>
                    </div>
                    <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 0.5rem; padding: 0.65rem; text-align: center;">
                      <div style="font-size: 0.7rem; font-weight: 700; color: #065f46;">SEDANG AKTIF</div>
                      <div id="emb-kpi-active" style="font-size: 1.4rem; font-weight: 800; color: #16a34a;">-</div>
                    </div>
                    <div style="background: #fef2f2; border: 1px solid #fecaca; border-radius: 0.5rem; padding: 0.65rem; text-align: center;">
                      <div style="font-size: 0.7rem; font-weight: 700; color: #991b1b;">TERKUNCI 5 MNT</div>
                      <div id="emb-kpi-locked" style="font-size: 1.4rem; font-weight: 800; color: #dc2626;">-</div>
                    </div>
                    <div style="background: #fffbeb; border: 1px solid #fde68a; border-radius: 0.5rem; padding: 0.65rem; text-align: center;">
                      <div style="font-size: 0.7rem; font-weight: 700; color: #92400e;">PERINGATAN 1X</div>
                      <div id="emb-kpi-violations" style="font-size: 1.4rem; font-weight: 800; color: #d97706;">-</div>
                    </div>
                    <div style="background: #f0fdf4; border: 1px solid #bbf7d0; border-radius: 0.5rem; padding: 0.65rem; text-align: center;">
                      <div style="font-size: 0.7rem; font-weight: 700; color: #166534;">SELESAI (SUBMIT)</div>
                      <div id="emb-kpi-submitted" style="font-size: 1.4rem; font-weight: 800; color: #0d9488;">-</div>
                    </div>
                  </div>

                  <!-- Quick Filter Row -->
                  <div style="display: flex; gap: 0.5rem; margin-bottom: 0.75rem; flex-wrap: wrap;">
                    <select id="emb-filter-class" style="padding: 0.35rem 0.6rem; font-size: 0.8rem; border-radius: 0.4rem; border: 1px solid #cbd5e1; background: #f8fafc;">
                      <option value="">Semua Kelas</option>
                    </select>
                    <select id="emb-filter-status" style="padding: 0.35rem 0.6rem; font-size: 0.8rem; border-radius: 0.4rem; border: 1px solid #cbd5e1; background: #f8fafc;">
                      <option value="ALL">Semua Status</option>
                      <option value="in_progress">Sedang Mengerjakan</option>
                      <option value="locked">Terkunci 5 Menit</option>
                      <option value="submitted">Selesai</option>
                    </select>
                    <input type="text" id="emb-search-student" placeholder="Cari nama siswa..." style="padding: 0.35rem 0.6rem; font-size: 0.8rem; border-radius: 0.4rem; border: 1px solid #cbd5e1; background: #f8fafc; flex: 1; min-width: 150px;" />
                  </div>

                  <!-- Mini Telemetry Table -->
                  <div style="overflow-x: auto; max-height: 360px; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 0.5rem;">
                    <table style="width: 100%; border-collapse: collapse; font-size: 0.8rem;">
                      <thead>
                        <tr style="background: #f8fafc; position: sticky; top: 0; z-index: 1;">
                          <th style="padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid #cbd5e1; white-space: nowrap;">Siswa</th>
                          <th style="padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid #cbd5e1; white-space: nowrap;">Kelas</th>
                          <th style="padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid #cbd5e1; white-space: nowrap;">Status</th>
                          <th style="padding: 0.5rem 0.6rem; text-align: left; border-bottom: 1px solid #cbd5e1; min-width: 130px;">Progres Soal</th>
                          <th style="padding: 0.5rem 0.6rem; text-align: center; border-bottom: 1px solid #cbd5e1; white-space: nowrap;">Nilai</th>
                          <th style="padding: 0.5rem 0.6rem; text-align: right; border-bottom: 1px solid #cbd5e1; min-width: 130px;">Aksi Pengawas</th>
                        </tr>
                      </thead>
                      <tbody id="emb-roster-tbody">
                        <tr>
                          <td colspan="6" style="padding: 2rem; text-align: center; color: #64748b;">
                            Memuat data live monitoring...
                          </td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                  <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 0.5rem; font-size: 0.725rem; color: #64748b;">
                    <span>Auto-refresh setiap 10 detik.</span>
                    <span id="emb-last-updated-text">Terakhir diperbarui: -</span>
                  </div>
                </div>
                </>
              )}

              <div class="m3-card m3-card-outlined m3-participant-card margin-top-md">
                <div class="m3-participant-header">
                  <div class="m3-avatar">
                    {user.name.charAt(0).toUpperCase()}
                  </div>
                  <div class="m3-participant-text">
                    <span class="m3-label-small text-primary">{isTeacherOrAdmin ? 'GURU PENGAMPU / ADMIN' : 'PESERTA UJIAN TERVERIFIKASI'}</span>
                    <h3 class="m3-title-medium">{user.name}</h3>
                    <span class="m3-body-small font-mono text-muted">{user.email}</span>
                  </div>
                </div>

                <!-- Token Input Form -->
                <form id="token-form" class="m3-token-form margin-top-md">
                  <div class="m3-token-group">
                    <label for="input-token" class="m3-label-large">
                      Masukkan Token Ujian Resmi:
                    </label>
                    <div class="m3-token-field-row">
                      <input
                        type="text"
                        id="input-token"
                        name="token"
                        value={isTeacherOrAdmin ? 'UJIAN-SQL-2026' : ''}
                        placeholder="Contoh: UJIAN-SQL-2026"
                        class="m3-text-field font-mono"
                        maxlength="30"
                        required
                        autocomplete="off"
                      />
                      <button type="submit" id="btn-start-exam" class="m3-btn m3-btn-filled m3-btn-lg">
                        Mulai Mengerjakan Ujian &rarr;
                      </button>
                    </div>
                    <div id="token-error" class="m3-alert m3-alert-error" style="display: none;"></div>
                    <div class="m3-helper-box">
                      <span>
                        Token resmi diberikan oleh Guru di ruang ujian: <strong class="font-mono text-primary">UJIAN-SQL-2026</strong> atau <strong class="font-mono text-primary">EVALUASI-SQL</strong>.
                      </span>
                    </div>
                  </div>
                </form>
              </div>
            </>
          )}
        </div>
      </div>

      {/* =========================================================
          SCREEN 2: CBT EXAMINATION WORKSPACE (Exact Tryout Layout)
          ========================================================= */}
      <div id="screen-cbt" class="m3-screen" style="display: none;">
        <!-- M3 Top App Bar -->
        <header class="m3-top-app-bar">
          <div class="m3-app-bar-top-row">
            <div class="m3-app-bar-leading">
              <span class="m3-badge-tonal">EVALUASI SQL</span>
              <span class="material-symbols-rounded icon-sm text-secondary">person</span>
              <span class="m3-title-small m3-app-bar-title" id="cbt-user-name">{user?.name || 'Peserta Siswa'}</span>
            </div>

            <!-- Security Pill -->
            <div class="m3-timer-container" id="security-status-pill" style="border-radius: 9999px;">
              <span class="material-symbols-rounded icon-sm text-primary" id="security-icon">verified_user</span>
              <span class="m3-label-small" id="security-text">Aman (0/3)</span>
            </div>

            <!-- Timer Countdown -->
            <div class="m3-timer-container">
              <span class="material-symbols-rounded icon-sm timer-icon">timer</span>
              <span class="m3-label-small timer-label text-secondary">Sisa:</span>
              <span class="m3-title-medium font-mono m3-timer-text" id="cbt-timer">60:00</span>
            </div>
          </div>

          <div class="m3-app-bar-actions">
            <button type="button" id="btn-mobile-palette-toggle" class="m3-btn m3-btn-tonal m3-mobile-only" title="Daftar Nomor Soal">
              <span class="material-symbols-rounded icon-sm">grid_view</span>
              <span>Daftar Soal (<span id="mobile-palette-badge">1/30</span>)</span>
            </button>
