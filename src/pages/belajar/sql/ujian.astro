    background-color: var(--m3-error-container);
    color: var(--m3-on-error-container);
  }

  /* Specs Grid */
  .m3-specs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
  }
  .m3-spec-card {
