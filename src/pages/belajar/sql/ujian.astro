<!-- Client JavaScript for CBT Interactive System (Aligned with Tryout) -->
<script>
  // =========================================================================
  // CLIENT-SIDE HIGH-SECURITY EXAM & ANTI-CHEAT ENGINE
  // =========================================================================
  const TOTAL_DURATION_SECS = 60 * 60; // 60 Minutes (3,600 Seconds)
  const LOCKOUT_DURATION_SECS = 5 * 60; // 5 Minutes (300 Seconds)

  const getExamQuestions = (): any[] => {
    return (window as any).__EXAM_QUESTIONS__ || [];
  };
  const getCurrentUser = (): any => {
    return (window as any).__CURRENT_USER__ || null;
  };
  const getIsTeacherOrAdmin = (): boolean => {
    return Boolean((window as any).__IS_TEACHER_OR_ADMIN__);
  };

  let activeToken = '';
  let currentQIndex = 0;
  let userAnswers: Record<number, string> = {};
  let userDoubt: Record<number, boolean> = {};
  let timerInterval: any = null;
  let secondsRemaining = TOTAL_DURATION_SECS;
  let examStartTime: number | null = null;

  // Admin / Teacher Test Mode
  let isAdminMode = getIsTeacherOrAdmin();
  let showAdminKey = false;

  // Anti-Cheat State
  let isExamActive = false;
  let isSubmitting = false;
  let violationCount = 0;
  let isLocked = false;
  let lockoutRemaining = LOCKOUT_DURATION_SECS;
  let lockoutInterval: any = null;
  let violationCooldown = false;

  // DOM Elements
  const screenGate = document.getElementById('screen-gate');
  const screenCbt = document.getElementById('screen-cbt');
  const screenResult = document.getElementById('screen-result');

  // Token Gate Elements
  const tokenForm = document.getElementById('token-form');
  const inputToken = document.getElementById('input-token') as HTMLInputElement | null;
  const btnStartExam = document.getElementById('btn-start-exam') as HTMLButtonElement | null;
  const tokenError = document.getElementById('token-error');

  // Admin Hub Elements
  const btnAdminDirectStart = document.getElementById('btn-admin-direct-start');
  const btnAdminResetPast = document.getElementById('btn-admin-reset-past');
  const btnToggleAdminKey = document.getElementById('btn-toggle-admin-key');
  const adminKeyBtnText = document.getElementById('admin-key-btn-text');
  const adminExplanationBox = document.getElementById('admin-explanation-box');
  const adminExplanationText = document.getElementById('admin-explanation-text');

  // CBT Elements
  const cbtTimer = document.getElementById('cbt-timer');
  const securityStatusPill = document.getElementById('security-status-pill');
  const securityIcon = document.getElementById('security-icon');
  const securityText = document.getElementById('security-text');
  const btnSubmitExam = document.getElementById('btn-submit-exam');
  const qNumBadge = document.getElementById('question-num-badge');
  const qCatBadge = document.getElementById('question-category-badge');
  const btnToggleDoubt = document.getElementById('btn-toggle-doubt');
  const doubtBtnText = document.getElementById('doubt-btn-text');
  const qText = document.getElementById('question-text');
  const qCodeWrap = document.getElementById('question-code-wrap');
  const qCode = document.getElementById('question-code');
  const optionsContainer = document.getElementById('options-container');
  const btnPrevQ = document.getElementById('btn-prev-q') as HTMLButtonElement | null;
  const btnNextQ = document.getElementById('btn-next-q') as HTMLButtonElement | null;
  const navIndicatorText = document.getElementById('nav-indicator-text');
  const paletteGrid = document.getElementById('palette-grid');
  const paletteSummary = document.getElementById('palette-summary');

  // Mobile Drawer Elements
  const btnMobilePaletteToggle = document.getElementById('btn-mobile-palette-toggle');
  const mobilePaletteModal = document.getElementById('mobile-palette-modal');
  const btnCloseMobilePalette = document.getElementById('btn-close-mobile-palette');
  const mobilePaletteGrid = document.getElementById('mobile-palette-grid');
  const mobilePaletteSummary = document.getElementById('mobile-palette-summary');
  const mobilePaletteBadge = document.getElementById('mobile-palette-badge');

  // Dialogs
  const confirmModal = document.getElementById('confirm-modal');
  const btnModalCancel = document.getElementById('btn-modal-cancel');
  const btnModalConfirm = document.getElementById('btn-modal-confirm');
  const modalSummaryText = document.getElementById('modal-summary-text');
  const modalUnansweredWarn = document.getElementById('modal-unanswered-warning');

  const modalViolation1 = document.getElementById('modal-violation-1');
  const btnViolation1Confirm = document.getElementById('btn-violation-1-confirm');

  const modalLockout = document.getElementById('modal-lockout');
  const lockoutCountdownDisplay = document.getElementById('lockout-countdown-display');

  const modalDisqualified = document.getElementById('modal-disqualified');
  const btnDisqualifiedViewResult = document.getElementById('btn-disqualified-view-result');

  // Result Elements
  const resultScore = document.getElementById('result-score');
  const resultStatusBadge = document.getElementById('result-status-badge');
  const resultHeading = document.getElementById('result-heading');
  const resultDesc = document.getElementById('result-desc');
  const resultCorrectCount = document.getElementById('result-correct-count');
  const resultWrongCount = document.getElementById('result-wrong-count');
  const resultDuration = document.getElementById('result-duration');
  const resultIntegrityVal = document.getElementById('result-integrity-val');

  // Storage key
  const userObj = getCurrentUser();
  const storageKey = userObj ? `sql_exam_answers_${userObj.id}` : 'sql_exam_answers_guest';

  // Escape HTML helper
  const escapeHtml = (str: string) => {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  };

  // =========================================================================
  // HEARTBEAT TELEMETRY & REMOTE UNLOCK (FAIL-SAFE)
  // =========================================================================
  let heartbeatInterval: number | null = null;

  const sendHeartbeat = async () => {
    if (!isExamActive || isSubmitting || isAdminMode) return;
    try {
      const answeredCount = Object.keys(userAnswers).length;
      const doubtCount = Object.values(userDoubt).filter(Boolean).length;
      const durationSeconds = examStartTime ? Math.round((Date.now() - examStartTime) / 1000) : 0;

      const res = await fetch('/api/sql/ujian/heartbeat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: activeToken,
          answersCount: answeredCount,
          currentQuestionIndex: currentQIndex,
          doubtCount: doubtCount,
          durationSeconds: durationSeconds,
          violationCount: violationCount,
          isLocked: isLocked,
          lockoutRemaining: lockoutRemaining
        })
      });

      if (res.ok) {
        const data = await res.json();
        if (data && data.forceUnlocked && isLocked) {
          unlockStudentFromRemote();
        }
      }
    } catch (e) {
      // Fail-silent: never disrupt student
    }
  };

  const startHeartbeat = () => {
    if (heartbeatInterval) clearInterval(heartbeatInterval);
    sendHeartbeat();
    heartbeatInterval = window.setInterval(sendHeartbeat, 10000);
  };

  const unlockStudentFromRemote = () => {
    if (lockoutInterval) clearInterval(lockoutInterval);
    isLocked = false;
    lockoutRemaining = 0;
    if (modalLockout) modalLockout.style.display = 'none';
    updateSecurityPill();

    try {
      if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
        document.documentElement.requestFullscreen();
      }
    } catch (e) {}

    showStudentNotice('Kunci ujian telah dibuka oleh Pengawas Guru. Silakan lanjutkan pengerjaan.');
  };

  const showStudentNotice = (msg: string) => {
    const existing = document.getElementById('exam-remote-notice');
    if (existing) existing.remove();

    const banner = document.createElement('div');
    banner.id = 'exam-remote-notice';
    banner.style.cssText = 'position: fixed; top: 1.5rem; left: 50%; transform: translateX(-50%); background: #15803d; color: #ffffff; padding: 0.75rem 1.5rem; border-radius: 9999px; box-shadow: 0 10px 15px -3px rgba(0,0,0,0.3); font-size: 0.875rem; font-weight: 600; z-index: 10000; display: flex; align-items: center; gap: 0.5rem;';
    banner.innerHTML = '<span class="material-symbols-rounded">check_circle</span> ' + escapeHtml(msg);
    document.body.appendChild(banner);

    setTimeout(() => {
      banner.remove();
    }, 5000);
  };

  // =========================================================================
  // EMBEDDED TEACHER TELEMETRY ENGINE (PROCTOR HUB)
  // =========================================================================
  let embPollInterval: number | null = null;
  let embRawStudents: any[] = [];

  const embKpiTotal = document.getElementById('emb-kpi-total');
  const embKpiActive = document.getElementById('emb-kpi-active');
  const embKpiLocked = document.getElementById('emb-kpi-locked');
  const embKpiViolations = document.getElementById('emb-kpi-violations');
  const embKpiSubmitted = document.getElementById('emb-kpi-submitted');
  const embFilterClass = document.getElementById('emb-filter-class') as HTMLSelectElement | null;
  const embFilterStatus = document.getElementById('emb-filter-status') as HTMLSelectElement | null;
  const embSearchStudent = document.getElementById('emb-search-student') as HTMLInputElement | null;
  const embRosterTbody = document.getElementById('emb-roster-tbody');
  const embLastUpdated = document.getElementById('emb-last-updated-text');
  const btnEmbRefresh = document.getElementById('btn-emb-refresh');

  const fetchEmbeddedTelemetry = async () => {
    if (!(window as any).__IS_TEACHER_OR_ADMIN__) return;
    try {
      const res = await fetch('/api/sql/ujian/monitoring', {
        headers: { 'Cache-Control': 'no-cache' }
      });
      if (!res.ok) return;
      const data = await res.json();
      if (data && data.success) {
        embRawStudents = data.students || [];

        if (embKpiTotal) embKpiTotal.textContent = String(data.summary?.totalStudents || 0);
        if (embKpiActive) embKpiActive.textContent = String(data.summary?.inProgressCount || 0);
        if (embKpiLocked) embKpiLocked.textContent = String(data.summary?.lockedCount || 0);
        if (embKpiViolations) embKpiViolations.textContent = String(data.summary?.violationAlertCount || 0);
        if (embKpiSubmitted) embKpiSubmitted.textContent = String(data.summary?.submittedCount || 0);

        if (embFilterClass) {
          const cur = embFilterClass.value;
          const currentOpts = Array.from(embFilterClass.options).map((o: any) => o.value);
          (data.classes || []).forEach((c: string) => {
            if (!currentOpts.includes(c)) {
              const opt = document.createElement('option');
              opt.value = c;
              opt.textContent = c;
              embFilterClass.appendChild(opt);
            }
          });
          embFilterClass.value = cur;
        }

        renderEmbeddedTable();

        if (embLastUpdated) {
          const now = new Date();
          embLastUpdated.textContent = 'Terakhir diperbarui: ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        }
      }
    } catch (e) {
      console.warn('Embedded telemetry fetch warning:', e);
    }
  };

  const renderEmbeddedTable = () => {
    if (!embRosterTbody) return;
    const selectedClass = embFilterClass ? embFilterClass.value.trim().toLowerCase() : '';
    const selectedStatus = embFilterStatus ? embFilterStatus.value : 'ALL';
    const query = embSearchStudent ? embSearchStudent.value.trim().toLowerCase() : '';

    const filtered = embRawStudents.filter((s: any) => {
      if (selectedClass && (s.className || '').toLowerCase() !== selectedClass) return false;
      if (selectedStatus !== 'ALL' && s.status !== selectedStatus) return false;
      if (query) {
        const text = `${s.name} ${s.email} ${s.className}`.toLowerCase();
        if (!text.includes(query)) return false;
      }
      return true;
    });

    if (filtered.length === 0) {
      embRosterTbody.innerHTML = '<tr><td colspan="6" style="padding: 1.5rem; text-align: center; color: #64748b;">Tidak ada data siswa yang cocok dengan filter.</td></tr>';
      return;
    }

    let html = '';
    filtered.forEach((s: any) => {
      const isLocked = s.status === 'locked';
      const answered = s.progress?.answered || 0;
      const total = s.progress?.total || 30;
      const percent = s.progress?.percentage || 0;

      let statusBadge = `<span class="m3-chip ${s.statusBadgeClass || ''}" style="font-size: 0.7rem; padding: 0.15rem 0.45rem;">${s.statusLabel}</span>`;
      if (isLocked) {
        statusBadge += ` <span style="font-size: 0.65rem; color: #dc2626; font-weight: 700;">(Terkunci)</span>`;
      }

      const scoreText = s.finalScore !== null && s.finalScore !== undefined ? `<strong>${s.finalScore}</strong>/100` : '-';

      let actionHtml = '-';
      if (isLocked) {
        actionHtml = `<button type="button" class="m3-btn m3-btn-filled" style="padding: 0.2rem 0.5rem; font-size: 0.725rem; background: #dc2626;" onclick="window.embeddedProctorAction('unlock', ${s.userId}, '${encodeURIComponent(s.name)}')">Buka Kunci</button>`;
      } else {
        actionHtml = `<button type="button" class="m3-btn m3-btn-outlined" style="padding: 0.2rem 0.5rem; font-size: 0.725rem;" onclick="window.embeddedProctorAction('reset', ${s.userId}, '${encodeURIComponent(s.name)}')">Reset</button>`;
      }

      html += `
        <tr style="border-bottom: 1px solid #f1f5f9;">
          <td style="padding: 0.45rem 0.6rem;">
            <strong>${escapeHtml(s.name)}</strong>
            <div style="font-size: 0.7rem; color: #64748b;">${escapeHtml(s.email)}</div>
          </td>
          <td style="padding: 0.45rem 0.6rem; white-space: nowrap;">${escapeHtml(s.className || '-')}</td>
          <td style="padding: 0.45rem 0.6rem; white-space: nowrap;">${statusBadge}</td>
          <td style="padding: 0.45rem 0.6rem;">
            <div style="font-size: 0.725rem; font-weight: 600;">${answered}/${total} (${percent}%)</div>
            <div style="width: 100%; height: 5px; background: #e2e8f0; border-radius: 9999px; overflow: hidden; margin-top: 2px;">
              <div style="width: ${percent}%; height: 100%; background: ${percent === 100 ? '#10b981' : '#1976d2'};"></div>
            </div>
          </td>
          <td style="padding: 0.45rem 0.6rem; text-align: center;">${scoreText}</td>
          <td style="padding: 0.45rem 0.6rem; text-align: right; white-space: nowrap;">${actionHtml}</td>
        </tr>
      `;
    });

    embRosterTbody.innerHTML = html;
  };

  (window as any).embeddedProctorAction = async (action: string, userId: number, encodedName: string) => {
    const sName = decodeURIComponent(encodedName);
    if (action === 'unlock') {
      if (!confirm(`Buka kunci layar untuk siswa ${sName}? Layar siswa akan langsung aktif kembali.`)) return;
    } else if (action === 'reset') {
      if (!confirm(`PERINGATAN: Reset sesi pengerjaan untuk ${sName}? Jawaban dan nilai tersimpan akan dihapus dari server sehingga siswa dapat mengulang dari awal.`)) return;
    }

    try {
      const res = await fetch('/api/sql/ujian/monitoring-action', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ action, targetUserId: userId })
      });
      const data = await res.json();
      if (data && data.success) {
        alert(data.message || 'Aksi berhasil dijalankan.');
        fetchEmbeddedTelemetry();
      } else {
        alert(data?.error || 'Gagal menjalankan aksi pengawas.');
      }
    } catch (e) {
      alert('Terjadi kesalahan jaringan.');
    }
  };

  // =========================================================================
  // 1. INITIALIZE EVENT LISTENERS
  // =========================================================================
  const init = () => {
    // Admin buttons
    btnAdminDirectStart?.addEventListener('click', () => {
      activeToken = 'ADMIN-TRY';
      isAdminMode = true;
      startCbtExam();
    });

    btnAdminResetPast?.addEventListener('click', async () => {
      if (!confirm('Reset riwayat uji coba Anda di server? Nilai sebelumnya akan dihapus sehingga Anda dapat menguji coba kembali.')) return;
      try {
        const res = await fetch('/api/sql/ujian/reset', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          try {
            sessionStorage.removeItem(storageKey);
          } catch (e) {}
          window.location.reload();
        } else {
          alert(data.error || 'Gagal mereset sesi.');
        }
      } catch (e) {
        alert('Terjadi kendala jaringan saat menghubungi server.');
      }
    });

    btnToggleAdminKey?.addEventListener('click', () => {
      showAdminKey = !showAdminKey;
      if (adminKeyBtnText) {
        adminKeyBtnText.textContent = showAdminKey ? 'Kunci Guru: ON' : 'Kunci Guru: OFF';
      }
      renderActiveQuestion();
    });

    tokenForm?.addEventListener('submit', handleTokenSubmit);
    btnPrevQ?.addEventListener('click', () => navigateQuestion(currentQIndex - 1));
    btnNextQ?.addEventListener('click', () => navigateQuestion(currentQIndex + 1));
    btnToggleDoubt?.addEventListener('click', toggleDoubt);
    btnSubmitExam?.addEventListener('click', openConfirmModal);
    btnModalCancel?.addEventListener('click', closeConfirmModal);
    btnModalConfirm?.addEventListener('click', () => submitExamAnswers(false, ''));
    btnViolation1Confirm?.addEventListener('click', acknowledgeViolation1);
    btnDisqualifiedViewResult?.addEventListener('click', () => {
      if (modalDisqualified) modalDisqualified.style.display = 'none';
    });

    // Mobile Palette Drawer
    btnMobilePaletteToggle?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'flex';
    });
    btnCloseMobilePalette?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
    });
    mobilePaletteModal?.addEventListener('click', (e) => {
      if (e.target === mobilePaletteModal) {
        mobilePaletteModal.style.display = 'none';
      }
    });

    setupAntiCheatListeners();

    // Initialize Embedded Teacher Telemetry if Admin
    if ((window as any).__IS_TEACHER_OR_ADMIN__) {
      fetchEmbeddedTelemetry();
      embPollInterval = window.setInterval(fetchEmbeddedTelemetry, 10000);
      btnEmbRefresh?.addEventListener('click', fetchEmbeddedTelemetry);
      embFilterClass?.addEventListener('change', renderEmbeddedTable);
      embFilterStatus?.addEventListener('change', renderEmbeddedTable);
      embSearchStudent?.addEventListener('input', renderEmbeddedTable);
    }
  };

  // =========================================================================
  // 2. TOKEN VERIFICATION & START CBT
  // =========================================================================
  const handleTokenSubmit = async (e: Event) => {
    e.preventDefault();
    if (!inputToken) return;

    const token = inputToken.value.trim().toUpperCase();
    if (!token) return;

    if (btnStartExam) {
      btnStartExam.disabled = true;
      btnStartExam.innerHTML = '<span class="material-symbols-rounded icon-sm spinning">sync</span> Memverifikasi Token...';
    }
    if (tokenError) tokenError.style.display = 'none';

    try {
      const res = await fetch('/api/sql/ujian/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (tokenError) {
          tokenError.textContent = data.error || 'Token ujian tidak valid.';
          tokenError.style.display = 'block';
        }
        if (btnStartExam) {
          btnStartExam.disabled = false;
          btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
        }
        return;
      }

      activeToken = token;

      // Request fullscreen on user gesture
      try {
        if (document.documentElement.requestFullscreen) {
          await document.documentElement.requestFullscreen();
        } else if ((document.documentElement as any).webkitRequestFullscreen) {
          await (document.documentElement as any).webkitRequestFullscreen();
        }
      } catch (fsErr) {
        console.warn('Fullscreen request bypassed or denied:', fsErr);
      }

      startCbtExam();
    } catch (err) {
      if (tokenError) {
        tokenError.textContent = 'Gagal menghubungi server pengawas ujian.';
        tokenError.style.display = 'block';
      }
      if (btnStartExam) {
        btnStartExam.disabled = false;
        btnStartExam.textContent = 'Mulai Mengerjakan Ujian →';
      }
    }
  };

  // =========================================================================
  // 3. START CBT SESSION
  // =========================================================================
  const startCbtExam = () => {
    try {
      const saved = sessionStorage.getItem(storageKey);
      if (saved) {
        userAnswers = JSON.parse(saved) || {};
      }
    } catch (e) {
      console.warn('Could not read session answers:', e);
    }

    if (screenGate) screenGate.style.display = 'none';
    if (screenResult) screenResult.style.display = 'none';
    if (screenCbt) screenCbt.style.display = 'block';

    window.scrollTo({ top: 0, behavior: 'smooth' });

    isExamActive = true;
    examStartTime = Date.now();
    secondsRemaining = TOTAL_DURATION_SECS;

    updateSecurityPill();
    buildPaletteGrid();
    renderActiveQuestion();
    startTimer();
    startHeartbeat();
  };

  // =========================================================================
  // 4. TIMER COUNTDOWN
  // =========================================================================
  const startTimer = () => {
    if (timerInterval) clearInterval(timerInterval);
    updateTimerDisplay();

    timerInterval = window.setInterval(() => {
      secondsRemaining--;
      updateTimerDisplay();

      if (secondsRemaining <= 0) {
        clearInterval(timerInterval);
        submitExamAnswers(false, 'Waktu pengerjaan ujian 60 menit telah habis');
      }
    }, 1000);
  };

  const updateTimerDisplay = () => {
    if (!cbtTimer) return;
    const mins = Math.floor(secondsRemaining / 60);
    const secs = secondsRemaining % 60;
    cbtTimer.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

    if (secondsRemaining <= 300) {
      cbtTimer.classList.add('timer-warning');
    } else {
      cbtTimer.classList.remove('timer-warning');
    }
  };

  // =========================================================================
  // 5. BUILD NAVIGATION PALETTE (Desktop + Mobile Bottom Sheet)
  // =========================================================================
  const buildPaletteGrid = () => {
    const questions = getExamQuestions();
    const buildInto = (container: HTMLElement | null) => {
      if (!container) return;
      container.innerHTML = '';
      questions.forEach((q: any, idx: number) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'm3-palette-btn';
        btn.setAttribute('data-qid', String(q.id));
        btn.textContent = String(idx + 1);
        btn.addEventListener('click', () => {
          if (isLocked && !isAdminMode) return;
          navigateQuestion(idx);
          if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
        });
        container.appendChild(btn);
      });
    };

    buildInto(paletteGrid);
    buildInto(mobilePaletteGrid);
    updatePaletteStatus();
  };

  const updatePaletteStatus = () => {
    const questions = getExamQuestions();
    const TOTAL_Q = questions.length;
    let answeredCount = 0;
    let doubtCount = 0;

    const syncButtons = (container: HTMLElement | null) => {
      if (!container) return;
      questions.forEach((q: any, idx: number) => {
        const btn = container.querySelector(`[data-qid="${q.id}"]`);
        if (!btn) return;

        btn.className = 'm3-palette-btn';

        if (idx === currentQIndex) {
          btn.classList.add('active');
        }

        if (userDoubt[q.id]) {
          btn.classList.add('doubtful');
        } else if (userAnswers[q.id]) {
          btn.classList.add('answered');
        }
      });
    };

    questions.forEach((q: any) => {
      if (userDoubt[q.id]) {
        doubtCount++;
      } else if (userAnswers[q.id]) {
        answeredCount++;
      }
    });

    syncButtons(paletteGrid);
    syncButtons(mobilePaletteGrid);

    const summaryHtml = `<span><strong>${answeredCount}</strong> Terjawab</span> &bull; <span><strong>${doubtCount}</strong> Ragu</span> &bull; <span><strong>${TOTAL_Q - (answeredCount + doubtCount)}</strong> Belum</span>`;
    if (paletteSummary) paletteSummary.innerHTML = summaryHtml;
    if (mobilePaletteSummary) mobilePaletteSummary.innerHTML = summaryHtml;
    if (mobilePaletteBadge) mobilePaletteBadge.textContent = `${currentQIndex + 1}/${TOTAL_Q}`;
  };

  // =========================================================================
  // 6. RENDER ACTIVE QUESTION & OPTION CARDS
  // =========================================================================
  const renderActiveQuestion = () => {
    const questions = getExamQuestions();
    const TOTAL_Q = questions.length;
    const q = questions[currentQIndex];
    if (!q) return;

    if (qNumBadge) qNumBadge.textContent = `SOAL NO. ${currentQIndex + 1} DARI ${TOTAL_Q}`;
    if (qCatBadge) qCatBadge.textContent = (q.category || 'BASIS DATA').toUpperCase();
    if (qText) qText.textContent = q.question;

    if (qCodeWrap && qCode) {
      if (q.codeSnippet) {
        qCode.textContent = q.codeSnippet;
        qCodeWrap.style.display = 'block';
      } else {
        qCodeWrap.style.display = 'none';
      }
    }

    // Toggle Doubt button state (tryout pattern)
    if (btnToggleDoubt && doubtBtnText) {
      if (userDoubt[q.id]) {
        btnToggleDoubt.classList.add('is-doubt');
        btnToggleDoubt.setAttribute('aria-pressed', 'true');
        doubtBtnText.textContent = 'Ragu-Ragu (Ditandai)';
      } else {
        btnToggleDoubt.classList.remove('is-doubt');
        btnToggleDoubt.setAttribute('aria-pressed', 'false');
        doubtBtnText.textContent = 'Ragu-Ragu';
      }
    }

    // Admin Teacher Explanation & Key Box
    if (isAdminMode && showAdminKey && q.explanation) {
      if (adminExplanationBox && adminExplanationText) {
        adminExplanationText.textContent = q.explanation;
        adminExplanationBox.style.display = 'block';
      }
    } else {
      if (adminExplanationBox) {
        adminExplanationBox.style.display = 'none';
      }
    }

    // Render Options in M3 Selection Cards (Identical Tryout Layout with .m3-option-circle)
    if (optionsContainer) {
      optionsContainer.innerHTML = '';

      q.options.forEach((opt: { key: string; text: string }) => {
        const isChecked = userAnswers[q.id] === opt.key;
        const isCorrectKey = isAdminMode && showAdminKey && q.correctAnswer === opt.key;

        const optCard = document.createElement('label');
        optCard.className = `m3-option-card ${isChecked ? 'selected' : ''} ${isCorrectKey ? 'opt-is-correct-key' : ''}`;
        optCard.setAttribute('data-key', opt.key);

        optCard.innerHTML = `
          <input type="radio" name="option_q_${q.id}" value="${opt.key}" ${isChecked ? 'checked' : ''} class="m3-radio-hidden" />
          <div class="m3-option-circle">${opt.key}</div>
          <div class="m3-option-text">${escapeHtml(opt.text)}</div>
          ${isCorrectKey ? '<span class="m3-tag m3-tag-success font-mono">KUNCI RESMI</span>' : ''}
        `;

        optCard.querySelector('input')?.addEventListener('change', () => {
          if (isLocked && !isAdminMode) return;
          selectAnswer(q.id, opt.key);
        });

        optCard.addEventListener('click', (e) => {
          if (isLocked && !isAdminMode) {
            e.preventDefault();
            return;
          }
          selectAnswer(q.id, opt.key);
        });

        optionsContainer.appendChild(optCard);
      });
    }

    // Update Bottom Navigation state
    if (btnPrevQ) btnPrevQ.disabled = currentQIndex === 0;
    if (btnNextQ) {
      if (currentQIndex === TOTAL_Q - 1) {
        btnNextQ.textContent = 'Selesai & Kumpulkan →';
      } else {
        btnNextQ.textContent = 'Soal Berikutnya →';
      }
    }
    if (navIndicatorText) {
      navIndicatorText.textContent = `${currentQIndex + 1} dari ${TOTAL_Q} Soal`;
    }

    updatePaletteStatus();
  };

  const selectAnswer = (questionId: number, optionKey: string) => {
    if (isLocked && !isAdminMode) return;
    userAnswers[questionId] = optionKey;
    try {
      sessionStorage.setItem(storageKey, JSON.stringify(userAnswers));
    } catch (e) {}

    // In-place UI update on option cards
    if (optionsContainer) {
      const cards = optionsContainer.querySelectorAll('.m3-option-card');
      cards.forEach((card) => {
        const key = card.getAttribute('data-key');
        const isSelected = key === optionKey;
        card.classList.toggle('selected', isSelected);
        const radio = card.querySelector<HTMLInputElement>('input[type="radio"]');
        if (radio) radio.checked = isSelected;
      });
    }

    updatePaletteStatus();
  };

  const toggleDoubt = () => {
    if (isLocked && !isAdminMode) return;
    const questions = getExamQuestions();
    const q = questions[currentQIndex];
    if (!q) return;
    userDoubt[q.id] = !userDoubt[q.id];
    renderActiveQuestion();
  };

  const navigateQuestion = (targetIndex: number) => {
    if (isLocked && !isAdminMode) return;
    const questions = getExamQuestions();
    const TOTAL_Q = questions.length;
    if (targetIndex < 0) return;
    if (targetIndex >= TOTAL_Q) {
      openConfirmModal();
      return;
    }
    currentQIndex = targetIndex;
    renderActiveQuestion();
    window.scrollTo({ top: 0, behavior: 'smooth' });
  };

  // =========================================================================
  // 7. ANTI-CHEAT LISTENERS & VIOLATION HANDLER
  // =========================================================================
  const setupAntiCheatListeners = () => {
    // 1. Visibility Change (Tab Switch or Minimize)
    document.addEventListener('visibilitychange', () => {
      if (isAdminMode || !isExamActive || isSubmitting) return;
      if (document.visibilityState === 'hidden') {
        triggerViolation('Meninggalkan tab ujian atau meminimalkan browser');
      }
    });

    // 2. Window Blur (Switching Apps, DevTools, or Clicking Outside)
    window.addEventListener('blur', () => {
      if (isAdminMode || !isExamActive || isSubmitting) return;
      triggerViolation('Berpindah fokus ke aplikasi atau jendela lain');
    });

    // 3. Fullscreen Exit
    document.addEventListener('fullscreenchange', () => {
      if (isAdminMode || !isExamActive || isSubmitting) return;
      if (!document.fullscreenElement) {
        triggerViolation('Keluar dari mode layar penuh (fullscreen)');
      }
    });

    // 4. Context Menu (Right Click) Block
    window.addEventListener('contextmenu', (e) => {
      if (!isAdminMode && isExamActive && !isSubmitting) {
        e.preventDefault();
      }
    });

    // 5. Clipboard Restriction (Copy, Cut, Paste)
    const blockClipboard = (e: ClipboardEvent) => {
      if (!isAdminMode && isExamActive && !isSubmitting) {
        e.preventDefault();
      }
    };
    window.addEventListener('copy', blockClipboard);
    window.addEventListener('cut', blockClipboard);
    window.addEventListener('paste', blockClipboard);

    // 6. Block Dangerous Shortcuts (F12, Inspect, Print, Save)
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (isAdminMode || !isExamActive || isSubmitting) return;

      const isCtrlOrMeta = e.ctrlKey || e.metaKey;
      const key = e.key.toLowerCase();

      if (
        e.key === 'F12' ||
        (isCtrlOrMeta && (key === 'u' || key === 's' || key === 'p')) ||
        (isCtrlOrMeta && e.shiftKey && (key === 'i' || key === 'j' || key === 'c'))
      ) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    // 7. Prevent accidental navigation away
    window.addEventListener('beforeunload', (e) => {
      if (isExamActive && !isSubmitting) {
        e.preventDefault();
        (e as any).returnValue = 'Ujian evaluasi sedang berlangsung!';
      }
    });
  };

  const triggerViolation = (reason: string) => {
    if (isAdminMode) return;
    if (!isExamActive || isSubmitting || violationCooldown) return;

    violationCooldown = true;
    setTimeout(() => {
      violationCooldown = false;
    }, 2500);

    violationCount++;
    updateSecurityPill();

    console.warn(`[Anti-Cheat Violation #${violationCount}]: ${reason}`);

    if (violationCount === 1) {
      if (modalViolation1) modalViolation1.style.display = 'flex';
    } else if (violationCount === 2) {
      if (modalViolation1) modalViolation1.style.display = 'none';
      start5MinuteLockout();
    } else if (violationCount >= 3) {
      if (modalViolation1) modalViolation1.style.display = 'none';
      if (modalLockout) modalLockout.style.display = 'none';
      if (modalDisqualified) modalDisqualified.style.display = 'flex';
      
      submitExamAnswers(true, `Diskualifikasi otomatis sistem: Mencapai 3 kali pelanggaran keamanan layar (${reason})`);
    }
  };

  const updateSecurityPill = () => {
    if (!securityStatusPill || !securityIcon || !securityText) return;

    if (isAdminMode) {
      securityIcon.textContent = 'admin_panel_settings';
      securityIcon.className = 'material-symbols-rounded icon-sm text-primary';
      securityText.textContent = 'Mode Guru (Bypass Keamanan)';
      return;
    }

    if (violationCount === 0) {
      securityIcon.textContent = 'verified_user';
      securityIcon.className = 'material-symbols-rounded icon-sm text-primary';
      securityText.textContent = 'Aman (0/3)';
    } else if (violationCount === 1) {
      securityIcon.textContent = 'warning';
      securityIcon.className = 'material-symbols-rounded icon-sm text-error';
      securityText.textContent = 'Peringatan (1/3)';
    } else if (violationCount === 2) {
      securityIcon.textContent = 'lock_clock';
      securityIcon.className = 'material-symbols-rounded icon-sm text-error';
      securityText.textContent = 'TERKUNCI 5 MNT (2/3)';
    } else {
      securityIcon.textContent = 'block';
      securityIcon.className = 'material-symbols-rounded icon-sm text-error';
      securityText.textContent = 'DISKUALIFIKASI (3/3)';
    }
  };

  const acknowledgeViolation1 = async () => {
    if (modalViolation1) modalViolation1.style.display = 'none';
    try {
      if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
        await document.documentElement.requestFullscreen();
      }
    } catch (e) {}
  };

  const start5MinuteLockout = () => {
    isLocked = true;
    lockoutRemaining = LOCKOUT_DURATION_SECS;

    if (modalLockout) modalLockout.style.display = 'flex';
    updateLockoutDisplay();
    sendHeartbeat();

    if (lockoutInterval) clearInterval(lockoutInterval);

    lockoutInterval = window.setInterval(() => {
      lockoutRemaining--;
      updateLockoutDisplay();

      if (lockoutRemaining <= 0) {
        clearInterval(lockoutInterval);
        isLocked = false;
        if (modalLockout) modalLockout.style.display = 'none';

        try {
          if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen();
          }
        } catch (e) {}
      }
    }, 1000);
  };

  const updateLockoutDisplay = () => {
    if (!lockoutCountdownDisplay) return;
    const mins = Math.floor(lockoutRemaining / 60);
    const secs = lockoutRemaining % 60;
    lockoutCountdownDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  };

  // =========================================================================
  // 8. SUBMIT CONFIRMATION MODAL & SERVER SUBMIT
  // =========================================================================
  const openConfirmModal = () => {
    if (isLocked && !isAdminMode) return;
    const questions = getExamQuestions();
    const TOTAL_Q = questions.length;
    const answeredCount = Object.keys(userAnswers).length;
    const doubtCount = Object.values(userDoubt).filter(Boolean).length;
    const unanswered = TOTAL_Q - answeredCount;

    if (modalSummaryText) {
      modalSummaryText.innerHTML = `Anda telah menjawab <strong>${answeredCount} dari ${TOTAL_Q} soal</strong>. Apakah Anda yakin ingin menyelesaikan dan mengumpulkan ujian evaluasi resmi ini sekarang?`;
    }

    if (modalUnansweredWarn) {
      if (unanswered > 0 || doubtCount > 0) {
        modalUnansweredWarn.innerHTML = `Perhatian: Masih ada <strong>${unanswered} soal belum diisi</strong> dan <strong>${doubtCount} soal ditandai ragu-ragu</strong>!`;
        modalUnansweredWarn.style.display = 'block';
      } else {
        modalUnansweredWarn.style.display = 'none';
      }
    }

    if (confirmModal) confirmModal.style.display = 'flex';
  };

  const closeConfirmModal = () => {
    if (confirmModal) confirmModal.style.display = 'none';
  };

  const submitExamAnswers = async (isDisqualified = false, disqualificationReason = '') => {
    if (isSubmitting) return;
    isSubmitting = true;
    closeConfirmModal();

    if (timerInterval) clearInterval(timerInterval);
    if (lockoutInterval) clearInterval(lockoutInterval);
    if (heartbeatInterval) clearInterval(heartbeatInterval);

    try {
      if (document.fullscreenElement && document.exitFullscreen) {
        await document.exitFullscreen();
      }
    } catch (e) {}

    const durationSeconds = examStartTime ? Math.round((Date.now() - examStartTime) / 1000) : 0;

    if (screenCbt) screenCbt.style.display = 'none';
    if (screenResult) screenResult.style.display = 'block';
    if (resultHeading) resultHeading.textContent = 'Memproses Skor Evaluasi Resmi...';

    window.scrollTo({ top: 0, behavior: 'smooth' });

    try {
      const res = await fetch('/api/sql/ujian/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: activeToken,
          answers: userAnswers,
          durationSeconds,
          violationCount,
          isDisqualified,
          disqualificationReason
        })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (resultHeading) resultHeading.textContent = 'Gagal Mengirim Hasil Ujian';
        if (resultDesc) resultDesc.textContent = data.error || 'Terjadi kesalahan pada server saat mencatat nilai Anda.';
        return;
      }

      try {
        sessionStorage.removeItem(storageKey);
      } catch (e) {}

      isExamActive = false;
      renderResultScreen(data);
    } catch (err) {
      console.error('Error submitting exam:', err);
      if (resultHeading) resultHeading.textContent = 'Gangguan Koneksi Server';
      if (resultDesc) resultDesc.textContent = 'Jawaban Anda telah tersimpan secara lokal. Silakan hubungi Guru Pengampu untuk memverifikasi nilai Anda.';
    }
  };

  const renderResultScreen = (data: any) => {
    if (resultScore) resultScore.textContent = String(data.score);
    if (resultCorrectCount) resultCorrectCount.textContent = String(data.correctCount);
    if (resultWrongCount) resultWrongCount.textContent = String(data.wrongCount);

    const mins = Math.floor((data.durationSeconds || 0) / 60);
    const secs = (data.durationSeconds || 0) % 60;
    if (resultDuration) resultDuration.textContent = `${mins}m ${secs}s`;

    if (resultIntegrityVal) {
      if (data.isDisqualified) {
        resultIntegrityVal.textContent = 'DISKUALIFIKASI';
        resultIntegrityVal.className = 'text-error';
      } else if (data.violationCount === 0) {
        resultIntegrityVal.textContent = '0 Pelanggaran (Jujur)';
        resultIntegrityVal.className = 'text-success';
      } else {
        resultIntegrityVal.textContent = `${data.violationCount} Pelanggaran`;
        resultIntegrityVal.className = 'text-error';
      }
    }

    if (resultStatusBadge && resultHeading && resultDesc) {
      if (data.isDisqualified) {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-error m3-chip-lg';
        resultStatusBadge.textContent = 'TERDISKUALIFIKASI';
        resultHeading.textContent = 'Ujian Dibatalkan Akibat Pelanggaran Keamanan';
        resultDesc.textContent = 'Sistem mencatat adanya aktivitas mencurigakan yang melampaui toleransi batas keamanan ujian sekolah.';
      } else if (data.isPassed) {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-success m3-chip-lg';
        resultStatusBadge.textContent = 'TUNTAS (MEMENUHI KKM 75)';
        resultHeading.textContent = 'Luar Biasa! Pemahaman SQL Anda Sangat Baik';
        resultDesc.textContent = `Selamat! Anda berhasil melampaui standar KKM dengan skor ${data.score}/100. Rekaman nilai dan audit integritas telah tersimpan ke buku nilai guru.`;
      } else {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-error m3-chip-lg';
        resultStatusBadge.textContent = 'BELUM TUNTAS (PERLU PENGAYAAN)';
        resultHeading.textContent = 'Perlu Belajar Lebih Lanjut & Konsultasi Remedial';
        resultDesc.textContent = `Skor akhir Anda saat ini adalah ${data.score}/100 (KKM 75). Pelajari kembali modul Basis Data Relasional dan koordinasikan sesi remedial dengan Guru Pengampu.`;
      }
    }
  };

  // Launch on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

