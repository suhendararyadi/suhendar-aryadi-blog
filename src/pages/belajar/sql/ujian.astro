</MainLayout>

<script>
  // =========================================================================
  // CLIENT-SIDE HIGH-SECURITY EXAM & ANTI-CHEAT ENGINE
  // =========================================================================
  const TOTAL_DURATION_SECS = 60 * 60; // 60 Minutes (3,600 Seconds)
  const LOCKOUT_DURATION_SECS = 5 * 60; // 5 Minutes (300 Seconds)

  const getExamQuestions = (): any[] => {
    return (window as any).__EXAM_QUESTIONS__ || [];
  };
  const getCurrentUser = (): any => {
    return (window as any).__CURRENT_USER__ || null;
  };
  const getIsTeacherOrAdmin = (): boolean => {
    return Boolean((window as any).__IS_TEACHER_OR_ADMIN__);
  };

  let activeToken = '';
  let currentQIndex = 0;
  let userAnswers: Record<number, string> = {};
  let userDoubt: Record<number, boolean> = {};
  let timerInterval: any = null;
  let secondsRemaining = TOTAL_DURATION_SECS;
  let examStartTime: number | null = null;

  // Admin / Teacher Test Mode
  let isAdminMode = getIsTeacherOrAdmin();
  let showAdminKey = false;

  // Anti-Cheat State
  let isExamActive = false;
  let isSubmitting = false;
  let violationCount = 0;
  let isLocked = false;
  let lockoutRemaining = LOCKOUT_DURATION_SECS;
  let lockoutInterval: any = null;
  let violationCooldown = false;

  // DOM Elements
  const screenGate = document.getElementById('screen-gate');
  const screenCbt = document.getElementById('screen-cbt');
  const screenResult = document.getElementById('screen-result');

  // Token Gate Elements
  const tokenForm = document.getElementById('token-form');
  const inputToken = document.getElementById('input-token') as HTMLInputElement | null;
  const btnStartExam = document.getElementById('btn-start-exam') as HTMLButtonElement | null;
  const tokenError = document.getElementById('token-error');

  // Admin Hub Elements
  const btnAdminDirectStart = document.getElementById('btn-admin-direct-start');
  const btnAdminResetPast = document.getElementById('btn-admin-reset-past');
  const btnToggleAdminKey = document.getElementById('btn-toggle-admin-key');
  const adminKeyBtnText = document.getElementById('admin-key-btn-text');
  const adminExplanationBox = document.getElementById('admin-explanation-box');
  const adminExplanationText = document.getElementById('admin-explanation-text');

  // CBT Elements
  const cbtTimer = document.getElementById('cbt-timer');
  const securityStatusPill = document.getElementById('security-status-pill');
  const securityIcon = document.getElementById('security-icon');
  const securityText = document.getElementById('security-text');
  const btnSubmitExam = document.getElementById('btn-submit-exam');
  const qNumBadge = document.getElementById('question-num-badge');
  const qCatBadge = document.getElementById('question-category-badge');
  const btnToggleDoubt = document.getElementById('btn-toggle-doubt');
  const doubtBtnText = document.getElementById('doubt-btn-text');
  const qText = document.getElementById('question-text');
  const qCodeWrap = document.getElementById('question-code-wrap');
  const qCode = document.getElementById('question-code');
  const optionsContainer = document.getElementById('options-container');
  const btnPrevQ = document.getElementById('btn-prev-q');
  const btnNextQ = document.getElementById('btn-next-q');
  const navIndicatorText = document.getElementById('nav-indicator-text');
  const paletteGrid = document.getElementById('palette-grid');
  const summaryAnsweredCount = document.getElementById('summary-answered-count');
  const summaryDoubtCount = document.getElementById('summary-doubt-count');

  // Modals
  const confirmModal = document.getElementById('confirm-modal');
  const btnModalCancel = document.getElementById('btn-modal-cancel');
  const btnModalConfirm = document.getElementById('btn-modal-confirm');
  const modalSummaryText = document.getElementById('modal-summary-text');
  const modalUnansweredWarn = document.getElementById('modal-unanswered-warning');

  const modalViolation1 = document.getElementById('modal-violation-1');
  const btnViolation1Confirm = document.getElementById('btn-violation-1-confirm');

  const modalLockout = document.getElementById('modal-lockout');
  const lockoutCountdownDisplay = document.getElementById('lockout-countdown-display');

  const modalDisqualified = document.getElementById('modal-disqualified');
  const btnDisqualifiedViewResult = document.getElementById('btn-disqualified-view-result');

  // Result Elements
  const resultScore = document.getElementById('result-score');
  const resultStatusBadge = document.getElementById('result-status-badge');
  const resultHeading = document.getElementById('result-heading');
  const resultDesc = document.getElementById('result-desc');
  const resultCorrectCount = document.getElementById('result-correct-count');
  const resultWrongCount = document.getElementById('result-wrong-count');
  const resultDuration = document.getElementById('result-duration');
  const resultIntegrityVal = document.getElementById('result-integrity-val');
  const resultIntegrityStatus = document.getElementById('result-integrity-status');

  // Mobile Palette Drawer & Bottom Bar
  const btnMobilePaletteToggle = document.getElementById('btn-mobile-palette-toggle');
  const mobilePaletteModal = document.getElementById('mobile-palette-modal');
  const btnCloseMobilePalette = document.getElementById('btn-close-mobile-palette');
  const mobilePaletteGrid = document.getElementById('mobile-palette-grid');
  const mobilePaletteBadge = document.getElementById('mobile-palette-badge');
  const btnMobileDrawerSubmit = document.getElementById('btn-mobile-drawer-submit');

  const btnMobilePrevQ = document.getElementById('btn-mobile-prev-q') as HTMLButtonElement | null;
  const btnMobileNextQ = document.getElementById('btn-mobile-next-q') as HTMLButtonElement | null;
  const btnMobilePaletteTrigger = document.getElementById('btn-mobile-palette-trigger');
  const btnMobileDoubtTrigger = document.getElementById('btn-mobile-doubt-trigger');
  const mobileBottomIndicator = document.getElementById('mobile-bottom-indicator');
  const mobileDoubtIcon = document.getElementById('mobile-doubt-icon');
  const mobileDoubtLabel = document.getElementById('mobile-doubt-label');
  const mobileNextLabel = document.getElementById('mobile-next-label');
  const mobileNextIcon = document.getElementById('mobile-next-icon');

  // Storage key
  const userObj = getCurrentUser();
  const storageKey = userObj ? `sql_exam_answers_${userObj.id}` : 'sql_exam_answers_guest';

  // =========================================================================
  // 1. INITIALIZATION & EVENT LISTENERS
  // =========================================================================
  const init = () => {
    // Admin Direct Start & Reset Listeners
    btnAdminDirectStart?.addEventListener('click', () => {
      activeToken = 'ADMIN-TRY';
      isAdminMode = true;
      startCbtExam();
    });

    btnAdminResetPast?.addEventListener('click', async () => {
      if (!confirm('Reset riwayat uji coba Anda di server? Nilai sebelumnya akan dihapus sehingga Anda dapat menguji coba kembali lembar baru.')) return;
      try {
        const res = await fetch('/api/sql/ujian/reset', { method: 'POST' });
        const data = await res.json();
        if (data.success) {
          try {
            sessionStorage.removeItem(storageKey);
          } catch (e) {}
          window.location.reload();
        } else {
          alert(data.error || 'Gagal mereset sesi.');
        }
      } catch (e) {
        alert('Terjadi kendala jaringan saat menghubungi server.');
      }
    });

    btnToggleAdminKey?.addEventListener('click', () => {
      showAdminKey = !showAdminKey;
      if (adminKeyBtnText) {
        adminKeyBtnText.textContent = showAdminKey ? 'Kunci Guru: ON' : 'Kunci Guru: OFF';
      }
      btnToggleAdminKey?.classList.toggle('active', showAdminKey);
      renderCurrentQuestion();
    });

    tokenForm?.addEventListener('submit', handleTokenSubmit);
    btnPrevQ?.addEventListener('click', () => navigateQuestion(currentQIndex - 1));
    btnNextQ?.addEventListener('click', () => navigateQuestion(currentQIndex + 1));
    btnToggleDoubt?.addEventListener('click', toggleDoubt);
    btnSubmitExam?.addEventListener('click', openConfirmModal);
    btnModalCancel?.addEventListener('click', closeConfirmModal);
    btnModalConfirm?.addEventListener('click', () => submitExamAnswers(false, ''));
    btnViolation1Confirm?.addEventListener('click', acknowledgeViolation1);
    btnDisqualifiedViewResult?.addEventListener('click', () => {
      if (modalDisqualified) modalDisqualified.style.display = 'none';
    });

    // Mobile Bottom Bar Navigation
    btnMobilePrevQ?.addEventListener('click', () => navigateQuestion(currentQIndex - 1));
    btnMobileNextQ?.addEventListener('click', () => navigateQuestion(currentQIndex + 1));
    btnMobilePaletteTrigger?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'flex';
    });
    btnMobileDoubtTrigger?.addEventListener('click', toggleDoubt);
    btnMobileDrawerSubmit?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
      openConfirmModal();
    });

    // Mobile Drawer
    btnMobilePaletteToggle?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'flex';
    });
    btnCloseMobilePalette?.addEventListener('click', () => {
      if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
    });
    mobilePaletteModal?.addEventListener('click', (e) => {
      if (e.target === mobilePaletteModal) mobilePaletteModal.style.display = 'none';
    });

    // Attach Anti-Cheat Listeners
    setupAntiCheatListeners();
  };

  // =========================================================================
  // 2. TOKEN VERIFICATION & FULLSCREEN START
  // =========================================================================
  const handleTokenSubmit = async (e: Event) => {
    e.preventDefault();
    if (!inputToken) return;

    const token = inputToken.value.trim().toUpperCase();
    if (!token) return;

    if (btnStartExam) {
      btnStartExam.disabled = true;
      btnStartExam.innerHTML = '<span class="material-symbols-rounded icon-sm spinning">sync</span> Memverifikasi Token...';
    }
    if (tokenError) tokenError.style.display = 'none';

    try {
      const res = await fetch('/api/sql/ujian/verify-token', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (tokenError) {
          tokenError.textContent = data.error || 'Token ujian tidak valid.';
          tokenError.style.display = 'block';
        }
        if (btnStartExam) {
          btnStartExam.disabled = false;
          btnStartExam.innerHTML = '<span class="material-symbols-rounded icon-sm">fullscreen</span> Mulai Ujian Layar Penuh &rarr;';
        }
        return;
      }

      activeToken = token;
      
      // Request Fullscreen on user gesture
      try {
        if (document.documentElement.requestFullscreen) {
          await document.documentElement.requestFullscreen();
        } else if ((document.documentElement as any).webkitRequestFullscreen) {
          await (document.documentElement as any).webkitRequestFullscreen();
        }
      } catch (fsErr) {
        console.warn('Fullscreen request bypassed or denied:', fsErr);
      }

      startCbtExam();
    } catch (err) {
      if (tokenError) {
        tokenError.textContent = 'Gagal menghubungi server pengawas ujian.';
        tokenError.style.display = 'block';
      }
      if (btnStartExam) {
        btnStartExam.disabled = false;
        btnStartExam.innerHTML = '<span class="material-symbols-rounded icon-sm">fullscreen</span> Mulai Ujian Layar Penuh &rarr;';
      }
    }
  };

  // =========================================================================
  // 3. START CBT SESSION
  // =========================================================================
  const startCbtExam = () => {
    // Restore any draft answers
    try {
      const saved = sessionStorage.getItem(storageKey);
      if (saved) {
        userAnswers = JSON.parse(saved) || {};
      }
    } catch (e) {
      console.warn('Could not read session answers:', e);
    }

    if (screenGate) screenGate.style.display = 'none';
    if (screenCbt) screenCbt.style.display = 'block';
    if (screenResult) screenResult.style.display = 'none';

    window.scrollTo({ top: 0, behavior: 'smooth' });

    isExamActive = true;
    examStartTime = Date.now();
    secondsRemaining = TOTAL_DURATION_SECS;

    updateSecurityPill();
    renderPalette();
    renderCurrentQuestion();
    startExamTimer();
  };

  // =========================================================================
  // 4. ANTI-CHEAT LISTENERS & VIOLATION HANDLER
  // =========================================================================
  const setupAntiCheatListeners = () => {
    // 1. Visibility Change (Tab Switch or Minimize)
    document.addEventListener('visibilitychange', () => {
      if (isAdminMode || !isExamActive || isSubmitting) return;
      if (document.visibilityState === 'hidden') {
        triggerViolation('Meninggalkan tab ujian atau meminimalkan browser');
      }
    });

    // 2. Window Blur (Switching Apps, DevTools, or Clicking Outside)
    window.addEventListener('blur', () => {
      if (isAdminMode || !isExamActive || isSubmitting) return;
      triggerViolation('Berpindah fokus ke aplikasi atau jendela lain');
    });

    // 3. Fullscreen Exit
    document.addEventListener('fullscreenchange', () => {
      if (isAdminMode || !isExamActive || isSubmitting) return;
      if (!document.fullscreenElement) {
        triggerViolation('Keluar dari mode layar penuh (fullscreen)');
      }
    });

    // 4. Context Menu (Right Click) Block
    window.addEventListener('contextmenu', (e) => {
      if (!isAdminMode && isExamActive && !isSubmitting) {
        e.preventDefault();
      }
    });

    // 5. Clipboard Restriction (Copy, Cut, Paste)
    const blockClipboard = (e: ClipboardEvent) => {
      if (!isAdminMode && isExamActive && !isSubmitting) {
        e.preventDefault();
      }
    };
    window.addEventListener('copy', blockClipboard);
    window.addEventListener('cut', blockClipboard);
    window.addEventListener('paste', blockClipboard);

    // 6. Block Dangerous Shortcuts (F12, Inspect, Print, Save)
    window.addEventListener('keydown', (e: KeyboardEvent) => {
      if (isAdminMode || !isExamActive || isSubmitting) return;

      const isCtrlOrMeta = e.ctrlKey || e.metaKey;
      const key = e.key.toLowerCase();

      if (
        e.key === 'F12' ||
        (isCtrlOrMeta && (key === 'u' || key === 's' || key === 'p')) ||
        (isCtrlOrMeta && e.shiftKey && (key === 'i' || key === 'j' || key === 'c'))
      ) {
        e.preventDefault();
        e.stopPropagation();
      }
    });

    // 7. Prevent accidental navigation away
    window.addEventListener('beforeunload', (e) => {
      if (isExamActive && !isSubmitting) {
        e.preventDefault();
        (e as any).returnValue = 'Ujian evaluasi sedang berlangsung!';
      }
    });
  };

  const triggerViolation = (reason: string) => {
    if (isAdminMode) return;
    if (!isExamActive || isSubmitting || violationCooldown) return;

    violationCooldown = true;
    setTimeout(() => {
      violationCooldown = false;
    }, 2500); // 2.5s cooldown to prevent double-firing from blur + visibility

    violationCount++;
    updateSecurityPill();

    console.warn(`[Anti-Cheat Violation #${violationCount}]: ${reason}`);

    if (violationCount === 1) {
      // Stage 1: Peringatan Keras (Modal 1)
      if (modalViolation1) modalViolation1.style.display = 'flex';
    } else if (violationCount === 2) {
      // Stage 2: Kunci Layar 5 Menit (300 Detik)
      if (modalViolation1) modalViolation1.style.display = 'none';
      start5MinuteLockout();
    } else if (violationCount >= 3) {
      // Stage 3: Auto-Submit & Diskualifikasi Langsung
      if (modalViolation1) modalViolation1.style.display = 'none';
      if (modalLockout) modalLockout.style.display = 'none';
      if (modalDisqualified) modalDisqualified.style.display = 'flex';
      
      submitExamAnswers(true, `Diskualifikasi otomatis sistem: Mencapai 3 kali pelanggaran keamanan layar (${reason})`);
    }
  };

  const updateSecurityPill = () => {
    if (!securityStatusPill || !securityIcon || !securityText) return;

    if (isAdminMode) {
      securityStatusPill.className = 'm3-security-pill status-safe';
      securityIcon.textContent = 'admin_panel_settings';
      securityText.textContent = 'Mode Guru (Bypass Keamanan)';
      return;
    }

    if (violationCount === 0) {
      securityStatusPill.className = 'm3-security-pill status-safe';
      securityIcon.textContent = 'verified_user';
      securityText.textContent = 'Status: Aman (0/3)';
    } else if (violationCount === 1) {
      securityStatusPill.className = 'm3-security-pill status-warn';
      securityIcon.textContent = 'warning';
      securityText.textContent = 'Peringatan 1/3 Terdeteksi';
    } else if (violationCount === 2) {
      securityStatusPill.className = 'm3-security-pill status-locked';
      securityIcon.textContent = 'lock_clock';
      securityText.textContent = 'TERKUNCI 5 MENIT (2/3)';
    } else {
      securityStatusPill.className = 'm3-security-pill status-disqualified';
      securityIcon.textContent = 'block';
      securityText.textContent = 'TERDISKUALIFIKASI (3/3)';
    }
  };

  const acknowledgeViolation1 = async () => {
    if (modalViolation1) modalViolation1.style.display = 'none';
    // Re-enforce fullscreen
    try {
      if (!document.fullscreenElement) {
        if (document.documentElement.requestFullscreen) {
          await document.documentElement.requestFullscreen();
        }
      }
    } catch (e) {
      console.warn('Could not re-enter fullscreen:', e);
    }
  };

  const start5MinuteLockout = () => {
    isLocked = true;
    lockoutRemaining = LOCKOUT_DURATION_SECS;

    if (modalLockout) modalLockout.style.display = 'flex';
    updateLockoutDisplay();

    if (lockoutInterval) clearInterval(lockoutInterval);

    lockoutInterval = window.setInterval(() => {
      lockoutRemaining--;
      updateLockoutDisplay();

      if (lockoutRemaining <= 0) {
        clearInterval(lockoutInterval);
        isLocked = false;
        if (modalLockout) modalLockout.style.display = 'none';

        // Re-enforce fullscreen
        try {
          if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen();
          }
        } catch (e) {}
      }
    }, 1000);
  };

  const updateLockoutDisplay = () => {
    if (!lockoutCountdownDisplay) return;
    const mins = Math.floor(lockoutRemaining / 60);
    const secs = lockoutRemaining % 60;
    lockoutCountdownDisplay.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
  };

  // =========================================================================
  // 5. EXAM COUNTDOWN TIMER
  // =========================================================================
  const startExamTimer = () => {
    if (timerInterval) clearInterval(timerInterval);

    timerInterval = window.setInterval(() => {
      secondsRemaining--;
      renderTimer();

      if (secondsRemaining <= 0) {
        clearInterval(timerInterval);
        submitExamAnswers(false, 'Waktu pengerjaan ujian 60 menit telah habis');
      }
    }, 1000);
  };

  const renderTimer = () => {
    if (!cbtTimer) return;
    const mins = Math.floor(secondsRemaining / 60);
    const secs = secondsRemaining % 60;
    cbtTimer.textContent = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;

    if (secondsRemaining <= 300) {
      cbtTimer.classList.add('timer-danger');
    } else {
      cbtTimer.classList.remove('timer-danger');
    }
  };

  // =========================================================================
  // 6. QUESTION RENDERING & NAVIGATION
  // =========================================================================
  const renderCurrentQuestion = () => {
    const questions = getExamQuestions();
    if (!questions || questions.length === 0) return;
    const q = questions[currentQIndex];
    if (!q) return;

    if (qNumBadge) qNumBadge.textContent = `SOAL NO. ${currentQIndex + 1} DARI ${questions.length}`;
    if (qCatBadge) qCatBadge.textContent = (q.category || 'BASIS DATA').toUpperCase();
    if (navIndicatorText) navIndicatorText.textContent = `${currentQIndex + 1} dari ${questions.length} Soal`;
    if (mobilePaletteBadge) mobilePaletteBadge.textContent = `${currentQIndex + 1}/${questions.length}`;

    if (qText) qText.textContent = q.question;

    if (qCodeWrap && qCode) {
      if (q.codeSnippet) {
        qCode.textContent = q.codeSnippet;
        qCodeWrap.style.display = 'block';
      } else {
        qCodeWrap.style.display = 'none';
      }
    }

    // Admin Teacher Explanation & Key Box
    if (isAdminMode && showAdminKey && q.explanation) {
      if (adminExplanationBox && adminExplanationText) {
        adminExplanationText.textContent = q.explanation;
        adminExplanationBox.style.display = 'block';
      }
    } else {
      if (adminExplanationBox) {
        adminExplanationBox.style.display = 'none';
      }
    }

    // Doubt button status
    if (btnToggleDoubt && doubtBtnText) {
      const isDoubt = Boolean(userDoubt[q.id]);
      btnToggleDoubt.setAttribute('aria-pressed', isDoubt ? 'true' : 'false');
      if (isDoubt) {
        btnToggleDoubt.classList.add('active');
        doubtBtnText.textContent = 'Ragu-Ragu (Ditandai)';
      } else {
        btnToggleDoubt.classList.remove('active');
        doubtBtnText.textContent = 'Ragu-Ragu';
      }
    }

    // Prev / Next button states
    if (btnPrevQ) (btnPrevQ as HTMLButtonElement).disabled = currentQIndex === 0;
    if (btnNextQ) {
      if (currentQIndex === questions.length - 1) {
        btnNextQ.innerHTML = '<span class="material-symbols-rounded icon-sm">check</span> Tinjau &amp; Selesai';
      } else {
        btnNextQ.innerHTML = 'Soal Berikutnya &rarr;';
      }
    }

    // Mobile Bottom Bar updates
    if (mobileBottomIndicator) {
      mobileBottomIndicator.textContent = `${currentQIndex + 1} / ${questions.length}`;
    }
    if (btnMobilePrevQ) {
      btnMobilePrevQ.disabled = currentQIndex === 0;
    }
    if (btnMobileNextQ && mobileNextLabel && mobileNextIcon) {
      if (currentQIndex === questions.length - 1) {
        mobileNextLabel.textContent = 'Selesai';
        mobileNextIcon.textContent = 'check';
        btnMobileNextQ.classList.add('finish');
      } else {
        mobileNextLabel.textContent = 'Berikutnya';
        mobileNextIcon.textContent = 'arrow_forward';
        btnMobileNextQ.classList.remove('finish');
      }
    }
    if (btnMobileDoubtTrigger && mobileDoubtIcon && mobileDoubtLabel) {
      const isDoubt = Boolean(userDoubt[q.id]);
      btnMobileDoubtTrigger.setAttribute('aria-pressed', isDoubt ? 'true' : 'false');
      if (isDoubt) {
        btnMobileDoubtTrigger.classList.add('active');
        mobileDoubtIcon.textContent = 'bookmark';
        mobileDoubtLabel.textContent = 'Ditandai';
      } else {
        btnMobileDoubtTrigger.classList.remove('active');
        mobileDoubtIcon.textContent = 'bookmark_border';
        mobileDoubtLabel.textContent = 'Ragu';
      }
    }

    // Render 5 Options as interactive labels with radio input
    if (optionsContainer) {
      optionsContainer.innerHTML = '';
      const selected = userAnswers[q.id] || null;

      q.options.forEach((opt: { key: string; text: string }) => {
        const isSelected = selected === opt.key;
        const isCorrectKey = isAdminMode && showAdminKey && q.correctAnswer === opt.key;

        const optCard = document.createElement('label');
        optCard.className = `m3-option-card ${isSelected ? 'selected' : ''} ${isCorrectKey ? 'admin-correct' : ''}`;
        optCard.setAttribute('data-key', opt.key);

        optCard.innerHTML = `
          <input
            type="radio"
            name="q_${q.id}"
            value="${opt.key}"
            ${isSelected ? 'checked' : ''}
            class="m3-option-radio-hidden"
          />
          <div class="m3-option-radio ${isSelected ? 'checked' : ''}">
            <span class="m3-option-radio-dot"></span>
          </div>
          <div class="m3-option-content">
            <div class="m3-option-header-row">
              <span class="m3-option-key font-mono">${opt.key}.</span>
              ${isCorrectKey ? '<span class="m3-chip-correct font-mono">✓ KUNCI RESMI</span>' : ''}
            </div>
            <span class="m3-option-text">${opt.text}</span>
          </div>
        `;

        optCard.addEventListener('click', (e) => {
          if (isLocked && !isAdminMode) {
            e.preventDefault();
            return;
          }
          selectAnswer(q.id, opt.key);
        });

        optionsContainer.appendChild(optCard);
      });
    }

    updatePaletteActiveState();
  };

  const selectAnswer = (questionId: number, optionKey: string) => {
    if (isLocked && !isAdminMode) return;
    userAnswers[questionId] = optionKey;
    try {
      sessionStorage.setItem(storageKey, JSON.stringify(userAnswers));
    } catch (e) {}

    // In-place UI update without destroying container DOM
    if (optionsContainer) {
      const cards = optionsContainer.querySelectorAll<HTMLElement>('.m3-option-card');
      cards.forEach((card) => {
        const key = card.getAttribute('data-key');
        const isSelected = key === optionKey;
        card.classList.toggle('selected', isSelected);
        const radio = card.querySelector('.m3-option-radio');
        if (radio) radio.classList.toggle('checked', isSelected);
        const radioInput = card.querySelector<HTMLInputElement>('input[type="radio"]');
        if (radioInput) radioInput.checked = isSelected;
      });
    }

    renderPalette();
  };

  const toggleDoubt = () => {
    if (isLocked && !isAdminMode) return;
    const questions = getExamQuestions();
    const q = questions[currentQIndex];
    if (!q) return;
    userDoubt[q.id] = !userDoubt[q.id];
    renderCurrentQuestion();
    renderPalette();
  };

  const navigateQuestion = (newIndex: number) => {
    if (isLocked && !isAdminMode) return;
    const questions = getExamQuestions();
    if (newIndex < 0) return;
    if (newIndex >= questions.length) {
      openConfirmModal();
      return;
    }
    currentQIndex = newIndex;
    renderCurrentQuestion();
  };

  // =========================================================================
  // 7. QUESTION PALETTE GRID
  // =========================================================================
  const renderPalette = () => {
    const questions = getExamQuestions();
    const renderTo = (container: HTMLElement | null) => {
      if (!container) return;
      container.innerHTML = '';

      questions.forEach((q: any, idx: number) => {
        const isAnswered = Boolean(userAnswers[q.id]);
        const isDoubt = Boolean(userDoubt[q.id]);
        const isCurrent = idx === currentQIndex;

        let statusClass = 'm3-box-unanswered';
        if (isDoubt) statusClass = 'm3-box-doubt';
        else if (isAnswered) statusClass = 'm3-box-answered';

        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = `m3-palette-btn ${statusClass} ${isCurrent ? 'current' : ''}`;
        btn.setAttribute('data-index', String(idx));
        btn.textContent = String(idx + 1);

        btn.addEventListener('click', () => {
          if (isLocked && !isAdminMode) return;
          currentQIndex = idx;
          renderCurrentQuestion();
          if (mobilePaletteModal) mobilePaletteModal.style.display = 'none';
        });

        container.appendChild(btn);
      });
    };

    renderTo(paletteGrid);
    renderTo(mobilePaletteGrid);

    // Update Summary counts
    const answeredCount = Object.keys(userAnswers).length;
    const doubtCount = Object.values(userDoubt).filter(Boolean).length;

    if (summaryAnsweredCount) summaryAnsweredCount.textContent = `${answeredCount} / ${questions.length}`;
    if (summaryDoubtCount) summaryDoubtCount.textContent = String(doubtCount);
  };

  const updatePaletteActiveState = () => {
    document.querySelectorAll('.m3-palette-btn').forEach((btn) => {
      const idx = Number(btn.getAttribute('data-index'));
      if (idx === currentQIndex) {
        btn.classList.add('current');
      } else {
        btn.classList.remove('current');
      }
    });
  };

  // =========================================================================
  // 8. SUBMIT EXAM ANSWERS (SERVER-SIDE GRADING)
  // =========================================================================
  const openConfirmModal = () => {
    if (isLocked && !isAdminMode) return;
    const questions = getExamQuestions();
    const answeredCount = Object.keys(userAnswers).length;
    const total = questions.length;
    const unansweredCount = total - answeredCount;
    const doubtCount = Object.values(userDoubt).filter(Boolean).length;

    if (modalSummaryText) {
      modalSummaryText.innerHTML = `Anda telah menjawab <strong>${answeredCount}</strong> dari total <strong>${total}</strong> soal evaluasi resmi.`;
    }

    if (modalUnansweredWarn) {
      if (unansweredCount > 0 || doubtCount > 0) {
        modalUnansweredWarn.style.display = 'block';
        modalUnansweredWarn.innerHTML = `<strong>Perhatian:</strong> Masih terdapat <strong>${unansweredCount} soal belum diisi</strong> dan <strong>${doubtCount} soal ragu-ragu</strong>.`;
      } else {
        modalUnansweredWarn.style.display = 'none';
      }
    }

    if (confirmModal) confirmModal.style.display = 'flex';
  };

  const closeConfirmModal = () => {
    if (confirmModal) confirmModal.style.display = 'none';
  };

  const submitExamAnswers = async (isDisqualified = false, disqualificationReason = '') => {
    if (isSubmitting) return;
    isSubmitting = true;
    closeConfirmModal();

    if (timerInterval) clearInterval(timerInterval);
    if (lockoutInterval) clearInterval(lockoutInterval);

    // Exit fullscreen cleanly
    try {
      if (document.fullscreenElement && document.exitFullscreen) {
        await document.exitFullscreen();
      }
    } catch (e) {}

    const durationSeconds = examStartTime ? Math.round((Date.now() - examStartTime) / 1000) : 0;

    // Show loading state
    if (screenCbt) screenCbt.style.display = 'none';
    if (screenResult) screenResult.style.display = 'block';
    if (resultHeading) resultHeading.textContent = 'Memproses & Mengamankan Nilai Evaluasi...';

    window.scrollTo({ top: 0, behavior: 'smooth' });

    try {
      const res = await fetch('/api/sql/ujian/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          token: activeToken,
          answers: userAnswers,
          durationSeconds,
          violationCount,
          isDisqualified,
          disqualificationReason
        })
      });

      const data = await res.json();

      if (!res.ok || !data.success) {
        if (resultHeading) resultHeading.textContent = 'Gagal Mengirim Hasil Ujian';
        if (resultDesc) resultDesc.textContent = data.error || 'Terjadi kesalahan pada server saat mencatat nilai Anda.';
        return;
      }

      // Clear local session storage
      try {
        sessionStorage.removeItem(storageKey);
      } catch (e) {}

      isExamActive = false;

      // Render Result Screen
      renderResultScreen(data);
    } catch (err) {
      console.error('Error submitting exam:', err);
      if (resultHeading) resultHeading.textContent = 'Gangguan Koneksi Server';
      if (resultDesc) resultDesc.textContent = 'Jawaban Anda telah tersimpan secara lokal. Silakan hubungi Guru Pengampu untuk memverifikasi nilai Anda.';
    }
  };

  const renderResultScreen = (data: any) => {
    if (resultScore) resultScore.textContent = String(data.score);
    if (resultCorrectCount) resultCorrectCount.textContent = String(data.correctCount);
    if (resultWrongCount) resultWrongCount.textContent = String(data.wrongCount);

    const mins = Math.floor((data.durationSeconds || 0) / 60);
    const secs = (data.durationSeconds || 0) % 60;
    if (resultDuration) resultDuration.textContent = `${mins}m ${secs}s`;

    if (resultIntegrityVal && resultIntegrityStatus) {
      if (data.isDisqualified) {
        resultIntegrityVal.textContent = 'DISKUALIFIKASI';
        resultIntegrityVal.className = 'metric-val text-error';
        resultIntegrityStatus.textContent = data.disqualificationReason || 'Melanggar batas keamanan';
      } else if (data.violationCount === 0) {
        resultIntegrityVal.textContent = '0 Pelanggaran';
        resultIntegrityVal.className = 'metric-val text-success';
        resultIntegrityStatus.textContent = 'Tervalidasi Jujur';
      } else {
        resultIntegrityVal.textContent = `${data.violationCount} Pelanggaran`;
        resultIntegrityVal.className = 'metric-val text-warning';
        resultIntegrityStatus.textContent = 'Peringatan Tercatat';
      }
    }

    if (resultStatusBadge && resultHeading && resultDesc) {
      if (data.isDisqualified) {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-error';
        resultStatusBadge.textContent = 'TERDISKUALIFIKASI';
        resultHeading.textContent = 'Ujian Dibatalkan Akibat Pelanggaran Keamanan';
        resultDesc.textContent = 'Sistem mencatat adanya aktivitas mencurigakan yang melampaui toleransi batas keamanan ujian sekolah.';
      } else if (data.isPassed) {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-success';
        resultStatusBadge.textContent = 'TUNTAS EVALUASI RESMI';
        resultHeading.textContent = 'Selamat! Anda Berhasil Lulus Standar KKM';
        resultDesc.textContent = `Anda telah melampaui nilai KKM 75 dengan perolehan skor ${data.score}/100. Penguasaan materi Basis Data Relasional Anda sangat baik.`;
      } else {
        resultStatusBadge.className = 'm3-chip m3-chip-tonal-warning';
        resultStatusBadge.textContent = 'BELUM TUNTAS KKM';
        resultHeading.textContent = 'Hasil Evaluasi Memerlukan Remedial';
        resultDesc.textContent = `Nilai akhir Anda (${data.score}/100) belum mencapai ambang batas KKM 75. Silakan pelajari kembali modul dan konsultasikan jadwal remedial dengan Guru.`;
      }
    }
  };

  // Launch on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
