    border-radius: 16px;
  }
  .m3-spec-icon-wrap {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .bg-primary-container { background-color: var(--m3-primary-container); }
  .bg-secondary-container { background-color: var(--m3-secondary-container); }
  .bg-tertiary-container { background-color: var(--m3-tertiary-container); }
  .bg-error-container { background-color: var(--m3-error-container); }
  .bg-warning-container { background-color: #fef3c7; }

  .m3-spec-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  /* Security Rules Box */
  .m3-security-rules-box {
    background-color: var(--m3-surface-container);
    border-left: 4px solid var(--m3-error);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
  }
  .m3-rules-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .m3-rules-list {
    margin: 0;
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }

  /* Admin Test Hub Card */
  .m3-admin-hub-card {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.08) 0%, rgba(168, 85, 247, 0.08) 100%);
    border: 1.5px solid var(--m3-primary);
    border-radius: 20px;
    padding: 1.25rem 1.5rem;
  }
  .m3-admin-hub-header {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .m3-admin-hub-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background-color: var(--m3-primary);
    color: var(--m3-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .m3-admin-hub-info {
    flex: 1;
  }
  .m3-chip-compact {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    font-weight: 700;
  }
  .m3-admin-hub-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  /* Single Attempt / Already Submitted Card */
  .m3-already-submitted-card {
    padding: 1.5rem;
    border-radius: 20px;
    background-color: var(--m3-surface-container-low);
  }
  .m3-sub-status-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .m3-status-icon-circle {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .m3-status-icon-circle.status-passed {
    background-color: var(--m3-primary-container);
    color: var(--m3-primary);
  }
  .m3-status-icon-circle.status-failed {
    background-color: #fef3c7;
    color: #b45309;
  }
  .m3-status-icon-circle.status-disqualified {
    background-color: var(--m3-error-container);
    color: var(--m3-error);
  }

  /* Participant & Token Box */
  .m3-participant-card {
    padding: 1.5rem;
    border-radius: 20px;
    background-color: var(--m3-surface-container-low);
  }
  .m3-participant-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .m3-avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--m3-primary);
    color: var(--m3-on-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .m3-token-field-row {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.5rem;
    flex-wrap: wrap;
  }
  .m3-token-field-row input {
    flex: 1;
    min-width: 240px;
    padding: 0.75rem 1rem;
    font-size: 1rem;
    border: 1px solid var(--m3-outline);
    border-radius: 12px;
    background-color: var(--m3-surface);
    color: var(--m3-on-surface);
  }

  /* CBT Top App Bar */
  .m3-top-app-bar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    background-color: var(--m3-surface-container);
    border: 1px solid var(--m3-outline-variant);
    border-radius: 20px;
    padding: 1rem 1.5rem;
    position: sticky;
    top: 1rem;
    z-index: 50;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }
  @media (min-width: 768px) {
    .m3-top-app-bar {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
  .m3-app-bar-top-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .m3-badge-tonal {
    padding: 0.25rem 0.5rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    background-color: var(--m3-primary-container);
    color: var(--m3-on-primary-container);
  }

  /* Security Pill */
  .m3-security-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .m3-security-pill.status-safe {
    background-color: #d1fae5;
    color: #065f46;
  }
  .m3-security-pill.status-warn {
    background-color: #fef3c7;
    color: #92400e;
  }
  .m3-security-pill.status-locked {
    background-color: #fee2e2;
    color: #991b1b;
    animation: pulseLock 1.5s infinite;
  }
  .m3-security-pill.status-disqualified {
    background-color: #fee2e2;
    color: #991b1b;
  }
  @keyframes pulseLock {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.03); }
  }

  /* Timer */
  .m3-timer-container {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background-color: var(--m3-surface-container-high);
    padding: 0.35rem 0.85rem;
    border-radius: 12px;
    border: 1px solid var(--m3-outline-variant);
  }
  .m3-timer-text {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--m3-on-surface);
  }
  .m3-timer-text.timer-danger {
    color: var(--m3-error);
    animation: pulseTimer 1s infinite;
  }
  @keyframes pulseTimer {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* CBT Main Layout */
  .m3-cbt-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 992px) {
    .m3-cbt-layout {
      grid-template-columns: 1fr 340px;
    }
  }

  /* Question Card */
  .m3-question-card {
    padding: 1.5rem 1.75rem;
    border-radius: 24px;
    background-color: var(--m3-surface-container-low);
    border: 1px solid var(--m3-outline-variant);
  }
  .m3-question-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    border-bottom: 1px solid var(--m3-outline-variant);
    padding-bottom: 0.75rem;
  }
  .m3-question-title {
    font-size: 1.125rem;
    line-height: 1.6;
    font-weight: 600;
  }

  /* Code Block */
  .m3-code-container {
    border-radius: 12px;
    background-color: #0f172a;
    border: 1px solid #334155;
    overflow: hidden;
  }
  .m3-code-header {
    background-color: #1e293b;
    padding: 0.4rem 0.85rem;
    color: #94a3b8;
    font-size: 0.75rem;
  }
  .m3-code-block {
    padding: 0.85rem 1rem;
    margin: 0;
    color: #38bdf8;
    font-size: 0.875rem;
    line-height: 1.5;
    white-space: pre-wrap;
  }

  /* Options Form */
  .m3-options-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .m3-option-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 0.85rem 1.25rem;
    border: 1.5px solid var(--m3-outline-variant);
    border-radius: 14px;
    background-color: var(--m3-surface);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .m3-option-card:hover {
    border-color: var(--m3-primary);
    background-color: var(--m3-surface-container-high);
  }
  .m3-option-card.selected {
    border-color: var(--m3-primary);
    background-color: var(--m3-primary-container);
  }
  .m3-option-radio {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--m3-outline);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }
  .m3-option-radio.checked {
    border-color: var(--m3-primary);
  }
  .m3-option-radio-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: transparent;
  }
  .m3-option-radio.checked .m3-option-radio-dot {
    background-color: var(--m3-primary);
  }
  .m3-option-content {
    display: flex;
    gap: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .m3-option-radio-hidden {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
    margin: 0;
  }
  .m3-option-header-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .m3-chip-correct {
    font-size: 0.7rem;
    font-weight: 700;
    color: #065f46;
    background-color: #a7f3d0;
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    letter-spacing: 0.5px;
  }
  .m3-option-card.admin-correct {
    border-color: #10b981 !important;
    background-color: rgba(16, 185, 129, 0.08) !important;
  }

  /* Admin Explanation Box */
  .m3-admin-explanation-box {
    background-color: var(--m3-surface-container-high);
    border-left: 4px solid var(--m3-primary);
    border-radius: 12px;
    padding: 1rem 1.25rem;
  }
  .m3-admin-explanation-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--m3-primary);
  }
  #btn-toggle-admin-key.active {
    background-color: var(--m3-primary);
    color: var(--m3-on-primary);
  }

  /* Footer Controls */
  .m3-question-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--m3-outline-variant);
    padding-top: 1.25rem;
  }

  /* Palette Sidebar */
  .m3-palette-card {
    padding: 1.25rem;
    border-radius: 24px;
    background-color: var(--m3-surface-container-low);
    border: 1px solid var(--m3-outline-variant);
    height: fit-content;
  }
  .m3-palette-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    font-size: 0.75rem;
    margin-top: 0.5rem;
  }
  .m3-legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }
  .m3-legend-box {
    width: 12px;
    height: 12px;
    border-radius: 3px;
  }
  .m3-box-answered { background-color: var(--m3-primary); }
  .m3-box-doubt { background-color: #f59e0b; }
  .m3-box-unanswered { background-color: var(--m3-outline-variant); }

  .m3-palette-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 0.5rem;
  }
  .m3-palette-btn {
    aspect-ratio: 1;
    border-radius: 10px;
    border: 1px solid transparent;
    font-size: 0.875rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.15s ease;
  }
  .m3-palette-btn:hover {
    transform: scale(1.05);
  }
  .m3-palette-btn.m3-box-answered {
    background-color: var(--m3-primary);
    color: var(--m3-on-primary);
  }
  .m3-palette-btn.m3-box-doubt {
    background-color: #f59e0b;
    color: #ffffff;
  }
  .m3-palette-btn.m3-box-unanswered {
    background-color: var(--m3-surface-container-high);
    color: var(--m3-on-surface);
    border-color: var(--m3-outline-variant);
  }
  .m3-palette-btn.current {
    outline: 2.5px solid var(--m3-primary);
    outline-offset: 2px;
  }

  .m3-palette-summary {
    border-top: 1px solid var(--m3-outline-variant);
    padding-top: 0.75rem;
    display: flex;
    justify-content: space-between;
  }
  .m3-security-watermark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    opacity: 0.7;
    font-size: 0.75rem;
  }

  /* Modals */
  .m3-modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 999;
    padding: 1rem;
  }
  .m3-modal-card {
    background-color: var(--m3-surface-container-high);
    border-radius: 24px;
    padding: 1.75rem;
    max-width: 500px;
    width: 100%;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.25);
  }
  .m3-border-warning {
    border: 2px solid #f59e0b;
  }
  .m3-border-error {
    border: 2px solid var(--m3-error);
  }
  .m3-modal-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .m3-modal-icon-wrap {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .m3-modal-footer {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
  }

  /* 5-Minute Lockout Modal Specifics */
  .m3-lockout-card {
    text-align: center;
    border: 3px solid var(--m3-error);
    background: linear-gradient(180deg, var(--m3-surface-container-high) 0%, var(--m3-surface-container) 100%);
  }
  .m3-lockout-icon-pulse {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--m3-error-container);
    color: var(--m3-error);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 0.75rem;
    animation: iconPulse 2s infinite;
  }
  @keyframes iconPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.08); }
  }
  .m3-lockout-countdown {
    font-size: 3.5rem;
    font-weight: 800;
    color: var(--m3-error);
    line-height: 1;
    letter-spacing: 2px;
  }

  /* Result Screen */
  .m3-result-card {
    max-width: 860px;
    margin: 0 auto;
    padding: 2.5rem 2rem;
    border-radius: 28px;
    background-color: var(--m3-surface-container-low);
  }
  .m3-score-display {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.25rem;
  }
  .m3-score-number {
    font-size: 4rem;
    font-weight: 800;
    color: var(--m3-primary);
    line-height: 1;
  }
  .m3-score-total {
    font-size: 1.5rem;
    color: var(--m3-outline);
  }
  .m3-result-metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
  }
  .m3-metric-box {
    background-color: var(--m3-surface-container);
    padding: 1rem;
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: center;
  }
  .metric-val {
    font-size: 1.35rem;
    font-weight: 700;
  }
  .m3-confidentiality-box {
    background-color: var(--m3-surface-container);
    border: 1px dashed var(--m3-primary);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
  }
  .m3-confidentiality-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Helper Classes */
  .w-100 { width: 100%; }
  .text-center { text-align: center; }
  .text-left { text-align: left; }
  .text-success { color: var(--m3-success, #10b981); }
  .text-warning { color: #f59e0b; }
  .text-error { color: var(--m3-error, #ef4444); }
  .text-muted { opacity: 0.7; }
  .margin-top-2xs { margin-top: 0.25rem; }
  .margin-top-xs { margin-top: 0.5rem; }
  .margin-top-sm { margin-top: 0.75rem; }
  .margin-top-md { margin-top: 1.25rem; }
  .margin-top-lg { margin-top: 1.75rem; }
  .spinning { animation: spin 1s linear infinite; }
  @keyframes spin { 100% { transform: rotate(360deg); } }
  .m3-mobile-only { display: inline-flex; }
  @media (min-width: 992px) {
    .m3-mobile-only { display: none; }
  }

  .m3-btn-warning {
    background-color: #f59e0b !important;
    color: #ffffff !important;
  }
  .m3-btn-error {
    background-color: var(--m3-error) !important;
    color: var(--m3-on-error, #ffffff) !important;
  }

  /* =========================================================================
     MOBILE-FIRST RESPONSIVE OPTIMIZATIONS & THUMB-FRIENDLY CONTROLS
     ========================================================================= */

  /* Input zoom prevention on iOS Safari */
  #input-token {
    font-size: 16px !important;
  }

  /* App Bar Actions */
  .m3-app-bar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* Mobile Bottom Navigation Bar */
  .m3-mobile-bottom-bar {
    display: none;
  }

  @media (max-width: 991px) {
    #screen-exam {
      padding-bottom: 5.5rem;
    }
    .m3-palette-card {
      display: none;
    }
    .m3-question-footer {
      display: none;
    }
    .m3-cbt-layout {
      grid-template-columns: 1fr;
    }
    .m3-mobile-bottom-bar {
      display: flex;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 100;
      background: var(--m3-surface-container-highest, #282a2f);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-top: 1px solid var(--m3-outline-variant);
      padding: 0.5rem 0.75rem max(0.5rem, env(safe-area-inset-bottom));
      justify-content: space-between;
      align-items: center;
      gap: 0.5rem;
      box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.18);
    }
  }

  .m3-mobile-nav-btn {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.35rem 0.25rem;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--m3-on-surface-variant);
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .m3-mobile-nav-btn .material-symbols-rounded {
    font-size: 1.35rem;
    line-height: 1;
  }
  .m3-mobile-nav-btn .mobile-nav-label {
    margin-top: 2px;
    font-size: 0.7rem;
    line-height: 1;
  }
  .m3-mobile-nav-btn:active {
    transform: scale(0.95);
    background-color: var(--m3-surface-container-high);
  }
  .m3-mobile-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
  }
  .m3-mobile-nav-btn.palette-trigger {
    background-color: var(--m3-surface-container);
    border: 1px solid var(--m3-outline-variant);
  }
  .m3-mobile-nav-btn.doubt-trigger.active {
    color: #f59e0b;
    background-color: rgba(245, 158, 11, 0.15);
    border-color: rgba(245, 158, 11, 0.4);
  }
  .m3-mobile-nav-btn.primary {
    background-color: var(--m3-primary);
    color: var(--m3-on-primary);
    flex: 1.35;
    border-radius: 14px;
    flex-direction: row;
    gap: 0.35rem;
  }
  .m3-mobile-nav-btn.primary .mobile-nav-label {
    font-size: 0.825rem;
    margin-top: 0;
  }
  .m3-mobile-nav-btn.primary:active {
    filter: brightness(0.9);
  }
  .m3-mobile-nav-btn.primary.finish {
    background-color: var(--m3-success, #10b981);
    color: #ffffff;
  }

  /* Bottom Sheet Palette Drawer */
  .m3-mobile-drawer-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    z-index: 1000;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 0;
  }
  .m3-mobile-drawer-card {
    background-color: var(--m3-surface-container-high);
    border-top-left-radius: 28px;
    border-top-right-radius: 28px;
    border: 1px solid var(--m3-outline-variant);
    border-bottom: none;
    width: 100%;
    max-width: 600px;
    max-height: 85vh;
    overflow-y: auto;
    padding: 1rem 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    box-shadow: 0 -12px 36px rgba(0, 0, 0, 0.35);
    animation: slideUpDrawer 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes slideUpDrawer {
    from { transform: translateY(100%); }
    to { transform: translateY(0); }
  }
  .m3-drawer-drag-handle {
    width: 40px;
    height: 4px;
    background-color: var(--m3-outline-variant);
    border-radius: 9999px;
    margin: 0 auto 0.75rem;
  }
  .m3-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--m3-outline-variant);
  }
  .m3-drawer-title-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .m3-palette-grid-mobile {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.5rem;
  }
  .m3-palette-grid-mobile .m3-palette-btn {
    min-height: 44px;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 12px;
  }
  .m3-drawer-footer {
    padding-top: 0.75rem;
    border-top: 1px solid var(--m3-outline-variant);
  }

  /* Responsive Adjustments for Tablets and Phones */
  @media (max-width: 768px) {
    .m3-exam-page {
      padding: 0.75rem 0.65rem 2rem;
    }
    .m3-top-app-bar {
      position: sticky;
      top: 0.5rem;
      padding: 0.65rem 0.85rem;
      border-radius: 16px;
      gap: 0.5rem;
      margin-bottom: 0.75rem;
    }
    .m3-app-bar-top-row {
