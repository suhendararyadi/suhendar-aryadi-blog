---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);
---

<MainLayout
  title="Materi Ajar: Arsitektur Basis Data & DDL (ERD, Normalisasi 1NF-3NF, Constraints) | SMK RPL"
  description="Panduan komprehensif konsep arsitektur database relasional, perancangan diagram ERD Mermaid, teknik normalisasi data bebas anomali, sintaksis DDL, dan batasan integritas untuk siswa Kelas 11 RPL."
>
  <div class="materi-container">
    <!-- Top Nav & Breadcrumbs -->
    <div class="top-nav-bar">
      <a href="/belajar/sql" class="btn btn-outline btn-sm">
        &larr; Kembali ke Katalog Modul SQL
      </a>
      <div class="top-nav-badges">
        <span class="badge badge-purple">MATERI INTI KELAS 11 RPL</span>
        <span class="badge badge-cyan">DATABASE ARCHITECTURE &amp; DDL</span>
        <span class="badge badge-amber">PANDUAN PRA-PROYEK</span>
      </div>
    </div>

    <!-- Hero Header Card -->
    <div class="hero-card glass-card">
      <div class="hero-badge-wrap">
        <span class="badge badge-primary">MODUL AJAR BASIS DATA</span>
        <span class="badge badge-emerald">TEORI &amp; PRAKTIKUM FUNDAMENTAL</span>
      </div>
      <h1 class="hero-title">Arsitektur Basis Data &amp; DDL</h1>
      <p class="hero-subtitle">
        Pelajari fondasi perancangan sistem database relasional: Mulai dari arsitektur RDBMS, pembuatan diagram relasi entitas (ERD), eliminasi anomali data melalui Normalisasi (1NF s.d. 3NF), hingga implementasi sintaksis DDL dan batasan integritas (<em>Constraints</em>).
      </p>

      <div class="hero-cta-row">
        <a href="#bab-1" class="btn btn-primary btn-sm">Mulai Belajar Bab 1 &darr;</a>
        <a href="#bab-2" class="btn btn-secondary btn-sm">Diagram ERD SmartMart &rarr;</a>
        <a href="/belajar/sql/proyek" class="btn btn-outline btn-sm">Lembar Tugas Proyek &nearr;</a>
      </div>
    </div>

    <!-- Quick Navigation Table of Contents -->
    <div class="toc-card glass-card">
      <h3 class="toc-title">📑 Daftar Isi Pembelajaran:</h3>
      <div class="toc-grid">
        <a href="#bab-1" class="toc-item">
          <span class="toc-num">01</span>
          <div>
            <strong>Konsep Arsitektur RDBMS &amp; ACID</strong>
            <span>Fondasi arsitektur multi-tier &amp; integritas data</span>
          </div>
        </a>
        <a href="#bab-2" class="toc-item">
          <span class="toc-num">02</span>
          <div>
            <strong>Diagram ERD &amp; Kardinalitas</strong>
            <span>Visualisasi entitas &amp; relasi Crow's Foot</span>
          </div>
        </a>
        <a href="#bab-3" class="toc-item">
          <span class="toc-num">03</span>
          <div>
            <strong>Normalisasi Data (1NF &rarr; 3NF)</strong>
            <span>Eliminasi anomali sisip, ubah, dan hapus</span>
          </div>
        </a>
        <a href="#bab-4" class="toc-item">
          <span class="toc-num">04</span>
          <div>
            <strong>Sintaksis Baku DDL SQL</strong>
            <span>CREATE, ALTER, DROP, &amp; TRUNCATE</span>
          </div>
        </a>
        <a href="#bab-5" class="toc-item">
          <span class="toc-num">05</span>
          <div>
            <strong>Batasan Integritas (Constraints)</strong>
            <span>PK, FK, CHECK, UNIQUE, &amp; ON DELETE CASCADE</span>
          </div>
        </a>
        <a href="#bab-6" class="toc-item">
          <span class="toc-num">06</span>
          <div>
            <strong>Cheat Sheet DDL &amp; Mini Kuis</strong>
            <span>Template skrip 6 tabel &amp; uji pemahaman</span>
          </div>
        </a>
      </div>
    </div>

    <!-- ==========================================
         BAB 1: FONDASI ARSITEKTUR RDBMS & ACID
         ========================================== -->
    <section id="bab-1" class="content-section glass-card">
      <div class="section-badge-header">
        <span class="section-step-num">BAB 01</span>
        <h2>Fondasi Arsitektur Basis Data Relasional (RDBMS) &amp; ACID</h2>
      </div>

      <p class="section-lead">
        Sebelum menulis kode SQL, seorang <em>Software Engineer</em> wajib memahami bagaimana sistem database bekerja di balik layar dalam memproses jutaan transaksi kasir secara aman, konsisten, dan konkuren.
      </p>

      <!-- Diagram 1: Arsitektur Multi-Tier Database -->
      <div class="visual-box">
        <div class="visual-header">
          <span class="visual-badge">DIAGRAM ARSITEKTUR</span>
          <h4>Alur Pemrosesan Query pada RDBMS</h4>
        </div>
        
        <div class="arch-flow-wrapper">
          <!-- 1. Client Layer -->
          <div class="arch-flow-card card-client">
            <div class="flow-card-badge">
              <span class="badge badge-cyan">LAYER 1: CLIENT APPLICATION</span>
            </div>
            <div class="flow-card-main">
              <div class="flow-card-icon">📱</div>
              <div class="flow-card-text">
                <h5 class="flow-card-title">Aplikasi Kasir POS (Frontend / Client)</h5>
                <p class="flow-card-desc">
                  Kasir memindai barcode &rarr; Aplikasi membuat perintah SQL (misal: <code>INSERT INTO transaksi ...</code>) dan mengirimkannya melalui koneksi TCP/IP.
                </p>
              </div>
            </div>
          </div>

          <!-- Flow Arrow 1 -->
          <div class="flow-connector">
            <div class="flow-line"></div>
            <span class="flow-pill-label">Kirim Perintah SQL (Query Stream)</span>
            <div class="flow-arrow-head">&darr;</div>
          </div>

          <!-- 2. Database Server Engine -->
          <div class="arch-flow-engine glass-card">
            <div class="engine-header">
              <div class="engine-title-flex">
                <span class="engine-icon">⚙️</span>
                <div>
                  <h5 class="engine-title">DATABASE ENGINE (RDBMS Core: PostgreSQL / MySQL)</h5>
                  <span class="engine-sub">Manajer Transaksi, Keamanan, &amp; Eksekusi Kueri ACID</span>
                </div>
              </div>
              <span class="badge badge-purple">SERVER SIDE</span>
            </div>

            <div class="engine-steps-grid">
              <!-- Step 1: Parser & Optimizer -->
              <div class="engine-step-card">
                <div class="step-badge-num">1</div>
                <div class="step-card-content">
                  <h6 class="step-title">SQL Parser &amp; Query Optimizer</h6>
                  <p class="step-desc">
                    Validasi sintaks SQL &amp; hak akses. Memilih rencana eksekusi (<em>Execution Plan</em>) dengan estimasi biaya algoritma I/O paling efisien.
                  </p>
                </div>
              </div>

              <!-- Step 2: Transaction & Execution Engine -->
              <div class="engine-step-card">
                <div class="step-badge-num">2</div>
                <div class="step-card-content">
                  <h6 class="step-title">Transaction &amp; Execution Engine (ACID)</h6>
                  <p class="step-desc">
                    Eksekusi kueri, penguncian data (<em>Row Lock</em>) untuk multi-kasir, validasi <em>Constraints</em> (PK/FK/CHECK), serta pengelolaan <code>COMMIT/ROLLBACK</code>.
                  </p>
                </div>
              </div>

              <!-- Step 3: Shared Memory Buffer & Cache -->
              <div class="engine-step-card">
                <div class="step-badge-num">3</div>
                <div class="step-card-content">
                  <h6 class="step-title">Shared Memory Buffer &amp; Cache (RAM)</h6>
                  <p class="step-desc">
                    Menyimpan blok data di RAM. Jika data ada di cache (<em>Buffer Cache Hit</em>), hasil kueri dikembalikan instan tanpa membaca disk fisik.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Flow Arrow 2 (Bidirectional) -->
          <div class="flow-connector flow-connector-bi">
            <div class="flow-line"></div>
            <span class="flow-pill-label">
              <span>&darr; <strong>Write:</strong> Write-Ahead Log (WAL) &amp; Dirty Buffer Flush</span>
              <span>&uarr; <strong>Read:</strong> Pembacaan Blok Data &amp; B-Tree Index ke RAM</span>
            </span>
            <div class="flow-arrow-head-bi">&#8645;</div>
          </div>

          <!-- 3. Storage Disk -->
          <div class="arch-flow-card card-storage">
            <div class="flow-card-badge">
              <span class="badge badge-amber">LAYER 3: PERSISTENT STORAGE</span>
            </div>
            <div class="flow-card-main">
              <div class="flow-card-icon">💾</div>
              <div class="flow-card-text">
                <h5 class="flow-card-title">Storage Disk Permanen (NVMe SSD / HDD)</h5>
                <p class="flow-card-desc">
                  Media penyimpanan fisik yang menyimpan berkas data tabel (<code>data files</code>), indeks B-Tree, dan berkas transaksi (WAL) agar data transaksi tidak pernah hilang (<em>Durability</em>).
                </p>
              </div>
            </div>
          </div>
        </div>

        <p class="visual-caption">
          <strong>Gambar 1.1:</strong> Alur transaksi dari antarmuka kasir ke parser SQL, eksekusi ACID, buffer memori, hingga penyimpanan permanen di disk.
        </p>
      </div>

      <!-- Tabel 1: Flat-File vs RDBMS -->
      <h3 class="sub-heading">Mengapa Menggunakan RDBMS, Bukan File Excel/CSV?</h3>
      <p>
        Banyak toko konvensional mencatat transaksi pada satu lembar file Excel (<em>Flat-File</em>). Namun saat skala bisnis membesar, cara ini menimbulkan bencana integritas:
      </p>

      <div class="table-responsive margin-top-sm">
        <table class="data-table">
          <thead>
            <tr>
              <th>Aspek Pembanding</th>
              <th>Flat-File (Excel / CSV)</th>
              <th>RDBMS (PostgreSQL / MySQL)</th>
              <th>Dampak Nyata di Kasir SmartMart</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Konkurensi (Banyak Kasir)</strong></td>
              <td>❌ File terkunci jika dibuka 2 kasir bersamaan</td>
              <td>✅ Mampu melayani ribuan kasir serentak (*Multi-User*)</td>
              <td>Kasir 1 &amp; Kasir 2 bisa transaksi tanpa antri kunci file</td>
            </tr>
            <tr>
              <td><strong>Integritas Relasi</strong></td>
              <td>❌ Nama pelanggan atau harga rawan salah ketik manual</td>
              <td>✅ Terkunci otomatis via Foreign Key &amp; Constraints</td>
              <td>Kasir tidak bisa menjual barang fiktif yang tidak ada di master</td>
            </tr>
            <tr>
              <td><strong>Keamanan Transaksi (ACID)</strong></td>
              <td>❌ Jika PC mati tiba-tiba, file rawan rusak (korup)</td>
              <td>✅ Rollback otomatis jika transaksi gagal di tengah jalan</td>
              <td>Struk nota tidak akan tercatat setengah jika listrik padam</td>
            </tr>
            <tr>
              <td><strong>Kecepatan Query Data Besar</strong></td>
              <td>❌ Lambat &amp; <em>lag</em> saat baris data mencapai &gt;100.000</td>
              <td>✅ Cepat berkat struktur B-Tree Indexing &amp; View</td>
              <td>Laporan omset tahunan selesai dalam hitungan milidetik</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Prinsip ACID Callout -->
      <div class="callout-box callout-info margin-top-md">
        <div class="callout-icon">🛡️</div>
        <div>
          <h4>4 Pilar Jaminan Transaksi Basis Data (Prinsip ACID):</h4>
          <ul class="clean-list margin-top-xs">
            <li><strong>Atomicity (Keutuhan):</strong> Transaksi diproses tuntas seluruhnya atau dibatalkan sama sekali (<em>All or Nothing</em>).</li>
            <li><strong>Consistency (Konsistensi):</strong> Saldo stok dan total uang kasir harus selalu sesuai aturan bisnis sebelum dan sesudah transaksi.</li>
            <li><strong>Isolation (Pemisahan):</strong> Transaksi Kasir A tidak boleh terganggu atau tercampur dengan transaksi Kasir B yang berjalan bersamaan.</li>
            <li><strong>Durability (Ketahanan):</strong> Sekali transaksi sukses dicetak (*Commit*), data tidak akan hilang meski server mati mendadak.</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ==========================================
         BAB 2: ERD & KARDINALITAS MERMAID DIAGRAM
         ========================================== -->
    <section id="bab-2" class="content-section glass-card">
      <div class="section-badge-header">
        <span class="section-step-num">BAB 02</span>
        <h2>Entity Relationship Diagram (ERD) &amp; Kardinalitas</h2>
      </div>

      <p class="section-lead">
        <strong>Entity Relationship Diagram (ERD)</strong> adalah diagram visual yang menggambarkan seluruh entitas tabel basis data beserta atribut (kolom) dan garis relasi antar-entitas.
      </p>

      <!-- Diagram 2: Static ERD Schema Diagram SmartMart POS -->
      <div class="visual-box">
        <div class="visual-header">
          <span class="visual-badge badge-cyan">DIAGRAM ERD RELASI TABEL</span>
          <h4>Diagram Relasi 6 Entitas Skema SmartMart POS</h4>
        </div>

        <div class="erd-visual-canvas">
          <!-- Summary of Relations -->
          <div class="erd-relationships-banner">
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>KASIR</strong> &rarr; TRANSAKSI (melayani)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>PELANGGAN</strong> &rarr; TRANSAKSI (melakukan)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>KATEGORI</strong> &rarr; PRODUK (memiliki)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>PRODUK</strong> &rarr; DETAIL_TRANSAKSI</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>TRANSAKSI</strong> &rarr; DETAIL_TRANSAKSI</span>
            </div>
          </div>

          <!-- 6 Tables Schema Grid -->
          <div class="erd-tables-grid">
            <!-- 1. KASIR -->
            <div class="erd-table-card">
              <div class="erd-table-header header-blue">
                <div class="erd-header-title">
                  <span class="erd-table-icon">👤</span>
                  <strong>KASIR</strong>
                </div>
                <span class="erd-table-type">Master Table</span>
              </div>
              <div class="erd-table-body">
                <div class="erd-column-row pk-row">
                  <span class="col-key badge-pk">PK</span>
                  <span class="col-name font-mono">id_kasir</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">nama_kasir</span>
                  <span class="col-type">VARCHAR(100)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">username</span>
                  <span class="col-type">VARCHAR(50)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">nomor_hp</span>
                  <span class="col-type">VARCHAR(20)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">shift</span>
                  <span class="col-type">VARCHAR(20)</span>
                </div>
              </div>
            </div>

            <!-- 2. PELANGGAN -->
            <div class="erd-table-card">
              <div class="erd-table-header header-emerald">
                <div class="erd-header-title">
                  <span class="erd-table-icon">👥</span>
                  <strong>PELANGGAN</strong>
                </div>
                <span class="erd-table-type">Master Table</span>
              </div>
              <div class="erd-table-body">
                <div class="erd-column-row pk-row">
                  <span class="col-key badge-pk">PK</span>
                  <span class="col-name font-mono">id_pelanggan</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">nama_pelanggan</span>
                  <span class="col-type">VARCHAR(100)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">nomor_telepon</span>
                  <span class="col-type">VARCHAR(20)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">poin_member</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">tanggal_bergabung</span>
                  <span class="col-type">DATE</span>
                </div>
              </div>
            </div>

            <!-- 3. KATEGORI -->
            <div class="erd-table-card">
              <div class="erd-table-header header-purple">
                <div class="erd-header-title">
                  <span class="erd-table-icon">🏷️</span>
                  <strong>KATEGORI</strong>
                </div>
                <span class="erd-table-type">Master Table</span>
              </div>
              <div class="erd-table-body">
                <div class="erd-column-row pk-row">
                  <span class="col-key badge-pk">PK</span>
                  <span class="col-name font-mono">id_kategori</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">nama_kategori</span>
                  <span class="col-type">VARCHAR(50)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">deskripsi</span>
                  <span class="col-type">TEXT</span>
                </div>
              </div>
            </div>

            <!-- 4. TRANSAKSI (Header) -->
            <div class="erd-table-card highlight-card">
              <div class="erd-table-header header-cyan">
                <div class="erd-header-title">
                  <span class="erd-table-icon">🧾</span>
                  <strong>TRANSAKSI</strong>
                </div>
                <span class="erd-table-type">Header Transaksi</span>
              </div>
              <div class="erd-table-body">
                <div class="erd-column-row pk-row">
                  <span class="col-key badge-pk">PK</span>
                  <span class="col-name font-mono">id_transaksi</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">kode_invoice</span>
                  <span class="col-type">VARCHAR(50) UNIQUE</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">tanggal_transaksi</span>
                  <span class="col-type">TIMESTAMP</span>
                </div>
                <div class="erd-column-row fk-row">
                  <span class="col-key badge-fk">FK</span>
                  <span class="col-name font-mono">id_kasir</span>
                  <span class="col-type">INT &rarr; KASIR</span>
                </div>
                <div class="erd-column-row fk-row">
                  <span class="col-key badge-fk">FK</span>
                  <span class="col-name font-mono">id_pelanggan</span>
                  <span class="col-type">INT &rarr; PELANGGAN</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">total_belanja</span>
                  <span class="col-type">DECIMAL(12,2)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">metode_pembayaran</span>
                  <span class="col-type">VARCHAR(30)</span>
                </div>
              </div>
            </div>

            <!-- 5. DETAIL_TRANSAKSI (Junction M:N) -->
            <div class="erd-table-card highlight-card-gold">
              <div class="erd-table-header header-gold">
                <div class="erd-header-title">
                  <span class="erd-table-icon">📦</span>
                  <strong>DETAIL_TRANSAKSI</strong>
                </div>
                <span class="erd-table-type">Junction (M:N)</span>
              </div>
              <div class="erd-table-body">
                <div class="erd-column-row pk-row">
                  <span class="col-key badge-pk">PK</span>
                  <span class="col-name font-mono">id_detail</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row fk-row">
                  <span class="col-key badge-fk">FK</span>
                  <span class="col-name font-mono">id_transaksi</span>
                  <span class="col-type">INT &rarr; TRANSAKSI</span>
                </div>
                <div class="erd-column-row fk-row">
                  <span class="col-key badge-fk">FK</span>
                  <span class="col-name font-mono">id_produk</span>
                  <span class="col-type">INT &rarr; PRODUK</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">jumlah_beli</span>
                  <span class="col-type">INT (CHECK &gt; 0)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">harga_satuan</span>
                  <span class="col-type">DECIMAL(10,2)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">subtotal</span>
                  <span class="col-type">DECIMAL(12,2)</span>
                </div>
              </div>
            </div>

            <!-- 6. PRODUK -->
            <div class="erd-table-card">
              <div class="erd-table-header header-teal">
                <div class="erd-header-title">
                  <span class="erd-table-icon">🛒</span>
                  <strong>PRODUK</strong>
                </div>
                <span class="erd-table-type">Master Table</span>
              </div>
              <div class="erd-table-body">
                <div class="erd-column-row pk-row">
                  <span class="col-key badge-pk">PK</span>
                  <span class="col-name font-mono">id_produk</span>
                  <span class="col-type">INT</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">kode_barcode</span>
                  <span class="col-type">VARCHAR(50) UNIQUE</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">nama_produk</span>
                  <span class="col-type">VARCHAR(150)</span>
                </div>
                <div class="erd-column-row fk-row">
                  <span class="col-key badge-fk">FK</span>
                  <span class="col-name font-mono">id_kategori</span>
                  <span class="col-type">INT &rarr; KATEGORI</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">harga_beli</span>
                  <span class="col-type">DECIMAL(10,2)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">harga_jual</span>
                  <span class="col-type">DECIMAL(10,2)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">stok</span>
                  <span class="col-type">INT (CHECK &gt;= 0)</span>
                </div>
                <div class="erd-column-row">
                  <span class="col-key"></span>
                  <span class="col-name font-mono">satuan</span>
                  <span class="col-type">VARCHAR(20)</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <p class="visual-caption">
          <strong>Gambar 2.1:</strong> Diagram ERD SmartMart POS. Perhatikan bagaimana tabel <code>DETAIL_TRANSAKSI</code> bertindak sebagai jembatan (<em>junction table</em>) antara <code>TRANSAKSI</code> dan <code>PRODUK</code> untuk menangani relasi banyak-ke-banyak (M:N).
        </p>
      </div>

      <h3 class="sub-heading">Memahami Tipe Kardinalitas Relasi</h3>
      <div class="card-grid-3 margin-top-sm">
        <div class="feature-card">
          <span class="badge badge-purple">1 : 1 (One-to-One)</span>
          <h4>Satu ke Satu</h4>
          <p>Satu baris pada Tabel A hanya berpasangan tepat dengan satu baris pada Tabel B.</p>
          <small class="text-muted">Contoh: 1 Kasir memiliki 1 Rekening Akun Penggajian.</small>
        </div>

        <div class="feature-card">
          <span class="badge badge-cyan">1 : N (One-to-Many)</span>
          <h4>Satu ke Banyak (Paling Umum)</h4>
          <p>Satu baris pada Tabel A dapat berpasangan dengan banyak baris pada Tabel B.</p>
          <small class="text-muted">Contoh: 1 Kategori memiliki banyak Produk. 1 Kasir melayani banyak Transaksi.</small>
        </div>

        <div class="feature-card">
          <span class="badge badge-amber">M : N (Many-to-Many)</span>
          <h4>Banyak ke Banyak</h4>
          <p>Banyak baris di Tabel A berpasangan dengan banyak baris di Tabel B (Wajib dipecah dengan Tabel Perantara).</p>
          <small class="text-muted">Contoh: 1 Transaksi membeli banyak Produk, dan 1 Produk terjual di banyak Transaksi.</small>
        </div>
      </div>

      <!-- Contoh Query Pemecahan Many-to-Many -->
      <div class="code-example-block margin-top-md">
        <div class="code-example-header">
          <span class="code-badge">SQL DDL</span>
          <strong>Contoh Pemecahan Relasi M:N Menggunakan Junction Table:</strong>
        </div>
        <pre class="code-snippet font-mono"><code>-- 1. Tabel Header Transaksi (Menyimpan nomor invoice dan tanggal)
CREATE TABLE transaksi (
    id_transaksi SERIAL PRIMARY KEY,
    kode_invoice VARCHAR(50) NOT NULL UNIQUE,
    tanggal_transaksi TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    id_kasir INT REFERENCES kasir(id_kasir),
    total_belanja DECIMAL(12,2) DEFAULT 0
);

-- 2. Tabel Junction / Detail (Menampung relasi M:N antara Transaksi dan Produk)
CREATE TABLE detail_transaksi (
    id_detail SERIAL PRIMARY KEY,
    id_transaksi INT NOT NULL REFERENCES transaksi(id_transaksi) ON DELETE CASCADE,
    id_produk INT NOT NULL REFERENCES produk(id_produk),
    jumlah_beli INT NOT NULL CHECK (jumlah_beli &gt; 0),
    harga_satuan DECIMAL(10,2) NOT NULL CHECK (harga_satuan &gt;= 0),
    subtotal DECIMAL(12,2) NOT NULL CHECK (subtotal &gt;= 0)
);</code></pre>
      </div>
    </section>

    <!-- ==========================================
         BAB 3: TEKNIK NORMALISASI (1NF - 3NF)
         ========================================== -->
    <section id="bab-3" class="content-section glass-card">
      <div class="section-badge-header">
        <span class="section-step-num">BAB 03</span>
        <h2>Teknik Normalisasi Data (1NF, 2NF, 3NF) Bebas Anomali</h2>
      </div>

      <p class="section-lead">
        <strong>Normalisasi</strong> adalah proses pengorganisasian tabel database untuk meminimalkan duplikasi data (redundansi) dan mencegah terjadinya 3 jenis anomali fatal:
      </p>

      <div class="card-grid-3 margin-top-sm">
        <div class="feature-card border-red">
          <span class="badge badge-red">ANOMALI 1</span>
          <h4>Anomali Sisip (Insert)</h4>
          <p>Tidak bisa menambahkan produk baru ke sistem jika belum ada pelanggan yang membelinya.</p>
        </div>
        <div class="feature-card border-amber">
          <span class="badge badge-amber">ANOMALI 2</span>
          <h4>Anomali Ubah (Update)</h4>
          <p>Jika nama kategori "Minuman" diubah, kita harus mengupdate ribuan baris transaksi satu per satu.</p>
        </div>
        <div class="feature-card border-purple">
          <span class="badge badge-purple">ANOMALI 3</span>
          <h4>Anomali Hapus (Delete)</h4>
          <p>Jika satu nota transaksi dibatalkan/dihapus, data master produk dan kasir ikut terhapus hilang selamanya.</p>
        </div>
      </div>

      <!-- Studi Kasus Normalisasi Bertahap -->
      <h3 class="sub-heading margin-top-lg">Studi Kasus: Membedah Nota Kasir Manual SmartMart</h3>

      <!-- 1. UNF -->
      <div class="norm-step-box margin-top-sm">
        <div class="norm-badge-row">
          <span class="step-pill step-unf">BENTUK TIDAK TERNORMALISASI (UNF)</span>
          <span class="status-pill status-bad">❌ Banyak Nilai Ganda &amp; Kolom Berulang</span>
        </div>
        <p>Data faktur manual yang digabung dalam satu lembar flat table:</p>
        <div class="table-responsive">
          <table class="data-table">
            <thead>
              <tr>
                <th>No_Invoice</th>
                <th>Kasir</th>
                <th>Shift</th>
                <th>Pelanggan</th>
                <th>Barang_1 (Qty, Harga)</th>
                <th>Barang_2 (Qty, Harga)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>INV-001</td>
                <td>Rian</td>
                <td>Pagi</td>
                <td>Budi (08123)</td>
                <td>Susu Kotak (2 pcs @ 6.000)</td>
