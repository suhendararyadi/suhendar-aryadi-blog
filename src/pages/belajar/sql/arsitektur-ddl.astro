                <th>Qty</th>
                <th>Kasir</th>
                <th>Shift</th>
                <th>Pelanggan</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>INV-001</strong></td>
                <td><strong>BRG-01</strong></td>
                <td>Susu Kotak</td>
                <td>Minuman</td>
                <td>6.000</td>
                <td>2</td>
                <td>Rian</td>
                <td>Pagi</td>
