      <h3 class="sub-heading m3-headline-small">Memahami Tipe Kardinalitas Relasi</h3>
      <div class="card-grid-3 margin-top-sm">
        <div class="feature-card">
          <span class="m3-chip m3-chip-tonal-tertiary">1 : 1 (One-to-One)</span>
          <h4 class="m3-title-medium">Satu ke Satu</h4>
          <p class="m3-body-small">Satu baris pada Tabel A hanya berpasangan tepat dengan satu baris pada Tabel B.</p>
          <small class="text-m3-muted">Contoh: 1 Kasir memiliki 1 Rekening Akun Penggajian.</small>
        </div>

        <div class="feature-card">
          <span class="m3-chip m3-chip-tonal-primary">1 : N (One-to-Many)</span>
          <h4 class="m3-title-medium">Satu ke Banyak (Paling Umum)</h4>
          <p class="m3-body-small">Satu baris pada Tabel A dapat berpasangan dengan banyak baris pada Tabel B.</p>
          <small class="text-m3-muted">Contoh: 1 Kategori memiliki banyak Produk. 1 Kasir melayani banyak Transaksi.</small>
        </div>

        <div class="feature-card">
          <span class="m3-chip m3-chip-tonal-warning">M : N (Many-to-Many)</span>
          <h4 class="m3-title-medium">Banyak ke Banyak</h4>
          <p class="m3-body-small">Banyak baris di Tabel A berpasangan dengan banyak baris di Tabel B (Wajib dipecah dengan Tabel Perantara).</p>
          <small class="text-m3-muted">Contoh: 1 Transaksi membeli banyak Produk, dan 1 Produk terjual di banyak Transaksi.</small>
        </div>
      </div>

      <!-- Contoh Query Pemecahan Many-to-Many -->
      <div class="code-example-block margin-top-md">
        <div class="code-example-header">
          <span class="m3-chip m3-chip-tonal-primary">
            <span class="material-symbols-rounded icon-sm">code</span>
            SQL DDL
          </span>
          <strong class="m3-label-large">Contoh Pemecahan Relasi M:N Menggunakan Junction Table:</strong>
        </div>
        <pre class="code-snippet font-mono"><code>-- 1. Tabel Header Transaksi (Menyimpan nomor invoice dan tanggal)
CREATE TABLE transaksi (
    id_transaksi SERIAL PRIMARY KEY,
    kode_invoice VARCHAR(50) NOT NULL UNIQUE,
    tanggal_transaksi TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    id_kasir INT REFERENCES kasir(id_kasir),
    total_belanja DECIMAL(12,2) DEFAULT 0
);

-- 2. Tabel Junction / Detail (Menampung relasi M:N antara Transaksi dan Produk)
CREATE TABLE detail_transaksi (
    id_detail SERIAL PRIMARY KEY,
    id_transaksi INT NOT NULL REFERENCES transaksi(id_transaksi) ON DELETE CASCADE,
    id_produk INT NOT NULL REFERENCES produk(id_produk),
    jumlah_beli INT NOT NULL CHECK (jumlah_beli &gt; 0),
    harga_satuan DECIMAL(10,2) NOT NULL CHECK (harga_satuan &gt;= 0),
    subtotal DECIMAL(12,2) NOT NULL CHECK (subtotal &gt;= 0)
);</code></pre>
      </div>
    </section>

    <!-- ==========================================
