        <form id="interactive-quiz-form" class="quiz-form">
          <!-- Soal 1 -->
          <div class="quiz-question-card" data-correct="B">
            <h4 class="m3-title-small">1. Mengapa tabel <code>transaksi</code> dan <code>produk</code> memerlukan tabel perantara <code>detail_transaksi</code>?</h4>
            <div class="quiz-options">
              <label class="quiz-option"><input type="radio" name="q1" value="A" /> <span>A. Karena kedua tabel memiliki tipe data yang berbeda</span></label>
