<script>
  const setupPage = () => {
    // Copy DDL Code Button
    const copyBtn = document.getElementById('copy-ddl-btn');
    const copyLabel = document.getElementById('copy-btn-label');
    const copyIcon = document.getElementById('copy-btn-icon');
    const ddlCode = document.getElementById('ddl-full-code');

    copyBtn?.addEventListener('click', () => {
      if (ddlCode) {
        navigator.clipboard.writeText(ddlCode.textContent || '').then(() => {
          if (copyLabel) copyLabel.textContent = 'Berhasil Disalin!';
          if (copyIcon) copyIcon.textContent = 'check';
          setTimeout(() => {
            if (copyLabel) copyLabel.textContent = 'Salin Skrip DDL';
            if (copyIcon) copyIcon.textContent = 'content_copy';
          }, 2000);
        });
      }
    });

    // Interactive Quiz Checker
    const checkBtn = document.getElementById('check-quiz-btn');
    const scoreBadge = document.getElementById('quiz-score-badge');

    checkBtn?.addEventListener('click', () => {
      const cards = document.querySelectorAll<HTMLElement>('.quiz-question-card');
      let score = 0;
      let total = cards.length;

      cards.forEach((card, idx) => {
        const correct = card.getAttribute('data-correct');
        const qName = `q${idx + 1}`;
        const selected = (card.querySelector(`input[name="${qName}"]:checked`) as HTMLInputElement | null)?.value;
        const feedback = card.querySelector<HTMLElement>('.quiz-feedback');

        if (feedback) {
          if (!selected) {
            feedback.className = 'quiz-feedback feedback-warn';
            feedback.innerHTML = '<span class="material-symbols-rounded icon-sm">warning</span> <span>Silakan pilih salah satu opsi jawaban terlebih dahulu.</span>';
            feedback.style.display = 'flex';
          } else if (selected === correct) {
            score++;
            feedback.className = 'quiz-feedback feedback-correct';
            feedback.innerHTML = '<span class="material-symbols-rounded icon-sm">check_circle</span> <span>Benar! Jawaban Anda tepat sesuai kaidah arsitektur basis data.</span>';
            feedback.style.display = 'flex';
          } else {
            feedback.className = 'quiz-feedback feedback-wrong';
            feedback.innerHTML = `<span class="material-symbols-rounded icon-sm">cancel</span> <span>Kurang tepat. Jawaban yang benar adalah Opsi ${correct}.</span>`;
            feedback.style.display = 'flex';
          }
        }
      });

      if (scoreBadge) {
        const finalScore = Math.round((score / total) * 100);
        scoreBadge.style.display = 'inline-flex';
        if (finalScore >= 75) {
          scoreBadge.className = 'quiz-score-pill score-pass';
          scoreBadge.innerHTML = `<span class="material-symbols-rounded icon-sm">celebration</span> <span>Skor Anda: <strong>${finalScore}/100</strong> (TUNTAS - Siap Masuk ke Tugas Proyek!)</span>`;
        } else {
          scoreBadge.className = 'quiz-score-pill score-fail';
          scoreBadge.innerHTML = `<span class="material-symbols-rounded icon-sm">menu_book</span> <span>Skor Anda: <strong>${finalScore}/100</strong> (Pelajari kembali materi di atas & coba lagi)</span>`;
        }
      }
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupPage);
  } else {
    setupPage();
  }
</script>

