              </tr>
              <tr>
                <td><strong>INV-001</strong></td>
                <td><strong>BRG-02</strong></td>
                <td>Roti Manis</td>
                <td>Makanan</td>
                <td>5.000</td>
                <td>1</td>
                <td>Rian</td>
                <td>Pagi</td>
                <td>Budi</td>
              </tr>
              <tr>
                <td><strong>INV-002</strong></td>
                <td><strong>BRG-03</strong></td>
                <td>Buku Tulis</td>
                <td>ATK</td>
