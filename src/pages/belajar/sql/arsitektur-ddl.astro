        <pre id="ddl-full-code" class="code-snippet font-mono" style="max-height: 420px; overflow-y: auto;"><code>-- ==========================================================
-- SKRIP DDL RESMI: SMARTMART POS (6 TABEL RELASIONAL)
-- Mata Pelajaran : Basis Data / Pemrograman Web & RPL (Kelas 11)
-- ==========================================================

-- 1. TABEL KATEGORI PRODUK
CREATE TABLE kategori (
    id_kategori SERIAL PRIMARY KEY,
    nama_kategori VARCHAR(100) NOT NULL UNIQUE,
    deskripsi TEXT
);

-- 2. TABEL MASTER PRODUK & STOK
CREATE TABLE produk (
    id_produk SERIAL PRIMARY KEY,
    kode_barcode VARCHAR(50) NOT NULL UNIQUE,
    nama_produk VARCHAR(150) NOT NULL,
    id_kategori INT NOT NULL REFERENCES kategori(id_kategori) ON DELETE RESTRICT,
    harga_beli DECIMAL(10,2) NOT NULL CHECK (harga_beli &gt;= 0),
    harga_jual DECIMAL(10,2) NOT NULL CHECK (harga_jual &gt;= harga_beli),
    stok INT NOT NULL DEFAULT 0 CHECK (stok &gt;= 0),
    satuan VARCHAR(20) DEFAULT 'Pcs'
);

-- 3. TABEL PETUGAS KASIR
CREATE TABLE kasir (
    id_kasir SERIAL PRIMARY KEY,
    nama_kasir VARCHAR(100) NOT NULL,
    username VARCHAR(50) NOT NULL UNIQUE,
    nomor_hp VARCHAR(25),
    shift VARCHAR(15) NOT NULL CHECK (shift IN ('Pagi', 'Siang', 'Malam'))
);

-- 4. TABEL MEMBER PELANGGAN
CREATE TABLE pelanggan (
    id_pelanggan SERIAL PRIMARY KEY,
    nama_pelanggan VARCHAR(100) NOT NULL,
    nomor_telepon VARCHAR(25) UNIQUE,
    poin_member INT NOT NULL DEFAULT 0 CHECK (poin_member &gt;= 0),
    tanggal_bergabung DATE DEFAULT CURRENT_DATE
);

-- 5. TABEL HEADER TRANSAKSI PENJUALAN
CREATE TABLE transaksi (
    id_transaksi SERIAL PRIMARY KEY,
    kode_invoice VARCHAR(50) NOT NULL UNIQUE,
    tanggal_transaksi TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    id_kasir INT NOT NULL REFERENCES kasir(id_kasir) ON DELETE RESTRICT,
    id_pelanggan INT REFERENCES pelanggan(id_pelanggan) ON DELETE SET NULL,
    total_belanja DECIMAL(12,2) NOT NULL DEFAULT 0.00 CHECK (total_belanja &gt;= 0),
    metode_pembayaran VARCHAR(20) NOT NULL CHECK (metode_pembayaran IN ('Tunai', 'QRIS', 'Transfer', 'Debit'))
);

-- 6. TABEL DETAIL TRANSAKSI (JUNCTION ITEM)
CREATE TABLE detail_transaksi (
    id_detail SERIAL PRIMARY KEY,
    id_transaksi INT NOT NULL REFERENCES transaksi(id_transaksi) ON DELETE CASCADE,
    id_produk INT NOT NULL REFERENCES produk(id_produk) ON DELETE RESTRICT,
    jumlah_beli INT NOT NULL CHECK (jumlah_beli &gt; 0),
    harga_satuan DECIMAL(10,2) NOT NULL CHECK (harga_satuan &gt;= 0),
    subtotal DECIMAL(12,2) NOT NULL CHECK (subtotal &gt;= 0)
);

-- INDEX UNTUK OPTIMASI PERFORMA PENCARIAN
CREATE INDEX idx_produk_barcode ON produk(kode_barcode);
CREATE INDEX idx_transaksi_tgl ON transaksi(tanggal_transaksi);
CREATE INDEX idx_detail_trans ON detail_transaksi(id_transaksi);</code></pre>
