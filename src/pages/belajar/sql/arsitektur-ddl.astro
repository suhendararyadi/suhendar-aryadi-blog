        <p class="text-m3-primary font-medium m3-body-medium">Hasil Akhir 3NF = Skema 6 Tabel SmartMart POS (<code>kategori</code>, <code>produk</code>, <code>kasir</code>, <code>pelanggan</code>, <code>transaksi</code>, <code>detail_transaksi</code>).</p>
      </div>

      <!-- Query Rekonstruksi Data 3NF -->
      <div class="code-example-block margin-top-md">
        <div class="code-example-header">
          <span class="m3-chip m3-chip-tonal-primary">
            <span class="material-symbols-rounded icon-sm">join_inner</span>
            SQL SELECT JOIN
          </span>
          <strong class="m3-label-large">Query Merekonstruksi Data 3NF Menjadi Struk Kasir Lengkap:</strong>
        </div>
        <pre class="code-snippet font-mono"><code>SELECT 
    t.kode_invoice,
    t.tanggal_transaksi,
    k.nama_kasir,
    COALESCE(p.nama_pelanggan, 'Non-Member') AS nama_pelanggan,
    pr.nama_produk,
    dt.jumlah_beli,
    dt.harga_satuan,
    (dt.jumlah_beli * dt.harga_satuan) AS subtotal
FROM transaksi t
JOIN kasir k ON t.id_kasir = k.id_kasir
LEFT JOIN pelanggan p ON t.id_pelanggan = p.id_pelanggan
JOIN detail_transaksi dt ON t.id_transaksi = dt.id_transaksi
JOIN produk pr ON dt.id_produk = pr.id_produk
ORDER BY t.id_transaksi DESC;</code></pre>
      </div>
    </section>

