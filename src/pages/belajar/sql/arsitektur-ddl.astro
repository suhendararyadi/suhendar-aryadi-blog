---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);
---

<MainLayout
  title="Materi Ajar: Arsitektur Basis Data & DDL (ERD, Normalisasi 1NF-3NF, Constraints) | SMK RPL"
  description="Panduan komprehensif konsep arsitektur database relasional, perancangan diagram ERD, teknik normalisasi data bebas anomali, sintaksis DDL, dan batasan integritas untuk siswa Kelas 11 RPL."
>
  <div class="materi-container">
    <!-- Top Nav & Breadcrumbs -->
    <div class="top-nav-bar">
      <a href="/belajar/sql" class="m3-btn m3-btn-outlined btn-sm">
        <span class="material-symbols-rounded icon-sm">arrow_back</span>
        Kembali ke Katalog Modul SQL
      </a>
      <div class="top-nav-badges">
        <span class="m3-chip m3-chip-tonal-primary">
          <span class="material-symbols-rounded icon-sm">school</span>
          KELAS 11 RPL
        </span>
        <span class="m3-chip m3-chip-tonal-secondary">
          <span class="material-symbols-rounded icon-sm">architecture</span>
          ARSITEKTUR &amp; DDL
        </span>
        <span class="m3-chip m3-chip-tonal-tertiary">
          <span class="material-symbols-rounded icon-sm">folder_special</span>
          PRA-PROYEK
        </span>
      </div>
    </div>

    <!-- Hero Header Card -->
    <div class="m3-card m3-card-elevated hero-card">
      <div class="hero-badge-wrap">
        <span class="m3-chip m3-chip-tonal-primary">
          <span class="material-symbols-rounded icon-sm">database</span>
          MODUL AJAR BASIS DATA
        </span>
        <span class="m3-chip m3-chip-tonal-success">
          <span class="material-symbols-rounded icon-sm">verified</span>
          TEORI &amp; PRAKTIKUM FUNDAMENTAL
        </span>
      </div>
      <h1 class="hero-title m3-display-small">Arsitektur Basis Data &amp; DDL</h1>
      <p class="hero-subtitle m3-body-large">
        Pelajari fondasi perancangan sistem database relasional: Mulai dari arsitektur RDBMS, pembuatan diagram relasi entitas (ERD), eliminasi anomali data melalui Normalisasi (1NF s.d. 3NF), hingga implementasi sintaksis DDL dan batasan integritas (<em>Constraints</em>).
      </p>

      <div class="hero-cta-row">
        <a href="#bab-1" class="m3-btn m3-btn-filled btn-sm">
          <span>Mulai Belajar Bab 1</span>
          <span class="material-symbols-rounded icon-sm">arrow_downward</span>
        </a>
        <a href="#bab-2" class="m3-btn m3-btn-tonal btn-sm">
          <span>Diagram ERD SmartMart</span>
          <span class="material-symbols-rounded icon-sm">schema</span>
        </a>
        <a href="/belajar/sql/proyek" class="m3-btn m3-btn-outlined btn-sm">
          <span>Lembar Tugas Proyek</span>
          <span class="material-symbols-rounded icon-sm">open_in_new</span>
        </a>
      </div>
    </div>

    <!-- Quick Navigation Table of Contents -->
    <div class="m3-card m3-card-elevated toc-card">
      <div class="toc-header">
        <span class="material-symbols-rounded icon-md text-m3-primary">menu_book</span>
        <h3 class="toc-title m3-title-medium">Daftar Isi Pembelajaran:</h3>
      </div>
      <div class="toc-grid">
        <a href="#bab-1" class="toc-item">
          <span class="toc-num">01</span>
          <div>
            <strong>Konsep Arsitektur RDBMS &amp; ACID</strong>
            <span>Fondasi arsitektur multi-tier &amp; integritas data</span>
          </div>
        </a>
        <a href="#bab-2" class="toc-item">
          <span class="toc-num">02</span>
          <div>
            <strong>Diagram ERD &amp; Kardinalitas</strong>
            <span>Visualisasi entitas &amp; relasi Crow's Foot</span>
          </div>
        </a>
        <a href="#bab-3" class="toc-item">
          <span class="toc-num">03</span>
          <div>
            <strong>Normalisasi Data (1NF &rarr; 3NF)</strong>
            <span>Eliminasi anomali sisip, ubah, dan hapus</span>
          </div>
        </a>
        <a href="#bab-4" class="toc-item">
          <span class="toc-num">04</span>
          <div>
            <strong>Sintaksis Baku DDL SQL</strong>
            <span>CREATE, ALTER, DROP, &amp; TRUNCATE</span>
          </div>
        </a>
        <a href="#bab-5" class="toc-item">
          <span class="toc-num">05</span>
          <div>
            <strong>Batasan Integritas (Constraints)</strong>
            <span>PK, FK, CHECK, UNIQUE, &amp; ON DELETE CASCADE</span>
          </div>
        </a>
        <a href="#bab-6" class="toc-item">
          <span class="toc-num">06</span>
          <div>
            <strong>Cheat Sheet DDL &amp; Mini Kuis</strong>
            <span>Template skrip 6 tabel &amp; uji pemahaman</span>
          </div>
        </a>
      </div>
    </div>

    <!-- ==========================================
         BAB 1: FONDASI ARSITEKTUR RDBMS & ACID
         ========================================== -->
    <section id="bab-1" class="content-section m3-card m3-card-elevated">
      <div class="section-badge-header">
        <span class="section-step-num">BAB 01</span>
        <h2 class="m3-headline-medium">Fondasi Arsitektur Basis Data Relasional (RDBMS) &amp; ACID</h2>
      </div>

      <p class="section-lead m3-body-large">
        Sebelum menulis kode SQL, seorang <em>Software Engineer</em> wajib memahami bagaimana sistem database bekerja di balik layar dalam memproses jutaan transaksi kasir secara aman, konsisten, dan konkuren.
      </p>

      <!-- Diagram 1: Arsitektur Multi-Tier Database -->
      <div class="visual-box">
        <div class="visual-header">
          <span class="m3-chip m3-chip-tonal-primary">
            <span class="material-symbols-rounded icon-sm">account_tree</span>
            DIAGRAM ARSITEKTUR
          </span>
          <h4 class="m3-title-large">Alur Pemrosesan Query pada RDBMS</h4>
        </div>
        
        <div class="arch-flow-wrapper">
          <!-- 1. Client Layer -->
          <div class="arch-flow-card card-client">
            <div class="flow-card-badge">
              <span class="m3-chip m3-chip-tonal-primary">
                <span class="material-symbols-rounded icon-sm">point_of_sale</span>
                LAYER 1: CLIENT APPLICATION
              </span>
            </div>
            <div class="flow-card-main">
              <div class="flow-card-icon-box bg-primary-container">
                <span class="material-symbols-rounded icon-lg text-m3-primary">devices</span>
              </div>
              <div class="flow-card-text">
                <h5 class="flow-card-title m3-title-medium">Aplikasi Kasir POS (Frontend / Client)</h5>
                <p class="flow-card-desc m3-body-medium">
                  Kasir memindai barcode &rarr; Aplikasi membuat perintah SQL (misal: <code>INSERT INTO transaksi ...</code>) dan mengirimkannya melalui koneksi TCP/IP.
                </p>
              </div>
            </div>
          </div>

          <!-- Flow Arrow 1 -->
          <div class="flow-connector">
            <div class="flow-line"></div>
            <span class="flow-pill-label-m3">
              <span class="material-symbols-rounded icon-sm">send</span>
              Kirim Perintah SQL (Query Stream via TCP/IP)
            </span>
            <span class="material-symbols-rounded icon-sm text-m3-primary">arrow_downward</span>
          </div>

          <!-- 2. Database Server Engine -->
          <div class="arch-flow-engine">
            <div class="engine-header">
              <div class="engine-title-flex">
                <div class="engine-icon-box bg-tertiary-container">
                  <span class="material-symbols-rounded icon-lg text-m3-tertiary">settings_suggest</span>
                </div>
                <div>
                  <h5 class="engine-title m3-title-medium">DATABASE ENGINE (RDBMS Core: PostgreSQL / MySQL)</h5>
                  <span class="engine-sub m3-body-small">Manajer Transaksi, Keamanan, &amp; Eksekusi Kueri ACID</span>
                </div>
              </div>
              <span class="m3-chip m3-chip-tonal-tertiary">
                <span class="material-symbols-rounded icon-sm">dns</span>
                SERVER SIDE
              </span>
            </div>

            <div class="engine-steps-grid">
              <!-- Step 1: Parser & Optimizer -->
              <div class="engine-step-card">
                <div class="step-badge-num">1</div>
                <div class="step-card-content">
                  <h6 class="step-title m3-title-small">SQL Parser &amp; Optimizer</h6>
                  <p class="step-desc m3-body-small">
                    Validasi sintaks SQL &amp; hak akses. Memilih rencana eksekusi (<em>Execution Plan</em>) dengan estimasi biaya algoritma I/O paling efisien.
                  </p>
                </div>
              </div>

              <!-- Step 2: Transaction & Execution Engine -->
              <div class="engine-step-card">
                <div class="step-badge-num">2</div>
                <div class="step-card-content">
                  <h6 class="step-title m3-title-small">Transaction Engine (ACID)</h6>
                  <p class="step-desc m3-body-small">
                    Eksekusi kueri, penguncian data (<em>Row Lock</em>) untuk multi-kasir, validasi <em>Constraints</em> (PK/FK/CHECK), serta pengelolaan <code>COMMIT/ROLLBACK</code>.
                  </p>
                </div>
              </div>

              <!-- Step 3: Shared Memory Buffer & Cache -->
              <div class="engine-step-card">
                <div class="step-badge-num">3</div>
                <div class="step-card-content">
                  <h6 class="step-title m3-title-small">Shared Buffer &amp; RAM Cache</h6>
                  <p class="step-desc m3-body-small">
                    Menyimpan blok data di RAM. Jika data ada di cache (<em>Buffer Cache Hit</em>), hasil kueri dikembalikan instan tanpa membaca disk fisik.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Flow Arrow 2 (Bidirectional) -->
          <div class="flow-connector">
            <div class="flow-line flow-line-tertiary"></div>
            <span class="flow-pill-label-m3 flow-pill-bi">
              <span class="material-symbols-rounded icon-sm">sync_alt</span>
              <span><strong>Write:</strong> WAL &amp; Dirty Buffer Flush | <strong>Read:</strong> Blok Data &amp; B-Tree Index</span>
            </span>
            <span class="material-symbols-rounded icon-sm" style="color: var(--m3-tertiary);">swap_vert</span>
          </div>

          <!-- 3. Storage Disk -->
          <div class="arch-flow-card card-storage">
            <div class="flow-card-badge">
              <span class="m3-chip m3-chip-tonal-warning">
                <span class="material-symbols-rounded icon-sm">hard_drive</span>
                LAYER 3: PERSISTENT STORAGE
              </span>
            </div>
            <div class="flow-card-main">
              <div class="flow-card-icon-box bg-warning-container">
                <span class="material-symbols-rounded icon-lg text-m3-warning">storage</span>
              </div>
              <div class="flow-card-text">
                <h5 class="flow-card-title m3-title-medium">Storage Disk Permanen (NVMe SSD / HDD)</h5>
                <p class="flow-card-desc m3-body-medium">
                  Media penyimpanan fisik yang menyimpan berkas data tabel (<code>data files</code>), indeks B-Tree, dan berkas transaksi (WAL) agar data transaksi tidak pernah hilang (<em>Durability</em>).
                </p>
              </div>
            </div>
          </div>
        </div>

        <p class="visual-caption m3-body-small text-m3-muted">
          <strong>Gambar 1.1:</strong> Alur transaksi dari antarmuka kasir ke parser SQL, eksekusi ACID, buffer memori, hingga penyimpanan permanen di disk.
        </p>
      </div>

      <!-- Tabel 1: Flat-File vs RDBMS -->
      <h3 class="sub-heading m3-headline-small">Mengapa Menggunakan RDBMS, Bukan File Excel/CSV?</h3>
      <p class="m3-body-medium">
        Banyak toko konvensional mencatat transaksi pada satu lembar file Excel (<em>Flat-File</em>). Namun saat skala bisnis membesar, cara ini menimbulkan bencana integritas:
      </p>

      <div class="table-responsive margin-top-sm">
        <table class="data-table">
          <thead>
            <tr>
              <th>Aspek Pembanding</th>
              <th>Flat-File (Excel / CSV)</th>
              <th>RDBMS (PostgreSQL / MySQL)</th>
              <th>Dampak Nyata di Kasir SmartMart</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><strong>Konkurensi (Banyak Kasir)</strong></td>
              <td><span class="material-symbols-rounded icon-sm text-m3-error status-inline-icon">cancel</span> File terkunci jika dibuka 2 kasir bersamaan</td>
              <td><span class="material-symbols-rounded icon-sm text-m3-success status-inline-icon">check_circle</span> Mampu melayani ribuan kasir serentak (*Multi-User*)</td>
              <td>Kasir 1 &amp; Kasir 2 bisa transaksi tanpa antri kunci file</td>
            </tr>
            <tr>
              <td><strong>Integritas Relasi</strong></td>
              <td><span class="material-symbols-rounded icon-sm text-m3-error status-inline-icon">cancel</span> Nama pelanggan atau harga rawan salah ketik manual</td>
              <td><span class="material-symbols-rounded icon-sm text-m3-success status-inline-icon">check_circle</span> Terkunci otomatis via Foreign Key &amp; Constraints</td>
              <td>Kasir tidak bisa menjual barang fiktif yang tidak ada di master</td>
            </tr>
            <tr>
              <td><strong>Keamanan Transaksi (ACID)</strong></td>
              <td><span class="material-symbols-rounded icon-sm text-m3-error status-inline-icon">cancel</span> Jika PC mati tiba-tiba, file rawan rusak (korup)</td>
              <td><span class="material-symbols-rounded icon-sm text-m3-success status-inline-icon">check_circle</span> Rollback otomatis jika transaksi gagal di tengah jalan</td>
              <td>Struk nota tidak akan tercatat setengah jika listrik padam</td>
            </tr>
            <tr>
              <td><strong>Kecepatan Query Data Besar</strong></td>
              <td><span class="material-symbols-rounded icon-sm text-m3-error status-inline-icon">cancel</span> Lambat &amp; <em>lag</em> saat baris data mencapai &gt;100.000</td>
              <td><span class="material-symbols-rounded icon-sm text-m3-success status-inline-icon">check_circle</span> Cepat berkat struktur B-Tree Indexing &amp; View</td>
              <td>Laporan omset tahunan selesai dalam hitungan milidetik</td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Prinsip ACID Callout -->
      <div class="m3-banner m3-banner-primary margin-top-md">
        <div class="callout-inner-flex">
          <span class="material-symbols-rounded icon-lg text-m3-primary callout-icon">verified_user</span>
          <div>
            <h4 class="m3-title-medium">4 Pilar Jaminan Transaksi Basis Data (Prinsip ACID):</h4>
            <ul class="clean-list margin-top-xs">
              <li><strong>Atomicity (Keutuhan):</strong> Transaksi diproses tuntas seluruhnya atau dibatalkan sama sekali (<em>All or Nothing</em>).</li>
              <li><strong>Consistency (Konsistensi):</strong> Saldo stok dan total uang kasir harus selalu sesuai aturan bisnis sebelum dan sesudah transaksi.</li>
              <li><strong>Isolation (Pemisahan):</strong> Transaksi Kasir A tidak boleh terganggu atau tercampur dengan transaksi Kasir B yang berjalan bersamaan.</li>
              <li><strong>Durability (Ketahanan):</strong> Sekali transaksi sukses dicetak (*Commit*), data tidak akan hilang meski server mati mendadak.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ==========================================
         BAB 2: ERD & KARDINALITAS MERMAID DIAGRAM
         ========================================== -->
    <section id="bab-2" class="content-section m3-card m3-card-elevated">
      <div class="section-badge-header">
        <span class="section-step-num">BAB 02</span>
        <h2 class="m3-headline-medium">Entity Relationship Diagram (ERD) &amp; Kardinalitas</h2>
      </div>

      <p class="section-lead m3-body-large">
        <strong>Entity Relationship Diagram (ERD)</strong> adalah diagram visual yang menggambarkan seluruh entitas tabel basis data beserta atribut (kolom) dan garis relasi antar-entitas.
      </p>

      <!-- Diagram 2: Static ERD Schema Diagram SmartMart POS -->
      <div class="visual-box">
        <div class="visual-header">
          <span class="m3-chip m3-chip-tonal-secondary">
            <span class="material-symbols-rounded icon-sm">schema</span>
            DIAGRAM ERD RELASI TABEL
          </span>
          <h4 class="m3-title-large">Diagram Relasi 6 Entitas Skema SmartMart POS</h4>
        </div>

        <div class="erd-visual-canvas">
          <!-- Summary of Relations -->
          <div class="erd-relationships-banner">
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>KASIR</strong> &rarr; TRANSAKSI (melayani)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>PELANGGAN</strong> &rarr; TRANSAKSI (melakukan)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>KATEGORI</strong> &rarr; PRODUK (memiliki)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>PRODUK</strong> &rarr; DETAIL_TRANSAKSI (tercatat)</span>
            </div>
            <div class="rel-badge-item">
              <span class="rel-line-icon">1 ───&lt; N</span>
              <span><strong>TRANSAKSI</strong> &rarr; DETAIL_TRANSAKSI (merinci)</span>
            </div>
          </div>

          <!-- Visual ERD Map with Visible Connecting Lines & Crow's Foot Markers -->
          <div class="erd-map-section">
            <div class="erd-map-header-bar">
              <div class="erd-map-header-title">
                <span class="material-symbols-rounded icon-sm text-m3-primary">hub</span>
                <span class="m3-title-small font-bold">Diagram Garis Relasi Entitas (Notasi Crow's Foot)</span>
              </div>
              <div class="erd-map-legend">
                <span class="legend-chip"><strong class="font-mono">||</strong> Tepat 1 (One)</span>
                <span class="legend-chip"><strong class="font-mono">|&lt;</strong> 1 atau Banyak (Many)</span>
              </div>
            </div>

            <div class="erd-svg-scroll-container">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1060 520" width="100%" height="auto" class="erd-svg-map">
                <defs>
                  <!-- Filter for Shadow -->
                  <filter id="node-shadow" x="-5%" y="-5%" width="110%" height="115%" filterUnits="userSpaceOnUse">
                    <feDropShadow dx="0" dy="4" stdDeviation="6" flood-color="#0f172a" flood-opacity="0.08" />
                  </filter>

                  <!-- Markers: Crow's Foot (Many) and One (Ticks) -->
                  <!-- Blue (Kasir -> Transaksi) -->
                  <marker id="one-kasir" viewBox="0 0 14 14" refX="4" refY="7" markerWidth="10" markerHeight="10" orient="auto">
                    <line x1="4" y1="2" x2="4" y2="12" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="9" y1="2" x2="9" y2="12" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" />
                  </marker>
                  <marker id="crow-kasir" viewBox="0 0 16 16" refX="14" refY="8" markerWidth="12" markerHeight="12" orient="auto">
                    <path d="M 2,2 L 14,8 L 2,14 M 14,1 L 14,15" fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linecap="round" />
                  </marker>

                  <!-- Emerald (Pelanggan -> Transaksi) -->
                  <marker id="one-pelanggan" viewBox="0 0 14 14" refX="4" refY="7" markerWidth="10" markerHeight="10" orient="auto">
                    <line x1="4" y1="2" x2="4" y2="12" stroke="#059669" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="9" y1="2" x2="9" y2="12" stroke="#059669" stroke-width="2.5" stroke-linecap="round" />
                  </marker>
                  <marker id="crow-pelanggan" viewBox="0 0 16 16" refX="14" refY="8" markerWidth="12" markerHeight="12" orient="auto">
                    <path d="M 2,2 L 14,8 L 2,14 M 14,1 L 14,15" fill="none" stroke="#059669" stroke-width="2.5" stroke-linecap="round" />
                  </marker>

                  <!-- Indigo (Transaksi -> Detail) -->
                  <marker id="one-transaksi" viewBox="0 0 14 14" refX="4" refY="7" markerWidth="10" markerHeight="10" orient="auto">
                    <line x1="4" y1="2" x2="4" y2="12" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="9" y1="2" x2="9" y2="12" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" />
                  </marker>
                  <marker id="crow-transaksi" viewBox="0 0 16 16" refX="14" refY="8" markerWidth="12" markerHeight="12" orient="auto">
                    <path d="M 2,2 L 14,8 L 2,14 M 14,1 L 14,15" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" />
                  </marker>

                  <!-- Purple (Kategori -> Produk) -->
                  <marker id="one-kategori" viewBox="0 0 14 14" refX="4" refY="7" markerWidth="10" markerHeight="10" orient="auto">
                    <line x1="4" y1="2" x2="4" y2="12" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="9" y1="2" x2="9" y2="12" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" />
                  </marker>
                  <marker id="crow-kategori" viewBox="0 0 16 16" refX="14" refY="8" markerWidth="12" markerHeight="12" orient="auto">
                    <path d="M 2,2 L 14,8 L 2,14 M 14,1 L 14,15" fill="none" stroke="#7c3aed" stroke-width="2.5" stroke-linecap="round" />
                  </marker>

                  <!-- Amber (Produk -> Detail) -->
                  <marker id="one-produk" viewBox="0 0 14 14" refX="4" refY="7" markerWidth="10" markerHeight="10" orient="auto">
                    <line x1="4" y1="2" x2="4" y2="12" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" />
                    <line x1="9" y1="2" x2="9" y2="12" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" />
                  </marker>
                  <marker id="crow-produk" viewBox="0 0 16 16" refX="14" refY="8" markerWidth="12" markerHeight="12" orient="auto">
                    <path d="M 2,2 L 14,8 L 2,14 M 14,1 L 14,15" fill="none" stroke="#d97706" stroke-width="2.5" stroke-linecap="round" />
                  </marker>
                </defs>

                <!-- ================= RELATIONAL LINES LAYER ================= -->
                <!-- 1. KASIR -> TRANSAKSI -->
                <g class="erd-line-group">
                  <path d="M 230,110 C 275,110 285,135 330,135" fill="none" stroke="#0284c7" stroke-width="3.5" stroke-linecap="round" marker-start="url(#one-kasir)" marker-end="url(#crow-kasir)" />
