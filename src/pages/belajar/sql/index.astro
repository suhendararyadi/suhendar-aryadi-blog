---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';
import { seedLessons, type SQLLesson } from '../../../lib/seedLessons';
import { query } from '../../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

let lessons: SQLLesson[] = seedLessons;
try {
  const dbRes = await query('SELECT * FROM sql_lessons ORDER BY order_index ASC');
  if (dbRes.rows && dbRes.rows.length > 0) {
    lessons = dbRes.rows as SQLLesson[];
  }
} catch (err) {
  console.warn('Fallback to seedLessons for catalog page:', err);
}

const completedLessonIds = new Set<number>();
if (user) {
  try {
    const progressRes = await query(
      "SELECT lesson_id FROM user_progress WHERE user_id = $1 AND status = 'completed'",
      [user.id]
    );
    progressRes.rows.forEach((r: any) => completedLessonIds.add(Number(r.lesson_id)));
  } catch (err) {
    console.warn('Could not fetch user progress:', err);
  }
}

const completedCount = completedLessonIds.size;
const totalCount = lessons.length;
const completionPercentage = totalCount > 0 ? Math.round((completedCount / totalCount) * 100) : 0;

interface LearningPathDef {
  id: 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security';
  title: string;
  shortTitle: string;
  badgeText: string;
  badgeClass: string;
  description: string;
  modulesRange: string;
}

const LEARNING_PATHS: LearningPathDef[] = [
  {
    id: 'basics',
    title: 'Path 1: SQL Basics',
    shortTitle: 'Basics',
    badgeText: 'Level 1',
    badgeClass: 'badge-emerald',
    description: 'Kuasai dasar-dasar SQL: sintaksis SELECT, filter WHERE, pengurutan ORDER BY, hingga manipulasi data INSERT, UPDATE, dan DELETE.',
    modulesRange: 'Modul 1 – 10'
  },
  {
    id: 'aggregates',
    title: 'Path 2: SQL Aggregates & Functions',
    shortTitle: 'Aggregates',
    badgeText: 'Level 2',
    badgeClass: 'badge-amber',
    description: 'Pelajari fungsi agregasi data (COUNT, SUM, AVG, MIN, MAX), kalkulasi aritmatika, filter teks LIKE, serta fungsi String dan Date.',
    modulesRange: 'Modul 11 – 18'
  },
  {
    id: 'joins',
    title: 'Path 3: SQL Joins & Relasi Tabel',
    shortTitle: 'Joins',
    badgeText: 'Level 3',
    badgeClass: 'badge-sky',
    description: 'Gabungkan informasi dari berbagai tabel relasional dengan INNER JOIN, LEFT JOIN, RIGHT JOIN, FULL OUTER JOIN, dan Self Join.',
    modulesRange: 'Modul 19 – 24'
  },
  {
    id: 'grouping',
    title: 'Path 4: SQL Grouping & Subqueries',
    shortTitle: 'Grouping',
    badgeText: 'Level 4',
    badgeClass: 'badge-purple',
    description: 'Analisis kelompok data dengan GROUP BY & HAVING, query bersarang (Subqueries), kueri kondisi EXISTS, operator ANY/ALL, dan UNION.',
    modulesRange: 'Modul 25 – 30'
  },
  {
    id: 'ddl_security',
    title: 'Path 5: SQL DDL, Constraints & Security',
    shortTitle: 'DDL & Security',
    badgeText: 'Level 5',
    badgeClass: 'badge-orange',
    description: 'Definisikan skema database (CREATE, ALTER, DROP), kelola batasan data (Constraints), Transaksi, Views, dan Proteksi Keamanan SQL.',
    modulesRange: 'Modul 31 – 40'
  }
];

function getPathId(lesson: SQLLesson): 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security' {
  if (lesson.path_id) return lesson.path_id;
  const idx = lesson.order_index;
  if (idx <= 10) return 'basics';
  if (idx <= 18) return 'aggregates';
  if (idx <= 24) return 'joins';
  if (idx <= 30) return 'grouping';
  return 'ddl_security';
}

const lessonsByOrder = new Map<number, SQLLesson>();
lessons.forEach((l) => lessonsByOrder.set(l.order_index, l));

const isTeacherOrAdmin = user?.role === 'teacher' || user?.role === 'admin' || (user?.email && user.email.toLowerCase().includes('suhendar'));

const pathGroups = LEARNING_PATHS.map((path) => {
  const pathLessons = lessons.filter((l) => getPathId(l) === path.id);
  const total = pathLessons.length;
  const completed = pathLessons.filter((l) => completedLessonIds.has(l.id)).length;
  const percentage = total > 0 ? Math.round((completed / total) * 100) : 0;
  return {
    ...path,
    lessons: pathLessons,
    total,
    completed,
    percentage
  };
});
---

<MainLayout 
  title="Katalog Pembelajaran SQL Interaktif | Suhendar Aryadi"
  description="Kurikulum pembelajaran SQL interaktif 40 Modul bergaya W3Schools. Pelajari SELECT, JOINs, Subqueries, DDL, Constraints & Keamanan."
>
  <div class="container">
    <div class="catalog-hero glass-card">
      <div class="hero-content">
        <span class="badge badge-cyan">KURIKULUM SQL INTERAKTIF 40 MODUL</span>
        <h1 class="hero-title">Katalog Pembelajaran <span class="text-gradient">SQL Masterclass</span></h1>
        <p class="hero-description">
          Kuasai sintaksis database SQL dari tingkat dasar hingga profesional melalui 5 Learning Path terstruktur.
          Tulis query pada editor SQLite WASM, eksekusi real-time, dan dapatkan umpan balik evaluasi otomatis.
        </p>

        {user ? (
          <div class="user-status-card">
            <div class="user-info">
              <div class="user-avatar">{user.name.charAt(0).toUpperCase()}</div>
              <div>
                <div class="user-name">Selamat datang kembali, <strong>{user.name}</strong></div>
                <div class="user-progress-text">Progres Keseluruhan: <strong>{completedCount} dari {totalCount} Modul Selesai</strong> ({completionPercentage}%)</div>
              </div>
            </div>
            <div class="progress-bar-container">
              <div class="progress-bar-fill" style={`width: ${completionPercentage}%`}></div>
            </div>
            <div class="status-actions">
              <a href="/dashboard" class="btn btn-secondary btn-sm">
                Lihat Dashboard Siswa
              </a>
            </div>
          </div>
        ) : (
          <div class="auth-prompt-card">
            <div class="auth-prompt-text">
              <div>
                <strong>Simpan Progres Belajar Anda</strong>
                <p>Login atau daftar akun siswa untuk menyimpan riwayat jawaban dan memantau pencapaian 5 Learning Path.</p>
              </div>
            </div>
            <div class="auth-prompt-buttons">
              <a href="/auth/login" class="btn btn-primary btn-sm">Login Siswa</a>
              <a href="/auth/register" class="btn btn-outline btn-sm">Daftar Akun Baru</a>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Interactive Filter Bar -->
    <div class="filter-bar glass-card">
      <div class="filter-header">
        <span class="filter-title">Filter Learning Path:</span>
      </div>
      <div class="filter-tabs">
        <button class="filter-tab active" data-filter="all">
          <span>Semua</span>
          <span class="tab-count">{totalCount} Modul</span>
        </button>
        {pathGroups.map((path) => (
          <button class="filter-tab" data-filter={path.id}>
            <span>{path.shortTitle}</span>
            <span class="tab-count">{path.completed}/{path.total}</span>
          </button>
        ))}
      </div>
    </div>

    <!-- 5 Learning Path Sections -->
    <div class="paths-container">
      {pathGroups.map((path) => (
        <section class="path-section" data-path={path.id}>
          <div class:list={['path-header-card', 'glass-card', path.id]}>
            <div class="path-header-top">
              <div class="path-title-group">
                <div>
                  <div class="path-badge-wrap">
                    <span class:list={['badge', path.badgeClass]}>{path.badgeText}</span>
                    <span class="module-range-badge">{path.modulesRange}</span>
                  </div>
                  <h2 class="path-title">{path.title}</h2>
                </div>
              </div>
              <div class="path-progress-box">
                <div class="path-progress-label">
                  Progres Path: <strong>{path.completed} / {path.total} Selesai</strong> ({path.percentage}%)
                </div>
                <div class="path-progress-bar">
                  <div class:list={['path-progress-fill', path.id]} style={`width: ${path.percentage}%`}></div>
                </div>
              </div>
            </div>
            <p class="path-description">{path.description}</p>
          </div>

          <div class="lessons-grid">
            {path.lessons.map((lesson) => {
              const isCompleted = completedLessonIds.has(lesson.id);
              const prevLessonInOrder = lesson.order_index > 1 ? lessonsByOrder.get(lesson.order_index - 1) : null;
              const isLocked = isTeacherOrAdmin 
                ? false 
                : user 
                  ? (lesson.order_index > 1 && prevLessonInOrder ? !completedLessonIds.has(prevLessonInOrder.id) : false) 
                  : false;
              const evaluatorType = lesson.evaluator_type || 'data_match';
              return (
                <div class:list={['lesson-card', 'glass-card', 'glass-card-interactive', { completed: isCompleted, locked: isLocked }]}>
                  <div class="card-top">
                    <span class="module-number">Modul #{lesson.order_index}</span>
                    {isLocked ? (
                      <span class="badge badge-locked-sm" title="Selesaikan modul sebelumnya terlebih dahulu">🔒 Terkunci</span>
                    ) : evaluatorType === 'schema_match' ? (
                      <span class="badge badge-purple" title="Evaluasi struktur tabel / skema DDL">Schema Match</span>
                    ) : (
                      <span class="badge badge-cyan" title="Evaluasi baris data SELECT">Data Match</span>
                    )}
                  </div>
                  <h3 class="lesson-title">{lesson.title}</h3>
                  <p class="lesson-desc">
                    {lesson.instructions_markdown.replace(/\*\*/g, '').slice(0, 110)}...
                  </p>
                  <div class="card-footer">
                    {isCompleted ? (
                      <span class="completion-badge">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                          <polyline points="20 6 9 17 4 12"></polyline>
                        </svg>
                        Selesai
                      </span>
                    ) : isTeacherOrAdmin ? (
                      <span class="status-teacher-access">🔓 Full Access Guru</span>
                    ) : isLocked ? (
                      <span class="status-locked" title={`Selesaikan Modul #${prevLessonInOrder?.order_index} terlebih dahulu`}>
                        🔒 Terkunci
                      </span>
                    ) : (
                      <span class="status-pending">Belum Dikerjakan</span>
                    )}
                    <a 
                      href={`/belajar/sql/${lesson.slug}`} 
                      class:list={['btn', 'btn-sm', 'cta-btn', isCompleted ? 'btn-primary' : isLocked ? 'btn-secondary btn-locked-cta' : 'btn-primary']}
                    >
                      {isCompleted ? 'Ulangi Modul' : isTeacherOrAdmin ? 'Pratinjau Modul →' : isLocked ? '🔒 Terkunci' : 'Mulai Latihan'}
                    </a>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      ))}
    </div>
  </div>
</MainLayout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterTabs = document.querySelectorAll<HTMLButtonElement>('.filter-tab');
    const pathSections = document.querySelectorAll<HTMLElement>('.path-section');

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');

        filterTabs.forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');

        pathSections.forEach((section) => {
          const sectionPath = section.getAttribute('data-path');
          if (filter === 'all' || sectionPath === filter) {
            section.style.display = 'block';
          } else {
            section.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  .catalog-hero {
    padding: 2.5rem;
    margin-top: 1rem;
    margin-bottom: 2rem;
    background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.15), transparent 50%), var(--glass-bg);
  }

  .hero-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    margin-top: 0.75rem;
    margin-bottom: 1rem;
  }

  .hero-description {
    color: var(--text-secondary);
    font-size: 1.05rem;
    max-width: 780px;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .user-status-card {
    background: var(--bg-secondary);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    margin-top: 1rem;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.875rem;
  }

  .user-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-full);
    background: var(--accent-gradient);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
  }

  .user-name {
    font-size: 1rem;
    color: var(--text-primary);
  }

  .user-progress-text {
    font-size: 0.875rem;
    color: var(--text-secondary);
  }

  .progress-bar-container {
    height: 8px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--accent-gradient);
    border-radius: var(--radius-full);
    transition: width 0.4s ease;
  }

  .status-actions {
    display: flex;
    justify-content: flex-end;
  }

  .auth-prompt-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    flex-wrap: wrap;
  }

  .auth-prompt-text {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .auth-prompt-text strong {
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .auth-prompt-text p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 0.2rem;
  }

  .auth-prompt-buttons {
    display: flex;
    gap: 0.75rem;
  }

  .btn-sm {
    padding: 0.45rem 0.95rem;
    font-size: 0.875rem;
  }

  /* Filter Bar */
  .filter-bar {
    padding: 1rem 1.5rem;
    margin-bottom: 2.5rem;
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .filter-header {
    white-space: nowrap;
  }

  .filter-title {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  .filter-tabs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    flex: 1;
  }

  .filter-tab {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-secondary);
    padding: 0.45rem 0.85rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .filter-tab:hover {
    color: var(--text-primary);
    border-color: var(--accent-color, #6366f1);
    background: rgba(99, 102, 241, 0.08);
  }

  .filter-tab.active {
    background: var(--accent-gradient, linear-gradient(135deg, #6366f1 0%, #a855f7 100%));
    color: #ffffff;
    border-color: transparent;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.3);
  }

  .tab-count {
    font-size: 0.75rem;
    opacity: 0.85;
    background: rgba(0, 0, 0, 0.15);
    padding: 0.1rem 0.4rem;
    border-radius: var(--radius-full);
  }

  .filter-tab.active .tab-count {
    background: rgba(255, 255, 255, 0.25);
  }

  /* Path Section & Header Card */
  .paths-container {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-bottom: 3rem;
  }

  .path-section {
    transition: opacity 0.3s ease;
  }

  .path-header-card {
    padding: 1.5rem 1.75rem;
    margin-bottom: 1.5rem;
    border-left: 4px solid var(--border-color);
  }

  .path-header-card.basics { border-left-color: #10b981; }
  .path-header-card.aggregates { border-left-color: #f59e0b; }
  .path-header-card.joins { border-left-color: #0284c7; }
  .path-header-card.grouping { border-left-color: #8b5cf6; }
  .path-header-card.ddl_security { border-left-color: #f97316; }

  .path-header-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }

  .path-title-group {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
  }

  .path-badge-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.35rem;
  }

  .module-range-badge {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--text-muted);
    background: var(--bg-secondary);
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-subtle);
  }

  .path-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .path-progress-box {
    min-width: 240px;
    max-width: 320px;
    flex: 1;
  }

  .path-progress-label {
    font-size: 0.825rem;
    color: var(--text-secondary);
    margin-bottom: 0.4rem;
    text-align: right;
  }

  .path-progress-bar {
    height: 8px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .path-progress-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.4s ease;
  }

  .path-progress-fill.basics { background: linear-gradient(90deg, #10b981, #34d399); }
  .path-progress-fill.aggregates { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
  .path-progress-fill.joins { background: linear-gradient(90deg, #0284c7, #38bdf8); }
  .path-progress-fill.grouping { background: linear-gradient(90deg, #8b5cf6, #c084fc); }
  .path-progress-fill.ddl_security { background: linear-gradient(90deg, #f97316, #fb923c); }

  .path-description {
    font-size: 0.925rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  /* Badges */
  .badge-emerald {
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  .badge-locked-sm {
    background: rgba(168, 85, 247, 0.12);
    color: #a855f7;
    border: 1px solid rgba(168, 85, 247, 0.3);
    font-size: 0.725rem;
    padding: 0.15rem 0.5rem;
  }

  .status-locked {
    font-size: 0.775rem;
    font-weight: 600;
    color: #a855f7;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .status-teacher-access {
    font-size: 0.775rem;
    font-weight: 600;
    color: var(--accent-cyan);
  }

  .btn-locked-cta {
    opacity: 0.9;
    border-color: rgba(168, 85, 247, 0.4);
    color: #a855f7;
  }

  .lesson-card.locked {
    border-color: rgba(168, 85, 247, 0.25);
    background: rgba(168, 85, 247, 0.03);
  }

  .badge-amber {
    background: rgba(245, 158, 11, 0.12);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .badge-sky {
    background: rgba(2, 132, 199, 0.12);
    color: #38bdf8;
    border: 1px solid rgba(2, 132, 199, 0.3);
  }

  .badge-purple {
    background: rgba(139, 92, 246, 0.12);
    color: #a78bfa;
    border: 1px solid rgba(139, 92, 246, 0.3);
  }

  .badge-orange {
    background: rgba(249, 115, 22, 0.12);
    color: #fb923c;
    border: 1px solid rgba(249, 115, 22, 0.3);
  }

  /* Lessons Grid */
  .lessons-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .lesson-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
  }

  .lesson-card.completed {
    border-color: rgba(16, 185, 129, 0.3);
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .module-number {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .lesson-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    line-height: 1.35;
  }

  .lesson-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .completion-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.825rem;
    font-weight: 600;
    color: #10b981;
  }

  .status-pending {
    font-size: 0.825rem;
    color: var(--text-muted);
  }

  .cta-btn {
    margin-left: auto;
  }

  /* Mobile Responsive UI/UX Enhancements */
  @media (max-width: 768px) {
    .catalog-hero {
      padding: 1.5rem 1.25rem;
      margin-top: 0.5rem;
      margin-bottom: 1.5rem;
      border-radius: var(--radius-md);
    }

    .hero-title {
      font-size: 1.75rem;
      line-height: 1.3;
    }

    .hero-description {
      font-size: 0.95rem;
      margin-bottom: 1.25rem;
    }

    .user-status-card {
      padding: 1rem;
    }

    .user-info {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }

    .user-name {
      font-size: 0.925rem;
