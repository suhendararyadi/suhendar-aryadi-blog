---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect(`/auth/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const isTeacherOrAdmin = user?.role === 'teacher' || user?.role === 'admin' || (user?.email && user.email.toLowerCase().includes('suhendar'));

const elements = [
  {
    code: 'BK',
    num: '1',
    title: 'Berpikir Komputasional',
    subtitle: 'Searching, Sorting, Stack & Queue Visualizer',
    description: 'Melatih pola pikir pemecahan masalah (problem solving), algoritma pencarian (Linear/Binary Search), algoritma pengurutan (Bubble/Selection Sort), serta struktur data Stack & Queue.',
    badge: 'PRAKTIKUM VISUALIZER',
    badgeClass: 'badge-purple',
    labUrl: '/belajar/informatika/bk',
    labStatus: 'active',
    labBtn: 'Buka Visualizer Lab →',
    topics: ['Konsep Data & Informasi', 'Linear vs Binary Search', 'Bubble & Selection Sort', 'Struktur Data Stack & Queue']
  },
  {
    code: 'TIK',
    num: '2',
    title: 'Teknologi Informasi & Komunikasi',
    subtitle: 'Integrasi Aplikasi Perkantoran & Digital Search',
    description: 'Mengintegrasikan konten antar-aplikasi perkantoran (Mail Merge, Embedding Object/Chart), pencarian data tingkat lanjut, serta pengelolaan informasi digital.',
    badge: 'MODUL & INTEGRASI DATA',
    badgeClass: 'badge-cyan',
    labUrl: '/belajar/informatika/tik',
    labStatus: 'active',
    labBtn: 'Buka Modul TIK →',
    topics: ['Integrasi Office / Mail Merge', 'Advanced Search Operators', 'Pencarian & Pengolahan Data']
  },
  {
    code: 'SK',
    num: '3',
    title: 'Sistem Komputer',
    subtitle: 'Arsitektur Komputer & Peran Sistem Operasi',
    description: 'Mengintip arsitektur internal komputer (CPU, RAM, ROM, Storage), interaksi perangkat keras (hardware), perangkat lunak (software), dan peran Sistem Operasi.',
    badge: 'INTERAKTIF SIMULATOR',
    badgeClass: 'badge-cyan',
    labUrl: '/belajar/informatika/sk',
    labStatus: 'active',
    labBtn: 'Buka Explorer SK →',
    topics: ['Komponen Utama CPU & Memori', 'Mekanisme Booting & OS', 'Interaksi Hardware & Software']
  },
  {
    code: 'JKI',
    num: '4',
    title: 'Jaringan Komputer & Internet',
    subtitle: 'Topologi, Subnetting & Enkripsi Data',
    description: 'Memahami cara data mengalir lewat jaringan lokal & internet, pengalamatan IP Address, kalkulasi Subnetting, serta mekanisme enkripsi SSL/HTTPS.',
    badge: 'KALKULATOR & ENKRIPSI',
    badgeClass: 'badge-purple',
    labUrl: '/belajar/informatika/jki',
    labStatus: 'active',
    labBtn: 'Buka Lab Jaringan →',
    topics: ['Topologi & Kabel UTP/Fiber', 'Kalkulator Subnetting IP', 'Enkripsi & Keamanan HTTPS']
  },
  {
    code: 'AD',
    num: '5',
    title: 'Analisis Data',
    subtitle: 'Pembersihan Data, Visualisasi & Statistik',
    description: 'Mengelola set data mentah (CSV/Excel), melakukan data cleaning, pemfilteran, serta visualisasi grafik statistik yang mudah dipahami.',
    badge: 'PLAYGROUND DATA',
    badgeClass: 'badge-cyan',
    labUrl: '/belajar/informatika/ad',
    labStatus: 'active',
    labBtn: 'Buka Data Playground →',
    topics: ['Pengumpulan & Cleaning Data', 'Pengolahan Statistik Dasar', 'Visualisasi Grafik & Chart']
  },
  {
    code: 'AP',
    num: '6',
    title: 'Algoritma & Pemrograman',
    subtitle: 'Dasar Pemrograman Python di Browser (WASM)',
    description: 'Menulis dan mengeksekusi kode Python 3 secara langsung di browser tanpa instalasi local software, mencakup logika variabel, percabangan, dan perulangan.',
    badge: 'PYTHON WASM SANDBOX',
    badgeClass: 'badge-purple',
    labUrl: '/belajar/informatika/ap',
    labStatus: 'active',
    labBtn: 'Buka Python Sandbox →',
    topics: ['Variabel & Tipe Data Python', 'Percabangan (If-Else)', 'Perulangan (For/While) & Fungsi']
  },
  {
    code: 'DSI',
    num: '7',
    title: 'Dampak Sosial Informatika',
    subtitle: 'Etika Digital, HAKI & Keamanan Informasi',
    description: 'Menganalisis dampak teknologi dalam kehidupan bermasyarakat, etika kewargaan digital, Perlindungan Data Pribadi (PDP), serta Hak Kekayaan Intelektual (HAKI).',
    badge: 'STUDI KASUS ETIKA',
    badgeClass: 'badge-cyan',
    labUrl: '/belajar/informatika/dsi',
    labStatus: 'active',
    labBtn: 'Buka Modul DSI →',
    topics: ['Sejarah Perkembangan Komputer', 'HAKI & Lisensi Software', 'Etika Digital & Profesi IT']
  },
  {
    code: 'PLB',
    num: '8',
    title: 'Praktik Lintas Bidang',
    subtitle: 'Proyek Komputasional Kelompok & Portofolio',
    description: 'Menggabungkan seluruh 7 elemen Informatika untuk menyelesaikan persoalan nyata di sekolah/masyarakat dalam bentuk proyek komputasional kelompok.',
    badge: 'SHOWCASE PROYEK',
    badgeClass: 'badge-gold',
    labUrl: '/belajar/informatika/plb',
    labStatus: 'active',
    labBtn: 'Buka Ruang Proyek →',
    topics: ['Identifikasi Masalah Nyata', 'Perancangan Solusi IT', 'Pengujian & Presentasi Tim']
  }
];
---

<MainLayout
  title="Kurikulum Informatika SMK | Suhendar Aryadi, S.Pd.,Gr."
  description="Platform Pembelajaran & Praktikum Interaktif 8 Elemen Informatika Kelas X SMK Berbasis Kurikulum Merdeka."
>
  <div class="info-catalog-container">
    <!-- Header Banner -->
    <div class="catalog-hero glass-card">
      <div class="hero-content">
        <div class="hero-badge-wrap">
          <span class="badge badge-purple">KURIKULUM MERDEKA SMK — FASE E</span>
          <span class="badge badge-cyan">8 ELEMEN MATERI INTI</span>
        </div>
        <h1 class="catalog-title">
          Mata Pelajaran <span class="text-gradient">Informatika</span>
        </h1>
        <p class="catalog-desc">
          Selamat datang di pusat pembelajaran dan praktikum interaktif <strong>Informatika Kelas X SMK</strong> yang diampu oleh <strong>Suhendar Aryadi, S.Pd.,Gr.</strong> Pelajari konsep komputasi, analisis data, hingga praktik coding Python di browser.
        </p>

        {user ? (
          <div class="user-status-card margin-top">
            <div class="user-info">
              <div class="user-avatar">{user.name.charAt(0).toUpperCase()}</div>
              <div>
                <div class="user-name">Selamat datang kembali, <strong>{user.name}</strong></div>
                <div class="user-progress-text">Kelas / Rombel: <strong>{user.class_name || 'X RPL'}</strong></div>
              </div>
            </div>
            <div class="status-actions">
              <a href="/dashboard" class="btn btn-secondary btn-sm">Dashboard Siswa</a>
            </div>
          </div>
        ) : (
          <div class="auth-prompt-card margin-top">
            <div class="auth-prompt-text">
              <div>
                <strong>Simpan Progres Belajar Anda</strong>
                <p>Login atau daftar akun siswa untuk mengerjakan LKPD Digital dan memantau progres 8 Elemen Informatika.</p>
              </div>
            </div>
            <div class="auth-prompt-buttons">
              <a href="/auth/login" class="btn btn-primary btn-sm">Login Siswa</a>
              <a href="/auth/register" class="btn btn-outline btn-sm">Daftar Akun Baru</a>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- 8 Elements Grid -->
    <div class="elements-grid-title">
      <h2>8 Elemen Utama Pembelajaran Informatika</h2>
      <p>Pilih elemen materi di bawah untuk membuka bahan ajar dan lab praktikum interaktif:</p>
    </div>

    <div class="elements-grid">
      {elements.map((el) => (
        <div class="element-card glass-card">
          <div class="element-header">
            <span class="element-num">ELEMEN {el.num}</span>
            <span class={`badge ${el.badgeClass}`}>{el.badge}</span>
          </div>

          <h3 class="element-title">{el.title}</h3>
          <p class="element-subtitle">{el.subtitle}</p>
          <p class="element-desc">{el.description}</p>

          <div class="topics-list">
            <span class="topics-heading">Topik Utama:</span>
            <ul>
              {el.topics.map(t => (
                <li>{t}</li>
              ))}
            </ul>
          </div>

          <div class="element-footer">
            <a href={el.labUrl} class="btn btn-primary btn-sm btn-lab">
              <span>{el.labBtn}</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</MainLayout>

<style>
  .info-catalog-container {
    max-width: 1140px;
    margin: 1.5rem auto 4rem;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .catalog-hero {
    padding: 2.5rem;
    margin-top: 1rem;
    margin-bottom: 2rem;
    background: radial-gradient(circle at top right, rgba(99, 102, 241, 0.15), transparent 50%), var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
  }

  .hero-badge-wrap {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .catalog-title {
    font-size: 2.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .catalog-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    max-width: 780px;
    line-height: 1.6;
  }

  .teacher-preview-pill {
    background: rgba(99, 102, 241, 0.12);
    border: 1px solid rgba(99, 102, 241, 0.3);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.85rem;
    color: var(--accent-primary);
    font-weight: 600;
    width: fit-content;
  }

  .elements-grid-title h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .elements-grid-title p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  .elements-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
  }

  .element-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }

  .element-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-primary);
  }

  .element-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .element-num {
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 700;
    color: var(--accent-primary);
    letter-spacing: 0.05em;
  }

  .element-title {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .element-subtitle {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .element-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .topics-list {
    background: var(--bg-secondary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    margin-top: auto;
  }

  .topics-heading {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    display: block;
    margin-bottom: 0.35rem;
  }

  .topics-list ul {
    list-style-type: disc;
    padding-left: 1.15rem;
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  .topics-list li {
    margin-bottom: 0.15rem;
  }

  .element-footer {
    margin-top: 0.5rem;
  }

  .btn-lab {
    width: 100%;
    justify-content: center;
  }

  .badge-gold {
    background: rgba(245, 158, 11, 0.15);
    color: #d97706;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }

  .margin-top {
    margin-top: 1.25rem;
  }

  .user-status-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .user-info {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-avatar {
    width: 2.5rem;
    height: 2.5rem;
    min-width: 2.5rem;
    min-height: 2.5rem;
    border-radius: var(--radius-full);
    background: var(--accent-gradient);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }

  .user-name {
    font-size: 1rem;
    color: var(--text-primary);
  }

  .user-progress-text {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .status-actions {
    display: flex;
    justify-content: flex-end;
  }

  .auth-prompt-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: 1.25rem 1.5rem;
    flex-wrap: wrap;
  }

  .auth-prompt-text strong {
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .auth-prompt-text p {
    color: var(--text-secondary);
    font-size: 0.875rem;
    margin-top: 0.2rem;
  }

  .auth-prompt-buttons {
    display: flex;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .catalog-title {
      font-size: 1.75rem;
    }
    .elements-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
