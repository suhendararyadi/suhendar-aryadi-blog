---
import MainLayout from '../../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../../lib/auth';
import { query } from '../../../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login?redirect=/belajar/informatika/bk/lkpd');
}

let existingSubmission: any = null;
try {
  const res = await query(
    `SELECT * FROM lkpd_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (res.rows && res.rows.length > 0) {
    existingSubmission = res.rows[0];
  }
} catch (err) {
  console.warn('Error fetching student submission:', err);
}

const KKM_THRESHOLD = 75;
const isGraded = existingSubmission && existingSubmission.score !== null;
const isKkmPassed = isGraded && existingSubmission.score >= KKM_THRESHOLD;
const isFormLocked = isKkmPassed; // Locked once the score reaches KKM -- resubmission is only for remediation below KKM.

let lkpdDeadlineStr = '';
let isPastDeadline = false;
try {
  const dRes = await query(`SELECT setting_value FROM system_settings WHERE setting_key = 'lkpd_deadline'`);
  if (dRes.rows && dRes.rows.length > 0 && dRes.rows[0].setting_value) {
    lkpdDeadlineStr = dRes.rows[0].setting_value;
    if (new Date() > new Date(lkpdDeadlineStr)) {
      isPastDeadline = true;
    }
  }
} catch (err) {
  console.warn('Error fetching lkpd_deadline setting:', err);
}
---

<MainLayout
  title="LKPD Digital: Berpikir Komputasional | Informatika SMK"
  description="Lembar Kerja Peserta Didik (LKPD) Interaktif Berpikir Komputasional Berbasis 4 Pilar untuk Siswa SMK RPL."
>
  <div class="lkpd-page-container">
    <!-- Top Nav Controls (Hidden on print) -->
    <div class="page-top-nav no-print">
      <a href="/belajar/informatika/bk" class="btn btn-outline btn-sm">
        &larr; Kembali ke Elemen 1 BK
      </a>
      <div class="top-nav-actions">
        <a href="/belajar/informatika/bk/flowchart" class="btn btn-outline btn-sm">
          Lanjut ke LKPD 2 &rarr;
        </a>
        <button id="print-lkpd-btn" class="btn btn-secondary btn-sm" type="button">
          Cetak / Unduh PDF
        </button>
        <span class="badge badge-cyan">LKPD 1 DIGITAL</span>
      </div>
    </div>

    <!-- Deadline Notice Banner -->
    {lkpdDeadlineStr && (
      <div class={`deadline-notice-card glass-card no-print ${isPastDeadline ? 'banner-expired' : 'banner-active'}`}>
        {isPastDeadline ? (
          <div class="deadline-notice-flex">
            <span class="badge badge-red">PENGUMPULAN DITUTUP</span>
            <div>
              <strong class="notice-title">Tenggat Waktu Pengumpulan LKPD Telah Berakhir</strong>
              <p class="notice-desc">
                Batas pengumpulan: {new Date(lkpdDeadlineStr).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB.
                {!existingSubmission && ' Pengajuan formulir LKPD baru telah ditutup oleh Guru.'}
              </p>
            </div>
          </div>
        ) : (
          <div class="deadline-notice-flex">
            <span class="badge badge-cyan">TENGGAT PENGUMPULAN</span>
            <div>
              <strong class="notice-title">Batas Waktu Pengumpulan Tugas</strong>
              <p class="notice-desc">
                Kumpulkan LKPD sebelum: <strong>{new Date(lkpdDeadlineStr).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB</strong>
              </p>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Submitted Task Status Indicator Banner -->
    {existingSubmission && (
      <div class="submitted-status-card glass-card no-print">
        <div class="status-banner-flex">
          <div class="status-left">
            <div class="badge-row">
              <span class="badge badge-success">BERHASIL MENGUMPULKAN TUGAS</span>
              {isGraded ? (
                <span class="badge badge-cyan">SUDAH DINILAI GURU</span>
              ) : (
                <span class="badge badge-amber">MENUNGGU PENILAIAN GURU</span>
              )}
            </div>
            <h3 class="status-title">Tugas LKPD 1 (BK) Terdaftar &amp; Tersimpan</h3>
            <p class="status-sub">
              Dikirim pada: <strong>{new Date(existingSubmission.updated_at).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB</strong>
              | Tim: <strong>{existingSubmission.team_name || 'Mandiri'}</strong>
            </p>
          </div>
          {isGraded && (
            <div class="status-grade-pill">
              <span class="grade-pill-label">NILAI AKHIR</span>
              <span class="grade-pill-value">{existingSubmission.score} / 100</span>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Teacher Evaluation Banner (If Graded) -->
    {isGraded && (
      <div class="grade-banner glass-card no-print">
        <div class={`grade-badge-box ${isKkmPassed ? 'grade-badge-pass' : 'grade-badge-remedial'}`}>
          <span class="grade-label">NILAI AKHIR LKPD</span>
          <span class="grade-score">{existingSubmission.score} / 100</span>
          {isKkmPassed ? (
            <span class="badge badge-success">TUNTAS KKM ({KKM_THRESHOLD})</span>
          ) : (
            <span class="badge badge-amber">BELUM TUNTAS KKM ({KKM_THRESHOLD}) — REMEDIASI</span>
          )}
        </div>
        <div class="grade-feedback-box">
          <strong>Umpan Balik Guru (Suhendar Aryadi, S.Pd.,Gr.):</strong>
          <p>{existingSubmission.teacher_feedback || 'Sangat baik! Pertahankan analisis 4 pilar berpikir komputasional tim kalian.'}</p>
          {!isKkmPassed && (
            <p class="remedial-note">Nilai kamu belum mencapai KKM. Silakan perbaiki jawaban pada form di bawah, lalu kirim ulang untuk dinilai kembali.</p>
          )}
        </div>
      </div>
    )}

    <!-- LKPD Document Body -->
    <div class="lkpd-document-paper" id="lkpd-document">
      <div class="doc-header">
        <div class="header-logo-wrap">
          <div class="doc-badge">SMK RPL</div>
          <div>
            <h1 class="doc-title">LEMBAR KERJA PESERTA DIDIK (LKPD) DIGITAL</h1>
            <p class="doc-sub">Mata Pelajaran Informatika — Elemen 1: Berpikir Komputasional (BK)</p>
          </div>
        </div>
        <div class="doc-meta-right">
          <span>Pengampu: <strong>Suhendar Aryadi, S.Pd.,Gr.</strong></span>
          <span>Siswa Login: <strong>{user.name}</strong></span>
        </div>
      </div>

      <form id="lkpd-form">
        <!-- Part 1: Team & Class Identity -->
        <section class="doc-section">
          <h2 class="section-title">1. IDENTITAS TIM &amp; STUDI KASUS</h2>
          <div class="identity-grid">
            <div class="form-group">
              <label for="team-name">Nama Kelompok / Tim:</label>
              <input type="text" id="team-name" class="doc-input" placeholder="Misal: Tim Cypher RPL 1" value={existingSubmission?.team_name || ''} required />
            </div>
            <div class="form-group">
              <label for="class-identity">Kelas &amp; Rombel:</label>
              <input type="text" class="doc-input" value={user.class_name || 'X RPL'} readonly />
            </div>
          </div>

          <div class="form-group margin-top">
            <label for="case-study-select">Pilih Studi Kasus Sistem Perangkat Lunak:</label>
            <select id="case-study-select" class="doc-select">
              <option value="kiosk" selected={existingSubmission?.case_study_id === 'kiosk'}>Studi Kasus A: Kiosk Self-Service Restoran (FoodExpress)</option>
              <option value="ekantin" selected={existingSubmission?.case_study_id === 'ekantin'}>Studi Kasus B: Marketplace E-Kantin Sekolah (E-Kantin RPL)</option>
              <option value="klinik" selected={existingSubmission?.case_study_id === 'klinik'}>Studi Kasus C: Sistem Antrean Klinik Digital (SmartKlinik)</option>
              <option value="custom" selected={existingSubmission?.case_study_id === 'custom'}>Studi Kasus D: Proyek Perangkat Lunak Mandiri Tim</option>
            </select>
          </div>
        </section>

        <!-- Part 2: 4 Pillars Worksheet -->
        <section class="doc-section">
          <h2 class="section-title">2. AKTIVITAS ANALISIS 4 PILAR BERPIKIR KOMPUTASIONAL</h2>

          <!-- 2.1 Dekomposisi -->
          <div class="pillar-box">
            <h3 class="pillar-heading">2.1 Dekomposisi (Decomposition)</h3>
            <p class="pillar-instruction">Pecahlah sistem pilihan kalian menjadi 4 modul/sub-sistem kecil beserta fungsi utamanya:</p>
            <table class="doc-table">
              <thead>
                <tr>
                  <th style="width: 60px;">No</th>
                  <th style="width: 240px;">Nama Modul / Sub-Sistem</th>
                  <th>Fungsi Utama &amp; Fitur di Dalam Modul</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="text-center">1</td>
                  <td><textarea id="deco-mod-1" class="doc-table-input" rows="2" placeholder="Misal: Modul Katalog Menu"></textarea></td>
                  <td><textarea id="deco-func-1" class="doc-table-input" rows="2" placeholder="Menampilkan daftar makanan, foto, dan filter harga"></textarea></td>
                </tr>
                <tr>
                  <td class="text-center">2</td>
                  <td><textarea id="deco-mod-2" class="doc-table-input" rows="2" placeholder="Misal: Modul Antrean &amp; Dapur"></textarea></td>
                  <td><textarea id="deco-func-2" class="doc-table-input" rows="2" placeholder="Mengatur nomor urut pesanan sesuai kedatangan (Queue)"></textarea></td>
                </tr>
                <tr>
                  <td class="text-center">3</td>
                  <td><textarea id="deco-mod-3" class="doc-table-input" rows="2" placeholder="Misal: Modul Keranjang &amp; Checkout"></textarea></td>
                  <td><textarea id="deco-func-3" class="doc-table-input" rows="2" placeholder="Merekam daftar belanja dan menghitung total harga"></textarea></td>
                </tr>
                <tr>
                  <td class="text-center">4</td>
                  <td><textarea id="deco-mod-4" class="doc-table-input" rows="2" placeholder="Misal: Modul Pembayaran Digital"></textarea></td>
                  <td><textarea id="deco-func-4" class="doc-table-input" rows="2" placeholder="Integrasi saldo/QRIS dan mencetak struk transaksi"></textarea></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- 2.2 Pengenalan Pola -->
          <div class="pillar-box margin-top">
            <h3 class="pillar-heading">2.2 Pengenalan Pola (Pattern Recognition)</h3>
            <p class="pillar-instruction">Identifikasi pola kesamaan atau alur kerja berulang yang ada di dalam sistem:</p>
            <table class="doc-table">
              <thead>
                <tr>
                  <th style="width: 60px;">No</th>
                  <th style="width: 280px;">Pola / Kemiripan Masalah Ditemukan</th>
                  <th>Rencana Penerapan Solusi Berulang dalam Sistem</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td class="text-center">1</td>
                  <td><textarea id="patt-name-1" class="doc-table-input" rows="2" placeholder="Alur Autentikasi / Login Siswa &amp; Guru"></textarea></td>
                  <td><textarea id="patt-sol-1" class="doc-table-input" rows="2" placeholder="Membuat 1 fungsi terpusat validasi password &amp; token session"></textarea></td>
                </tr>
                <tr>
                  <td class="text-center">2</td>
                  <td><textarea id="patt-name-2" class="doc-table-input" rows="2" placeholder="Fitur Pencarian Data Menu &amp; Pasien"></textarea></td>
                  <td><textarea id="patt-sol-2" class="doc-table-input" rows="2" placeholder="Memakai algoritma searching terstandar untuk pencarian kata kunci"></textarea></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- 2.3 Abstraksi -->
          <div class="pillar-box margin-top">
            <h3 class="pillar-heading">2.3 Abstraksi (Abstraction)</h3>
            <div class="form-group">
              <label for="abs-kept"><strong>Data / Atribut Utama yang WAJIB Disimpan dalam Database:</strong></label>
              <textarea id="abs-kept" class="doc-textarea" rows="2" placeholder="ID Transaksi, Nama Pelanggan, Daftar Menu Dibelanja, Total Bayar, Waktu Transaksi"></textarea>
            </div>
            <div class="form-group margin-top">
              <label for="abs-ignored"><strong>Detail Informasi yang DIABSTRAKSIKAN (Diabaikan):</strong></label>
              <textarea id="abs-ignored" class="doc-textarea" rows="2" placeholder="Warna baju pembeli, jenis sepatu, suasana hati pelanggan saat memesan"></textarea>
            </div>
          </div>

          <!-- 2.4 Perancangan Algoritma -->
          <div class="pillar-box margin-top">
            <h3 class="pillar-heading">2.4 Perancangan Algoritma &amp; Struktur Data</h3>

            <div class="grid-2col">
              <div class="form-group">
                <label for="alg-search">Algoritma Searching Yang Dipilih:</label>
                <select id="alg-search" class="doc-select">
                  <option value="Linear Search">Linear Search (Pencarian Berurutan)</option>
                  <option value="Binary Search">Binary Search (Pencarian Bagi Dua - Data Terurut)</option>
                </select>
              </div>
              <div class="form-group">
                <label for="alg-sort">Algoritma Sorting Yang Dipilih:</label>
                <select id="alg-sort" class="doc-select">
                  <option value="Bubble Sort">Bubble Sort (Pengurutan Gelembung)</option>
                  <option value="Selection Sort">Selection Sort (Pengurutan Minimum)</option>
                  <option value="Quick Sort">Quick Sort (Pengurutan Cepat)</option>
                </select>
              </div>
            </div>

            <div class="grid-2col margin-top">
              <div class="form-group">
                <label for="alg-queue-use">Penerapan Queue (FIFO - First In First Out):</label>
                <textarea id="alg-queue-use" class="doc-input" rows="2" placeholder="Manajemen Antrean Pesanan Dapur / Nomor Berobat Pasien"></textarea>
              </div>
              <div class="form-group">
                <label for="alg-stack-use">Penerapan Stack (LIFO - Last In First Out):</label>
                <textarea id="alg-stack-use" class="doc-input" rows="2" placeholder="Fitur Undo / Redo Pembatalan Transaksi Kasir"></textarea>
              </div>
            </div>

            <div class="form-group margin-top">
              <label for="alg-pseudocode"><strong>Pseudocode / Notasi Algoritma Alur Utama Sistem:</strong></label>
              <textarea id="alg-pseudocode" class="doc-textarea font-mono" rows="6" placeholder="ALGORITMA Proses_Pemesanan_Kantin
START
  INPUT id_menu, jumlah
  CEK stok_menu
  IF stok_menu >= jumlah THEN
     Hitung total_bayar
     Potong saldo_siswa
     MASUKKAN antrean_dapur (QUEUE)
  ELSE
     TAMPILKAN 'Stok Tidak Cukup'
  ENDIF
END"></textarea>
            </div>
          </div>
        </section>

        <!-- Submit Button (Hidden on print) -->
        <div class="doc-actions no-print">
          {isFormLocked ? (
            <button id="submit-lkpd-btn" class="btn btn-secondary btn-lg btn-disabled" type="button" disabled title={`Nilai sudah mencapai KKM ${KKM_THRESHOLD}, pengumpulan ulang tidak diperlukan`}>
              ✓ Tugas Tuntas KKM — Pengumpulan Ulang Tidak Diperlukan
            </button>
          ) : isPastDeadline ? (
            <button id="submit-lkpd-btn" class="btn btn-secondary btn-lg btn-disabled" type="button" disabled>
              Pengumpulan Ditutup (Batas Waktu Berakhir)
            </button>
          ) : isGraded ? (
            <button id="submit-lkpd-btn" class="btn btn-primary btn-lg" type="submit">
              Kirim Ulang untuk Remediasi (Belum Tuntas KKM)
            </button>
          ) : (
            <button id="submit-lkpd-btn" class="btn btn-primary btn-lg" type="submit">
              Kirim Tugas LKPD ke LMS Guru
            </button>
          )}
        </div>
      </form>
    <!-- Success Notification Modal -->
    <div id="submit-success-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card glass-card text-center" style="max-width: 460px;">
        <div class="modal-success-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <h2 class="modal-title margin-top-sm">Pengumpulan Berhasil!</h2>
        <p class="modal-sub margin-top-xs" style="color: var(--text-secondary); font-size: 0.925rem; line-height: 1.5;">
          Tugas <strong>LKPD 1 Berpikir Komputasional</strong> tim Anda telah berhasil terkirim dan tersimpan di LMS Guru (Pak Suhendar Aryadi, S.Pd.,Gr.).
        </p>
        <div class="margin-top">
          <button id="success-modal-close-btn" class="btn btn-primary btn-full" type="button">
            Selesai &amp; Lihat Status Tugas
          </button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ existingSubmission, isPastDeadline, isFormLocked, kkmThreshold: KKM_THRESHOLD }}>
  document.addEventListener('DOMContentLoaded', () => {
    const printBtn = document.getElementById('print-lkpd-btn');
    const form = document.getElementById('lkpd-form');

    // Anti-Paste & Anti-Drop Protection for all LKPD answer inputs & textareas
    const lkpdFields = document.querySelectorAll('#lkpd-form input, #lkpd-form textarea');
    lkpdFields.forEach((field) => {
      field.addEventListener('paste', (e) => {
        e.preventDefault();
        alert('⚠️ Fitur Paste Dinonaktifkan! Siswa diwajibkan mengetik hasil analisis LKPD secara langsung untuk melatih pemahaman mendalam.');
        return false;
      });
      field.addEventListener('drop', (e) => {
        e.preventDefault();
        return false;
      });
    });

    // Populate existing fields if available
    if (existingSubmission) {
      try {
        const deco = JSON.parse(existingSubmission.decomposition_json || '[]');
        if (deco[0]) { document.getElementById('deco-mod-1').value = deco[0].mod || ''; document.getElementById('deco-func-1').value = deco[0].func || ''; }
        if (deco[1]) { document.getElementById('deco-mod-2').value = deco[1].mod || ''; document.getElementById('deco-func-2').value = deco[1].func || ''; }
        if (deco[2]) { document.getElementById('deco-mod-3').value = deco[2].mod || ''; document.getElementById('deco-func-3').value = deco[2].func || ''; }
        if (deco[3]) { document.getElementById('deco-mod-4').value = deco[3].mod || ''; document.getElementById('deco-func-4').value = deco[3].func || ''; }

        const patt = JSON.parse(existingSubmission.pattern_json || '[]');
        if (patt[0]) { document.getElementById('patt-name-1').value = patt[0].name || ''; document.getElementById('patt-sol-1').value = patt[0].sol || ''; }
        if (patt[1]) { document.getElementById('patt-name-2').value = patt[1].name || ''; document.getElementById('patt-sol-2').value = patt[1].sol || ''; }

        const abs = JSON.parse(existingSubmission.abstraction_json || '{}');
        document.getElementById('abs-kept').value = abs.kept || '';
        document.getElementById('abs-ignored').value = abs.ignored || '';

        const alg = JSON.parse(existingSubmission.algorithm_json || '{}');
        document.getElementById('alg-search').value = alg.search || 'Linear Search';
        document.getElementById('alg-sort').value = alg.sort || 'Bubble Sort';
        document.getElementById('alg-queue-use').value = alg.queue || '';
        document.getElementById('alg-stack-use').value = alg.stack || '';
        document.getElementById('alg-pseudocode').value = alg.pseudocode || '';
      } catch (err) {
        console.warn('Error parsing submission data:', err);
      }
    }

    printBtn?.addEventListener('click', () => {
      window.print();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (isFormLocked) {
        alert(`Nilai kamu sudah mencapai KKM (${kkmThreshold}). Pengumpulan ulang tidak diperlukan dan telah dikunci oleh sistem.`);
        return;
      }

      if (isPastDeadline) {
        alert('Pengumpulan Ditutup! Batas waktu (deadline) pengumpulan LKPD dari Guru telah berakhir.');
        return;
      }

      const caseStudyId = document.getElementById('case-study-select').value;
      const teamName = document.getElementById('team-name').value;

      const decomposition = [
        { mod: document.getElementById('deco-mod-1').value, func: document.getElementById('deco-func-1').value },
        { mod: document.getElementById('deco-mod-2').value, func: document.getElementById('deco-func-2').value },
        { mod: document.getElementById('deco-mod-3').value, func: document.getElementById('deco-func-3').value },
        { mod: document.getElementById('deco-mod-4').value, func: document.getElementById('deco-func-4').value }
      ];

      const pattern = [
        { name: document.getElementById('patt-name-1').value, sol: document.getElementById('patt-sol-1').value },
        { name: document.getElementById('patt-name-2').value, sol: document.getElementById('patt-sol-2').value }
      ];

      const abstraction = {
        kept: document.getElementById('abs-kept').value,
        ignored: document.getElementById('abs-ignored').value
      };

      const algorithm = {
        search: document.getElementById('alg-search').value,
        sort: document.getElementById('alg-sort').value,
        queue: document.getElementById('alg-queue-use').value,
        stack: document.getElementById('alg-stack-use').value,
        pseudocode: document.getElementById('alg-pseudocode').value
      };

      const submitBtn = document.getElementById('submit-lkpd-btn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Mengirim LKPD...';

      try {
        const res = await fetch('/api/lkpd/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            caseStudyId,
            teamName,
            teamMembers: [],
            decomposition,
            pattern,
            abstraction,
            algorithm
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          const modal = document.getElementById('submit-success-modal');
          const closeBtn = document.getElementById('success-modal-close-btn');
          if (modal) {
            modal.style.display = 'flex';
            closeBtn?.addEventListener('click', () => {
              window.location.reload();
            });
          } else {
            alert('✅ ' + data.message);
            window.location.reload();
          }
        } else {
          alert('❌ Gagal: ' + (data.error || 'Terjadi kesalahan.'));
        }
      } catch (err) {
        alert('❌ Error koneksi ke server.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Kirim Tugas LKPD ke LMS Guru';
      }
    });
  });
</script>

<style>
  .lkpd-page-container {
    max-width: 1040px;
    margin: 1.5rem auto 4rem;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Deadline Notice Banner */
  .deadline-notice-card {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-xl);
  }

  .banner-active {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
    border: 1px solid rgba(14, 165, 233, 0.3);
