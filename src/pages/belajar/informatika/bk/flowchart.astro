---
import MainLayout from '../../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../../lib/auth';
import { query } from '../../../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login?redirect=/belajar/informatika/bk/flowchart');
}

let existingSubmission: any = null;
try {
  const res = await query(
    `SELECT * FROM lkpd_flowchart_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (res.rows && res.rows.length > 0) {
    existingSubmission = res.rows[0];
  }
} catch (err) {
  console.warn('Error fetching student flowchart submission:', err);
}

const KKM_THRESHOLD = 75;
const isGraded = existingSubmission && existingSubmission.score !== null;
const isKkmPassed = isGraded && existingSubmission.score >= KKM_THRESHOLD;
const isFormLocked = isKkmPassed; // Locked once the score reaches KKM -- resubmission is only for remediation below KKM.

let lkpdDeadlineStr = '';
let isPastDeadline = false;
try {
  const dRes = await query(`SELECT setting_value FROM system_settings WHERE setting_key = 'lkpd_deadline'`);
  if (dRes.rows && dRes.rows.length > 0 && dRes.rows[0].setting_value) {
    lkpdDeadlineStr = dRes.rows[0].setting_value;
    if (new Date() > new Date(lkpdDeadlineStr)) {
      isPastDeadline = true;
    }
  }
} catch (err) {
  console.warn('Error fetching lkpd_deadline setting:', err);
}

// Flowchart symbol palette (same 4 ANSI symbols introduced in the deep-dive material)
const flowchartPalette = [
  { shape: 'terminal', label: 'Terminal', hint: 'Awal / Akhir alur' },
  { shape: 'io', label: 'Input/Output', hint: 'Input atau tampilkan data' },
  { shape: 'process', label: 'Proses', hint: 'Langkah pengolahan data' },
  { shape: 'decision', label: 'Decision', hint: 'Percabangan kondisi Ya/Tidak' }
];
---

<MainLayout
  title="LKPD 2 Digital: Perancangan Algoritma (Flowchart & Pseudocode) | Informatika SMK"
  description="Lembar Kerja Peserta Didik (LKPD) 2 Interaktif -- susun flowchart secara visual dan tuliskan pseudocode untuk melatih Perancangan Algoritma."
>
  <div class="lkpd-page-container">
    <!-- Top Nav Controls (Hidden on print) -->
    <div class="page-top-nav no-print">
      <a href="/belajar/informatika/bk" class="btn btn-outline btn-sm">
        &larr; Kembali ke Elemen 1 BK
      </a>
      <div class="top-nav-actions">
        <a href="/belajar/informatika/bk/lkpd" class="btn btn-outline btn-sm">
          &larr; LKPD 1
        </a>
        <button id="print-lkpd-btn" class="btn btn-secondary btn-sm" type="button">
          Cetak / Unduh PDF
        </button>
        <span class="badge badge-purple">LKPD 2 DIGITAL</span>
      </div>
    </div>

    <!-- Deadline Notice Banner -->
    {lkpdDeadlineStr && (
      <div class={`deadline-notice-card glass-card no-print ${isPastDeadline ? 'banner-expired' : 'banner-active'}`}>
        {isPastDeadline ? (
          <div class="deadline-notice-flex">
            <span class="badge badge-red">PENGUMPULAN DITUTUP</span>
            <div>
              <strong class="notice-title">Tenggat Waktu Pengumpulan LKPD Telah Berakhir</strong>
              <p class="notice-desc">
                Batas pengumpulan: {new Date(lkpdDeadlineStr).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB.
                {!existingSubmission && ' Pengajuan formulir LKPD baru telah ditutup oleh Guru.'}
              </p>
            </div>
          </div>
        ) : (
          <div class="deadline-notice-flex">
            <span class="badge badge-cyan">TENGGAT PENGUMPULAN</span>
            <div>
              <strong class="notice-title">Batas Waktu Pengumpulan Tugas</strong>
              <p class="notice-desc">
                Kumpulkan LKPD sebelum: <strong>{new Date(lkpdDeadlineStr).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB</strong>
              </p>
            </div>
          </div>
        )}
      </div>
    )}

    <!-- Submitted Task Status Indicator Banner -->
    {existingSubmission && (
      <div class="submitted-status-card glass-card no-print">
        <div class="status-banner-flex">
          <div class="status-left">
            <div class="badge-row">
              <span class="badge badge-success">✓ BERHASIL MENGUMPULKAN TUGAS</span>
              {isGraded ? (
                <span class="badge badge-purple">SUDAH DINILAI GURU</span>
              ) : (
                <span class="badge badge-amber">MENUNGGU PENILAIAN GURU</span>
              )}
            </div>
            <h3 class="status-title">Tugas LKPD 2 (Flowchart &amp; Pseudocode) Terdaftar &amp; Tersimpan</h3>
            <p class="status-sub">
              Dikirim pada: <strong>{new Date(existingSubmission.updated_at).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB</strong>
              | Tim: <strong>{existingSubmission.team_name || 'Mandiri'}</strong>
            </p>
          </div>
          {isGraded && (
            <div class="status-grade-pill">
              <span class="grade-pill-label">NILAI AKHIR</span>
              <span class="grade-pill-value">{existingSubmission.score} / 100</span>
            </div>
          )}
        </div>
      </div>
    )}

    <!-- Teacher Evaluation Banner (If Graded) -->
    {isGraded && (
      <div class="grade-banner glass-card no-print">
        <div class={`grade-badge-box ${isKkmPassed ? 'grade-badge-pass' : 'grade-badge-remedial'}`}>
          <span class="grade-label">NILAI AKHIR LKPD</span>
          <span class="grade-score">{existingSubmission.score} / 100</span>
          {isKkmPassed ? (
            <span class="badge badge-success">✓ TUNTAS KKM ({KKM_THRESHOLD})</span>
          ) : (
            <span class="badge badge-amber">BELUM TUNTAS KKM ({KKM_THRESHOLD}) — REMEDIASI</span>
          )}
        </div>
        <div class="grade-feedback-box">
          <strong>Umpan Balik Guru (Suhendar Aryadi, S.Pd.,Gr.):</strong>
          <p>{existingSubmission.teacher_feedback || 'Sangat baik! Pertahankan alur logika flowchart dan pseudocode tim kalian.'}</p>
          {!isKkmPassed && (
            <p class="remedial-note">Nilai kamu belum mencapai KKM. Silakan perbaiki flowchart/pseudocode pada workspace di bawah, lalu kirim ulang untuk dinilai kembali.</p>
          )}
        </div>
      </div>
    )}

    <!-- LKPD Document Body -->
    <div class="lkpd-document-paper" id="lkpd-document">
      <div class="doc-header">
        <div class="header-logo-wrap">
          <div class="doc-badge">SMK RPL</div>
          <div>
            <h1 class="doc-title">LEMBAR KERJA PESERTA DIDIK (LKPD) DIGITAL 2</h1>
            <p class="doc-sub">Mata Pelajaran Informatika — Elemen 1: Perancangan Algoritma (Flowchart &amp; Pseudocode)</p>
          </div>
        </div>
        <div class="doc-meta-right">
          <span>Pengampu: <strong>Suhendar Aryadi, S.Pd.,Gr.</strong></span>
          <span>Siswa Login: <strong>{user.name}</strong></span>
        </div>
      </div>

      <form id="lkpd-form">
        <!-- Part 1: Team & Case Study Identity -->
        <section class="doc-section">
          <h2 class="section-title">1. IDENTITAS TIM &amp; STUDI KASUS</h2>
          <div class="identity-grid">
            <div class="form-group">
              <label for="team-name">Nama Kelompok / Tim:</label>
              <input type="text" id="team-name" class="doc-input" placeholder="Misal: Tim Cypher RPL 1" value={existingSubmission?.team_name || ''} required />
            </div>
            <div class="form-group">
              <label for="class-identity">Kelas &amp; Rombel:</label>
              <input type="text" class="doc-input" value={user.class_name || 'X RPL'} readonly />
            </div>
          </div>

          <div class="form-group margin-top">
            <label for="case-study-select">Pilih Studi Kasus Sistem Perangkat Lunak:</label>
            <select id="case-study-select" class="doc-select">
              <option value="kiosk" selected={existingSubmission?.case_study_id === 'kiosk'}>Studi Kasus A: Kiosk Self-Service Restoran (FoodExpress)</option>
              <option value="ekantin" selected={existingSubmission?.case_study_id === 'ekantin'}>Studi Kasus B: Marketplace E-Kantin Sekolah (E-Kantin RPL)</option>
              <option value="klinik" selected={existingSubmission?.case_study_id === 'klinik'}>Studi Kasus C: Sistem Antrean Klinik Digital (SmartKlinik)</option>
              <option value="custom" selected={existingSubmission?.case_study_id === 'custom'}>Studi Kasus D: Proyek Perangkat Lunak Mandiri Tim</option>
            </select>
          </div>
        </section>

        <!-- Part 2: Flowchart Builder Workspace -->
        <section class="doc-section">
          <h2 class="section-title">2. WORKSPACE PENYUSUNAN FLOWCHART</h2>
          <p class="pillar-instruction">
            Klik salah satu simbol pada palet di bawah untuk menambahkannya ke susunan flowchart. Isikan teks/label untuk tiap simbol, lalu atur urutannya menggunakan tombol naik/turun. Susun alur logika lengkap dari studi kasus yang kalian pilih (minimal 5 simbol, wajib mengandung minimal 1 Decision).
          </p>

          <div class="flowchart-builder">
            <!-- Symbol Palette -->
            <div class="flow-palette">
              <span class="flow-palette-label">Palet Simbol (Klik untuk Tambah)</span>
              <div class="flow-palette-grid">
                {flowchartPalette.map(p => (
                  <button type="button" class="flow-palette-btn" data-shape={p.shape} title={p.hint}>
                    <span class={`flow-shape flow-shape-${p.shape} flow-shape-sm`}><span>{p.label}</span></span>
                  </button>
                ))}
              </div>
            </div>

            <!-- Canvas: Assembled Flowchart -->
            <div class="flow-canvas-wrap">
              <span class="flow-palette-label">Susunan Flowchart Kalian</span>
              <div id="flow-canvas" class="flow-canvas">
                <p class="flow-canvas-empty" id="flow-canvas-empty">Belum ada simbol. Klik palet di sebelah kiri untuk mulai menyusun.</p>
              </div>
            </div>
          </div>

          <!-- Hidden input carrying the serialized flowchart JSON, submitted with the form -->
          <input type="hidden" id="flowchart-data" name="flowchart-data" />
        </section>

        <!-- Part 3: Pseudocode Workspace (same format as LKPD 1) -->
        <section class="doc-section">
          <h2 class="section-title">3. WORKSPACE PENULISAN PSEUDOCODE</h2>
          <div class="pillar-box">
            <h3 class="pillar-heading">Pseudocode / Notasi Algoritma Alur Utama Sistem</h3>
            <p class="pillar-instruction">Tuliskan pseudocode yang merepresentasikan flowchart yang sudah kalian susun di atas:</p>
            <div class="form-group">
              <textarea id="alg-pseudocode" class="doc-textarea font-mono" rows="10" placeholder="ALGORITMA Proses_Pemesanan_Kantin
START
  INPUT id_menu, jumlah
  CEK stok_menu
  IF stok_menu >= jumlah THEN
     Hitung total_bayar
     Potong saldo_siswa
     MASUKKAN antrean_dapur (QUEUE)
  ELSE
     TAMPILKAN 'Stok Tidak Cukup'
  ENDIF
END">{existingSubmission?.pseudocode_text || ''}</textarea>
            </div>
          </div>
        </section>

        <!-- Submit Button (Hidden on print) -->
        <div class="doc-actions no-print">
          {isFormLocked ? (
            <button id="submit-lkpd-btn" class="btn btn-secondary btn-lg btn-disabled" type="button" disabled title={`Nilai sudah mencapai KKM ${KKM_THRESHOLD}, pengumpulan ulang tidak diperlukan`}>
              ✓ Tugas Tuntas KKM — Pengumpulan Ulang Tidak Diperlukan
            </button>
          ) : isPastDeadline ? (
            <button id="submit-lkpd-btn" class="btn btn-secondary btn-lg btn-disabled" type="button" disabled>
              Pengumpulan Ditutup (Batas Waktu Berakhir)
            </button>
          ) : isGraded ? (
            <button id="submit-lkpd-btn" class="btn btn-primary btn-lg" type="submit">
              Kirim Ulang untuk Remediasi (Belum Tuntas KKM)
            </button>
          ) : (
            <button id="submit-lkpd-btn" class="btn btn-primary btn-lg" type="submit">
              Kirim Tugas LKPD 2 ke LMS Guru
            </button>
          )}
        </div>
      </form>
    <!-- Success Notification Modal -->
    <div id="submit-success-modal" class="modal-backdrop" style="display: none;">
      <div class="modal-card glass-card text-center" style="max-width: 460px;">
        <div class="modal-success-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
            <polyline points="22 4 12 14.01 9 11.01"></polyline>
          </svg>
        </div>
        <h2 class="modal-title margin-top-sm">Pengumpulan Berhasil!</h2>
        <p class="modal-sub margin-top-xs" style="color: var(--text-secondary); font-size: 0.925rem; line-height: 1.5;">
          Tugas <strong>LKPD 2 Flowchart &amp; Pseudocode</strong> tim Anda telah berhasil terkirim dan tersimpan di LMS Guru (Pak Suhendar Aryadi, S.Pd.,Gr.).
        </p>
        <div class="margin-top">
          <button id="success-modal-close-btn" class="btn btn-primary btn-full" type="button">
            Selesai &amp; Lihat Status Tugas
          </button>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ existingFlowchartJson: existingSubmission?.flowchart_json || '[]', isPastDeadline, isFormLocked, kkmThreshold: KKM_THRESHOLD }}>
  document.addEventListener('DOMContentLoaded', () => {
    const printBtn = document.getElementById('print-lkpd-btn');
    const form = document.getElementById('lkpd-form');

    // Anti-Paste Protection for text inputs (consistent with LKPD 1)
    const lkpdFields = document.querySelectorAll('#lkpd-form input[type="text"], #lkpd-form textarea');
    lkpdFields.forEach((field) => {
      field.addEventListener('paste', (e) => {
        e.preventDefault();
        alert('⚠️ Fitur Paste Dinonaktifkan! Siswa diwajibkan mengetik/menyusun hasil analisis LKPD secara langsung untuk melatih pemahaman mendalam.');
        return false;
      });
      field.addEventListener('drop', (e) => {
        e.preventDefault();
        return false;
      });
    });

    // ===== Flowchart Builder Logic =====
    const flowCanvas = document.getElementById('flow-canvas');
    const flowCanvasEmpty = document.getElementById('flow-canvas-empty');
    const flowDataInput = document.getElementById('flowchart-data');
    const paletteBtns = document.querySelectorAll('.flow-palette-btn');

    const shapeLabels = { terminal: 'Terminal', io: 'Input/Output', process: 'Proses', decision: 'Decision' };

    let flowItems = [];
    try {
      flowItems = JSON.parse(existingFlowchartJson || '[]');
      if (!Array.isArray(flowItems)) flowItems = [];
    } catch (e) {
      flowItems = [];
    }

    function renderFlowCanvas() {
      // Clear canvas except the empty-state placeholder
      flowCanvas.innerHTML = '';

      if (flowItems.length === 0) {
        flowCanvas.appendChild(flowCanvasEmpty);
        flowDataInput.value = '[]';
        return;
      }

      flowItems.forEach((item, idx) => {
        const row = document.createElement('div');
        row.className = 'flow-canvas-item';

        const shapeEl = document.createElement('div');
        shapeEl.className = `flow-shape flow-shape-${item.shape} flow-shape-sm flow-shape-editable`;
        const shapeSpan = document.createElement('span');
        shapeSpan.textContent = item.text || `(${shapeLabels[item.shape] || item.shape})`;
        shapeEl.appendChild(shapeSpan);

        const controls = document.createElement('div');
        controls.className = 'flow-item-controls';

        const editBtn = document.createElement('button');
        editBtn.type = 'button';
        editBtn.className = 'flow-ctrl-btn';
        editBtn.title = 'Edit teks';
        editBtn.textContent = '✏️';
        editBtn.addEventListener('click', () => {
          const newText = prompt(`Isi teks untuk simbol ${shapeLabels[item.shape] || item.shape}:`, item.text || '');
          if (newText !== null) {
            flowItems[idx].text = newText.trim();
            renderFlowCanvas();
          }
        });

        const upBtn = document.createElement('button');
        upBtn.type = 'button';
        upBtn.className = 'flow-ctrl-btn';
        upBtn.title = 'Naikkan urutan';
        upBtn.textContent = '↑';
        upBtn.disabled = idx === 0;
        upBtn.addEventListener('click', () => {
          if (idx > 0) {
            [flowItems[idx - 1], flowItems[idx]] = [flowItems[idx], flowItems[idx - 1]];
            renderFlowCanvas();
          }
        });

        const downBtn = document.createElement('button');
        downBtn.type = 'button';
        downBtn.className = 'flow-ctrl-btn';
        downBtn.title = 'Turunkan urutan';
        downBtn.textContent = '↓';
        downBtn.disabled = idx === flowItems.length - 1;
        downBtn.addEventListener('click', () => {
          if (idx < flowItems.length - 1) {
            [flowItems[idx + 1], flowItems[idx]] = [flowItems[idx], flowItems[idx + 1]];
            renderFlowCanvas();
          }
        });

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'flow-ctrl-btn flow-ctrl-delete';
        delBtn.title = 'Hapus simbol';
        delBtn.textContent = '✕';
        delBtn.addEventListener('click', () => {
          flowItems.splice(idx, 1);
          renderFlowCanvas();
        });

        controls.appendChild(editBtn);
        controls.appendChild(upBtn);
        controls.appendChild(downBtn);
        controls.appendChild(delBtn);

        row.appendChild(shapeEl);
        row.appendChild(controls);
        flowCanvas.appendChild(row);

        if (idx < flowItems.length - 1) {
          const arrow = document.createElement('div');
          arrow.className = 'flow-arrow-down';
          arrow.innerHTML = '&darr;';
          flowCanvas.appendChild(arrow);
        }
      });

      flowDataInput.value = JSON.stringify(flowItems);
    }

    paletteBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const shape = btn.getAttribute('data-shape');
        const text = prompt(`Isi teks/label untuk simbol ${shapeLabels[shape] || shape}:`, '');
        if (text === null) return; // user cancelled
        flowItems.push({ shape, text: text.trim() });
        renderFlowCanvas();
      });
    });

    renderFlowCanvas();

    printBtn?.addEventListener('click', () => {
      window.print();
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (isFormLocked) {
        alert(`Nilai kamu sudah mencapai KKM (${kkmThreshold}). Pengumpulan ulang tidak diperlukan dan telah dikunci oleh sistem.`);
        return;
      }

      if (isPastDeadline) {
        alert('Pengumpulan Ditutup! Batas waktu (deadline) pengumpulan LKPD dari Guru telah berakhir.');
        return;
      }

      if (flowItems.length < 5) {
        alert('⚠️ Susunan flowchart minimal harus terdiri dari 5 simbol. Tambahkan lebih banyak simbol sebelum mengirim.');
        return;
      }

      const hasDecision = flowItems.some((it) => it.shape === 'decision');
      if (!hasDecision) {
        alert('⚠️ Flowchart wajib mengandung minimal 1 simbol Decision (percabangan kondisi).');
        return;
      }

      const caseStudyId = document.getElementById('case-study-select').value;
      const teamName = document.getElementById('team-name').value;
      const pseudocode = document.getElementById('alg-pseudocode').value;

      const submitBtn = document.getElementById('submit-lkpd-btn');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Mengirim LKPD...';

      try {
        const res = await fetch('/api/lkpd/submit-flowchart', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            caseStudyId,
            teamName,
            flowchart: flowItems,
            pseudocode
          })
        });

        const data = await res.json();
        if (res.ok && data.success) {
          const modal = document.getElementById('submit-success-modal');
          const closeBtn = document.getElementById('success-modal-close-btn');
          if (modal) {
            modal.style.display = 'flex';
            closeBtn?.addEventListener('click', () => {
              window.location.reload();
            });
          } else {
            alert('✅ ' + data.message);
            window.location.reload();
          }
        } else {
          alert('❌ Gagal: ' + (data.error || 'Terjadi kesalahan.'));
        }
      } catch (err) {
        alert('❌ Error koneksi ke server.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = 'Kirim Tugas LKPD 2 ke LMS Guru';
      }
    });
  });
</script>

<style>
  .lkpd-page-container {
    max-width: 1040px;
    margin: 1.5rem auto 4rem;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .top-nav-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Deadline Notice Banner */
  .deadline-notice-card {
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-xl);
  }

  .banner-active {
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1) 0%, rgba(59, 130, 246, 0.1) 100%);
    border: 1px solid rgba(14, 165, 233, 0.3);
  }

  .banner-expired {
    background: linear-gradient(135deg, rgba(239, 68, 68, 0.12) 0%, rgba(220, 38, 38, 0.12) 100%);
    border: 1px solid rgba(239, 68, 68, 0.3);
  }

  .deadline-notice-flex {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .notice-title {
    font-size: 1.05rem;
    color: var(--text-primary);
    display: block;
  }

  .notice-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-top: 0.15rem;
  }

  .badge-red {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border-color: rgba(239, 68, 68, 0.3);
  }

  .btn-disabled {
    opacity: 0.65;
    cursor: not-allowed;
  }

  /* Grade Banner */
  .grade-banner {
    padding: 1.25rem 1.75rem;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.12) 0%, rgba(5, 150, 105, 0.12) 100%);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--radius-xl);
  }

  .grade-badge-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: #10b981;
    color: #ffffff;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-lg);
    min-width: 140px;
  }

  .grade-badge-remedial {
    background: #d97706;
  }

  .grade-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .grade-score {
    font-size: 1.5rem;
    font-weight: 800;
  }

  .grade-feedback-box {
    font-size: 0.9rem;
    color: var(--text-primary);
  }

  .remedial-note {
    margin-top: 0.6rem;
    padding: 0.6rem 0.85rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.35);
