---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);
---

<MainLayout
  title="Elemen 1: Berpikir Komputasional Visualizer | Informatika SMK"
  description="Simulator Visual Interaktif untuk Algoritma Searching, Sorting, Stack, dan Queue."
>
  <div class="bk-page-container">
    <!-- Header Navigation -->
    <div class="page-top-nav">
      <a href="/belajar/informatika" class="btn btn-outline btn-sm">
        &larr; Kembali ke Katalog Informatika
      </a>
      <span class="badge badge-purple">ELEMEN 1 — BERPIKIR KOMPUTASIONAL</span>
    </div>

    <!-- Intro Card -->
    <div class="intro-card glass-card">
      <h1 class="intro-title">Visualizer Simulator: Algoritma &amp; Struktur Data</h1>
      <p class="intro-desc">
        Pahami bagaimana algoritma <strong>Searching (Linear &amp; Binary)</strong>, <strong>Sorting (Bubble &amp; Selection Sort)</strong>, serta <strong>Struktur Data (Stack &amp; Queue)</strong> bekerja di dalam memori komputer melalui simulasi visual interaktif di bawah ini.
      </p>
    </div>

    <!-- Simulator Controls Tabs -->
    <div class="sim-wrapper glass-card">
      <div class="sim-tabs">
        <button class="sim-tab active" data-mode="bubble">Bubble Sort</button>
        <button class="sim-tab" data-mode="selection">Selection Sort</button>
        <button class="sim-tab" data-mode="linear">Linear Search</button>
        <button class="sim-tab" data-mode="binary">Binary Search</button>
        <button class="sim-tab" data-mode="stack">Stack (LIFO)</button>
        <button class="sim-tab" data-mode="queue">Queue (FIFO)</button>
      </div>

      <!-- Action & Control Bar -->
      <div class="sim-control-bar">
        <div class="control-left">
          <label for="array-size-input">Data (Array):</label>
          <input type="text" id="array-data-input" class="sim-input" value="45, 12, 89, 34, 67, 23, 90" />
          <button id="reset-sim-btn" class="btn btn-secondary btn-sm" type="button">Reset Data</button>
        </div>
        <div class="control-right">
          <button id="play-sim-btn" class="btn btn-primary btn-sm" type="button">▶️ Jalankan Visualisator</button>
        </div>
      </div>

      <!-- Live Explanation Log Banner -->
      <div class="sim-log-banner" id="sim-log-text">
        Pilih mode simulasi di atas, lalu klik <strong>Jalankan Visualisator</strong> untuk melihat pergerakan algoritma.
      </div>

      <!-- Visual Area -->
      <div class="visual-canvas" id="visual-canvas">
        <!-- Dynamically rendered by JavaScript -->
      </div>
    </div>

    <!-- Concept Theory & Explanation -->
    <div class="theory-grid">
      <div class="theory-card glass-card">
        <h3>🔍 Searching (Pencarian Data)</h3>
        <p><strong>Linear Search:</strong> Memeriksa data satu per satu dari awal sampai ketemu. Cocok untuk data tidak terurut.</p>
        <p><strong>Binary Search:</strong> Membagi data menjadi 2 bagian secara berulang. <em>Syarat wajib: data harus sudah terurut!</em></p>
      </div>
      <div class="theory-card glass-card">
        <h3>📊 Sorting (Pengurutan Data)</h3>
        <p><strong>Bubble Sort:</strong> Membandingkan dua elemen berdampingan dan menukarnya jika urutannya salah sampai gelembung data terbesar berada di posisi akhir.</p>
        <p><strong>Selection Sort:</strong> Mencari nilai terkecil dari sisa array, lalu menukarnya ke posisi paling depan secara berurutan.</p>
      </div>
      <div class="theory-card glass-card">
        <h3>📦 Stack &amp; Queue (Struktur Data)</h3>
        <p><strong>Stack (LIFO - Last In First Out):</strong> Elemen terakhir yang masuk adalah yang pertama kali keluar (seperti tumpukan piring).</p>
        <p><strong>Queue (FIFO - First In First Out):</strong> Elemen pertama yang masuk adalah yang pertama kali keluar (seperti antrean kantin).</p>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.sim-tab');
    const inputField = document.getElementById('array-data-input');
    const resetBtn = document.getElementById('reset-sim-btn');
    const playBtn = document.getElementById('play-sim-btn');
    const logBanner = document.getElementById('sim-log-text');
    const canvas = document.getElementById('visual-canvas');

    let currentMode = 'bubble';
    let isRunning = false;

    function getArray() {
      const raw = inputField.value.split(',').map(x => parseInt(x.trim(), 10)).filter(x => !isNaN(x));
      return raw.length > 0 ? raw : [45, 12, 89, 34, 67, 23, 90];
    }

    function renderBars(arr, activeIndices = [], sortedIndices = []) {
      canvas.innerHTML = '';
      const maxVal = Math.max(...arr, 100);
      const container = document.createElement('div');
      container.className = 'bars-container';

      arr.forEach((val, idx) => {
        const barWrap = document.createElement('div');
        barWrap.className = 'bar-wrap';

        const bar = document.createElement('div');
        bar.className = 'bar-element';
        const heightPct = Math.max((val / maxVal) * 100, 15);
        bar.style.height = `${heightPct}%`;

        if (activeIndices.includes(idx)) {
          bar.classList.add('bar-active');
        } else if (sortedIndices.includes(idx)) {
          bar.classList.add('bar-sorted');
        }

        const barVal = document.createElement('span');
        barVal.className = 'bar-val';
        barVal.textContent = val;

        barWrap.appendChild(bar);
        barWrap.appendChild(barVal);
        container.appendChild(barWrap);
      });

      canvas.appendChild(container);
    }

    function renderStackQueue(arr, highlightedIdx = -1) {
      canvas.innerHTML = '';
      const container = document.createElement('div');
      container.className = currentMode === 'stack' ? 'stack-container' : 'queue-container';

      arr.forEach((val, idx) => {
        const item = document.createElement('div');
        item.className = `sq-item ${idx === highlightedIdx ? 'sq-active' : ''}`;
        item.innerHTML = `<span class="sq-index">#${idx + 1}</span><strong class="sq-val">${val}</strong>`;
        container.appendChild(item);
      });

      canvas.appendChild(container);
    }

    function resetVisualizer() {
      const arr = getArray();
      if (currentMode === 'stack' || currentMode === 'queue') {
        renderStackQueue(arr);
        logBanner.innerHTML = `Mode <strong>${currentMode.toUpperCase()}</strong>: Tambahkan data atau hapus data elemen.`;
      } else {
        renderBars(arr);
        logBanner.innerHTML = `Visualisator siap. Mode: <strong>${currentMode.toUpperCase()}</strong>. Klik ▶️ Jalankan Visualisator.`;
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentMode = tab.getAttribute('data-mode');
        resetVisualizer();
      });
    });

    resetBtn?.addEventListener('click', resetVisualizer);

    // Sleep helper
    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    playBtn?.addEventListener('click', async () => {
      if (isRunning) return;
      isRunning = true;
      playBtn.disabled = true;

      let arr = getArray();

      if (currentMode === 'bubble') {
        logBanner.innerHTML = 'Memulai <strong>Bubble Sort</strong>...';
        let n = arr.length;
        let sorted = [];

        for (let i = 0; i < n - 1; i++) {
          for (let j = 0; j < n - i - 1; j++) {
            renderBars(arr, [j, j + 1], sorted);
            logBanner.innerHTML = `Membandingkan [${arr[j]}] dan [${arr[j + 1]}]...`;
            await sleep(600);

            if (arr[j] > arr[j + 1]) {
              logBanner.innerHTML = `Menukar [${arr[j]}] > [${arr[j + 1]}]...`;
              let temp = arr[j];
              arr[j] = arr[j + 1];
              arr[j + 1] = temp;
              renderBars(arr, [j, j + 1], sorted);
              await sleep(600);
            }
          }
          sorted.push(n - 1 - i);
        }
        sorted.push(0);
        renderBars(arr, [], sorted);
        logBanner.innerHTML = '✅ <strong>Bubble Sort Selesai!</strong> Data berhasil diurutkan.';
      } 
      else if (currentMode === 'selection') {
        logBanner.innerHTML = 'Memulai <strong>Selection Sort</strong>...';
        let n = arr.length;
        let sorted = [];

        for (let i = 0; i < n; i++) {
          let minIdx = i;
          for (let j = i + 1; j < n; j++) {
            renderBars(arr, [minIdx, j], sorted);
            logBanner.innerHTML = `Mencari nilai terkecil: membandingkan [${arr[minIdx]}] dengan [${arr[j]}]...`;
            await sleep(500);
            if (arr[j] < arr[minIdx]) {
              minIdx = j;
            }
          }
          if (minIdx !== i) {
            logBanner.innerHTML = `Menukar nilai terkecil [${arr[minIdx]}] ke posisi ke-${i + 1}...`;
            let temp = arr[i];
            arr[i] = arr[minIdx];
            arr[minIdx] = temp;
          }
          sorted.push(i);
          renderBars(arr, [], sorted);
          await sleep(600);
        }
        logBanner.innerHTML = '✅ <strong>Selection Sort Selesai!</strong> Data berhasil diurutkan.';
      }
      else if (currentMode === 'linear') {
        const target = arr[Math.floor(Math.random() * arr.length)];
        logBanner.innerHTML = `Memulai <strong>Linear Search</strong> untuk mencari angka <strong>${target}</strong>...`;

        let found = false;
        for (let i = 0; i < arr.length; i++) {
          renderBars(arr, [i], []);
          logBanner.innerHTML = `Memeriksa indeks [${i}]: apakah ${arr[i]} == ${target}?`;
          await sleep(700);

          if (arr[i] === target) {
            renderBars(arr, [], [i]);
            logBanner.innerHTML = `🎯 <strong>Ditemukan!</strong> Angka <strong>${target}</strong> berada pada indeks [${i}].`;
            found = true;
            break;
          }
        }
        if (!found) logBanner.innerHTML = `❌ Angka ${target} tidak ditemukan dalam array.`;
      }
      else if (currentMode === 'binary') {
        arr.sort((a, b) => a - b);
        inputField.value = arr.join(', ');
        const target = arr[Math.floor(Math.random() * arr.length)];
        logBanner.innerHTML = `Memulai <strong>Binary Search</strong> pada array terurut untuk mencari <strong>${target}</strong>...`;

        let low = 0, high = arr.length - 1;
        let found = false;

        while (low <= high) {
          let mid = Math.floor((low + high) / 2);
          renderBars(arr, [low, mid, high], []);
          logBanner.innerHTML = `Low=${low}, High=${high}, Mid=${mid} (Nilai Mid = <strong>${arr[mid]}</strong>). Mencari ${target}...`;
          await sleep(900);

          if (arr[mid] === target) {
            renderBars(arr, [], [mid]);
            logBanner.innerHTML = `🎯 <strong>Ditemukan!</strong> Angka <strong>${target}</strong> berada pada indeks [${mid}].`;
            found = true;
            break;
          } else if (arr[mid] < target) {
            logBanner.innerHTML = `${arr[mid]} < ${target}, geser batas kiri ke Mid + 1.`;
            low = mid + 1;
          } else {
            logBanner.innerHTML = `${arr[mid]} > ${target}, geser batas kanan ke Mid - 1.`;
            high = mid - 1;
          }
          await sleep(600);
        }
        if (!found) logBanner.innerHTML = `❌ Angka ${target} tidak ditemukan.`;
      }
      else if (currentMode === 'stack') {
        logBanner.innerHTML = 'Simulasi <strong>Stack (Push & Pop)</strong>...';
        renderStackQueue(arr);
        await sleep(500);
        arr.push(99);
        renderStackQueue(arr, arr.length - 1);
        logBanner.innerHTML = '<strong>PUSH(99)</strong>: Menambahkan angka 99 ke atas tumpukan.';
        await sleep(1000);
        const popped = arr.pop();
        renderStackQueue(arr);
        logBanner.innerHTML = `<strong>POP()</strong>: Mengeluarkan angka paling atas [${popped}].`;
      }
      else if (currentMode === 'queue') {
        logBanner.innerHTML = 'Simulasi <strong>Queue (Enqueue & Dequeue)</strong>...';
        renderStackQueue(arr);
        await sleep(500);
        arr.push(99);
        renderStackQueue(arr, arr.length - 1);
        logBanner.innerHTML = '<strong>ENQUEUE(99)</strong>: Menambahkan angka 99 ke belakang antrean.';
        await sleep(1000);
        const dequeued = arr.shift();
        renderStackQueue(arr);
        logBanner.innerHTML = `<strong>DEQUEUE()</strong>: Melayani / Mengeluarkan angka paling depan [${dequeued}].`;
      }

      isRunning = false;
      playBtn.disabled = false;
    });

    // Initial render
    resetVisualizer();
  });
</script>

<style>
  .bk-page-container {
    max-width: 1040px;
    margin: 1.5rem auto 4rem;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .page-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .intro-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .intro-title {
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .intro-desc {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .sim-wrapper {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sim-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .sim-tab {
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .sim-tab.active {
    background: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
  }

  .sim-control-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .control-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .sim-input {
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-primary);
    width: 250px;
  }

  .sim-log-banner {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 4px solid var(--accent-primary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--text-primary);
  }

  .visual-canvas {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    min-height: 220px;
    padding: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bars-container {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 1rem;
    height: 180px;
    width: 100%;
  }

  .bar-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    width: 45px;
    height: 100%;
    justify-content: flex-end;
  }

  .bar-element {
    width: 100%;
    background: linear-gradient(180deg, #6366f1 0%, #4f46e5 100%);
    border-radius: var(--radius-sm) var(--radius-sm) 0 0;
    transition: all 0.3s ease;
  }

  .bar-active {
    background: linear-gradient(180deg, #f59e0b 0%, #d97706 100%) !important;
    transform: scaleY(1.05);
  }

  .bar-sorted {
    background: linear-gradient(180deg, #10b981 0%, #059669 100%) !important;
  }

  .bar-val {
    font-size: 0.8rem;
    font-weight: 700;
    font-family: var(--font-mono);
    color: var(--text-primary);
  }

  /* Stack & Queue visualizer */
  .stack-container, .queue-container {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
  }

  .stack-container {
    flex-direction: column-reverse;
  }

  .sq-item {
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-md);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 140px;
  }

  .sq-active {
    border-color: #10b981;
    background: rgba(16, 185, 129, 0.15);
  }

  .sq-index {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .sq-val {
    font-size: 1rem;
    color: var(--text-primary);
  }

  .theory-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.25rem;
  }

  .theory-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .theory-card h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .theory-card p {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>
