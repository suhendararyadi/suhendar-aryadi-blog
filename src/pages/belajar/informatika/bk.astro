---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

const pillars = [
  {
    icon: '🧩',
    title: '1. Dekomposisi (Decomposition)',
    subtitle: 'Memecah Masalah Kompleks',
    desc: 'Kemampuan memecah satu masalah besar atau sistem perangkat lunak yang rumit menjadi komponen-komponen kecil yang lebih mudah dipahami dan dikelola.',
    example: 'Contoh RPL: Memecah aplikasi E-Kantin menjadi modul Katalog Produk, Keranjang Belanja, Gateway Pembayaran, dan Sistem Antrean.'
  },
  {
    icon: '🔍',
    title: '2. Pengenalan Pola (Pattern Recognition)',
    subtitle: 'Menemukan Kesamaan & Keselarasan',
    desc: 'Kemampuan mengenali kemiripan, pola berulang, atau tren di antara berbagai masalah yang pernah diselesaikan sebelumnya.',
    example: 'Contoh RPL: Mengenali bahwa fitur Login Siswa, Login Guru, dan Login Admin memiliki alur autentikasi dan validasi formulir yang serupa.'
  },
  {
    icon: '💡',
    title: '3. Abstraksi (Abstraction)',
    subtitle: 'Fokus pada Hal Penting',
    desc: 'Kemampuan menyaring dan memfokuskan perhatian pada informasi penting saja, serta mengabaikan detail-detail yang tidak relevan.',
    example: 'Contoh RPL: Saat merancang tabel database Siswa, kita hanya menyimpan Nama, NIS, dan Kelas, serta mengabaikan warna sepatu atau hobi siswa.'
  },
  {
    icon: '⚙️',
    title: '4. Perancangan Algoritma (Algorithm Design)',
    subtitle: 'Merancang Langkah Sistematis',
    desc: 'Kemampuan menyusun urutan langkah-langkah logis dan sistematis untuk menyelesaikan masalah atau menjalankan perintah komputer.',
    example: 'Contoh RPL: Menyusun pseudocode/flowchart alur checkout belanja: Cek Stok -> Hitung Total -> Potong Saldo -> Buat Struk.'
  }
];

const caseStudies = [
  {
    id: 'kiosk',
    title: '📱 Studi Kasus A: Sistem Self-Service Restoran',
    desc: 'Penerapan 4 Pilar BK dalam merancang sistem kasir mandiri restoran cepat saji.',
    deco: 'Sub-Sistem: Katalog Menu, Order Cart, Payment Gateway, Display Antrean Dapur.',
    pola: 'Pola Autentikasi Kasir & Validasi Input Pembayaran.',
    abstraksi: 'Data Utama: ID Transaksi, Nama Menu, Harga, No Antrean. (Abaikan warna baju pembeli).',
    algoritma: 'Algoritma Queue (FIFO) untuk nomor urut antrean pesanan di dapur.'
  },
  {
    id: 'ekantin',
    title: '🛍️ Studi Kasus B: Marketplace E-Kantin Sekolah',
    desc: 'Penerapan 4 Pilar BK untuk mengatasi desakan siswa saat jam istirahat sekolah.',
    deco: 'Sub-Sistem: Profil Merchant, Pre-Order Menu, Saldo Digital, Notifikasi Siap Ambil.',
    pola: 'Pola Pencarian Menu & Pengurutan Harga Termurah.',
    abstraksi: 'Data Utama: ID Siswa, Saldo, Status Pesanan (Pending/Proses/Selesai).',
    algoritma: 'Algoritma Binary Search untuk pencarian cepat menu makanan.'
  }
];
---

<MainLayout
  title="Elemen 1: Berpikir Komputasional (Computational Thinking) | Informatika SMK"
  description="Kuasai 4 Fondasi Berpikir Komputasional (Dekomposisi, Pengenalan Pola, Abstraksi, Algoritma) & Simulator Visualizer Interaktif."
>
  <div class="bk-page-container">
    <!-- Top Nav -->
    <div class="page-top-nav">
      <a href="/belajar/informatika" class="btn btn-outline btn-sm">
        &larr; Kembali ke Katalog Informatika
      </a>
      <div class="top-nav-right">
        <a href="/belajar/informatika/bk/lkpd" class="btn btn-primary btn-sm">
          <span>📋 Buka LKPD Digital Interaktif &rarr;</span>
        </a>
      </div>
    </div>

    <!-- Hero Intro -->
    <div class="intro-card glass-card">
      <div class="hero-badge">
        <span class="badge badge-cyan">SUPERPOWER PEMECAHAN MASALAH</span>
      </div>
      <h1 class="intro-title">Berpikir Komputasional: 4 Fondasi Utamanya</h1>
      <p class="intro-desc">
        <strong>Berpikir Komputasional (Computational Thinking)</strong> bukan sekadar tentang cara menulis program komputer, melainkan kerangka berpikir (*mindset*) untuk memecahkan persoalan kompleks secara logis, efisien, dan terstruktur.
      </p>
    </div>

    <!-- 4 Pillars Section -->
    <div class="section-title">
      <h2>4 Fondasi Utama Berpikir Komputasional</h2>
      <p>Setiap solusi perangkat lunak hebat selalu dibangun di atas 4 pilar dasar ini:</p>
    </div>

    <div class="pillars-grid">
      {pillars.map(p => (
        <div class="pillar-card glass-card">
          <div class="pillar-top">
            <span class="pillar-icon">{p.icon}</span>
            <div>
              <h3 class="pillar-title">{p.title}</h3>
              <span class="pillar-sub">{p.subtitle}</span>
            </div>
          </div>
          <p class="pillar-desc">{p.desc}</p>
          <div class="pillar-example">
            <strong>💡 Penerapan di Dunia RPL:</strong>
            <p>{p.example}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Data vs Informasi Section -->
    <div class="data-info-card glass-card">
      <h2>📊 Konsep Siklus Data &amp; Informasi (Input &rarr; Proses &rarr; Output)</h2>
      <p>
        Data adalah fakta/nilai mentah (misal: angka <code>37</code> atau <code>85</code>). Ketika data diolah menggunakan <strong>Algoritma</strong> yang tepat dan diberi konteks, data berubah menjadi <strong>Informasi</strong> bermakna untuk pengambilan keputusan (misal: <code>"Suhu Budi 37°C = Normal"</code>).
      </p>
      <div class="cycle-grid">
        <div class="cycle-step">
          <span class="step-num">1. INPUT</span>
          <strong>Data Mentah</strong>
          <span>Angka, Teks, Simbol, Gambar Mentah</span>
        </div>
        <div class="cycle-arrow">&rarr;</div>
        <div class="cycle-step">
          <span class="step-num">2. PROSES</span>
          <strong>Algoritma Pengolahan</strong>
          <span>Searching, Sorting, Formulasi Logika</span>
        </div>
        <div class="cycle-arrow">&rarr;</div>
        <div class="cycle-step">
          <span class="step-num">3. OUTPUT</span>
          <strong>Informasi Bermakna</strong>
          <span>Rekap Nilai, Keputusan &amp; Laporan</span>
        </div>
      </div>
    </div>

    <!-- Visualizer Simulator Section -->
    <div class="sim-section-header">
      <h2>🛠️ Interactive Visualizer: Searching, Sorting, Stack &amp; Queue</h2>
      <p>Simulasikan cara kerja algoritma dan struktur data di dalam memori komputer secara langsung:</p>
    </div>

    <div class="sim-wrapper glass-card">
      <div class="sim-tabs">
        <button class="sim-tab active" data-mode="bubble">Bubble Sort</button>
        <button class="sim-tab" data-mode="selection">Selection Sort</button>
        <button class="sim-tab" data-mode="linear">Linear Search</button>
        <button class="sim-tab" data-mode="binary">Binary Search</button>
        <button class="sim-tab" data-mode="stack">Stack (LIFO)</button>
        <button class="sim-tab" data-mode="queue">Queue (FIFO)</button>
      </div>

      <!-- Action & Control Bar -->
      <div class="sim-control-bar">
        <div class="control-left">
          <label for="array-data-input">Data (Array):</label>
          <input type="text" id="array-data-input" class="sim-input" value="45, 12, 89, 34, 67, 23, 90" />
          <button id="reset-sim-btn" class="btn btn-secondary btn-sm" type="button">Reset Data</button>
        </div>
        <div class="control-right">
          <button id="play-sim-btn" class="btn btn-primary btn-sm" type="button">▶️ Jalankan Visualisator</button>
        </div>
      </div>

      <!-- Live Explanation Log Banner -->
      <div class="sim-log-banner" id="sim-log-text">
        Pilih mode simulasi di atas, lalu klik <strong>Jalankan Visualisator</strong> untuk melihat pergerakan algoritma.
      </div>

      <!-- Visual Area -->
      <div class="visual-canvas" id="visual-canvas">
        <!-- Dynamically rendered by JavaScript -->
      </div>
    </div>

    <!-- Case Studies Explorer -->
    <div class="case-studies-section">
      <div class="section-title">
        <h2>📁 Case Study Explorer: Analisis Kasus Perangkat Lunak RPL</h2>
        <p>Lihat contoh bagaimana 4 Pilar BK diterapkan pada proyek sistem industri nyata:</p>
      </div>

      <div class="cases-grid">
        {caseStudies.map(c => (
          <div class="case-card glass-card">
            <h3>{c.title}</h3>
            <p class="case-desc">{c.desc}</p>
            <ul class="case-details">
              <li><strong>🧩 Dekomposisi:</strong> {c.deco}</li>
              <li><strong>🔍 Pengenalan Pola:</strong> {c.pola}</li>
              <li><strong>💡 Abstraksi:</strong> {c.abstraksi}</li>
              <li><strong>⚙️ Algoritma:</strong> {c.algoritma}</li>
            </ul>
          </div>
        ))}
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const tabs = document.querySelectorAll('.sim-tab');
    const inputField = document.getElementById('array-data-input');
    const resetBtn = document.getElementById('reset-sim-btn');
    const playBtn = document.getElementById('play-sim-btn');
    const logBanner = document.getElementById('sim-log-text');
    const canvas = document.getElementById('visual-canvas');

    let currentMode = 'bubble';
    let isRunning = false;

    function getArray() {
      const raw = inputField.value.split(',').map(x => parseInt(x.trim(), 10)).filter(x => !isNaN(x));
      return raw.length > 0 ? raw : [45, 12, 89, 34, 67, 23, 90];
    }

    function renderBars(arr, activeIndices = [], sortedIndices = []) {
      canvas.innerHTML = '';
      const maxVal = Math.max(...arr, 100);
      const container = document.createElement('div');
      container.className = 'bars-container';

      arr.forEach((val, idx) => {
        const barWrap = document.createElement('div');
        barWrap.className = 'bar-wrap';

        const bar = document.createElement('div');
        bar.className = 'bar-element';
        const heightPct = Math.max((val / maxVal) * 100, 15);
        bar.style.height = `${heightPct}%`;

        if (activeIndices.includes(idx)) {
          bar.classList.add('bar-active');
        } else if (sortedIndices.includes(idx)) {
          bar.classList.add('bar-sorted');
        }

        const barVal = document.createElement('span');
        barVal.className = 'bar-val';
        barVal.textContent = val;

        barWrap.appendChild(bar);
        barWrap.appendChild(barVal);
        container.appendChild(barWrap);
      });

      canvas.appendChild(container);
    }

    function renderStackQueue(arr, highlightedIdx = -1) {
      canvas.innerHTML = '';
      const container = document.createElement('div');
      container.className = currentMode === 'stack' ? 'stack-container' : 'queue-container';

      arr.forEach((val, idx) => {
        const item = document.createElement('div');
        item.className = `sq-item ${idx === highlightedIdx ? 'sq-active' : ''}`;
        item.innerHTML = `<span class="sq-index">#${idx + 1}</span><strong class="sq-val">${val}</strong>`;
        container.appendChild(item);
      });

      canvas.appendChild(container);
    }

    function resetVisualizer() {
      const arr = getArray();
      if (currentMode === 'stack' || currentMode === 'queue') {
        renderStackQueue(arr);
        logBanner.innerHTML = `Mode <strong>${currentMode.toUpperCase()}</strong>: Tambahkan data atau hapus data elemen.`;
      } else {
        renderBars(arr);
        logBanner.innerHTML = `Visualisator siap. Mode: <strong>${currentMode.toUpperCase()}</strong>. Klik ▶️ Jalankan Visualisator.`;
      }
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        tabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');
        currentMode = tab.getAttribute('data-mode');
        resetVisualizer();
      });
    });

    resetBtn?.addEventListener('click', resetVisualizer);

    // Sleep helper
    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

    playBtn?.addEventListener('click', async () => {
      if (isRunning) return;
      isRunning = true;
      playBtn.disabled = true;

      let arr = getArray();

      if (currentMode === 'bubble') {
        logBanner.innerHTML = 'Memulai <strong>Bubble Sort</strong>...';
        let n = arr.length;
        let sorted = [];

        for (let i = 0; i < n - 1; i++) {
          for (let j = 0; j < n - i - 1; j++) {
            renderBars(arr, [j, j + 1], sorted);
            logBanner.innerHTML = `Membandingkan [${arr[j]}] dan [${arr[j + 1]}]...`;
            await sleep(600);

            if (arr[j] > arr[j + 1]) {
              logBanner.innerHTML = `Menukar [${arr[j]}] > [${arr[j + 1]}]...`;
              let temp = arr[j];
              arr[j] = arr[j + 1];
              arr[j + 1] = temp;
              renderBars(arr, [j, j + 1], sorted);
              await sleep(600);
            }
          }
          sorted.push(n - 1 - i);
        }
        sorted.push(0);
        renderBars(arr, [], sorted);
        logBanner.innerHTML = '✅ <strong>Bubble Sort Selesai!</strong> Data berhasil diurutkan.';
      } 
      else if (currentMode === 'selection') {
        logBanner.innerHTML = 'Memulai <strong>Selection Sort</strong>...';
        let n = arr.length;
        let sorted = [];

        for (let i = 0; i < n; i++) {
          let minIdx = i;
          for (let j = i + 1; j < n; j++) {
            renderBars(arr, [minIdx, j], sorted);
            logBanner.innerHTML = `Mencari nilai terkecil: membandingkan [${arr[minIdx]}] dengan [${arr[j]}]...`;
            await sleep(500);
            if (arr[j] < arr[minIdx]) {
              minIdx = j;
            }
          }
          if (minIdx !== i) {
            logBanner.innerHTML = `Menukar nilai terkecil [${arr[minIdx]}] ke posisi ke-${i + 1}...`;
            let temp = arr[i];
            arr[i] = arr[minIdx];
            arr[minIdx] = temp;
          }
          sorted.push(i);
          renderBars(arr, [], sorted);
          await sleep(600);
        }
        logBanner.innerHTML = '✅ <strong>Selection Sort Selesai!</strong> Data berhasil diurutkan.';
      }
      else if (currentMode === 'linear') {
        const target = arr[Math.floor(Math.random() * arr.length)];
        logBanner.innerHTML = `Memulai <strong>Linear Search</strong> untuk mencari angka <strong>${target}</strong>...`;

        let found = false;
        for (let i = 0; i < arr.length; i++) {
          renderBars(arr, [i], []);
          logBanner.innerHTML = `Memeriksa indeks [${i}]: apakah ${arr[i]} == ${target}?`;
          await sleep(700);

          if (arr[i] === target) {
            renderBars(arr, [], [i]);
            logBanner.innerHTML = `🎯 <strong>Ditemukan!</strong> Angka <strong>${target}</strong> berada pada indeks [${i}].`;
            found = true;
            break;
          }
        }
        if (!found) logBanner.innerHTML = `❌ Angka ${target} tidak ditemukan dalam array.`;
      }
      else if (currentMode === 'binary') {
        arr.sort((a, b) => a - b);
        inputField.value = arr.join(', ');
        const target = arr[Math.floor(Math.random() * arr.length)];
        logBanner.innerHTML = `Memulai <strong>Binary Search</strong> pada array terurut untuk mencari <strong>${target}</strong>...`;

        let low = 0, high = arr.length - 1;
        let found = false;

        while (low <= high) {
          let mid = Math.floor((low + high) / 2);
          renderBars(arr, [low, mid, high], []);
          logBanner.innerHTML = `Low=${low}, High=${high}, Mid=${mid} (Nilai Mid = <strong>${arr[mid]}</strong>). Mencari ${target}...`;
          await sleep(900);

          if (arr[mid] === target) {
            renderBars(arr, [], [mid]);
            logBanner.innerHTML = `🎯 <strong>Ditemukan!</strong> Angka <strong>${target}</strong> berada pada indeks [${mid}].`;
            found = true;
            break;
          } else if (arr[mid] < target) {
            logBanner.innerHTML = `${arr[mid]} < ${target}, geser batas kiri ke Mid + 1.`;
            low = mid + 1;
          } else {
            logBanner.innerHTML = `${arr[mid]} > ${target}, geser batas kanan ke Mid - 1.`;
            high = mid - 1;
          }
          await sleep(600);
        }
        if (!found) logBanner.innerHTML = `❌ Angka ${target} tidak ditemukan.`;
      }
      else if (currentMode === 'stack') {
        logBanner.innerHTML = 'Simulasi <strong>Stack (Push & Pop)</strong>...';
        renderStackQueue(arr);
        await sleep(500);
        arr.push(99);
        renderStackQueue(arr, arr.length - 1);
        logBanner.innerHTML = '<strong>PUSH(99)</strong>: Menambahkan angka 99 ke atas tumpukan.';
        await sleep(1000);
        const popped = arr.pop();
        renderStackQueue(arr);
        logBanner.innerHTML = `<strong>POP()</strong>: Mengeluarkan angka paling atas [${popped}].`;
      }
      else if (currentMode === 'queue') {
        logBanner.innerHTML = 'Simulasi <strong>Queue (Enqueue & Dequeue)</strong>...';
        renderStackQueue(arr);
        await sleep(500);
        arr.push(99);
        renderStackQueue(arr, arr.length - 1);
        logBanner.innerHTML = '<strong>ENQUEUE(99)</strong>: Menambahkan angka 99 ke belakang antrean.';
        await sleep(1000);
        const dequeued = arr.shift();
        renderStackQueue(arr);
        logBanner.innerHTML = `<strong>DEQUEUE()</strong>: Melayani / Mengeluarkan angka paling depan [${dequeued}].`;
      }

      isRunning = false;
      playBtn.disabled = false;
    });

    // Initial render
    resetVisualizer();
  });
</script>

<style>
  .bk-page-container {
    max-width: 1080px;
    margin: 1.5rem auto 4rem;
    padding: 0 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .page-top-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .intro-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .intro-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .intro-desc {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .section-title h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .section-title p {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
  }

  /* 4 Pillars Grid */
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(480px, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }

  .pillar-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .pillar-top {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .pillar-icon {
    font-size: 2rem;
  }

  .pillar-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .pillar-sub {
    font-size: 0.8rem;
    color: var(--accent-primary);
    font-weight: 600;
  }

  .pillar-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .pillar-example {
    background: var(--bg-secondary);
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-subtle);
    font-size: 0.8125rem;
    color: var(--text-secondary);
  }

  /* Data vs Info Section */
  .data-info-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .data-info-card h2 {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .data-info-card p {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .cycle-grid {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: 1rem;
    flex-wrap: wrap;
    background: var(--bg-secondary);
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
  }

  .cycle-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.25rem;
    flex: 1;
    min-width: 160px;
  }

  .step-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-primary);
    letter-spacing: 0.05em;
  }

  .cycle-step strong {
    font-size: 1rem;
    color: var(--text-primary);
  }

  .cycle-step span {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .cycle-arrow {
    font-size: 1.5rem;
    color: var(--text-muted);
    font-weight: 800;
  }

  /* Simulator */
  .sim-section-header h2 {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .sim-section-header p {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .sim-wrapper {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .sim-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .sim-tab {
    padding: 0.45rem 0.95rem;
    font-size: 0.85rem;
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 1px solid var(--border-color);
    background: var(--bg-secondary);
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .sim-tab.active {
    background: var(--accent-primary);
    color: #ffffff;
    border-color: var(--accent-primary);
  }

  .sim-control-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .control-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 0.875rem;
    color: var(--text-secondary);
    font-weight: 600;
  }

  .sim-input {
    padding: 0.4rem 0.75rem;
    font-size: 0.875rem;
