---
import MainLayout from '../../../layouts/MainLayout.astro';
import { getSessionUser } from '../../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect(`/auth/login?redirect=${encodeURIComponent(Astro.url.pathname)}`);
}

const pillars = [
  {
    icon: '01',
    title: '1. Dekomposisi (Decomposition)',
    subtitle: 'Memecah Masalah Kompleks',
    desc: 'Kemampuan memecah satu masalah besar atau sistem perangkat lunak yang rumit menjadi komponen-komponen kecil yang lebih mudah dipahami dan dikelola.',
    example: 'Contoh RPL: Memecah aplikasi E-Kantin menjadi modul Katalog Produk, Keranjang Belanja, Gateway Pembayaran, dan Sistem Antrean.'
  },
  {
    icon: '02',
    title: '2. Pengenalan Pola (Pattern Recognition)',
    subtitle: 'Menemukan Kesamaan & Keselarasan',
    desc: 'Kemampuan mengenali kemiripan, pola berulang, atau tren di antara berbagai masalah yang pernah diselesaikan sebelumnya.',
    example: 'Contoh RPL: Mengenali bahwa fitur Login Siswa, Login Guru, dan Login Admin memiliki alur autentikasi dan validasi formulir yang serupa.'
  },
  {
    icon: '03',
    title: '3. Abstraksi (Abstraction)',
    subtitle: 'Fokus pada Hal Penting',
    desc: 'Kemampuan menyaring dan memfokuskan perhatian pada informasi penting saja, serta mengabaikan detail-detail yang tidak relevan.',
    example: 'Contoh RPL: Saat merancang tabel database Siswa, kita hanya menyimpan Nama, NIS, dan Kelas, serta mengabaikan warna sepatu atau hobi siswa.'
  },
  {
    icon: '04',
    title: '4. Perancangan Algoritma (Algorithm Design)',
    subtitle: 'Merancang Langkah Sistematis',
    desc: 'Kemampuan menyusun urutan langkah-langkah logis dan sistematis untuk menyelesaikan masalah atau menjalankan perintah komputer.',
    example: 'Contoh RPL: Menyusun pseudocode/flowchart alur checkout belanja: Cek Stok -> Hitung Total -> Potong Saldo -> Buat Struk.'
  }
];

const caseStudies = [
  {
    id: 'kiosk',
    title: 'Studi Kasus A: Sistem Self-Service Restoran',
    desc: 'Penerapan 4 Pilar BK dalam merancang sistem kasir mandiri restoran cepat saji.',
    deco: 'Sub-Sistem: Katalog Menu, Order Cart, Payment Gateway, Display Antrean Dapur.',
    pola: 'Pola Autentikasi Kasir & Validasi Input Pembayaran.',
    abstraksi: 'Data Utama: ID Transaksi, Nama Menu, Harga, No Antrean. (Abaikan warna baju pembeli).',
    algoritma: 'Algoritma Queue (FIFO) untuk nomor urut antrean pesanan di dapur.'
  },
  {
    id: 'ekantin',
    title: 'Studi Kasus B: Marketplace E-Kantin Sekolah',
    desc: 'Penerapan 4 Pilar BK untuk mengatasi desakan siswa saat jam istirahat sekolah.',
    deco: 'Sub-Sistem: Profil Merchant, Pre-Order Menu, Saldo Digital, Notifikasi Siap Ambil.',
    pola: 'Pola Pencarian Menu & Pengurutan Harga Termurah.',
    abstraksi: 'Data Utama: ID Siswa, Saldo, Status Pesanan (Pending/Proses/Selesai).',
    algoritma: 'Algoritma Binary Search untuk pencarian cepat menu makanan.'
  }
];

// ===== Materi Mendalam: Fondasi 4 - Perancangan Algoritma (Algorithm Design) =====

// 4 simbol flowchart standar (ANSI) yang dipakai di seluruh diagram pada section ini
const flowchartSymbols = [
  { shape: 'terminal', label: 'Terminal', desc: 'Menandai titik AWAL (Start) dan AKHIR (End) sebuah algoritma.' },
  { shape: 'io', label: 'Input/Output', desc: 'Menandai proses memasukkan data (Input) atau menampilkan hasil (Output).' },
  { shape: 'process', label: 'Proses', desc: 'Menandai satu langkah pengolahan/komputasi data (perhitungan, penugasan nilai).' },
  { shape: 'decision', label: 'Decision', desc: 'Menandai titik percabangan logika berdasarkan kondisi (Ya/Tidak, Benar/Salah).' }
];

// 3 struktur kontrol dasar algoritma, masing-masing dengan flowchart step + pseudocode singkat
const controlStructures = [
  {
    id: 'sequential',
    title: 'Sequential (Runtutan)',
    desc: 'Instruksi dieksekusi berurutan dari atas ke bawah, satu per satu, tanpa percabangan atau perulangan.',
    example: 'Contoh RPL: INPUT nama_siswa → INPUT nilai_ujian → HITUNG rata_rata → TAMPILKAN rata_rata.',
    flow: [
      { shape: 'terminal', text: 'Mulai' },
      { shape: 'io', text: 'Input Nilai' },
      { shape: 'process', text: 'Hitung Rata-rata' },
      { shape: 'io', text: 'Tampilkan Hasil' },
      { shape: 'terminal', text: 'Selesai' }
    ]
  },
  {
    id: 'selection',
    title: 'Selection (Percabangan)',
    desc: 'Instruksi memilih salah satu dari beberapa jalur eksekusi berdasarkan hasil evaluasi kondisi logika (IF-THEN-ELSE).',
    example: 'Contoh RPL: JIKA stok_barang > 0 MAKA proses_pesanan, JIKA TIDAK tampilkan "Stok Habis".',
    flow: [
      { shape: 'terminal', text: 'Mulai' },
      { shape: 'decision', text: 'Stok > 0?' },
      { shape: 'process', text: 'Ya: Proses Pesanan' },
      { shape: 'process', text: 'Tidak: Tampilkan "Stok Habis"' },
      { shape: 'terminal', text: 'Selesai' }
    ]
  },
  {
    id: 'iteration',
    title: 'Iteration (Perulangan)',
    desc: 'Instruksi diulang berkali-kali selama (atau sampai) suatu kondisi tertentu terpenuhi, menghindari penulisan kode berulang secara manual.',
    example: 'Contoh RPL: SELAMA antrean_dapur TIDAK KOSONG, proses pesanan terdepan satu per satu (looping Queue).',
    flow: [
      { shape: 'terminal', text: 'Mulai' },
      { shape: 'decision', text: 'Antrean Kosong?' },
      { shape: 'process', text: 'Tidak: Proses Pesanan Terdepan' },
      { shape: 'process', text: 'Ya: Hentikan Perulangan' },
      { shape: 'terminal', text: 'Selesai' }
    ]
  }
];

// Perbandingan algoritma searching
const searchingComparison = [
  {
    name: 'Linear Search',
    howItWorks: 'Memeriksa setiap elemen data satu per satu dari posisi pertama hingga elemen target ditemukan atau seluruh data habis diperiksa.',
    complexity: 'O(n) — waktu pencarian bertambah linear seiring jumlah data.',
    whenToUse: 'Data belum terurut, atau jumlah data relatif kecil.',
    rplExample: 'Mencari 1 nama siswa di daftar absensi kelas yang belum diurutkan.'
  },
  {
    name: 'Binary Search',
    howItWorks: 'Membagi dua data yang SUDAH TERURUT secara berulang, membandingkan elemen tengah dengan target, lalu mempersempit pencarian ke separuh kiri/kanan.',
    complexity: 'O(log n) — jauh lebih cepat dari Linear Search pada data besar.',
    whenToUse: 'Data sudah terurut (sorted) dan berjumlah besar.',
    rplExample: 'Mencari kode produk di katalog kantin yang sudah diurutkan berdasarkan ID.'
  }
];

// Perbandingan algoritma sorting
const sortingComparison = [
  {
    name: 'Bubble Sort',
    howItWorks: 'Membandingkan dua elemen bersebelahan secara berulang, menukar posisinya jika urutannya salah, hingga seluruh data terurut.',
    complexity: 'O(n²) — lambat untuk data besar, tapi sederhana untuk dipahami.',
    tradeoff: 'Mudah diimplementasikan, cocok untuk pembelajaran, tidak efisien untuk data produksi besar.',
    rplExample: 'Mengurutkan daftar 10 nilai siswa dari terkecil ke terbesar.'
  },
  {
    name: 'Selection Sort',
    howItWorks: 'Mencari elemen terkecil/terbesar dari data yang belum terurut, lalu menukarnya ke posisi terdepan, diulang untuk sisa data.',
    complexity: 'O(n²) — jumlah perbandingan sama seperti Bubble Sort, namun jumlah penukaran (swap) lebih sedikit.',
    tradeoff: 'Sedikit lebih efisien dari Bubble Sort dalam jumlah swap, tetap tidak ideal untuk data sangat besar.',
    rplExample: 'Mengurutkan daftar harga menu kantin dari termurah ke termahal.'
  },
  {
    name: 'Quick Sort',
    howItWorks: 'Memilih satu elemen sebagai pivot, memisahkan data menjadi dua kelompok (lebih kecil & lebih besar dari pivot), lalu mengurutkan tiap kelompok secara rekursif.',
    complexity: 'O(n log n) rata-rata — jauh lebih efisien untuk data besar dibanding Bubble/Selection Sort.',
    tradeoff: 'Kompleks untuk dipahami pemula, tapi menjadi standar performa tinggi di sistem produksi nyata.',
    rplExample: 'Mengurutkan ribuan data transaksi pada sistem kasir toko online.'
  }
];

// Struktur data Queue (FIFO) & Stack (LIFO)
const dataStructures = [
  {
    name: 'Queue (FIFO — First In, First Out)',
    principle: 'Data yang PERTAMA masuk adalah data yang PERTAMA diproses/keluar, seperti antrean fisik di kehidupan nyata.',
    operations: 'Enqueue (memasukkan data ke belakang antrean), Dequeue (mengambil data dari depan antrean).',
    rplExample: 'Antrean pesanan dapur: pesanan yang masuk lebih dulu, dimasak dan diproses lebih dulu.'
  },
  {
    name: 'Stack (LIFO — Last In, First Out)',
    principle: 'Data yang TERAKHIR masuk adalah data yang PERTAMA diproses/keluar, seperti menumpuk piring.',
    operations: 'Push (menambahkan data ke atas tumpukan), Pop (mengambil data dari atas tumpukan).',
    rplExample: 'Fitur Undo pada aplikasi kasir: transaksi terakhir yang diinput adalah yang pertama dibatalkan.'
  }
];

// Contoh pseudocode lengkap: alur checkout (menggabungkan Selection + Iteration + Queue)
const checkoutFlowchart = [
  { shape: 'terminal', text: 'Mulai' },
  { shape: 'io', text: 'Input Daftar Pesanan' },
  { shape: 'process', text: 'Hitung Total Harga' },
  { shape: 'decision', text: 'Saldo Cukup?' },
  { shape: 'process', text: 'Ya: Potong Saldo & Enqueue ke Antrean Dapur' },
  { shape: 'process', text: 'Tidak: Tampilkan "Saldo Tidak Cukup"' },
  { shape: 'io', text: 'Tampilkan Nomor Antrean' },
  { shape: 'terminal', text: 'Selesai' }
];

const checkoutPseudocode = `ALGORITMA Proses_Checkout_Kantin
DEKLARASI:
    daftar_pesanan : ARRAY OF Item
    total_harga, saldo_siswa : INTEGER
    antrean_dapur : QUEUE OF Pesanan

ALUR PROSES:
    INPUT daftar_pesanan
    total_harga = 0

    // Iteration: hitung total harga dari semua item pesanan
    UNTUK SETIAP item DALAM daftar_pesanan LAKUKAN
        total_harga = total_harga + item.harga * item.jumlah
    AKHIR UNTUK

    // Selection: validasi saldo sebelum lanjut transaksi
    JIKA saldo_siswa >= total_harga MAKA
        saldo_siswa = saldo_siswa - total_harga
        ENQUEUE(antrean_dapur, daftar_pesanan)
        TAMPILKAN "Pembayaran Berhasil. Nomor Antrean:", PANJANG(antrean_dapur)
    LAINNYA
        TAMPILKAN "Saldo Tidak Cukup, Silakan Isi Ulang"
    AKHIR JIKA
SELESAI`;

// Kesalahan umum siswa saat merancang algoritma (penguatan sebelum mengisi LKPD)
const commonMistakes = [
  {
    mistake: 'Lupa menuliskan kondisi berhenti (base case) pada perulangan',
    impact: 'Menyebabkan infinite loop — program tidak pernah selesai berjalan.',
    fix: 'Selalu pastikan ada kondisi yang membuat perulangan berhenti, misal "SELAMA antrean TIDAK KOSONG".'
  },
  {
    mistake: 'Tertukar antara prinsip Queue (FIFO) dan Stack (LIFO)',
    impact: 'Urutan pemrosesan data menjadi terbalik dari yang seharusnya (mis. pesanan pertama malah diproses terakhir).',
    fix: 'Ingat: Queue = antrean fisik (depan duluan), Stack = tumpukan piring (atas duluan).'
  },
  {
    mistake: 'Percabangan IF-THEN-ELSE tidak mencakup semua kemungkinan kondisi',
    impact: 'Ada kondisi data yang tidak tertangani (unhandled case), menyebabkan hasil program tidak sesuai harapan.',
    fix: 'Selalu sertakan cabang ELSE sebagai jaring pengaman untuk kondisi yang tidak terduga.'
  },
  {
    mistake: 'Pseudocode terlalu mirip kode program (menuliskan sintaks bahasa pemrograman tertentu)',
    impact: 'Pseudocode kehilangan sifatnya yang universal dan sulit dipahami lintas bahasa pemrograman.',
    fix: 'Gunakan bahasa natural terstruktur (INPUT, PROSES, JIKA-MAKA, SELAMA) tanpa syntax spesifik seperti kurung kurawal {}.'
  }
];
---

<MainLayout
  title="Elemen 1: Berpikir Komputasional (Computational Thinking) | Informatika SMK"
  description="Kuasai 4 Fondasi Berpikir Komputasional (Dekomposisi, Pengenalan Pola, Abstraksi, Algoritma) & Simulator Visualizer Interaktif."
>
  <div class="bk-page-container">
    <!-- Top Nav -->
    <div class="page-top-nav">
      <a href="/belajar/informatika" class="btn btn-outline btn-sm">
        ← Kembali ke Katalog Informatika
      </a>
    </div>

    <!-- Hero Intro -->
    <div class="intro-card glass-card">
      <div class="hero-badge">
        <span class="badge badge-cyan">SUPERPOWER PEMECAHAN MASALAH</span>
      </div>
      <h1 class="intro-title">Berpikir Komputasional: 4 Fondasi Utamanya</h1>
      <p class="intro-desc">
        <strong>Berpikir Komputasional (Computational Thinking)</strong> bukan sekadar tentang cara menulis program komputer, melainkan kerangka berpikir (*mindset*) untuk memecahkan persoalan kompleks secara logis, efisien, dan terstruktur.
      </p>
    </div>

    <!-- 4 Pillars Section -->
    <div class="section-title">
      <h2>4 Fondasi Utama Berpikir Komputasional</h2>
      <p>Setiap solusi perangkat lunak hebat selalu dibangun di atas 4 pilar dasar ini:</p>
    </div>

    <div class="pillars-grid">
      {pillars.map(p => (
        <div class="pillar-card glass-card">
          <div class="pillar-top">
            <span class="pillar-icon">{p.icon}</span>
            <div>
              <h3 class="pillar-title">{p.title}</h3>
              <span class="pillar-sub">{p.subtitle}</span>
            </div>
          </div>
          <p class="pillar-desc">{p.desc}</p>
          <div class="pillar-example">
            <strong>💡 Penerapan di Dunia RPL:</strong>
            <p>{p.example}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Deep Dive: Fondasi 4 - Perancangan Algoritma -->
    <div class="algo-deepdive-section">
      <div class="section-title">
        <span class="badge badge-cyan">MATERI MENDALAM</span>
        <h2>4. Perancangan Algoritma (Algorithm Design)</h2>
        <p>Pendalaman fondasi terakhir Berpikir Komputasional: notasi standar, struktur kontrol, algoritma searching &amp; sorting, struktur data Queue/Stack, hingga contoh pseudocode lengkap siap pakai untuk LKPD.</p>
      </div>

      <!-- 1. Flowchart vs Pseudocode -->
      <div class="algo-card glass-card">
        <h3 class="algo-card-title">4.1 Notasi Standar: Flowchart &amp; Pseudocode</h3>
        <p class="algo-card-intro">
          Sebelum menuliskan program, seorang pengembang perangkat lunak wajib merancang alur logika terlebih dahulu menggunakan dua notasi standar: <strong>Flowchart</strong> (diagram alir visual dengan simbol-simbol baku) dan <strong>Pseudocode</strong> (kode semu berbahasa natural terstruktur). Keduanya menggambarkan algoritma yang sama, namun Flowchart lebih mudah dibaca secara visual, sedangkan Pseudocode lebih dekat ke struktur kode program sesungguhnya.
        </p>
        <div class="symbol-legend-grid">
          {flowchartSymbols.map(s => (
            <div class="symbol-legend-item">
              <div class={`flow-shape flow-shape-${s.shape}`}><span>{s.label}</span></div>
              <p>{s.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- 2. 3 Struktur Kontrol Dasar -->
      <div class="algo-card glass-card">
        <h3 class="algo-card-title">4.2 Tiga Struktur Kontrol Dasar Algoritma</h3>
        <p class="algo-card-intro">Setiap algoritma, tidak peduli seberapa kompleks, selalu dibangun dari kombinasi 3 struktur kontrol dasar berikut:</p>
        <div class="control-structures-grid">
          {controlStructures.map(cs => (
            <div class="control-structure-card">
              <h4>{cs.title}</h4>
              <p class="cs-desc">{cs.desc}</p>
              <div class="mini-flowchart">
                {cs.flow.map((step, i) => (
                  <>
                    <div class={`flow-shape flow-shape-${step.shape} flow-shape-sm`}><span>{step.text}</span></div>
                    {i < cs.flow.length - 1 && <div class="flow-arrow-down">&darr;</div>}
                  </>
                ))}
              </div>
              <div class="cs-example"><span class="material-symbols-rounded icon-sm" style="color: var(--m3-warning);">lightbulb</span> <strong>Contoh RPL:</strong> {cs.example}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- 3. Perbandingan Algoritma Searching -->
      <div class="algo-card glass-card">
        <h3 class="algo-card-title">4.3 Algoritma Pencarian Data (Searching)</h3>
        <table class="sample-table">
          <thead>
            <tr>
              <th style="width: 140px;">Algoritma</th>
              <th>Cara Kerja</th>
              <th style="width: 160px;">Kompleksitas</th>
              <th>Kapan Dipakai</th>
              <th>Contoh RPL</th>
            </tr>
          </thead>
          <tbody>
            {searchingComparison.map(s => (
              <tr>
                <td><strong>{s.name}</strong></td>
                <td>{s.howItWorks}</td>
                <td><code>{s.complexity.split(' — ')[0]}</code></td>
                <td>{s.whenToUse}</td>
                <td>{s.rplExample}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- 4. Perbandingan Algoritma Sorting -->
      <div class="algo-card glass-card">
        <h3 class="algo-card-title">4.4 Algoritma Pengurutan Data (Sorting)</h3>
        <table class="sample-table">
          <thead>
            <tr>
              <th style="width: 140px;">Algoritma</th>
              <th>Cara Kerja</th>
              <th style="width: 160px;">Kompleksitas</th>
              <th>Trade-off</th>
              <th>Contoh RPL</th>
            </tr>
          </thead>
          <tbody>
            {sortingComparison.map(s => (
              <tr>
                <td><strong>{s.name}</strong></td>
                <td>{s.howItWorks}</td>
                <td><code>{s.complexity.split(' — ')[0]}</code></td>
                <td>{s.tradeoff}</td>
                <td>{s.rplExample}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <p class="algo-hint-note"><span class="material-symbols-rounded icon-sm text-m3-primary">info</span> Bandingkan cara kerja ketiganya secara visual pada <strong>Interactive Visualizer</strong> di bagian bawah halaman ini.</p>
      </div>

      <!-- 5. Queue & Stack -->
      <div class="algo-card glass-card">
        <h3 class="algo-card-title">4.5 Struktur Data Queue (FIFO) &amp; Stack (LIFO)</h3>
        <div class="ds-grid">
          {dataStructures.map(ds => (
            <div class="ds-card">
              <h4>{ds.name}</h4>
              <p><strong>Prinsip:</strong> {ds.principle}</p>
              <p><strong>Operasi:</strong> {ds.operations}</p>
              <div class="ds-example"><span class="material-symbols-rounded icon-sm" style="color: var(--m3-warning);">lightbulb</span> <strong>Contoh RPL:</strong> {ds.rplExample}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- 6. Contoh Pseudocode Lengkap: Flowchart + Pseudocode side-by-side -->
      <div class="algo-card glass-card">
        <h3 class="algo-card-title">4.6 Studi Kasus Lengkap: Alur Checkout Kantin Digital</h3>
        <p class="algo-card-intro">Contoh berikut menggabungkan ketiga struktur kontrol (Sequential, Selection, Iteration) sekaligus struktur data Queue dalam satu alur nyata — checkout pembayaran di aplikasi kantin digital.</p>
        <div class="flowchart-pseudocode-pair">
          <div class="fp-flowchart">
            <span class="fp-label">Flowchart</span>
            <div class="mini-flowchart mini-flowchart-lg">
              {checkoutFlowchart.map((step, i) => (
                <>
                  <div class={`flow-shape flow-shape-${step.shape}`}><span>{step.text}</span></div>
                  {i < checkoutFlowchart.length - 1 && <div class="flow-arrow-down">&darr;</div>}
                </>
              ))}
            </div>
          </div>
          <div class="fp-pseudocode">
            <span class="fp-label">Pseudocode</span>
            <pre class="algo-pseudocode-block"><code>{checkoutPseudocode}</code></pre>
          </div>
        </div>
      </div>

      <!-- 7. Kesalahan Umum -->
      <div class="algo-card glass-card algo-mistakes-card">
        <h3 class="algo-card-title">4.7 Kesalahan Umum Siswa dalam Merancang Algoritma</h3>
        <p class="algo-card-intro">Perhatikan 4 kesalahan yang paling sering ditemukan saat menilai LKPD Berpikir Komputasional — hindari ini sebelum mengumpulkan tugas:</p>
        <div class="mistakes-list">
          {commonMistakes.map((m, i) => (
            <div class="mistake-item">
              <span class="mistake-num">{i + 1}</span>
              <div class="mistake-body">
                <strong class="mistake-title"><span class="material-symbols-rounded icon-sm text-m3-warning">warning</span> {m.mistake}</strong>
                <p class="mistake-impact"><em>Dampak:</em> {m.impact}</p>
                <p class="mistake-fix"><span class="material-symbols-rounded icon-sm text-m3-success">check_circle</span> <em>Solusi:</em> {m.fix}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Data vs Informasi Section -->
    <div class="data-info-card glass-card">
      <h2>Konsep Siklus Data &amp; Informasi (Input → Proses → Output)</h2>
      <p>
        Data adalah fakta/nilai mentah (misal: angka <code>37</code> atau <code>85</code>). Ketika data diolah menggunakan <strong>Algoritma</strong> yang tepat dan diberi konteks, data berubah menjadi <strong>Informasi</strong> bermakna untuk pengambilan keputusan (misal: <code>"Suhu Budi 37°C = Normal"</code>).
      </p>
      <div class="cycle-grid">
        <div class="cycle-step">
          <span class="step-num">1. INPUT</span>
          <strong>Data Mentah</strong>
          <span>Angka, Teks, Simbol, Gambar Mentah</span>
        </div>
        <div class="cycle-arrow">&rarr;</div>
        <div class="cycle-step">
          <span class="step-num">2. PROSES</span>
