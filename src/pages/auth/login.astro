---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSessionUser } from '../../lib/auth';

const sessionId = Astro.cookies.get('session_id')?.value;
if (sessionId) {
  try {
    const user = await getSessionUser(sessionId);
    if (user) {
      if (user.role !== 'admin' && user.role !== 'teacher' && (!user.class_name || user.class_name.trim() === '')) {
        Astro.cookies.delete('session_id', { path: '/' });
      } else {
        const redirectTarget = Astro.url.searchParams.get('redirect') || '/belajar';
        return Astro.redirect(redirectTarget);
      }
    }
  } catch (e) {
    // Ignore error if DB unreachable during build
  }
}

const reason = Astro.url.searchParams.get('reason');
const errorParam = Astro.url.searchParams.get('error');
const isMissingClass = reason === 'missing_class' || errorParam === 'missing_class';
---

<MainLayout title="Masuk Akun | Platform Pembelajaran Informatika & RPL" description="Halaman masuk (login) akun siswa untuk mengakses modul pembelajaran & praktikum interaktif.">
  <div class="auth-container">
    <div class="auth-card m3-card m3-card-elevated">
      <div class="auth-header">
        <div class="m3-chip m3-chip-tonal-primary auth-badge" id="auth-badge">
          <span class="material-symbols-rounded">login</span>
          <span>Akses Masuk</span>
        </div>
        <h1 id="auth-title">Selamat Datang Kembali</h1>
        <p id="auth-desc">Masuk ke akun Anda untuk mengakses modul pembelajaran &amp; praktikum interaktif.</p>
      </div>

      <div id="error-banner" class="alert alert-error" style={isMissingClass ? "display: block;" : "display: none;"}>
        {isMissingClass ? "Identitas Kelas wajib diisi. Silakan login kembali dan pilih kelas Anda." : ""}
      </div>
      <div id="success-banner" class="alert alert-success" style="display: none;"></div>

      <!-- Step 1: Login Form -->
      <form id="login-form" class="auth-form">
        <div class="form-group">
          <label for="email">Alamat Email</label>
          <input
            type="email"
            id="email"
            name="email"
            placeholder="contoh@siswa.smk.sch.id"
            required
            autocomplete="email"
          />
        </div>

        <div class="form-group">
          <label for="password">Password</label>
          <input
            type="password"
            id="password"
            name="password"
            placeholder="Masukkan password Anda"
            required
            autocomplete="current-password"
          />
        </div>

        <button type="submit" id="submit-btn" class="m3-btn m3-btn-filled auth-submit-btn">
          <span class="btn-text">Masuk Sekarang</span>
          <span class="btn-spinner" style="display: none;">Memproses...</span>
        </button>
      </form>

      <!-- Step 2: Complete Class Identity Form (Interception) -->
      <div id="class-step" style="display: none;">
        <form id="class-form" class="auth-form">
          <input type="hidden" id="class-user-id" name="userId" value="" />
          
          <div class="form-group">
            <label for="class-select">Pilih Kelas / Rombel Anda</label>
            <select id="class-select" name="className" required>
              <option value="" disabled selected>-- Pilih Kelas / Rombel --</option>
              <optgroup label="Kelas 10 (Fase E)">
                <option value="10 RPL 1">10 RPL 1 (X RPL 1)</option>
                <option value="10 RPL 2">10 RPL 2 (X RPL 2)</option>
                <option value="10 RPL 3">10 RPL 3 (X RPL 3)</option>
                <option value="10 RPL 4">10 RPL 4 (X RPL 4)</option>
              </optgroup>
              <optgroup label="Kelas 11 (XI RPL)">
                <option value="11 RPL 1">11 RPL 1 (XI RPL 1)</option>
                <option value="11 RPL 2">11 RPL 2 (XI RPL 2)</option>
                <option value="11 RPL 3">11 RPL 3 (XI RPL 3)</option>
                <option value="11 RPL 4">11 RPL 4 (XI RPL 4)</option>
              </optgroup>
              <optgroup label="Kelas 12 (XII RPL)">
                <option value="12 RPL 1">12 RPL 1 (XII RPL 1)</option>
                <option value="12 RPL 2">12 RPL 2 (XII RPL 2)</option>
                <option value="12 RPL 3">12 RPL 3 (XII RPL 3)</option>
                <option value="12 RPL 4">12 RPL 4 (XII RPL 4)</option>
              </optgroup>
            </select>
          </div>

          <button type="submit" id="class-submit-btn" class="m3-btn m3-btn-filled auth-submit-btn">
            <span class="btn-text">Simpan Kelas &amp; Lanjutkan</span>
            <span class="btn-spinner" style="display: none;">Memproses...</span>
          </button>
        </form>
      </div>

      <div class="auth-footer" id="auth-footer">
        <p>Belum memiliki akun? <a href="/auth/register">Daftar sekarang</a></p>
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById('login-form') as HTMLFormElement | null;
  const errorBanner = document.getElementById('error-banner') as HTMLDivElement | null;
  const successBanner = document.getElementById('success-banner') as HTMLDivElement | null;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

  // Check URL parameters for missing_class error banner
  const urlParams = new URLSearchParams(window.location.search);
  const reason = urlParams.get('reason');
  const errorParam = urlParams.get('error');
  if ((reason === 'missing_class' || errorParam === 'missing_class') && errorBanner) {
    errorBanner.innerText = 'Identitas Kelas wajib diisi. Silakan login kembali dan pilih kelas Anda.';
    errorBanner.style.display = 'block';
  }

  if (form && submitBtn && errorBanner && successBanner) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const emailInput = document.getElementById('email') as HTMLInputElement;
      const passwordInput = document.getElementById('password') as HTMLInputElement;

      const email = emailInput.value.trim();
      const password = passwordInput.value;

      errorBanner.style.display = 'none';
      successBanner.style.display = 'none';

      const btnText = submitBtn.querySelector('.btn-text') as HTMLSpanElement;
      const btnSpinner = submitBtn.querySelector('.btn-spinner') as HTMLSpanElement;

      submitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline';

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Login gagal');
        }

        // Intercept requiresClass response from login endpoint
        if (data.requiresClass) {
          const classStep = document.getElementById('class-step');
          const classUserIdInput = document.getElementById('class-user-id') as HTMLInputElement | null;
          const authBadge = document.getElementById('auth-badge');
          const authTitle = document.getElementById('auth-title');
          const authDesc = document.getElementById('auth-desc');

          if (classUserIdInput) {
            classUserIdInput.value = data.userId || '';
          }

          if (authBadge) authBadge.innerText = 'LANGKAH 2 DARI 2';
          if (authTitle) authTitle.innerText = 'Lengkapi Identitas Kelas';
          if (authDesc) authDesc.innerText = 'Identitas kelas wajib diisi untuk mengakses platform pembelajaran.';

          form.style.display = 'none';
          if (classStep) classStep.style.display = 'block';

          errorBanner.innerText = data.message || 'Identitas kelas wajib diisi. Silakan pilih kelas Anda.';
          errorBanner.style.display = 'block';

          return;
        }

        successBanner.innerText = 'Login berhasil! Mengalihkan ke platform...';
        successBanner.style.display = 'block';

        setTimeout(() => {
          const redirectTarget = urlParams.get('redirect') || '/belajar';
          window.location.href = redirectTarget;
        }, 1000);
      } catch (err: any) {
        errorBanner.innerText = err.message || 'Terjadi kesalahan. Silakan coba lagi.';
        errorBanner.style.display = 'block';
        submitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnSpinner) btnSpinner.style.display = 'none';
      }
    });
  }

  // Handle Step 2 Class Form Submit
  const classForm = document.getElementById('class-form') as HTMLFormElement | null;
  const classSubmitBtn = document.getElementById('class-submit-btn') as HTMLButtonElement | null;

  if (classForm && classSubmitBtn) {
    classForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const classSelect = document.getElementById('class-select') as HTMLSelectElement | null;
      const userIdInput = document.getElementById('class-user-id') as HTMLInputElement | null;

      const className = classSelect?.value.trim() || '';
      const userId = userIdInput?.value || '';

      if (!className) {
        if (errorBanner) {
          errorBanner.innerText = 'Silakan pilih kelas Anda terlebih dahulu';
          errorBanner.style.display = 'block';
        }
        return;
      }

      if (errorBanner) errorBanner.style.display = 'none';
      if (successBanner) successBanner.style.display = 'none';

      const btnText = classSubmitBtn.querySelector('.btn-text') as HTMLSpanElement;
      const btnSpinner = classSubmitBtn.querySelector('.btn-spinner') as HTMLSpanElement;

      classSubmitBtn.disabled = true;
      if (btnText) btnText.style.display = 'none';
      if (btnSpinner) btnSpinner.style.display = 'inline';

      try {
        const response = await fetch('/api/auth/update-class', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, className }),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Gagal menyelaraskan kelas');
        }

        if (successBanner) {
          successBanner.innerText = 'Identitas kelas berhasil disimpan! Mengalihkan ke platform...';
          successBanner.style.display = 'block';
        }

        setTimeout(() => {
          const redirectTarget = urlParams.get('redirect') || '/belajar';
          window.location.href = redirectTarget;
        }, 1000);
      } catch (err: any) {
        if (errorBanner) {
          errorBanner.innerText = err.message || 'Terjadi kesalahan saat menyimpan kelas.';
          errorBanner.style.display = 'block';
        }
        classSubmitBtn.disabled = false;
        if (btnText) btnText.style.display = 'inline';
        if (btnSpinner) btnSpinner.style.display = 'none';
      }
    });
  }
</script>

<style>
  .auth-container {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: calc(80vh - 4rem);
    padding: 2rem 1rem;
  }

  .auth-card {
    width: 100%;
    max-width: 440px;
    padding: 2.5rem 2rem;
    border-radius: var(--radius-2xl, 28px);
    background: var(--m3-surface-container-low, #f7f3f9);
    border: 1px solid var(--m3-outline-variant, #c4c6d0);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .auth-badge {
    margin-bottom: 0.5rem;
    font-size: 0.75rem;
  }

  .auth-header h1 {
    font-size: 1.65rem;
    font-weight: 700;
    margin: 0;
    color: var(--m3-on-surface, #1a1b1f);
  }

  .auth-header p {
    font-size: 0.9rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.5;
    margin: 0;
  }

  .alert {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md, 8px);
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .alert-error {
    background-color: var(--m3-error-container, #ffdad6);
    border: 1px solid var(--m3-error, #ba1a1a);
    color: var(--m3-on-error-container, #410002);
  }

  .alert-success {
    background-color: #d4edda;
    border: 1px solid #28a745;
    color: #155724;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .form-group label {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md, 8px);
    background: var(--m3-surface, #fdfcff);
    border: 1px solid var(--m3-outline, #74777f);
    color: var(--m3-on-surface, #1a1b1f);
    font-size: 0.95rem;
    outline: none;
    transition: border-color var(--transition-fast);
    box-sizing: border-box;
  }

  .form-group input:focus,
  .form-group select:focus {
    border-color: var(--m3-primary, #005ac1);
    border-width: 2px;
  }

  .auth-submit-btn {
    width: 100%;
    height: 48px;
    font-size: 0.95rem;
    margin-top: 0.5rem;
  }

  .auth-footer {
    margin-top: 1.75rem;
    text-align: center;
    font-size: 0.875rem;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .auth-footer a {
    color: var(--m3-primary, #005ac1);
    font-weight: 600;
    text-decoration: none;
  }

  .auth-footer a:hover {
    text-decoration: underline;
  }
</style>

