---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const modules = await getCollection('modules');

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}
---

<MainLayout 
  title="Suhendar Aryadi, S.Pd.,Gr. | Guru RPL SMK & Tech Educator"
  description="Website resmi & portal edukasi Suhendar Aryadi, S.Pd.,Gr. - Guru Jurusan Rekayasa Perangkat Lunak (RPL) SMK. Berbagi modul pembelajaran, tutorial web development, dan portofolio vokasi IT."
>
  <!-- M3 Hero Section -->
  <section class="m3-hero-section">
    <div class="m3-hero-container">
      <!-- Announcement Tonal Chip -->
      <div class="m3-chip m3-chip-tonal-primary m3-hero-chip">
        <span class="material-symbols-rounded">campaign</span>
        <span>Kurikulum Merdeka Informatika &amp; RPL 2026</span>
      </div>
      
      <!-- Big Centered Title -->
      <h1 class="m3-hero-title">
        Mengembangkan Potensi Vokasi IT &amp; <span class="highlight-primary">Pemrograman Web</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="m3-hero-subtitle">
        Selamat datang di portal pembelajaran resmi <strong>Suhendar Aryadi, S.Pd.,Gr.</strong> Pelajari 8 Elemen Informatika, 40 Modul SQL Interaktif, serta 4 Pilar Berpikir Komputasional secara gratis langsung di browser.
      </p>

      <!-- Dual Action Buttons -->
      <div class="m3-hero-actions">
        <a href="/belajar" class="m3-btn m3-btn-filled m3-hero-btn">
          <span class="material-symbols-rounded">rocket_launch</span>
          <span>Mulai Belajar Gratis</span>
        </a>
        <a href="/materi" class="m3-btn m3-btn-tonal m3-hero-btn">
          <span class="material-symbols-rounded">menu_book</span>
          <span>Lihat Modul RPL</span>
        </a>
      </div>

      <!-- Tech Stack Trust Bar -->
      <div class="m3-trust-bar">
        <p class="m3-trust-label">PLATFORM BELAJAR BERBASIS TEKNOLOGI PENDIDIKAN VOKASI MODERN</p>
        <div class="m3-tech-chips">
          <span class="m3-chip m3-chip-outline">Astro v4</span>
          <span class="m3-chip m3-chip-outline">Neon Postgres</span>
          <span class="m3-chip m3-chip-outline">Python WASM</span>
          <span class="m3-chip m3-chip-outline">SQLite WASM</span>
          <span class="m3-chip m3-chip-outline">TypeScript</span>
          <span class="m3-chip m3-chip-outline">Vercel SSR</span>
        </div>
      </div>

      <!-- 3 Feature Highlights Below -->
      <div class="m3-features-grid">
        <div class="m3-card m3-card-elevated m3-feature-card">
          <div class="feature-card-header">
            <div class="m3-icon-badge">
              <span class="material-symbols-rounded">memory</span>
            </div>
            <span class="m3-chip m3-chip-tonal-primary">FASE E KELAS X</span>
          </div>
          <h3 class="feature-card-title">Kurikulum Informatika</h3>
          <p class="feature-card-desc">8 Elemen Inti Kurikulum Merdeka dilengkapi Simulator Visual BK dan Python WASM Sandbox.</p>
        </div>

        <div class="m3-card m3-card-elevated m3-feature-card">
          <div class="feature-card-header">
            <div class="m3-icon-badge">
              <span class="material-symbols-rounded">database</span>
            </div>
            <span class="m3-chip m3-chip-tonal-secondary">FASE F KELAS XI</span>
          </div>
          <h3 class="feature-card-title">SQL Masterclass 40 Modul</h3>
          <p class="feature-card-desc">Latihan DDL &amp; DML langsung di browser dengan evaluasi kueri otomatis &amp; Sertifikat Digital.</p>
        </div>

        <div class="m3-card m3-card-elevated m3-feature-card">
          <div class="feature-card-header">
            <div class="m3-icon-badge">
              <span class="material-symbols-rounded">assignment</span>
            </div>
            <span class="m3-chip m3-chip-tonal-tertiary">EVALUASI ONLINE</span>
          </div>
          <h3 class="feature-card-title">LKPD Digital Interaktif</h3>
          <p class="feature-card-desc">Lembar kerja peserta didik terintegrasi LMS Guru, ekspor PDF, dan penilaian real-time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Posts Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Artikel & Tutorial Pilihan</h2>
        <p class="section-subtitle">Wawasan teknis dan panduan praktis pengembangan perangkat lunak</p>
      </div>
      <a href="/blog" class="section-link">Lihat Semua Artikel &rarr;</a>
    </div>

    {featuredPosts.length > 0 ? (
      <div class="grid grid-posts">
        {featuredPosts.map((post) => (
          <article class="m3-card m3-card-elevated post-card">
            <!-- Article Thumbnail Image Container -->
            <a href={`/blog/${post.slug}`} class="post-thumb-wrapper">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="post-thumb-img" loading="lazy" />
              ) : (
                <div class="post-thumb-placeholder">
                  <span class="material-symbols-rounded thumb-m3-icon">article</span>
                  <span class="thumb-topic">{post.data.category}</span>
                </div>
              )}
              <span class="m3-chip m3-chip-tonal-primary post-badge-floating">{post.data.category}</span>
            </a>

            <div class="post-body">
              <div class="post-meta-top">
                <time datetime={post.data.pubDate.toISOString()} class="post-date">
                  {formatDate(post.data.pubDate)}
                </time>
                <span class="m3-chip m3-chip-outline read-time-chip">5 min baca</span>
              </div>
              
              <h3 class="post-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              
              <p class="post-description">{post.data.description}</p>
              
              <div class="post-footer">
                <div class="post-author">
                  <div class="author-avatar">{post.data.author.charAt(0)}</div>
                  <span class="author-name">{post.data.author}</span>
                </div>
                <a href={`/blog/${post.slug}`} class="m3-btn m3-btn-text read-more-btn">
                  <span>Baca</span>
                  <span class="material-symbols-rounded">arrow_forward</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">Belum ada artikel pilihan saat ini.</p>
    )}
  </section>

  <!-- Modules Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Modul Pembelajaran RPL</h2>
        <p class="section-subtitle">Bahan ajar dan panduan praktikum SMK Rekayasa Perangkat Lunak</p>
      </div>
      <a href="/materi" class="m3-btn m3-btn-text section-link">
        <span>Semua Modul</span>
        <span class="material-symbols-rounded">arrow_forward</span>
      </a>
    </div>

    {modules.length > 0 ? (
      <div class="grid grid-modules">
        {modules.map((mod) => (
          <div class="m3-card m3-card-elevated module-card">
            <!-- Module Thumbnail Container -->
            <a href={`/materi/${mod.slug}`} class="module-thumb-wrapper">
              {mod.data.image ? (
                <img src={mod.data.image} alt={mod.data.title} class="module-thumb-img" loading="lazy" />
              ) : (
                <div class="module-thumb-placeholder">
                  <span class="material-symbols-rounded thumb-m3-icon">menu_book</span>
                  <span class="thumb-subject">{mod.data.subject}</span>
                </div>
              )}
              <span class="m3-chip m3-chip-tonal-secondary module-grade-badge">{mod.data.grade}</span>
            </a>

            <div class="module-body">
              <h3 class="module-title">
                <a href={`/materi/${mod.slug}`}>{mod.data.title}</a>
              </h3>

              <div class="module-tags">
                {mod.data.tags.map((tag) => (
                  <span class="m3-chip m3-chip-outline tag-chip">#{tag}</span>
                ))}
              </div>

              <div class="module-footer">
                <a href={`/materi/${mod.slug}`} class="m3-btn m3-btn-filled module-btn">
                  <span>Pelajari Modul</span>
                </a>
                {mod.data.downloadUrl && (
                  <a href={mod.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="m3-btn m3-btn-outlined module-btn">
                    <span>PDF</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty-state">Belum ada modul pembelajaran yang diunggah.</p>
    )}
  </section>
</MainLayout>

<style>
  /* =========================================================
     M3 HERO SECTION
     ========================================================= */
  .m3-hero-section {
    width: 100%;
    padding: 3.5rem 0 4rem;
    position: relative;
    border-bottom: 1px solid var(--m3-outline-variant, #c4c6d0);
  }

  .m3-hero-container {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0 1rem;
    box-sizing: border-box;
  }

  .m3-hero-chip {
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    gap: 0.4rem;
  }

  .m3-hero-title {
    font-size: clamp(2.15rem, 5vw, 3.25rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--m3-on-surface, #1a1b1f);
    margin-bottom: 1.25rem;
    max-width: 860px;
  }

  .highlight-primary {
    color: var(--m3-primary, #005ac1);
  }

  .m3-hero-subtitle {
    font-size: 1.05rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.65;
    max-width: 720px;
    margin-bottom: 2.25rem;
  }

  .m3-hero-subtitle strong {
    color: var(--m3-on-surface, #1a1b1f);
  }

  .m3-hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .m3-hero-btn {
    height: 48px;
    padding: 0 1.75rem;
    font-size: 0.95rem;
    gap: 0.5rem;
  }

  /* Trust Bar */
  .m3-trust-bar {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    border-top: 1px solid var(--m3-outline-variant, #c4c6d0);
    padding-top: 2rem;
    margin-bottom: 2.5rem;
  }

  .m3-trust-label {
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--m3-outline, #74777f);
  }

  .m3-tech-chips {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  /* Feature Grid */
  .m3-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
  }

  @media (max-width: 820px) {
    .m3-features-grid {
      grid-template-columns: 1fr;
    }
  }

  .m3-feature-card {
    padding: 1.5rem;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    border-radius: var(--radius-xl, 16px);
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .m3-icon-badge {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-md, 8px);
    background: var(--m3-primary-container, #d8e2ff);
    color: var(--m3-on-primary-container, #001a41);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--m3-on-surface, #1a1b1f);
  }

  .feature-card-desc {
    font-size: 0.875rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.55;
  }

  /* Section Styling */
  .section {
    margin-top: 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--m3-on-surface, #1a1b1f);
    line-height: 1.3;
  }

  .section-subtitle {
    font-size: 0.9375rem;
    color: var(--m3-on-surface-variant, #44474f);
    margin-top: 0.25rem;
  }

  .section-link {
    font-size: 0.875rem;
    font-weight: 600;
    gap: 0.35rem;
    white-space: nowrap;
  }

  /* Grid Layouts */
  .grid {
    display: grid;
    gap: 1.75rem;
  }

  .grid-posts,
  .grid-modules {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  @media (max-width: 640px) {
    .grid-posts, .grid-modules {
      grid-template-columns: 1fr;
    }
  }

  /* Article Post Card */
  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xl, 16px);
  }

  .post-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--m3-surface-container, #f1edf3);
    display: block;
  }

  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .post-card:hover .post-thumb-img {
    transform: scale(1.05);
  }

  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--m3-surface-container-high, #ebe7ed);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .thumb-m3-icon {
    font-size: 2.5rem;
    color: var(--m3-primary, #005ac1);
  }

  .thumb-topic {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-badge-floating {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 3;
    font-size: 0.75rem;
  }

  .post-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--m3-outline, #74777f);
  }

  .read-time-chip {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-title a {
    color: var(--m3-on-surface, #1a1b1f);
  }

  .post-title a:hover {
    color: var(--m3-primary, #005ac1);
  }

  .post-description {
    font-size: 0.9rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--m3-outline-variant, #c4c6d0);
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--m3-primary-container, #d8e2ff);
    color: var(--m3-on-primary-container, #001a41);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-name {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .read-more-btn {
    font-size: 0.8125rem;
    font-weight: 600;
    gap: 0.25rem;
  }

  /* Module Card */
  .module-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xl, 16px);
  }

  .module-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--m3-surface-container, #f1edf3);
    display: block;
  }

  .module-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .module-card:hover .module-thumb-img {
    transform: scale(1.05);
  }

  .module-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--m3-surface-container-high, #ebe7ed);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .thumb-subject {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .module-grade-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 3;
    font-size: 0.75rem;
  }

  .module-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .module-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 1rem;
    flex: 1;
  }

  .module-title a {
    color: var(--m3-on-surface, #1a1b1f);
  }

  .module-title a:hover {
    color: var(--m3-primary, #005ac1);
  }

  .module-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tag-chip {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .module-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--m3-outline-variant, #c4c6d0);
  }

  .module-btn {
    height: 38px;
    padding: 0 1.15rem;
    font-size: 0.8125rem;
  }

  .empty-state {
    color: var(--m3-outline, #74777f);
    font-style: italic;
  }
</style>

