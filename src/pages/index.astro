---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const modules = await getCollection('modules');

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}
---

<MainLayout 
  title="Suhendar Aryadi, S.Pd.,Gr. | Guru RPL SMK & Tech Educator"
  description="Website resmi & portal edukasi Suhendar Aryadi, S.Pd.,Gr. - Guru Jurusan Rekayasa Perangkat Lunak (RPL) SMK. Berbagi modul pembelajaran, tutorial web development, dan portofolio vokasi IT."
>
  <!-- M3 Hero Section with Educational Intelligence & Genius Banner -->
  <section class="m3-hero-section">
    <div class="m3-hero-container">
      <div class="m3-hero-grid">
        
        <!-- Left Content Column: Educational Copywriting & Actions -->
        <div class="m3-hero-content">
          <!-- Announcement Chip -->
          <div class="m3-chip m3-chip-tonal-primary m3-hero-chip">
            <span class="material-symbols-rounded">school</span>
            <span>Portal Edukasi RPL &amp; Informatika SMK</span>
          </div>

          <!-- Hero Headline -->
          <h1 class="m3-hero-title">
            Mengasah Nalar Logika &amp; <span class="highlight-primary">Kecerdasan Komputasional</span>
          </h1>

          <!-- Educational Subtitle -->
          <p class="m3-hero-subtitle">
            Media belajar interaktif bersama <strong>Pak Suhendar Aryadi, S.Pd.,Gr.</strong> Didesain khusus bagi siswa SMK untuk menguasai Algoritma, Basis Data SQL, dan Rekayasa Web modern secara praktis langsung di peramban.
          </p>

          <!-- Quick Proof Metric Chips -->
          <div class="m3-hero-metrics">
            <div class="metric-item">
              <span class="material-symbols-rounded metric-icon text-m3-primary">database</span>
              <div class="metric-text">
                <span class="metric-val">40+</span>
                <span class="metric-label">Modul SQL</span>
              </div>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-item">
              <span class="material-symbols-rounded metric-icon text-m3-secondary">memory</span>
              <div class="metric-text">
                <span class="metric-val">8</span>
                <span class="metric-label">Elemen Informatika</span>
              </div>
            </div>
            <div class="metric-divider"></div>
            <div class="metric-item">
              <span class="material-symbols-rounded metric-icon text-m3-tertiary">terminal</span>
              <div class="metric-text">
                <span class="metric-val">100%</span>
                <span class="metric-label">Praktik di Browser</span>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="m3-hero-actions">
            <a href="/belajar" class="m3-btn m3-btn-filled m3-hero-btn">
              <span class="material-symbols-rounded">rocket_launch</span>
              <span>Mulai Belajar Gratis</span>
            </a>
            <a href="/materi" class="m3-btn m3-btn-tonal m3-hero-btn">
              <span class="material-symbols-rounded">menu_book</span>
              <span>Bahan Ajar &amp; Modul</span>
            </a>
          </div>
        </div>

        <!-- Right Visual Column: Intelligence & Genius SVG Graphic -->
        <div class="m3-hero-visual-col">
          <div class="genius-graphic-card">
            <!-- Floating Badge 1: Top Right -->
            <div class="floating-badge badge-top-right">
              <span class="material-symbols-rounded icon-badge text-m3-primary">psychology</span>
              <span>Berpikir Komputasional</span>
            </div>

            <!-- Floating Badge 2: Middle Left -->
            <div class="floating-badge badge-mid-left">
              <span class="material-symbols-rounded icon-badge text-m3-secondary">terminal</span>
              <span>Nalar Algoritma &amp; SQL</span>
            </div>

            <!-- Floating Badge 3: Bottom Right -->
            <div class="floating-badge badge-bottom-right">
              <span class="material-symbols-rounded icon-badge text-amber">auto_awesome</span>
              <span>Daya Cipta &amp; Logika</span>
            </div>

            <!-- SVG Vector Graphic: Computational Intelligence, Neural Synapses, and Genius Nucleus -->
            <svg 
              viewBox="0 0 540 500" 
              class="genius-hero-svg" 
              xmlns="http://www.w3.org/2000/svg" 
              role="img" 
              aria-label="Grafik Vektor Kecerdasan dan Kejeniusan Komputasional"
            >
              <defs>
                <!-- Central Radiant Glow for Intelligence -->
                <radialGradient id="core-aura-glow" cx="50%" cy="45%" r="55%">
                  <stop offset="0%" stop-color="#005ac1" stop-opacity="0.25" />
                  <stop offset="50%" stop-color="#0284c7" stop-opacity="0.10" />
                  <stop offset="100%" stop-color="#005ac1" stop-opacity="0" />
                </radialGradient>

                <!-- Golden Spark of Genius (Eureka Glow) -->
                <radialGradient id="eureka-gold-glow" cx="50%" cy="50%" r="50%">
                  <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.9" />
                  <stop offset="45%" stop-color="#f59e0b" stop-opacity="0.35" />
                  <stop offset="100%" stop-color="#d97706" stop-opacity="0" />
                </radialGradient>

                <!-- Mind Profile Silhouette Gradient -->
                <linearGradient id="silhouette-fill-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#005ac1" stop-opacity="0.12" />
                  <stop offset="60%" stop-color="#0284c7" stop-opacity="0.06" />
                  <stop offset="100%" stop-color="#6750a4" stop-opacity="0.02" />
                </linearGradient>

                <!-- Neural Connection Gradient -->
                <linearGradient id="synaptic-line-grad" x1="0%" y1="0%" x2="100%" y2="100%">
                  <stop offset="0%" stop-color="#005ac1" />
                  <stop offset="45%" stop-color="#0284c7" />
                  <stop offset="85%" stop-color="#7c3aed" />
                  <stop offset="100%" stop-color="#f59e0b" />
                </linearGradient>

                <!-- Soft Glow Filter -->
                <filter id="m3-glow-filter" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="5" result="blur" />
                  <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
              </defs>

              <!-- Layer 1: Ambient Background Aura -->
              <circle cx="280" cy="235" r="195" fill="url(#core-aura-glow)" />

              <!-- Layer 2: Concentric & Tilted Science / Logic Orbital Rings -->
              <g class="genius-orbital-system">
                <!-- Outer Atomic Ring 1 -->
                <ellipse 
                  cx="280" cy="235" rx="215" ry="90" 
                  transform="rotate(-28 280 235)" 
                  fill="none" 
                  stroke="#005ac1" 
                  stroke-width="1.5" 
                  stroke-dasharray="8 6" 
                  opacity="0.45" 
                  class="orbit-ring orbit-ring-1"
                />
                <!-- Inner Atomic Ring 2 -->
                <ellipse 
                  cx="280" cy="235" rx="195" ry="80" 
                  transform="rotate(35 280 235)" 
                  fill="none" 
                  stroke="#7c3aed" 
                  stroke-width="1.5" 
                  stroke-dasharray="6 8" 
                  opacity="0.4" 
                  class="orbit-ring orbit-ring-2"
                />
                <!-- Concentric Logic Circle -->
                <circle 
                  cx="280" cy="235" r="145" 
                  fill="none" 
                  stroke="#0284c7" 
                  stroke-width="1" 
                  stroke-dasharray="4 8" 
                  opacity="0.35" 
                  class="orbit-ring orbit-ring-3"
                />

                <!-- Orbiting Particles / Energy Nodes -->
                <circle cx="100" cy="180" r="5" fill="#0284c7" filter="url(#m3-glow-filter)" class="orbit-particle p1" />
                <circle cx="455" cy="170" r="4.5" fill="#fbbf24" filter="url(#m3-glow-filter)" class="orbit-particle p2" />
                <circle cx="435" cy="315" r="4" fill="#7c3aed" filter="url(#m3-glow-filter)" class="orbit-particle p3" />
                <circle cx="125" cy="305" r="4" fill="#10b981" filter="url(#m3-glow-filter)" class="orbit-particle p4" />
              </g>

              <!-- Layer 3: The Mind Profile Silhouette (Siluet Kepala Nalar Komputasional) -->
              <g class="genius-head-silhouette">
                <!-- Base Profile Curve facing right -->
                <path 
                  d="M 190,410 C 190,375 210,355 230,345 C 220,320 215,285 215,245 C 215,160 265,115 340,115 C 410,115 450,155 450,215 C 450,248 435,268 430,288 C 428,298 430,308 438,315 C 445,322 444,332 434,338 C 418,344 402,345 390,350 C 378,356 372,372 370,410 Z" 
                  fill="url(#silhouette-fill-grad)" 
                  stroke="#005ac1" 
                  stroke-width="2.5" 
                  stroke-linejoin="round"
                  class="head-outline"
                />
                <!-- Inner Cranium Boundary (Arsitektur Otak Berpikir) -->
                <path 
                  d="M 235,250 C 235,175 275,135 340,135 C 400,135 430,170 430,225 C 430,265 405,295 365,305 C 330,315 280,310 245,280 C 238,272 235,262 235,250 Z" 
                  fill="none" 
                  stroke="#0284c7" 
                  stroke-width="1.5" 
                  stroke-dasharray="5 5" 
                  opacity="0.5" 
                />
              </g>

              <!-- Layer 4: Neural Synaptic Network (Jaringan Sinapsis Nalar & Logika) -->
              <g class="genius-neural-network">
                <!-- Connecting Synaptic Pathways -->
                <line x1="285" y1="160" x2="330" y2="150" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                <line x1="330" y1="150" x2="365" y2="175" stroke="url(#synaptic-line-grad)" stroke-width="2.5" stroke-linecap="round" opacity="0.9" />
                <line x1="285" y1="160" x2="320" y2="205" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                <line x1="330" y1="150" x2="320" y2="205" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.75" />
                <line x1="320" y1="205" x2="365" y2="175" stroke="url(#synaptic-line-grad)" stroke-width="2.5" stroke-linecap="round" opacity="0.9" />
                <line x1="285" y1="160" x2="265" y2="215" stroke="url(#synaptic-line-grad)" stroke-width="1.75" stroke-linecap="round" opacity="0.7" />
                <line x1="265" y1="215" x2="260" y2="265" stroke="url(#synaptic-line-grad)" stroke-width="1.75" stroke-linecap="round" opacity="0.7" />
                <line x1="320" y1="205" x2="370" y2="225" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                <line x1="365" y1="175" x2="370" y2="225" stroke="url(#synaptic-line-grad)" stroke-width="2.5" stroke-linecap="round" opacity="0.9" />
                <line x1="265" y1="215" x2="320" y2="205" stroke="url(#synaptic-line-grad)" stroke-width="1.75" stroke-linecap="round" opacity="0.7" />
                <line x1="320" y1="205" x2="325" y2="260" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                <line x1="370" y1="225" x2="365" y2="275" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                <line x1="260" y1="265" x2="325" y2="260" stroke="url(#synaptic-line-grad)" stroke-width="1.75" stroke-linecap="round" opacity="0.7" />
                <line x1="325" y1="260" x2="365" y2="275" stroke="url(#synaptic-line-grad)" stroke-width="2" stroke-linecap="round" opacity="0.8" />
                <line x1="325" y1="260" x2="300" y2="305" stroke="url(#synaptic-line-grad)" stroke-width="1.75" stroke-linecap="round" opacity="0.7" />
                <line x1="365" y1="275" x2="300" y2="305" stroke="url(#synaptic-line-grad)" stroke-width="1.75" stroke-linecap="round" opacity="0.7" />

                <!-- Synaptic Intelligence Nodes -->
                <!-- N2: Upper Prefrontal -->
                <circle cx="330" cy="150" r="5" fill="#005ac1" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="330" cy="150" r="2" fill="#ffffff" />

                <!-- N3: Parietal Analytical -->
                <circle cx="285" cy="160" r="5" fill="#0284c7" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="285" cy="160" r="2" fill="#ffffff" />

                <!-- N4: Central Association Hub -->
                <circle cx="320" cy="205" r="5.5" fill="#005ac1" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="320" cy="205" r="2.5" fill="#ffffff" />

                <!-- N5: Temporal Memory -->
                <circle cx="265" cy="215" r="4.5" fill="#7c3aed" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="265" cy="215" r="2" fill="#ffffff" />

                <!-- N6: Algorithmic Core -->
                <circle cx="370" cy="225" r="5" fill="#0284c7" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="370" cy="225" r="2" fill="#ffffff" />

                <!-- N7: Occipital Pattern Recognition -->
                <circle cx="260" cy="265" r="4.5" fill="#0284c7" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="260" cy="265" r="2" fill="#ffffff" />

                <!-- N8: Creative Synthesis -->
                <circle cx="325" cy="260" r="5" fill="#7c3aed" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="325" cy="260" r="2" fill="#ffffff" />

                <!-- N9: Integration Node -->
                <circle cx="365" cy="275" r="4.5" fill="#005ac1" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="365" cy="275" r="2" fill="#ffffff" />

                <!-- N10: Output Motor Gateway -->
                <circle cx="300" cy="305" r="4.5" fill="#10b981" filter="url(#m3-glow-filter)" class="syn-node" />
                <circle cx="300" cy="305" r="2" fill="#ffffff" />
              </g>

              <!-- Layer 5: The Center of Genius & Inspiration (Eureka Spark at N1 Frontal Lobe) -->
              <g class="genius-eureka-center">
                <!-- Glowing Aura -->
                <circle cx="365" cy="175" r="30" fill="url(#eureka-gold-glow)" class="eureka-glow-anim" />
                
                <!-- Radiant 8-Point Golden Star of Genius -->
                <path 
                  d="M 365,150 Q 365,175 390,175 Q 365,175 365,200 Q 365,175 340,175 Q 365,175 365,150 Z" 
                  fill="#fbbf24" 
                  filter="url(#m3-glow-filter)" 
                  class="eureka-spark-anim"
                />
                <!-- Diagonal Star Rays -->
                <path 
                  d="M 352,162 Q 365,175 378,188 M 378,162 Q 365,175 352,188" 
                  stroke="#fbbf24" 
                  stroke-width="2.5" 
                  stroke-linecap="round" 
                />
                <!-- Spark Core -->
                <circle cx="365" cy="175" r="4" fill="#ffffff" />
              </g>

              <!-- Layer 6: Floating Logic, Code & Computational Thought Glyphs -->
              <g class="genius-thought-glyphs">
                <!-- Curly Braces (Coding Foundation) -->
                <text x="165" y="155" font-family="'Fira Code', monospace" font-size="20" font-weight="700" fill="#005ac1" opacity="0.85" class="float-glyph g1">&#123; &#125;</text>
                
                <!-- Binary Data Stream (Digital Systems) -->
                <text x="390" y="125" font-family="'Fira Code', monospace" font-size="11" font-weight="700" fill="#7c3aed" opacity="0.8" class="float-glyph g2">010110</text>
                
                <!-- Lambda (Functional Logic & Abstraction) -->
                <text x="215" y="125" font-family="Georgia, serif" font-size="18" font-style="italic" font-weight="700" fill="#0284c7" opacity="0.85" class="float-glyph g3">&lambda;</text>
                
                <!-- SQL Query Representation -->
                <text x="395" y="340" font-family="'Fira Code', monospace" font-size="12" font-weight="700" fill="#0284c7" opacity="0.9" class="float-glyph g4">SELECT *</text>
                
                <!-- Mathematical Function Abstraction -->
                <text x="175" y="270" font-family="'Fira Code', monospace" font-size="13" font-weight="700" fill="#10b981" opacity="0.85" class="float-glyph g5">f(x)</text>
                
                <!-- Code Tags (Web Engineering) -->
                <text x="445" y="210" font-family="'Fira Code', monospace" font-size="14" font-weight="700" fill="#f59e0b" opacity="0.9" class="float-glyph g6">&lt;/&gt;</text>
                
                <!-- Artificial Intelligence / Logic Tag -->
                <text x="315" y="360" font-family="system-ui, -apple-system, sans-serif" font-size="10" font-weight="800" fill="#6750a4" opacity="0.8" letter-spacing="1">AI &bull; LOGIC</text>

                <!-- Eureka Sparks -->
                <text x="290" y="100" font-size="16" fill="#fbbf24" class="spark-twinkle s1">&#10022;</text>
                <text x="475" y="255" font-size="14" fill="#38bdf8" class="spark-twinkle s2">&#10022;</text>
                <text x="135" y="225" font-size="13" fill="#a855f7" class="spark-twinkle s3">&#10022;</text>
              </g>
            </svg>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Educational Pathways Section: Tiga Pilar Pembelajaran RPL & Informatika -->
  <section class="section m3-pathways-section">
    <div class="section-header text-center">
      <div class="m3-chip m3-chip-tonal-primary section-chip">
        <span class="material-symbols-rounded icon-sm">auto_awesome</span>
        <span>JALUR BELAJAR TERSTRUKTUR</span>
      </div>
      <h2 class="section-title">Kurikulum Edukasi Berkelanjutan</h2>
      <p class="section-subtitle">Disusun terarah sesuai Capaian Pembelajaran Kurikulum Merdeka untuk jenjang SMK Fase E dan Fase F.</p>
    </div>

    <div class="m3-pathways-grid">
      <!-- Pathway 1: Fase E Informatika & BK -->
      <div class="m3-card m3-card-elevated pathway-card">
        <div class="pathway-card-header">
          <div class="pathway-icon-box bg-primary-container text-m3-primary">
            <span class="material-symbols-rounded">psychology</span>
          </div>
          <span class="m3-chip m3-chip-tonal-primary">FASE E • KELAS X</span>
        </div>
        <h3 class="pathway-title">Berpikir Komputasional &amp; Algoritma</h3>
        <p class="pathway-desc">
          Membangun fondasi nalar logika problem solving melalui 4 pilar (Dekomposisi, Pengenalan Pola, Abstraksi, dan Perancangan Algoritma) disertai simulator interaktif.
        </p>
        <ul class="pathway-features">
          <li><span class="material-symbols-rounded feat-check">check_circle</span> 8 Elemen Inti Informatika SMK</li>
          <li><span class="material-symbols-rounded feat-check">check_circle</span> Simulator Interaktif 4 Pilar BK</li>
          <li><span class="material-symbols-rounded feat-check">check_circle</span> LKPD Digital &amp; Penilaian Guru</li>
        </ul>
        <div class="pathway-footer">
          <a href="/belajar" class="m3-btn m3-btn-filled pathway-btn">
            <span>Buka Modul Informatika</span>
            <span class="material-symbols-rounded">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Pathway 2: Fase F Basis Data & SQL Masterclass -->
      <div class="m3-card m3-card-elevated pathway-card featured-pathway">
        <div class="pathway-card-header">
          <div class="pathway-icon-box bg-secondary-container text-m3-secondary">
            <span class="material-symbols-rounded">database</span>
          </div>
          <span class="m3-chip m3-chip-tonal-secondary">FASE F • SPESIALISASI RPL</span>
        </div>
        <h3 class="pathway-title">Basis Data Relasional &amp; SQL Masterclass</h3>
        <p class="pathway-desc">
          Kuasai arsitektur RDBMS, normalisasi, DDL/DML, multi-table JOIN, hingga optimasi kueri dengan database engine langsung di browser.
        </p>
        <ul class="pathway-features">
          <li><span class="material-symbols-rounded feat-check">check_circle</span> 40 Modul Terstruktur &amp; Teruji</li>
          <li><span class="material-symbols-rounded feat-check">check_circle</span> Eksekusi Kueri SQL Real-time</li>
          <li><span class="material-symbols-rounded feat-check">check_circle</span> Ujian CBT &amp; Sertifikat Digital</li>
        </ul>
        <div class="pathway-footer">
          <a href="/belajar/sql" class="m3-btn m3-btn-filled pathway-btn">
            <span>Mulai Masterclass SQL</span>
            <span class="material-symbols-rounded">arrow_forward</span>
          </a>
        </div>
      </div>

      <!-- Pathway 3: Fase F Rekayasa Web Modern -->
      <div class="m3-card m3-card-elevated pathway-card">
        <div class="pathway-card-header">
          <div class="pathway-icon-box bg-tertiary-container text-m3-tertiary">
            <span class="material-symbols-rounded">code</span>
          </div>
          <span class="m3-chip m3-chip-tonal-tertiary">FASE F • VOKASI INDUSTRI</span>
        </div>
        <h3 class="pathway-title">Rekayasa Web &amp; Arsitektur Aplikasi</h3>
        <p class="pathway-desc">
          Membangun aplikasi web tangguh dengan kaidah clean architecture, antarmuka responsif Material Design 3, integrasi API, dan standar industri modern.
        </p>
        <ul class="pathway-features">
          <li><span class="material-symbols-rounded feat-check">check_circle</span> Desain Sistem Google Material 3</li>
          <li><span class="material-symbols-rounded feat-check">check_circle</span> Fullstack TypeScript &amp; Cloud DB</li>
          <li><span class="material-symbols-rounded feat-check">check_circle</span> Portofolio Proyek Siswa Binaan</li>
        </ul>
        <div class="pathway-footer">
          <a href="/materi" class="m3-btn m3-btn-filled pathway-btn">
            <span>Jelajahi Panduan Web</span>
            <span class="material-symbols-rounded">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Posts Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <div class="m3-chip m3-chip-tonal-primary section-chip">
          <span class="material-symbols-rounded icon-sm">article</span>
          <span>WAWASAN TEKNOLOGI</span>
        </div>
        <h2 class="section-title">Artikel &amp; Tutorial Pilihan</h2>
        <p class="section-subtitle">Wawasan teknis dan panduan praktis pengembangan perangkat lunak bagi pelajar vokasi.</p>
      </div>
      <a href="/blog" class="m3-btn m3-btn-text section-link">
        <span>Semua Artikel</span>
        <span class="material-symbols-rounded">arrow_forward</span>
      </a>
    </div>

    {featuredPosts.length > 0 ? (
      <div class="grid grid-posts">
        {featuredPosts.map((post) => (
          <article class="m3-card m3-card-elevated post-card">
            <!-- Article Thumbnail Image Container -->
            <a href={`/blog/${post.slug}`} class="post-thumb-wrapper">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="post-thumb-img" loading="lazy" />
              ) : (
                <div class="post-thumb-placeholder">
                  <span class="material-symbols-rounded thumb-m3-icon">article</span>
                  <span class="thumb-topic">{post.data.category}</span>
                </div>
              )}
              <span class="m3-chip m3-chip-tonal-primary post-badge-floating">{post.data.category}</span>
            </a>

            <div class="post-body">
              <div class="post-meta-top">
                <time datetime={post.data.pubDate.toISOString()} class="post-date">
                  {formatDate(post.data.pubDate)}
                </time>
