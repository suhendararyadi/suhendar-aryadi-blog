---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime())
  .slice(0, 3);

const modules = await getCollection('modules');

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}
---

<MainLayout 
  title="Suhendar Aryadi, S.Pd.,Gr. | Guru RPL SMK & Tech Educator"
  description="Website resmi & portal edukasi Suhendar Aryadi, S.Pd.,Gr. - Guru Jurusan Rekayasa Perangkat Lunak (RPL) SMK. Berbagi modul pembelajaran, tutorial web development, dan portofolio vokasi IT."
>
  <!-- Hero Section (SpineEdge Modern Aesthetic) -->
  <section class="hero-spine-section">
    <div class="hero-spine-container">
      <!-- Announcement Pill Badge -->
      <div class="pill-announcement">
        <span class="pill-chip">NEW</span>
        <span class="pill-text">Kurikulum Merdeka Informatika &amp; RPL 2026 &rarr;</span>
      </div>
      
      <!-- Big Centered Title -->
      <h1 class="spine-hero-title">
        Mengembangkan Potensi Vokasi IT &amp; <span class="highlight-green">Pemrograman Web</span>
      </h1>
      
      <!-- Subtitle -->
      <p class="spine-hero-subtitle">
        Selamat datang di portal pembelajaran resmi <strong>Suhendar Aryadi, S.Pd.,Gr.</strong> Pelajari 8 Elemen Informatika, 40 Modul SQL Interaktif, serta 4 Pilar Berpikir Komputasional secara gratis di browser.
      </p>

      <!-- Dual Action Buttons -->
      <div class="spine-hero-actions">
        <a href="/belajar" class="btn btn-lime-pill">
          <span>Mulai Belajar Gratis &rarr;</span>
        </a>
        <a href="/materi" class="btn btn-dark-pill">
          <span>Lihat Modul RPL</span>
        </a>
      </div>

      <!-- Wave Fluid Art & Tech Stack Logos -->
      <div class="wave-art-wrapper">
        <div class="wave-mesh-gradient"></div>
        
        <div class="tech-trust-bar">
          <p class="trust-label">PLATFORM BELAJAR BERBASIS TEKNOLOGI PENDIDIKAN VOKASI MODERN</p>
          <div class="tech-logos-grid">
            <span class="tech-tag">Astro v4</span>
            <span class="tech-tag">Neon Postgres</span>
            <span class="tech-tag">Python WASM</span>
            <span class="tech-tag">SQLite WASM</span>
            <span class="tech-tag">TypeScript</span>
            <span class="tech-tag">Vercel SSR</span>
          </div>
        </div>
      </div>

      <!-- 3 Feature Highlights Below Wave -->
      <div class="spine-features-grid">
        <div class="spine-feature-card glass-card">
          <div class="feature-card-header">
            <div class="feature-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"></rect>
                <rect x="9" y="9" width="6" height="6"></rect>
                <line x1="9" y1="1" x2="9" y2="4"></line>
                <line x1="15" y1="1" x2="15" y2="4"></line>
                <line x1="9" y1="20" x2="9" y2="23"></line>
                <line x1="15" y1="20" x2="15" y2="23"></line>
                <line x1="20" y1="9" x2="23" y2="9"></line>
                <line x1="20" y1="15" x2="23" y2="15"></line>
                <line x1="1" y1="9" x2="4" y2="9"></line>
                <line x1="1" y1="15" x2="4" y2="15"></line>
              </svg>
            </div>
            <span class="feature-badge-small">FASE E KELAS X</span>
          </div>
          <h3 class="feature-card-title">Kurikulum Informatika</h3>
          <p class="feature-card-desc">8 Elemen Inti Kurikulum Merdeka dilengkapi Simulator Visual BK dan WASM Sandbox.</p>
        </div>

        <div class="spine-feature-card glass-card">
          <div class="feature-card-header">
            <div class="feature-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
                <path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path>
                <path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>
              </svg>
            </div>
            <span class="feature-badge-small">FASE F KELAS XI</span>
          </div>
          <h3 class="feature-card-title">SQL Masterclass 40 Modul</h3>
          <p class="feature-card-desc">Latihan DDL &amp; DML langsung di browser dengan evaluasi otomatis &amp; Sertifikat Digital.</p>
        </div>

        <div class="spine-feature-card glass-card">
          <div class="feature-card-header">
            <div class="feature-icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
            </div>
            <span class="feature-badge-small">EVALUASI ONLINE</span>
          </div>
          <h3 class="feature-card-title">LKPD Digital Interaktif</h3>
          <p class="feature-card-desc">Lembar kerja peserta didik terintegrasi LMS Guru, ekspor PDF, dan penilaian real-time.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Posts Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Artikel & Tutorial Pilihan</h2>
        <p class="section-subtitle">Wawasan teknis dan panduan praktis pengembangan perangkat lunak</p>
      </div>
      <a href="/blog" class="section-link">Lihat Semua Artikel &rarr;</a>
    </div>

    {featuredPosts.length > 0 ? (
      <div class="grid grid-posts">
        {featuredPosts.map((post) => (
          <article class="glass-card glass-card-interactive post-card">
            <!-- Article Thumbnail Image Container -->
            <a href={`/blog/${post.slug}`} class="post-thumb-wrapper">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.title} class="post-thumb-img" loading="lazy" />
              ) : (
                <div class="post-thumb-placeholder">
                  <div class="thumb-pattern"></div>
                  <div class="thumb-content">
                    <div class="thumb-code-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="16 18 22 12 16 6"></polyline>
                        <polyline points="8 6 2 12 8 18"></polyline>
                      </svg>
                    </div>
                    <span class="thumb-topic">{post.data.category}</span>
                  </div>
                </div>
              )}
              <span class="post-badge-floating">{post.data.category}</span>
            </a>

            <div class="post-body">
              <div class="post-meta-top">
                <time datetime={post.data.pubDate.toISOString()} class="post-date">
                  {formatDate(post.data.pubDate)}
                </time>
                <span class="read-time-pill">5 min baca</span>
              </div>
              
              <h3 class="post-title">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              
              <p class="post-description">{post.data.description}</p>
              
              <div class="post-footer">
                <div class="post-author">
                  <div class="author-avatar">{post.data.author.charAt(0)}</div>
                  <span class="author-name">{post.data.author}</span>
                </div>
                <a href={`/blog/${post.slug}`} class="read-more">Baca &rarr;</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">Belum ada artikel pilihan saat ini.</p>
    )}
  </section>

  <!-- Modules Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Modul Pembelajaran RPL</h2>
        <p class="section-subtitle">Bahan ajar dan panduan praktikum SMK Rekayasa Perangkat Lunak</p>
      </div>
      <a href="/materi" class="section-link">Semua Modul &rarr;</a>
    </div>

    {modules.length > 0 ? (
      <div class="grid grid-modules">
        {modules.map((mod) => (
          <div class="glass-card glass-card-interactive module-card">
            <!-- Module Thumbnail Container -->
            <a href={`/materi/${mod.slug}`} class="module-thumb-wrapper">
              {mod.data.image ? (
                <img src={mod.data.image} alt={mod.data.title} class="module-thumb-img" loading="lazy" />
              ) : (
                <div class="module-thumb-placeholder">
                  <div class="thumb-pattern"></div>
                  <div class="thumb-content">
                    <div class="thumb-book-icon">
                      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                      </svg>
                    </div>
                    <span class="thumb-subject">{mod.data.subject}</span>
                  </div>
                </div>
              )}
              <span class="module-grade-badge">{mod.data.grade}</span>
            </a>

            <div class="module-body">
              <h3 class="module-title">
                <a href={`/materi/${mod.slug}`}>{mod.data.title}</a>
              </h3>

              <div class="module-tags">
                {mod.data.tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>

              <div class="module-footer">
                <a href={`/materi/${mod.slug}`} class="btn btn-primary btn-sm">
                  <span>Pelajari Modul</span>
                </a>
                {mod.data.downloadUrl && (
                  <a href={mod.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                    <span>PDF</span>
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty-state">Belum ada modul pembelajaran yang diunggah.</p>
    )}
  </section>
</MainLayout>

<style>
  /* SpineEdge Modern Hero Section - Full Bleed Edge-to-Edge with Original Dark Aesthetic */
  .hero-spine-section {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    padding: 4.5rem 1.5rem 5rem;
    overflow: hidden;
    background: linear-gradient(180deg, #070a12 0%, #0d1322 100%);
    color: #f8fafc;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: none;
  }

  .hero-spine-container {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
    z-index: 2;
  }

  .pill-announcement {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.95rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 9999px;
    font-size: 0.8125rem;
    margin-bottom: 1.75rem;
    transition: all 0.2s ease;
  }

  .pill-announcement:hover {
    border-color: rgba(132, 204, 22, 0.5);
    background: rgba(132, 204, 22, 0.08);
  }

  .pill-chip {
    background: #84cc16;
    color: #080c14;
    font-weight: 800;
    font-size: 0.6875rem;
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
  }

  .pill-text {
    color: #cbd5e1;
    font-weight: 500;
  }

  .spine-hero-title {
    font-size: 3.25rem;
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #ffffff;
    margin-bottom: 1.25rem;
    max-width: 860px;
  }

  .highlight-green {
    background: linear-gradient(135deg, #84cc16 0%, #10b981 50%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .spine-hero-subtitle {
    font-size: 1.05rem;
    color: #94a3b8;
    line-height: 1.65;
    max-width: 720px;
    margin-bottom: 2rem;
  }

  .spine-hero-subtitle strong {
    color: #f1f5f9;
  }

  .spine-hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3.5rem;
  }

  .btn-lime-pill {
    background: #84cc16;
    color: #080c14;
    font-weight: 700;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    box-shadow: 0 4px 20px rgba(132, 204, 22, 0.3);
    transition: all 0.2s ease;
  }

  .btn-lime-pill:hover {
    background: #a3e635;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(132, 204, 22, 0.45);
    color: #080c14;
  }

  .btn-dark-pill {
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #f8fafc;
    font-weight: 600;
    padding: 0.75rem 1.75rem;
    border-radius: 9999px;
    transition: all 0.2s ease;
  }

  .btn-dark-pill:hover {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.3);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Wave Art & Tech Trust Bar */
  .wave-art-wrapper {
    position: relative;
    width: 100%;
    margin-bottom: 2.5rem;
    padding-top: 1rem;
  }

  .wave-mesh-gradient {
    height: 120px;
    width: 100%;
    background: radial-gradient(ellipse at center, rgba(132, 204, 22, 0.22) 0%, rgba(6, 182, 212, 0.15) 45%, transparent 75%);
    filter: blur(20px);
    position: absolute;
    top: -40px;
    left: 0;
    pointer-events: none;
  }

  .tech-trust-bar {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 2rem;
  }

  .trust-label {
    font-size: 0.725rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #64748b;
  }

  .tech-logos-grid {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
  }

  .tech-tag {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #cbd5e1;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    font-weight: 600;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-md);
  }

  /* Spine Features Grid */
  .spine-features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .spine-hero-title {
      font-size: 2.15rem;
    }
    .spine-features-grid {
      grid-template-columns: 1fr;
    }
  }

  .spine-feature-card {
    padding: 1.5rem;
    text-align: left;
    background: rgba(255, 255, 255, 0.03) !important;
    border: 1px solid rgba(255, 255, 255, 0.08) !important;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-radius: var(--radius-xl);
  }

  .spine-feature-card:hover {
    border-color: rgba(132, 204, 22, 0.3) !important;
    background: rgba(255, 255, 255, 0.05) !important;
  }

  .feature-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .feature-icon-box {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: rgba(132, 204, 22, 0.12);
    color: #84cc16;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feature-badge-small {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #84cc16;
    letter-spacing: 0.06em;
  }

  .feature-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #ffffff;
  }

  .feature-card-desc {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
  }

  /* Light Mode Theme Overrides for Hero Banner */
  :global([data-theme="light"]) .hero-spine-section {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    color: #0f172a;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global([data-theme="light"]) .pill-announcement {
    background: #f1f5f9;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  :global([data-theme="light"]) .pill-announcement:hover {
    border-color: rgba(101, 163, 13, 0.5);
    background: rgba(101, 163, 13, 0.08);
  }

  :global([data-theme="light"]) .pill-text {
    color: #475569;
  }

  :global([data-theme="light"]) .spine-hero-title {
    color: #0f172a;
  }

  :global([data-theme="light"]) .spine-hero-subtitle {
    color: #475569;
  }

  :global([data-theme="light"]) .spine-hero-subtitle strong {
    color: #0f172a;
  }

  :global([data-theme="light"]) .btn-dark-pill {
    background: #f1f5f9;
    border: 1px solid rgba(0, 0, 0, 0.14);
    color: #0f172a;
  }

  :global([data-theme="light"]) .btn-dark-pill:hover {
    background: #e2e8f0;
    border-color: rgba(0, 0, 0, 0.25);
    color: #0f172a;
  }

  :global([data-theme="light"]) .tech-trust-bar {
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  :global([data-theme="light"]) .trust-label {
    color: #64748b;
  }

  :global([data-theme="light"]) .tech-tag {
    background: #f1f5f9;
    border: 1px solid rgba(0, 0, 0, 0.1);
    color: #334155;
  }

  :global([data-theme="light"]) .spine-feature-card {
    background: #ffffff !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }

  :global([data-theme="light"]) .spine-feature-card:hover {
    border-color: rgba(101, 163, 13, 0.4) !important;
    background: #ffffff !important;
    box-shadow: 0 8px 24px rgba(101, 163, 13, 0.12);
  }

  :global([data-theme="light"]) .feature-card-title {
    color: #0f172a;
  }

  :global([data-theme="light"]) .feature-card-desc {
    color: #475569;
  }

  /* Section Styling */
  .section {
    margin-top: 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .section-subtitle {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .section-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-primary);
    white-space: nowrap;
  }

  /* Grid Layouts */
  .grid {
    display: grid;
    gap: 1.75rem;
  }

  .grid-posts {
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  }

  .grid-modules {
    grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
  }

  @media (max-width: 640px) {
    .grid-posts, .grid-modules {
      grid-template-columns: 1fr;
    }
  }

  /* Article Post Card */
  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xl);
  }

  .post-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--bg-tertiary);
    display: block;
  }

  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .post-card:hover .post-thumb-img {
    transform: scale(1.06);
  }

  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 40%, #06b6d4 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.4s ease;
  }

  .post-card:hover .post-thumb-placeholder {
    transform: scale(1.04);
  }

  .thumb-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(#ffffff 1px, transparent 1px);
    background-size: 16px 16px;
  }

  .thumb-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
  }

  .thumb-code-icon {
