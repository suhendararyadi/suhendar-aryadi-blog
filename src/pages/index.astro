---
import MainLayout from '../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const featuredPosts = allPosts
  .filter(post => post.data.featured)
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());

const modules = await getCollection('modules');

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}
---

<MainLayout 
  title="Suhendar Aryadi, S.Kom. | Guru RPL SMK & Tech Educator"
  description="Website resmi & portal edukasi Suhendar Aryadi, S.Kom. - Guru Jurusan Rekayasa Perangkat Lunak (RPL) SMK. Berbagi modul pembelajaran, tutorial web development, dan portofolio vokasi IT."
>
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="hero-content">
      <div class="badge-wrapper">
        <span class="badge badge-cyan">
          Guru RPL SMK & Tech Educator
        </span>
      </div>
      
      <h1 class="hero-title">
        Mengembangkan Potensi Vokasi IT & <span class="text-gradient">Pemrograman Web Modern</span>
      </h1>
      
      <p class="hero-subtitle">
        Selamat datang di portal resmi <strong>Suhendar Aryadi, S.Kom.</strong> Berbagi modul pembelajaran Rekayasa Perangkat Lunak (RPL), tutorial teknologi web terkini, serta etalase karya & portofolio vokasi IT.
      </p>

      <div class="hero-actions">
        <a href="/materi" class="btn btn-primary">
          <span>Lihat Materi RPL</span>
        </a>
        <a href="/portofolio" class="btn btn-secondary">
          <span>Portofolio & Karya</span>
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat-card glass-card">
          <span class="stat-number text-gradient">RPL</span>
          <span class="stat-label">Kurikulum Vokasi SMK</span>
        </div>
        <div class="stat-card glass-card">
          <span class="stat-number text-gradient">{modules.length}+</span>
          <span class="stat-label">Modul Pembelajaran</span>
        </div>
        <div class="stat-card glass-card">
          <span class="stat-number text-gradient">{allPosts.length}+</span>
          <span class="stat-label">Artikel & Tutorial</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Posts Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Artikel & Tutorial Pilihan</h2>
        <p class="section-subtitle">Wawasan teknis dan panduan praktis pengembangan perangkat lunak</p>
      </div>
      <a href="/blog" class="section-link">Lihat Semua Artikel &rarr;</a>
    </div>

    {featuredPosts.length > 0 ? (
      <div class="grid grid-posts">
        {featuredPosts.map((post) => (
          <article class="glass-card glass-card-interactive post-card">
            <div class="post-meta">
              <span class="badge">{post.data.category}</span>
              <time datetime={post.data.pubDate.toISOString()} class="post-date">
                {formatDate(post.data.pubDate)}
              </time>
            </div>
            
            <h3 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h3>
            
            <p class="post-description">{post.data.description}</p>
            
            <div class="post-footer">
              <div class="post-tags">
                {post.data.tags.slice(0, 3).map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
              <a href={`/blog/${post.slug}`} class="read-more">Baca &rarr;</a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="empty-state">Belum ada artikel pilihan saat ini.</p>
    )}
  </section>

  <!-- Modules Section -->
  <section class="section">
    <div class="section-header">
      <div>
        <h2 class="section-title">Modul Pembelajaran RPL</h2>
        <p class="section-subtitle">Bahan ajar dan panduan praktikum SMK Rekayasa Perangkat Lunak</p>
      </div>
      <a href="/materi" class="section-link">Semua Modul &rarr;</a>
    </div>

    {modules.length > 0 ? (
      <div class="grid grid-modules">
        {modules.map((mod) => (
          <div class="glass-card glass-card-interactive module-card">
            <div class="module-badges">
              <span class="badge badge-cyan">{mod.data.subject}</span>
              <span class="badge">{mod.data.grade}</span>
            </div>

            <h3 class="module-title">
              <a href={`/materi/${mod.slug}`}>{mod.data.title}</a>
            </h3>

            <div class="module-footer">
              <div class="module-tags">
                {mod.data.tags.map((tag) => (
                  <span class="tag">#{tag}</span>
                ))}
              </div>
              <a href={`/materi/${mod.slug}`} class="btn btn-outline btn-sm">
                Pelajari Modul
              </a>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <p class="empty-state">Belum ada modul pembelajaran yang diunggah.</p>
    )}
  </section>
</MainLayout>

<style>
  .hero-section {
    padding: 3rem 0 4rem;
    text-align: center;
  }

  .hero-content {
    max-width: 850px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .badge-wrapper {
    margin-bottom: 1.25rem;
  }

  .hero-title {
    font-size: 2.75rem;
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1.25rem;
    letter-spacing: -0.02em;
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }
  }

  .hero-subtitle {
    font-size: 1.125rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 2rem;
    max-width: 720px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 3.5rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
    width: 100%;
    max-width: 700px;
  }

  @media (max-width: 640px) {
    .hero-stats {
      grid-template-columns: 1fr;
    }
  }

  .stat-card {
    padding: 1.25rem 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .stat-number {
    font-size: 1.75rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  /* Section Styling */
  .section {
    margin-top: 4rem;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .section-header {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  .section-title {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
  }

  .section-subtitle {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    margin-top: 0.25rem;
  }

  .section-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--accent-primary);
    white-space: nowrap;
  }

  /* Grid Layouts */
  .grid {
    display: grid;
    gap: 1.5rem;
  }

  .grid-posts {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  .grid-modules {
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  }

  /* Post Card */
  .post-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 0.75rem;
  }

  .post-title a {
    color: var(--text-primary);
  }

  .post-title a:hover {
    color: var(--accent-primary);
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;

    /* Line clamp to 3 lines */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .post-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .read-more {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-primary);
  }

  /* Module Card */
  .module-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .module-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }

  .module-title {
    font-size: 1.1875rem;
    font-weight: 700;
    line-height: 1.4;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .module-title a {
    color: var(--text-primary);
  }

  .module-title a:hover {
    color: var(--accent-cyan);
  }

  .module-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .module-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .btn-sm {
    padding: 0.375rem 0.875rem;
    font-size: 0.8125rem;
  }

  .empty-state {
    color: var(--text-muted);
    font-style: italic;
  }
</style>
