---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { seedLessons } from '../../lib/seedLessons';
import { query } from '../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

// Allow access for teachers, admins, or account owner
const isTeacherOrAdmin = user.role === 'teacher' || user.role === 'admin' || user.email.includes('suhendar');

let students: any[] = [];
let totalStudentsCount = 0;
let totalCompletionsCount = 0;
let difficultModules: any[] = [];
const totalLessonsCount = seedLessons.length || 40;

if (isTeacherOrAdmin) {
  try {
    // 1. Fetch all registered students, SQL completion metrics, & LKPD 1 and LKPD 2 scores
    const studentsRes = await query(
      `SELECT u.id, u.name, u.email, u.role, u.class_name, u.created_at,
              COUNT(DISTINCT up.id) as completed_count,
              MAX(up.completed_at) as last_completed_at,
              MAX(lk1.score) as lkpd1_score,
              MAX(lk1.updated_at) as lkpd1_submitted_at,
              MAX(lk2.score) as lkpd2_score,
              MAX(lk2.updated_at) as lkpd2_submitted_at
       FROM users u
       LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
       LEFT JOIN lkpd_submissions lk1 ON u.id = lk1.user_id
       LEFT JOIN lkpd_flowchart_submissions lk2 ON u.id = lk2.user_id
       GROUP BY u.id, u.name, u.email, u.role, u.class_name, u.created_at
       ORDER BY u.created_at DESC`
    );

    if (studentsRes.rows) {
      students = studentsRes.rows.map((row: any) => {
        const count = parseInt(row.completed_count || '0', 10);
        const percentage = Math.round((count / totalLessonsCount) * 100);
        const lkpd1Score = row.lkpd1_score !== null && row.lkpd1_score !== undefined ? parseInt(row.lkpd1_score, 10) : null;
        const lkpd2Score = row.lkpd2_score !== null && row.lkpd2_score !== undefined ? parseInt(row.lkpd2_score, 10) : null;

        let rankTitle = 'SQL Novice';
        let badgeClass = 'badge-novice';
        if (count >= 40) {
          rankTitle = 'Master SQL Engineer';
          badgeClass = 'badge-master';
        } else if (count >= 25) {
          rankTitle = 'SQL Advanced';
          badgeClass = 'badge-advanced';
        } else if (count >= 11) {
          rankTitle = 'SQL Intermediate';
          badgeClass = 'badge-intermediate';
        }

        return {
          ...row,
          completed_count: count,
          percentage,
          lkpd1_score: lkpd1Score,
          lkpd2_score: lkpd2Score,
          rankTitle,
          badgeClass
        };
      });
      totalStudentsCount = students.length;
      totalCompletionsCount = students.reduce((acc, curr) => acc + curr.completed_count, 0);
    }

    // 2. Fetch module completion breakdown across all students
    const diffRes = await query(
      `SELECT sl.id, sl.title, sl.category, sl.order_index,
              COUNT(up.id) as completion_count
       FROM sql_lessons sl
       LEFT JOIN user_progress up ON sl.id = up.lesson_id AND up.status = 'completed'
       GROUP BY sl.id, sl.title, sl.category, sl.order_index
       ORDER BY completion_count ASC, sl.order_index ASC
       LIMIT 5`
    );

    if (diffRes.rows) {
      difficultModules = diffRes.rows.map((r: any) => ({
        ...r,
        completion_count: parseInt(r.completion_count || '0', 10),
        completion_rate: totalStudentsCount > 0 ? Math.round((parseInt(r.completion_count || '0', 10) / totalStudentsCount) * 100) : 0
      }));
    }
  } catch (err) {
    console.warn('Teacher dashboard query error:', err);
  }
}

const avgCompletionsPerStudent = totalStudentsCount > 0 ? (totalCompletionsCount / totalStudentsCount).toFixed(1) : '0';
const totalLkpd1Graded = students.filter((s) => s.lkpd1_score !== null).length;
const totalLkpd2Graded = students.filter((s) => s.lkpd2_score !== null).length;
---

<MainLayout 
  title="Portal Guru & Admin Dashboard | Suhendar Aryadi"
  description="Dashboard Guru Rekayasa Perangkat Lunak (RPL). Rekap nilai siswa, ekspor CSV raport, dan analitik pembelajaran SQL."
>
  <div class="container admin-container">
    {!isTeacherOrAdmin ? (
      <div class="access-denied-card glass-card">
        <div class="access-icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: var(--accent-amber);">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h2>Akses Terbatas — Portal Guru</h2>
        <p>Halaman ini diperuntukkan bagi Guru / Administrator untuk memantau rekap nilai dan progres belajar siswa SMK.</p>
        <p class="access-sub">Akun Anda saat ini terdaftar sebagai <strong>{user.role.toUpperCase()}</strong> ({user.email}).</p>
        <div class="access-actions">
          <a href="/dashboard" class="btn btn-primary btn-sm">Kembali ke Dashboard Siswa</a>
        </div>
      </div>
    ) : (
      <>
        <!-- Header Banner -->
        <div class="admin-header glass-card">
          <div class="header-main">
            <div>
              <div class="badge-wrap">
                <span class="badge badge-cyan">PORTAL GURU &amp; ADMIN</span>
                <span class="badge badge-role">{user.role.toUpperCase()}</span>
              </div>
              <h1 class="admin-title">Dashboard Rekap Nilai Siswa</h1>
              <p class="admin-sub">
                Selamat datang, <strong>Pak {user.name}</strong>. Pantau progres belajar seluruh siswa, identifikasi modul yang memerlukan pembahasan ulang, dan unduh data rekap nilai untuk Raport.
              </p>
            </div>
            <div class="header-cta">
              <a href="/dashboard" class="btn btn-outline btn-sm">
                <span>Dashboard Profil</span>
              </a>
              <a href="/belajar/leaderboard" class="btn btn-secondary btn-sm">
                <span>Papan Peringkat</span>
              </a>
              <a href="/admin/lkpd" class="btn btn-outline btn-sm">
                <span>Evaluasi LKPD Digital</span>
              </a>
              <button id="export-csv-btn" class="btn btn-primary btn-sm" type="button">
                <span>Export Rekap CSV</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Summary Stats Grid -->
        <div class="stats-grid">
          <div class="stat-card glass-card">
            <span class="stat-value">{totalStudentsCount}</span>
            <span class="stat-label">Siswa Terdaftar</span>
          </div>
          <div class="stat-card glass-card">
            <span class="stat-value">{totalCompletionsCount}</span>
            <span class="stat-label">Modul SQL Selesai</span>
          </div>
          <div class="stat-card glass-card">
            <span class="stat-value">{totalLkpd1Graded}</span>
            <span class="stat-label">Nilai LKPD 1 (BK)</span>
          </div>
          <div class="stat-card glass-card">
            <span class="stat-value">{totalLkpd2Graded}</span>
            <span class="stat-label">Nilai LKPD 2 (Algoritma)</span>
          </div>
          <div class="stat-card glass-card">
            <span class="stat-value">{avgCompletionsPerStudent} <span class="stat-unit">modul/siswa</span></span>
            <span class="stat-label">Rata-Rata Progres SQL</span>
          </div>
        </div>

        <!-- Difficult Modules Analysis -->
        <div class="section-block glass-card">
          <div class="block-header">
            <div>
              <h2 class="block-title">Analitik Modul Perlu Pembahasan Ulang</h2>
              <p class="block-sub">5 modul dengan tingkat penyelesaian terendah di kelas (perlu perhatian khusus)</p>
            </div>
          </div>

          <div class="difficult-grid">
            {difficultModules.map((mod) => (
              <div class="diff-card">
                <div class="diff-top">
                  <span class="diff-num">Modul #{mod.order_index}</span>
                  <span class="badge badge-cyan">{mod.category}</span>
                </div>
                <h3 class="diff-title">{mod.title}</h3>
                <div class="diff-progress-wrap">
                  <div class="diff-progress-track">
                    <div class="diff-progress-fill" style={`width: ${mod.completion_rate}%`}></div>
                  </div>
                  <span class="diff-count">{mod.completion_count}/{totalStudentsCount} siswa ({mod.completion_rate}%)</span>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Student Roster Table -->
        <div class="section-block glass-card">
          <div class="block-header">
            <div>
              <h2 class="block-title">Daftar Rekap Nilai Siswa</h2>
              <p class="block-sub">Rincian pencapaian 40 Modul SQL per siswa terdaftar</p>
            </div>
            <div class="search-filter-wrap">
              <select id="class-filter-select" class="class-filter-select">
                <option value="ALL">Semua Kelas (Rombel)</option>
                <optgroup label="Kelas 10 (Fase E)">
                  <option value="10 RPL 1">10 RPL 1 (X RPL 1)</option>
                  <option value="10 RPL 2">10 RPL 2 (X RPL 2)</option>
                  <option value="10 RPL 3">10 RPL 3 (X RPL 3)</option>
                  <option value="10 RPL 4">10 RPL 4 (X RPL 4)</option>
                </optgroup>
                <optgroup label="Kelas 11 (XI RPL)">
                  <option value="11 RPL 1">11 RPL 1 (XI RPL 1)</option>
                  <option value="11 RPL 2">11 RPL 2 (XI RPL 2)</option>
                  <option value="11 RPL 3">11 RPL 3 (XI RPL 3)</option>
                  <option value="11 RPL 4">11 RPL 4 (XI RPL 4)</option>
                </optgroup>
                <optgroup label="Kelas 12 (XII RPL)">
                  <option value="12 RPL 1">12 RPL 1 (XII RPL 1)</option>
                  <option value="12 RPL 2">12 RPL 2 (XII RPL 2)</option>
                  <option value="12 RPL 3">12 RPL 3 (XII RPL 3)</option>
                  <option value="12 RPL 4">12 RPL 4 (XII RPL 4)</option>
                </optgroup>
                <option value="UNASSIGNED">Belum Mengisi Kelas</option>
              </select>
              <input 
                type="text" 
                id="student-search" 
                class="search-input" 
                placeholder="Cari nama atau email siswa..." 
                autocomplete="off"
              />
            </div>
          </div>

          <div class="table-wrapper">
            <div class="table-info-bar">
              <div class="mobile-table-hint">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="9 18 15 12 9 6"></polyline>
                </svg>
                <span>Geser tabel ke samping untuk melihat data lengkap</span>
              </div>
              <span id="filtered-student-count" class="filtered-count-badge">Menampilkan {students.length} siswa</span>
            </div>
            <table class="admin-table" id="students-table">
              <thead>
                <tr>
                  <th class="text-center">No</th>
                  <th>Nama Siswa</th>
                  <th class="text-center">Kelas (RPL)</th>
                  <th>Email</th>
                  <th class="text-center">Role</th>
                  <th class="text-center">Modul SQL</th>
                  <th class="text-center">LKPD 1 (BK)</th>
                  <th class="text-center">LKPD 2 (Algoritma)</th>
                  <th class="text-center">Peringkat Rank</th>
                  <th class="text-center">Terdaftar pada</th>
                  <th class="text-center">Aksi</th>
                </tr>
              </thead>
              <tbody>
                {students.map((item, idx) => (
                  <tr class="student-row" data-class={item.class_name || 'UNASSIGNED'} data-email={item.email} data-name={item.name}>
                    <td class="num-col text-center">{idx + 1}</td>
                    <td>
                      <div class="user-cell">
                        <span class="user-avatar-sm">{item.name.charAt(0).toUpperCase()}</span>
                        <strong class="user-name">{item.name}</strong>
                      </div>
                    </td>
                    <td class="class-col text-center">
                      {item.class_name ? (
                        <span class="badge badge-cyan badge-class-chip">{item.class_name}</span>
                      ) : (
                        <span class="badge badge-muted badge-class-chip badge-empty-chip">-</span>
                      )}
                    </td>
                    <td class="email-col">{item.email}</td>
                    <td class="text-center">
                      <span class="badge badge-role">{item.role.toUpperCase()}</span>
                    </td>
                    <td class="text-center">
                      <span class="module-score font-mono">
                        <strong>{item.completed_count}</strong> / {totalLessonsCount} ({item.percentage}%)
                      </span>
                    </td>
                    <td class="text-center">
                      {item.lkpd1_score !== null && item.lkpd1_score !== undefined ? (
                        <span class={`badge ${item.lkpd1_score >= 75 ? 'badge-green' : 'badge-amber'} font-mono`}>
                          {item.lkpd1_score} / 100
                        </span>
                      ) : item.lkpd1_submitted_at ? (
                        <span class="badge badge-amber font-mono">Belum Dinilai</span>
                      ) : (
                        <span class="badge badge-muted font-mono">-</span>
                      )}
                    </td>
                    <td class="text-center">
                      {item.lkpd2_score !== null && item.lkpd2_score !== undefined ? (
                        <span class={`badge ${item.lkpd2_score >= 75 ? 'badge-green' : 'badge-amber'} font-mono`}>
                          {item.lkpd2_score} / 100
                        </span>
                      ) : item.lkpd2_submitted_at ? (
                        <span class="badge badge-amber font-mono">Belum Dinilai</span>
                      ) : (
                        <span class="badge badge-muted font-mono">-</span>
                      )}
                    </td>
                    <td class="text-center">
                      <span class={`badge ${item.badgeClass}`}>{item.rankTitle}</span>
                    </td>
                    <td class="date-col text-center">
                      {new Date(item.created_at).toLocaleDateString('id-ID', {
                        day: 'numeric', month: 'short', year: 'numeric'
                      })}
                    </td>
                    <td class="text-center">
                      <div class="action-cell">
                        <a href="/admin/lkpd" class="btn btn-outline btn-xs">
                          Nilai LKPD
                        </a>
                        <button
                          type="button"
                          class="btn btn-outline btn-xs btn-reset-password"
                          data-user-id={item.id}
                          data-user-name={item.name}
                        >
                          Reset Password
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Reset Password Modal -->
        <div id="reset-password-modal" class="rp-modal-overlay" hidden>
          <div class="rp-modal glass-card">
            <div id="rp-modal-step-confirm">
              <h3 class="rp-modal-title">Reset Password Siswa</h3>
              <p class="rp-modal-text">
                Anda akan mereset password untuk <strong id="rp-target-name">-</strong>.
                Password lama tidak akan berfungsi lagi dan siswa akan otomatis logout dari sesi aktif.
              </p>
              <div class="rp-modal-actions">
                <button type="button" class="btn btn-outline btn-sm" id="rp-cancel-btn">Batal</button>
                <button type="button" class="btn btn-primary btn-sm" id="rp-confirm-btn">Ya, Reset Password</button>
              </div>
            </div>
            <div id="rp-modal-step-result" hidden>
              <h3 class="rp-modal-title">Password Baru Berhasil Dibuat</h3>
              <p class="rp-modal-text">
                Sampaikan password sementara ini kepada <strong id="rp-result-name">-</strong> secara langsung.
                Password ini hanya ditampilkan <strong>satu kali</strong> dan tidak dapat dilihat kembali.
              </p>
              <div class="rp-password-box">
                <code id="rp-new-password">-</code>
                <button type="button" class="btn btn-outline btn-xs" id="rp-copy-btn">Salin</button>
              </div>
              <div class="rp-modal-actions">
                <button type="button" class="btn btn-primary btn-sm" id="rp-close-btn">Tutup</button>
              </div>
            </div>
            <div id="rp-modal-step-error" hidden>
              <h3 class="rp-modal-title">Gagal Mereset Password</h3>
              <p class="rp-modal-text" id="rp-error-message">Terjadi kesalahan. Silakan coba lagi.</p>
              <div class="rp-modal-actions">
                <button type="button" class="btn btn-outline btn-sm" id="rp-error-close-btn">Tutup</button>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</MainLayout>

<script is:inline define:vars={{ studentsData: students, totalLessonsCount }}>
  document.addEventListener('DOMContentLoaded', () => {
    const exportBtn = document.getElementById('export-csv-btn');
    const searchInput = document.getElementById('student-search');
    const classSelect = document.getElementById('class-filter-select');
    const countBadge = document.getElementById('filtered-student-count');
    const tableRows = document.querySelectorAll('.student-row');

    function normalizeClass(raw) {
      if (!raw) return 'UNASSIGNED';
      const c = String(raw).toUpperCase().trim();
      if (c === 'UNASSIGNED' || c === '-' || c === '') return 'UNASSIGNED';
      if (c.includes('10 RPL 1') || c.includes('X RPL 1')) return '10 RPL 1';
      if (c.includes('10 RPL 2') || c.includes('X RPL 2')) return '10 RPL 2';
      if (c.includes('10 RPL 3') || c.includes('X RPL 3')) return '10 RPL 3';
      if (c.includes('10 RPL 4') || c.includes('X RPL 4')) return '10 RPL 4';
      if (c.includes('11 RPL 1') || c.includes('XI RPL 1')) return '11 RPL 1';
      if (c.includes('11 RPL 2') || c.includes('XI RPL 2')) return '11 RPL 2';
      if (c.includes('11 RPL 3') || c.includes('XI RPL 3')) return '11 RPL 3';
      if (c.includes('11 RPL 4') || c.includes('XI RPL 4')) return '11 RPL 4';
      if (c.includes('12 RPL 1') || c.includes('XII RPL 1')) return '12 RPL 1';
      if (c.includes('12 RPL 2') || c.includes('XII RPL 2')) return '12 RPL 2';
      if (c.includes('12 RPL 3') || c.includes('XII RPL 3')) return '12 RPL 3';
      if (c.includes('12 RPL 4') || c.includes('XII RPL 4')) return '12 RPL 4';
      return c;
    }

    function applyFilters() {
      const term = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const selectedClass = classSelect ? classSelect.value : 'ALL';
      let visibleCount = 0;

      tableRows.forEach((row) => {
        const text = row.textContent.toLowerCase();
        const rowClass = row.getAttribute('data-class') || 'UNASSIGNED';

        const matchesSearch = !term || text.includes(term);
        const matchesClass = selectedClass === 'ALL' || 
                             rowClass === selectedClass || 
                             normalizeClass(rowClass) === normalizeClass(selectedClass);

        if (matchesSearch && matchesClass) {
          row.style.display = '';
          visibleCount++;
        } else {
          row.style.display = 'none';
        }
      });

      if (countBadge) {
        countBadge.textContent = `Menampilkan ${visibleCount} dari ${studentsData.length} siswa`;
      }
    }

    searchInput?.addEventListener('input', applyFilters);
    classSelect?.addEventListener('change', applyFilters);

    // CSV Exporter for Filtered Class Record
    exportBtn?.addEventListener('click', () => {
      if (!studentsData || studentsData.length === 0) {
        alert('Tidak ada data siswa untuk diekspor.');
        return;
      }

      const term = searchInput ? searchInput.value.toLowerCase().trim() : '';
      const selectedClass = classSelect ? classSelect.value : 'ALL';

      const filtered = studentsData.filter((s) => {
        const sClass = s.class_name || 'UNASSIGNED';
        const sText = `${s.name} ${s.email} ${s.class_name}`.toLowerCase();
        const matchesSearch = !term || sText.includes(term);
        const matchesClass = selectedClass === 'ALL' || 
                             sClass === selectedClass || 
                             normalizeClass(sClass) === normalizeClass(selectedClass);
        return matchesSearch && matchesClass;
      });

      if (filtered.length === 0) {
        alert('Tidak ada data siswa yang cocok dengan filter saat ini.');
        return;
      }

      // UTF-8 BOM for Excel compatibility
      let csv = '\uFEFF';
      csv += 'No,Nama Siswa,Kelas (RPL),Email,Role,Modul Selesai,Total Modul,Persentase SQL,Nilai LKPD 1 (BK),Nilai LKPD 2 (Algoritma),Peringkat Rank,Tanggal Terdaftar\n';

      filtered.forEach((s, idx) => {
        const name = `"${(s.name || '').replace(/"/g, '""')}"`;
        const className = `"${(s.class_name || '-').replace(/"/g, '""')}"`;
        const email = `"${(s.email || '').replace(/"/g, '""')}"`;
        const role = s.role || 'student';
        const completed = s.completed_count || 0;
        const pct = `${s.percentage || 0}%`;
        const lkpd1Val = s.lkpd1_score !== null && s.lkpd1_score !== undefined ? s.lkpd1_score : (s.lkpd1_submitted_at ? 'Belum Dinilai' : '-');
        const lkpd2Val = s.lkpd2_score !== null && s.lkpd2_score !== undefined ? s.lkpd2_score : (s.lkpd2_submitted_at ? 'Belum Dinilai' : '-');
        const rank = `"${s.rankTitle || ''}"`;
        const date = new Date(s.created_at).toLocaleDateString('id-ID');

        csv += `${idx + 1},${name},${className},${email},${role},${completed},${totalLessonsCount},${pct},${lkpd1Val},${lkpd2Val},${rank},${date}\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      const sanitizedClass = selectedClass.replace(/\s+/g, '-').toLowerCase();
      link.setAttribute('download', `rekap-nilai-sql-lkpd-${sanitizedClass}-${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // Reset Password Modal Logic
    const rpModal = document.getElementById('reset-password-modal');
    const rpStepConfirm = document.getElementById('rp-modal-step-confirm');
    const rpStepResult = document.getElementById('rp-modal-step-result');
    const rpStepError = document.getElementById('rp-modal-step-error');
    const rpTargetName = document.getElementById('rp-target-name');
    const rpResultName = document.getElementById('rp-result-name');
    const rpNewPassword = document.getElementById('rp-new-password');
    const rpErrorMessage = document.getElementById('rp-error-message');
    const rpConfirmBtn = document.getElementById('rp-confirm-btn');
    const rpCancelBtn = document.getElementById('rp-cancel-btn');
    const rpCloseBtn = document.getElementById('rp-close-btn');
    const rpErrorCloseBtn = document.getElementById('rp-error-close-btn');
    const rpCopyBtn = document.getElementById('rp-copy-btn');

    let rpCurrentUserId = null;
    let rpCurrentUserName = '';

    function rpShowStep(step) {
      rpStepConfirm.hidden = step !== 'confirm';
      rpStepResult.hidden = step !== 'result';
      rpStepError.hidden = step !== 'error';
    }

    function rpOpenModal(userId, userName) {
      rpCurrentUserId = userId;
      rpCurrentUserName = userName;
      rpTargetName.textContent = userName;
      rpConfirmBtn.disabled = false;
      rpConfirmBtn.textContent = 'Ya, Reset Password';
      rpShowStep('confirm');
      rpModal.hidden = false;
    }

    function rpCloseModal() {
      rpModal.hidden = true;
      rpCurrentUserId = null;
    }

    document.querySelectorAll('.btn-reset-password').forEach((btn) => {
      btn.addEventListener('click', () => {
        const userId = btn.getAttribute('data-user-id');
        const userName = btn.getAttribute('data-user-name') || 'siswa ini';
        rpOpenModal(userId, userName);
      });
    });

    rpCancelBtn?.addEventListener('click', rpCloseModal);
    rpCloseBtn?.addEventListener('click', rpCloseModal);
    rpErrorCloseBtn?.addEventListener('click', rpCloseModal);
    rpModal?.addEventListener('click', (e) => {
      if (e.target === rpModal) rpCloseModal();
    });

    rpConfirmBtn?.addEventListener('click', async () => {
      if (!rpCurrentUserId) return;
      rpConfirmBtn.disabled = true;
      rpConfirmBtn.textContent = 'Memproses...';

      try {
        const res = await fetch('/api/admin/reset-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId: rpCurrentUserId })
        });
        const data = await res.json();

        if (!res.ok) {
          rpErrorMessage.textContent = data.error || 'Terjadi kesalahan saat mereset password.';
          rpShowStep('error');
          return;
        }

        rpResultName.textContent = rpCurrentUserName;
        rpNewPassword.textContent = data.tempPassword;
        rpShowStep('result');
      } catch (err) {
        rpErrorMessage.textContent = 'Gagal terhubung ke server. Periksa koneksi Anda dan coba lagi.';
        rpShowStep('error');
      } finally {
        rpConfirmBtn.disabled = false;
        rpConfirmBtn.textContent = 'Ya, Reset Password';
      }
    });

    rpCopyBtn?.addEventListener('click', async () => {
      const pwd = rpNewPassword.textContent || '';
      try {
        await navigator.clipboard.writeText(pwd);
        rpCopyBtn.textContent = 'Tersalin!';
        setTimeout(() => { rpCopyBtn.textContent = 'Salin'; }, 1500);
      } catch (err) {
        // Clipboard API unavailable — silently ignore, password is still visible on screen
      }
    });
  });
</script>

