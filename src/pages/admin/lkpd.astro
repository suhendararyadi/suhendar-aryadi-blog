---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { query } from '../../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

const isTeacherOrAdmin = user?.role === 'teacher' || user?.role === 'admin' || (user?.email && user.email.toLowerCase().includes('suhendar'));

if (!user || !isTeacherOrAdmin) {
  return Astro.redirect('/dashboard');
}

let bkSubmissions: any[] = [];
try {
  const res = await query(
    `SELECT s.*, u.name as student_name, u.email as student_email, u.class_name
     FROM lkpd_submissions s
     JOIN users u ON s.user_id = u.id
     ORDER BY s.updated_at DESC`
  );
  if (res.rows) {
    bkSubmissions = res.rows.map(row => {
      let deco: any[] = [];
      let patt: any[] = [];
      let abs: any = {};
      let alg: any = {};

      try { deco = typeof row.decomposition_json === 'string' ? JSON.parse(row.decomposition_json || '[]') : (row.decomposition_json || []); } catch (e) {}
      try { patt = typeof row.pattern_json === 'string' ? JSON.parse(row.pattern_json || '[]') : (row.pattern_json || []); } catch (e) {}
      try { abs = typeof row.abstraction_json === 'string' ? JSON.parse(row.abstraction_json || '{}') : (row.abstraction_json || {}); } catch (e) {}
      try { alg = typeof row.algorithm_json === 'string' ? JSON.parse(row.algorithm_json || '{}') : (row.algorithm_json || {}); } catch (e) {}

      return {
        ...row,
        moduleType: 'BK',
        parsedDeco: deco,
        parsedPatt: patt,
        parsedAbs: abs,
        parsedAlg: alg
      };
    });
  }
} catch (err) {
  console.warn('Error fetching BK LKPD submissions:', err);
}

let tikSubmissions: any[] = [];
try {
  const res = await query(
    `SELECT s.*, u.name as student_name, u.email as student_email, u.class_name
     FROM lkpd_tik_submissions s
     JOIN users u ON s.user_id = u.id
     ORDER BY s.updated_at DESC`
  );
  if (res.rows) {
    tikSubmissions = res.rows.map(row => {
      let mailMerge: any = {};
      let searchOperators: any = {};
      let reflection: any = {};
      let teamMembers: any = [];

      try { mailMerge = typeof row.mail_merge_json === 'string' ? JSON.parse(row.mail_merge_json || '{}') : (row.mail_merge_json || {}); } catch (e) {}
      try { searchOperators = typeof row.search_operators_json === 'string' ? JSON.parse(row.search_operators_json || '{}') : (row.search_operators_json || {}); } catch (e) {}
      try { reflection = typeof row.reflection_json === 'string' ? JSON.parse(row.reflection_json || '{}') : (row.reflection_json || {}); } catch (e) {}
      try { teamMembers = typeof row.team_members === 'string' ? JSON.parse(row.team_members || '[]') : (row.team_members || []); } catch (e) {}

      return {
        ...row,
        moduleType: 'TIK',
        parsedMailMerge: mailMerge,
        parsedSearchOperators: searchOperators,
        parsedReflection: reflection,
        parsedTeamMembers: Array.isArray(teamMembers) ? teamMembers : []
      };
    });
  }
} catch (err) {
  console.warn('Error fetching TIK LKPD submissions:', err);
}

const allSubmissions = [...bkSubmissions, ...tikSubmissions];

let flowchartSubmissions: any[] = [];
try {
  const res = await query(
    `SELECT s.*, u.name as student_name, u.email as student_email, u.class_name
     FROM lkpd_flowchart_submissions s
     JOIN users u ON s.user_id = u.id
     ORDER BY s.updated_at DESC`
  );
  if (res.rows) {
    flowchartSubmissions = res.rows.map(row => {
      let flowchart: any[] = [];
      try { flowchart = typeof row.flowchart_json === 'string' ? JSON.parse(row.flowchart_json || '[]') : (row.flowchart_json || []); } catch (e) {}

      return {
        ...row,
        moduleType: 'FLOWCHART',
        parsedFlowchart: Array.isArray(flowchart) ? flowchart : []
      };
    });
  }
} catch (err) {
  console.warn('Error fetching Flowchart LKPD submissions:', err);
}

const allSubmissionsWithFlowchart = [...allSubmissions, ...flowchartSubmissions];

// Get unique classes for filter dropdown
const uniqueClasses = Array.from(new Set(allSubmissionsWithFlowchart.map(s => s.class_name || 'X RPL'))).sort();

let currentDeadline = '';
try {
  const dRes = await query(`SELECT setting_value FROM system_settings WHERE setting_key = 'lkpd_deadline'`);
  if (dRes.rows && dRes.rows.length > 0) {
    currentDeadline = dRes.rows[0].setting_value || '';
  }
} catch (e) {
  console.warn('Error fetching lkpd_deadline setting:', e);
}
---

<MainLayout
  title="Portal Penilaian LKPD Digital | Suhendar Aryadi, S.Pd.,Gr."
  description="Portal evaluasi dan penilaian Lembar Kerja Peserta Didik (LKPD) Informatika (BK & TIK) oleh Guru."
>
  <div class="admin-lkpd-container">
    <!-- Header Banner -->
    <div class="admin-header glass-card">
      <div class="header-main">
        <div>
          <span class="badge badge-purple">PORTAL GURU &amp; ADMIN</span>
          <h1 class="admin-title">Penilaian LKPD Digital Informatika</h1>
          <p class="admin-sub">
            Evaluasi dan berikan umpan balik tugas Lembar Kerja Peserta Didik (LKPD) Berpikir Komputasional (BK) &amp; TIK per rombel kelas.
          </p>
        </div>
        <div class="header-actions">
          <button id="export-csv-btn" class="btn btn-secondary btn-sm" type="button">
            Unduh CSV Rekap LKPD
          </button>
          <a href="/admin/dashboard" class="btn btn-outline btn-sm">
            &larr; Dashboard Rekap Nilai
          </a>
        </div>
      </div>
    </div>

    <!-- LKPD Deadline Setting Card -->
    <div class="deadline-card glass-card">
      <div class="deadline-flex">
        <div class="deadline-info">
          <h3 class="deadline-title">Pengaturan Tenggat Waktu (Deadline) Pengumpulan LKPD</h3>
          <p class="deadline-sub">
            {currentDeadline ? (
              <>Tenggat Pengumpulan Aktif: <strong class="text-accent">{new Date(currentDeadline).toLocaleString('id-ID', { dateStyle: 'full', timeStyle: 'short' })} WIB</strong></>
            ) : (
              <>Status Pengumpulan: <span class="text-muted">Tidak Ada Tenggat Waktu (Bebas Mengirim)</span></>
            )}
          </p>
        </div>
        <form id="deadline-form" class="deadline-form">
          <input 
            type="datetime-local" 
            id="deadline-datetime-input" 
            class="tool-input deadline-input"
            value={currentDeadline ? new Date(new Date(currentDeadline).getTime() - new Date().getTimezoneOffset() * 60000).toISOString().slice(0, 16) : ''} 
            required
          />
          <button type="submit" class="btn btn-primary btn-sm" id="save-deadline-btn">
            Simpan Deadline
          </button>
          {currentDeadline && (
            <button type="button" class="btn btn-outline btn-sm" id="remove-deadline-btn">
              Hapus Deadline
            </button>
          )}
        </form>
      </div>
    </div>

    <!-- Module Tab Switcher Bar -->
    <div class="tab-switcher-card glass-card">
      <div class="tab-switcher-nav">
        <button id="tab-btn-bk" class="tab-nav-item active" type="button" data-module="BK">
          <span class="tab-badge badge badge-purple">LKPD 1</span>
          <span class="tab-title">BK: 4 Pilar Masalah</span>
          <span class="tab-count-pill" id="bk-count-pill">{bkSubmissions.length}</span>
        </button>
        <button id="tab-btn-flowchart" class="tab-nav-item" type="button" data-module="FLOWCHART">
          <span class="tab-badge badge badge-purple">LKPD 2</span>
          <span class="tab-title">BK: Flowchart &amp; Pseudocode</span>
          <span class="tab-count-pill" id="flowchart-count-pill">{flowchartSubmissions.length}</span>
        </button>
        <button id="tab-btn-tik" class="tab-nav-item" type="button" data-module="TIK">
          <span class="tab-badge badge badge-cyan">LKPD TIK</span>
          <span class="tab-title">TIK: Mail Merge &amp; Search</span>
          <span class="tab-count-pill" id="tik-count-pill">{tikSubmissions.length}</span>
        </button>
      </div>
    </div>

    <!-- Filter & Toolbar Block -->
    <div class="toolbar-card glass-card">
      <div class="toolbar-grid">
        <div class="tool-group">
          <label for="filter-class">Filter Kelas / Rombel:</label>
          <select id="filter-class" class="tool-select">
            <option value="ALL">Semua Kelas</option>
            {uniqueClasses.map(c => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </div>

        <div class="tool-group">
          <label for="filter-status">Filter Status Penilaian:</label>
          <select id="filter-status" class="tool-select">
            <option value="ALL">Semua Status</option>
            <option value="UNGRADED">Belum Dinilai</option>
            <option value="GRADED">Sudah Dinilai</option>
          </select>
        </div>

        <div class="tool-group flex-2">
          <label for="search-input">Cari Siswa / Tim:</label>
          <input type="text" id="search-input" class="tool-input" placeholder="Ketik nama siswa, email, atau nama tim..." />
        </div>
      </div>
    </div>

    <!-- Submissions Block -->
    <div class="section-block glass-card">
      <div class="block-header">
        <div>
          <h2 class="block-title">
            Daftar Kiriman <span id="module-title-display">LKPD 1 (BK)</span> Siswa (<span id="count-display">{bkSubmissions.length}</span>)
          </h2>
          <p class="block-sub" id="module-sub-display">Pilih tugas siswa untuk memeriksa 4 pilar analisis dan memberikan skor nilai</p>
        </div>
      </div>

      <div class="submissions-list" id="submissions-list">
        <!-- Render BK Submissions -->
        {bkSubmissions.map((item) => (
          <div 
            class="submission-card glass-card module-card-bk"
            data-module="BK"
            data-class={item.class_name || 'X RPL'}
            data-status={item.score !== null ? 'GRADED' : 'UNGRADED'}
            data-search={`${item.student_name} ${item.student_email} ${item.team_name || ''}`.toLowerCase()}
          >
            <div class="sub-card-header">
              <div>
                <span class="badge badge-purple">LKPD 1 BK</span>
                <span class="badge badge-cyan">{item.class_name || 'X RPL'}</span>
                <h3 class="sub-student-name">{item.student_name} <span class="sub-email">({item.student_email})</span></h3>
                <span class="sub-team-name">Tim: <strong>{item.team_name || 'Mandiri'}</strong> | Studi Kasus: <strong>{item.case_study_id.toUpperCase()}</strong></span>
              </div>
              <div class="sub-score-box">
                {item.score !== null ? (
                  <span class="badge badge-green">Nilai: {item.score} / 100</span>
                ) : (
                  <span class="badge badge-amber">Belum Dinilai</span>
                )}
              </div>
            </div>

            <!-- Quick Answers Overview -->
            <div class="sub-quick-preview">
              <div class="quick-item">
                <strong>Struktur Modul Dekomposisi:</strong>
                <span>{item.parsedDeco.map((d: any) => d.mod).filter(Boolean).join(', ') || 'Belum diisi'}</span>
              </div>
              <div class="quick-item">
                <strong>Algoritma &amp; Search:</strong>
                <span>{item.parsedAlg.search || '-'} / {item.parsedAlg.sort || '-'}</span>
              </div>
            </div>

            <!-- Collapsible Full Detail Drawer Button -->
            <div class="detail-toggle-bar">
              <button class="btn-toggle-detail" type="button" data-target={`detail-bk-${item.id}`}>
                <span>Tampilkan Detail Jawaban Lengkap 4 Pilar</span>
                <span class="arrow-icon">&darr;</span>
              </button>
            </div>

            <!-- Full Detail Answer Drawer (Hidden by default) -->
            <div id={`detail-bk-${item.id}`} class="detail-drawer" style="display: none;">
              <!-- 1. Dekomposisi -->
              <div class="detail-section">
                <h4 class="detail-sec-title">1. Dekomposisi System (4 Sub-Sistem)</h4>
                <table class="detail-table">
                  <thead>
                    <tr>
                      <th style="width: 40px;">No</th>
                      <th style="width: 220px;">Modul / Sub-Sistem</th>
                      <th>Fungsi Utama &amp; Fitur</th>
                    </tr>
                  </thead>
                  <tbody>
                    {item.parsedDeco.map((d: any, idx: number) => (
                      <tr>
                        <td class="text-center">{idx + 1}</td>
                        <td><strong>{d.mod || '-'}</strong></td>
                        <td>{d.func || '-'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- 2. Pengenalan Pola -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">2. Pengenalan Pola (Pattern Recognition)</h4>
                <table class="detail-table">
                  <thead>
                    <tr>
                      <th style="width: 40px;">No</th>
                      <th style="width: 240px;">Pola Ditemukan</th>
                      <th>Rencana Solusi Berulang</th>
                    </tr>
                  </thead>
                  <tbody>
                    {item.parsedPatt.map((p: any, idx: number) => (
                      <tr>
                        <td class="text-center">{idx + 1}</td>
                        <td><strong>{p.name || '-'}</strong></td>
                        <td>{p.sol || '-'}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>

              <!-- 3. Abstraksi -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">3. Abstraksi (Abstraction)</h4>
                <div class="detail-grid-2">
                  <div class="detail-box box-kept">
                    <strong>Data Utama Wajib Disimpan:</strong>
                    <p>{item.parsedAbs.kept || 'Belum diisi'}</p>
                  </div>
                  <div class="detail-box box-ignored">
                    <strong>Detail Informasi Diabaikan:</strong>
                    <p>{item.parsedAbs.ignored || 'Belum diisi'}</p>
                  </div>
                </div>
              </div>

              <!-- 4. Algoritma & Pseudocode -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">4. Algoritma &amp; Pseudocode</h4>
                <div class="detail-grid-2 margin-bottom-xs">
                  <div><strong>Algoritma Search:</strong> {item.parsedAlg.search || '-'}</div>
                  <div><strong>Algoritma Sort:</strong> {item.parsedAlg.sort || '-'}</div>
                  <div><strong>Penggunaan Queue:</strong> {item.parsedAlg.queue || '-'}</div>
                  <div><strong>Penggunaan Stack:</strong> {item.parsedAlg.stack || '-'}</div>
                </div>
                <div class="pseudocode-preview-box">
                  <strong>Pseudocode Alur Utama:</strong>
                  <pre class="font-mono">{item.parsedAlg.pseudocode || '// Belum diisi'}</pre>
                </div>
              </div>
            </div>

            <!-- Grading Form -->
            <div class="grading-form-wrap">
              <form class="grade-form" data-id={item.id} data-endpoint="/api/admin/grade-lkpd">
                <div class="grade-inputs-row">
                  <div class="input-group">
                    <label>Skor Nilai (0 - 100):</label>
                    <input type="number" name="score" min="0" max="100" class="grade-score-input" value={item.score !== null ? item.score : ''} required />
                  </div>
                  <div class="input-group flex-1">
                    <label>Umpan Balik / Catatan Guru (BK):</label>
                    <input type="text" name="feedback" class="grade-feedback-input" placeholder="Misal: Dekomposisi sangat tepat, perhatikan urutan Pseudocode." value={item.teacher_feedback || ''} />
                  </div>
                  <button class="btn btn-primary btn-sm save-grade-btn" type="submit">
                    Simpan Nilai BK
                  </button>
                </div>
              </form>
            </div>
          </div>
        ))}

        <!-- Render Flowchart (LKPD 1B) Submissions -->
        {flowchartSubmissions.map((item) => (
          <div 
            class="submission-card glass-card module-card-flowchart"
            data-module="FLOWCHART"
            data-class={item.class_name || 'X RPL'}
            data-status={item.score !== null ? 'GRADED' : 'UNGRADED'}
            data-search={`${item.student_name} ${item.student_email} ${item.team_name || ''}`.toLowerCase()}
            style="display: none;"
          >
            <div class="sub-card-header">
              <div>
                <span class="badge badge-purple">LKPD 1B FLOWCHART</span>
                <span class="badge badge-cyan">{item.class_name || 'X RPL'}</span>
                <h3 class="sub-student-name">{item.student_name} <span class="sub-email">({item.student_email})</span></h3>
                <span class="sub-team-name">Tim: <strong>{item.team_name || 'Mandiri'}</strong> | Studi Kasus: <strong>{item.case_study_id.toUpperCase()}</strong></span>
              </div>
              <div class="sub-score-box">
                {item.score !== null ? (
                  <span class="badge badge-green">Nilai: {item.score} / 100</span>
                ) : (
                  <span class="badge badge-amber">Belum Dinilai</span>
                )}
              </div>
            </div>

            <!-- Quick Answers Overview Flowchart -->
            <div class="sub-quick-preview">
              <div class="quick-item">
                <strong>Jumlah Simbol Flowchart:</strong>
                <span>{item.parsedFlowchart.length} simbol</span>
              </div>
              <div class="quick-item">
                <strong>Mengandung Decision:</strong>
                <span>{item.parsedFlowchart.some((f: any) => f.shape === 'decision') ? 'Ya ✓' : 'Tidak ✗'}</span>
              </div>
            </div>

            <!-- Collapsible Full Detail Drawer Button -->
            <div class="detail-toggle-bar">
              <button class="btn-toggle-detail" type="button" data-target={`detail-flow-${item.id}`}>
                <span>Tampilkan Detail Flowchart &amp; Pseudocode Lengkap</span>
                <span class="arrow-icon">&darr;</span>
              </button>
            </div>

            <!-- Full Detail Answer Drawer Flowchart (Hidden by default) -->
            <div id={`detail-flow-${item.id}`} class="detail-drawer" style="display: none;">
              <!-- 1. Susunan Flowchart -->
              <div class="detail-section">
                <h4 class="detail-sec-title">1. Susunan Flowchart ({item.parsedFlowchart.length} Simbol)</h4>
                {item.parsedFlowchart.length > 0 ? (
                  <div class="flow-review-list">
                    {item.parsedFlowchart.map((f: any, idx: number) => (
                      <div class="flow-review-item">
                        <span class="flow-review-num">{idx + 1}</span>
                        <span class={`flow-review-badge flow-review-${f.shape}`}>{f.shape.toUpperCase()}</span>
                        <span class="flow-review-text">{f.text || '(kosong)'}</span>
                      </div>
                    ))}
                  </div>
                ) : (
                  <p class="text-muted">Belum ada simbol flowchart yang disusun.</p>
                )}
              </div>

              <!-- 2. Pseudocode -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">2. Pseudocode</h4>
                <div class="pseudocode-preview-box">
                  <strong>Pseudocode Alur Utama:</strong>
                  <pre class="font-mono">{item.pseudocode_text || '// Belum diisi'}</pre>
                </div>
              </div>
            </div>

            <!-- Grading Form Flowchart -->
            <div class="grading-form-wrap">
              <form class="grade-form" data-id={item.id} data-endpoint="/api/admin/grade-lkpd-flowchart">
                <div class="grade-inputs-row">
                  <div class="input-group">
                    <label>Skor Nilai (0 - 100):</label>
                    <input type="number" name="score" min="0" max="100" class="grade-score-input" value={item.score !== null ? item.score : ''} required />
                  </div>
                  <div class="input-group flex-1">
                    <label>Umpan Balik / Catatan Guru (Flowchart):</label>
                    <input type="text" name="feedback" class="grade-feedback-input" placeholder="Misal: Alur decision sudah tepat, perhatikan urutan simbol I/O." value={item.teacher_feedback || ''} />
                  </div>
                  <button class="btn btn-primary btn-sm save-grade-btn" type="submit">
                    Simpan Nilai Flowchart
                  </button>
                </div>
              </form>
            </div>
          </div>
        ))}

        <!-- Render TIK Submissions -->
        {tikSubmissions.map((item) => (
          <div 
            class="submission-card glass-card module-card-tik"
            data-module="TIK"
            data-class={item.class_name || 'X RPL'}
            data-status={item.score !== null ? 'GRADED' : 'UNGRADED'}
            data-search={`${item.student_name} ${item.student_email} ${item.team_name || ''} ${item.parsedTeamMembers.join(' ')}`.toLowerCase()}
            style="display: none;"
          >
            <div class="sub-card-header">
              <div>
                <span class="badge badge-cyan">LKPD 2 TIK</span>
                <span class="badge badge-purple">{item.class_name || 'X RPL'}</span>
                <h3 class="sub-student-name">{item.student_name} <span class="sub-email">({item.student_email})</span></h3>
                <span class="sub-team-name">
                  Tim: <strong>{item.team_name || 'Mandiri'}</strong> 
                  {item.parsedTeamMembers.length > 0 && <> ({item.parsedTeamMembers.join(', ')})</>}
                  | Studi Kasus: <strong>{item.case_study_id.toUpperCase()}</strong>
                </span>
              </div>
              <div class="sub-score-box">
                {item.score !== null ? (
                  <span class="badge badge-green">Nilai: {item.score} / 100</span>
                ) : (
                  <span class="badge badge-amber">Belum Dinilai</span>
                )}
              </div>
            </div>

            <!-- Quick Answers Overview TIK -->
            <div class="sub-quick-preview">
              <div class="quick-item">
                <strong>Mail Merge Kolom:</strong>
                <span>{item.parsedMailMerge.headers || 'Belum diisi'}</span>
              </div>
              <div class="quick-item">
                <strong>Query Search Operator:</strong>
                <span class="font-mono">{item.parsedSearchOperators.query || item.parsedSearchOperators.query_string || 'Belum diisi'}</span>
              </div>
            </div>

            <!-- Collapsible Full Detail Drawer Button -->
            <div class="detail-toggle-bar">
              <button class="btn-toggle-detail" type="button" data-target={`detail-tik-${item.id}`}>
                <span>Tampilkan Detail Jawaban Lengkap LKPD TIK</span>
                <span class="arrow-icon">&darr;</span>
              </button>
            </div>

            <!-- Full Detail Answer Drawer TIK (Hidden by default) -->
            <div id={`detail-tik-${item.id}`} class="detail-drawer" style="display: none;">
              <!-- 1. Identitas Kelompok & Studi Kasus -->
              <div class="detail-section">
                <h4 class="detail-sec-title">1. Identitas Kelompok &amp; Studi Kasus TIK</h4>
                <div class="detail-grid-2">
                  <div class="detail-box">
                    <strong>Nama Tim / Kelompok:</strong>
                    <p>{item.team_name || 'Mandiri'}</p>
                  </div>
                  <div class="detail-box">
                    <strong>Anggota Tim:</strong>
                    <p>{item.parsedTeamMembers.join(', ') || 'Mandiri'}</p>
                  </div>
                </div>
              </div>

              <!-- 2. Integrasi Perkantoran (Mail Merge & OLE) -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">2. Integrasi Perkantoran (Mail Merge &amp; OLE)</h4>
                <div class="detail-box margin-bottom-xs">
                  <strong>Struktur Header Kolom Data (CSV / Excel):</strong>
                  <p class="font-mono">{item.parsedMailMerge.headers || '-'}</p>
                </div>
                <div class="detail-box margin-bottom-xs">
                  <strong>Template Tag / Placeholder (Word):</strong>
                  <p class="font-mono">{item.parsedMailMerge.template || '-'}</p>
                </div>
                <div class="detail-box">
                  <strong>Analisis Alur Kerja Object Linking &amp; Embedding (OLE):</strong>
                  <p>{item.parsedMailMerge.ole_workflow || 'Belum diisi'}</p>
                </div>
              </div>

              <!-- 3. Advanced Search Operators -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">3. Advanced Search Operators (Pencarian Digital Efektif)</h4>
                <div class="detail-grid-2 margin-bottom-xs">
                  <div class="detail-box">
                    <strong>Topik Target Pencarian:</strong>
                    <p>{item.parsedSearchOperators.topic || item.parsedSearchOperators.target_topic || '-'}</p>
                  </div>
                  <div class="detail-box">
                    <strong>Sintaks Query Operator:</strong>
                    <p class="font-mono">{item.parsedSearchOperators.query || item.parsedSearchOperators.query_string || '-'}</p>
                  </div>
                </div>
                <div class="detail-box">
                  <strong>Evaluasi Efektivitas Query &amp; Validasi Kredibilitas Sumber:</strong>
                  <p>{item.parsedSearchOperators.evaluation || item.parsedSearchOperators.source_eval || 'Belum diisi'}</p>
                </div>
              </div>

              <!-- 4. Refleksi Tim -->
              <div class="detail-section margin-top-sm">
                <h4 class="detail-sec-title">4. Refleksi Tim &amp; Pembelajaran TIK</h4>
                <div class="detail-box">
                  <strong>Kesimpulan &amp; Refleksi Efisiensi Kerja Tim:</strong>
                  <p>{item.parsedReflection.efficiency || item.parsedReflection.reflection || 'Belum diisi'}</p>
                </div>
              </div>
            </div>

            <!-- Grading Form TIK -->
            <div class="grading-form-wrap">
              <form class="grade-form" data-id={item.id} data-endpoint="/api/admin/grade-lkpd-tik">
                <div class="grade-inputs-row">
                  <div class="input-group">
                    <label>Skor Nilai TIK (0 - 100):</label>
                    <input type="number" name="score" min="0" max="100" class="grade-score-input" value={item.score !== null ? item.score : ''} required />
                  </div>
                  <div class="input-group flex-1">
                    <label>Umpan Balik / Catatan Guru (TIK):</label>
                    <input type="text" name="feedback" class="grade-feedback-input" placeholder="Misal: Sintaks query operator sangat tepat dan analisis Mail Merge runtut." value={item.teacher_feedback || ''} />
                  </div>
                  <button class="btn btn-primary btn-sm save-grade-btn" type="submit">
                    Simpan Nilai TIK
                  </button>
                </div>
              </form>
            </div>
          </div>
        ))}

        <!-- Empty State Container -->
        <div class="empty-state" id="empty-state-display" style="display: none;">
          <p>Belum ada siswa yang mengirimkan LKPD pada kategori ini.</p>
        </div>
      </div>
    </div>
  </div>
</MainLayout>

<script is:inline define:vars={{ bkSubmissionsData: bkSubmissions, tikSubmissionsData: tikSubmissions, flowchartSubmissionsData: flowchartSubmissions }}>
  document.addEventListener('DOMContentLoaded', () => {
    let currentModule = 'BK'; // 'BK' or 'TIK'

    // 1. Tab Switcher Logic
    const tabBk = document.getElementById('tab-btn-bk');
    const tabFlowchart = document.getElementById('tab-btn-flowchart');
    const tabTik = document.getElementById('tab-btn-tik');
    const moduleTitleDisplay = document.getElementById('module-title-display');
    const moduleSubDisplay = document.getElementById('module-sub-display');
    const exportBtn = document.getElementById('export-csv-btn');

    function setModuleTab(module) {
      currentModule = module;
      tabBk?.classList.remove('active');
      tabFlowchart?.classList.remove('active');
      tabTik?.classList.remove('active');

      if (module === 'BK') {
        tabBk?.classList.add('active');
        if (moduleTitleDisplay) moduleTitleDisplay.textContent = 'LKPD 1 (BK)';
        if (moduleSubDisplay) moduleSubDisplay.textContent = 'Pilih tugas siswa untuk memeriksa 4 pilar analisis dan memberikan skor nilai';
        if (exportBtn) exportBtn.textContent = 'Unduh CSV Rekap LKPD 1 (BK)';
      } else if (module === 'FLOWCHART') {
        tabFlowchart?.classList.add('active');
        if (moduleTitleDisplay) moduleTitleDisplay.textContent = 'LKPD 1B (Flowchart & Pseudocode)';
        if (moduleSubDisplay) moduleSubDisplay.textContent = 'Pilih tugas siswa untuk memeriksa susunan flowchart & pseudocode dan memberikan skor nilai';
        if (exportBtn) exportBtn.textContent = 'Unduh CSV Rekap LKPD 1B (Flowchart)';
      } else {
        tabTik?.classList.add('active');
        if (moduleTitleDisplay) moduleTitleDisplay.textContent = 'LKPD 2 (TIK)';
        if (moduleSubDisplay) moduleSubDisplay.textContent = 'Pilih tugas siswa untuk memeriksa Mail Merge & Advanced Search Operators dan memberikan skor nilai';
        if (exportBtn) exportBtn.textContent = 'Unduh CSV Rekap LKPD 2 (TIK)';
      }
      applyFilters();
    }

    tabBk?.addEventListener('click', () => setModuleTab('BK'));
    tabFlowchart?.addEventListener('click', () => setModuleTab('FLOWCHART'));
    tabTik?.addEventListener('click', () => setModuleTab('TIK'));

    // 2. Toggle Detail Drawers
    const toggleBtns = document.querySelectorAll('.btn-toggle-detail');
    toggleBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-target');
        const drawer = document.getElementById(targetId);
        const arrow = btn.querySelector('.arrow-icon');
        if (!drawer) return;

        if (drawer.style.display === 'none' || !drawer.style.display) {
          drawer.style.display = 'block';
          btn.classList.add('active');
          if (arrow) arrow.innerHTML = '&uarr;';
        } else {
          drawer.style.display = 'none';
          btn.classList.remove('active');
          if (arrow) arrow.innerHTML = '&darr;';
        }
      });
    });

    // 3. Filter & Search Logic
    const filterClass = document.getElementById('filter-class');
    const filterStatus = document.getElementById('filter-status');
    const searchInput = document.getElementById('search-input');
    const countDisplay = document.getElementById('count-display');
    const emptyStateDisplay = document.getElementById('empty-state-display');
    const cards = document.querySelectorAll('.submission-card');

    function applyFilters() {
      const selectedClass = filterClass ? filterClass.value : 'ALL';
      const selectedStatus = filterStatus ? filterStatus.value : 'ALL';
      const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : '';

      let visibleCount = 0;

      cards.forEach(card => {
        const cardModule = card.getAttribute('data-module') || 'BK';
        const cardClass = card.getAttribute('data-class') || '';
        const cardStatus = card.getAttribute('data-status') || '';
        const cardSearch = card.getAttribute('data-search') || '';

        const moduleMatch = cardModule === currentModule;
        const classMatch = selectedClass === 'ALL' || cardClass === selectedClass;
        const statusMatch = selectedStatus === 'ALL' || cardStatus === selectedStatus;
        const searchMatch = !searchQuery || cardSearch.includes(searchQuery);

        if (moduleMatch && classMatch && statusMatch && searchMatch) {
          card.style.display = 'flex';
          visibleCount++;
        } else {
          card.style.display = 'none';
        }
      });

      if (countDisplay) countDisplay.textContent = String(visibleCount);
      if (emptyStateDisplay) {
        emptyStateDisplay.style.display = visibleCount === 0 ? 'block' : 'none';
      }
    }

    filterClass?.addEventListener('change', applyFilters);
    filterStatus?.addEventListener('change', applyFilters);
    searchInput?.addEventListener('input', applyFilters);

    // Initial filter run
    applyFilters();

    // 4. Save Grade Form Submit
    const forms = document.querySelectorAll('.grade-form');
    forms.forEach(form => {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const submissionId = form.getAttribute('data-id');
        const endpoint = form.getAttribute('data-endpoint') || '/api/admin/grade-lkpd';
        const score = form.querySelector('[name="score"]').value;
        const teacherFeedback = form.querySelector('[name="feedback"]').value;
        const btn = form.querySelector('.save-grade-btn');

        btn.disabled = true;
        const origBtnText = btn.textContent;
        btn.textContent = 'Menyimpan...';

        try {
          const res = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ submissionId, score, teacherFeedback })
          });

          const data = await res.json();
          if (res.ok && data.success) {
            alert('✅ ' + data.message);
            window.location.reload();
          } else {
            alert('❌ Gagal: ' + (data.error || 'Terjadi kesalahan.'));
          }
        } catch (err) {
          alert('❌ Error koneksi ke server.');
        } finally {
          btn.disabled = false;
          btn.textContent = origBtnText;
        }
      });
    });

    // 5. Export CSV Handler
    exportBtn?.addEventListener('click', () => {
      const activeData = currentModule === 'BK' ? bkSubmissionsData : (currentModule === 'FLOWCHART' ? flowchartSubmissionsData : tikSubmissionsData);

      if (!activeData || activeData.length === 0) {
        alert(`Tidak ada data kiriman LKPD ${currentModule} untuk di-export.`);
        return;
      }

      let csv;
      if (currentModule === 'BK') {
        csv = 'No,Nama Siswa,Email Siswa,Kelas,Nama Tim,Studi Kasus,Skor Nilai,Umpan Balik Guru,Tanggal Kirim\n';
      } else if (currentModule === 'FLOWCHART') {
        csv = 'No,Nama Siswa,Email Siswa,Kelas,Nama Tim,Studi Kasus,Jumlah Simbol,Skor Nilai,Umpan Balik Guru,Tanggal Kirim\n';
      } else {
        csv = 'No,Nama Siswa,Email Siswa,Kelas,Nama Tim,Anggota Tim,Studi Kasus,Skor Nilai,Umpan Balik Guru,Tanggal Kirim\n';
      }

      activeData.forEach((row, index) => {
        const studentName = `"${(row.student_name || '').replace(/"/g, '""')}"`;
        const studentEmail = `"${(row.student_email || '').replace(/"/g, '""')}"`;
        const className = `"${(row.class_name || 'X RPL').replace(/"/g, '""')}"`;
        const teamName = `"${(row.team_name || 'Mandiri').replace(/"/g, '""')}"`;
        const caseStudy = `"${(row.case_study_id || '').toUpperCase().replace(/"/g, '""')}"`;
        const score = row.score !== null ? row.score : 'Belum Dinilai';
        const feedback = `"${(row.teacher_feedback || '').replace(/"/g, '""')}"`;
        const date = `"${new Date(row.updated_at).toLocaleString('id-ID')}"`;

        if (currentModule === 'BK') {
          csv += `${index + 1},${studentName},${studentEmail},${className},${teamName},${caseStudy},${score},${feedback},${date}\n`;
        } else if (currentModule === 'FLOWCHART') {
          let symbolCount = 0;
          try { symbolCount = JSON.parse(row.flowchart_json || '[]').length; } catch (e) {}
          csv += `${index + 1},${studentName},${studentEmail},${className},${teamName},${caseStudy},${symbolCount},${score},${feedback},${date}\n`;
        } else {
          const teamMembers = `"${(Array.isArray(row.parsedTeamMembers) ? row.parsedTeamMembers.join('; ') : '').replace(/"/g, '""')}"`;
          csv += `${index + 1},${studentName},${studentEmail},${className},${teamName},${teamMembers},${caseStudy},${score},${feedback},${date}\n`;
        }
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.setAttribute('href', url);
      link.setAttribute('download', `rekap_lkpd_${currentModule.toLowerCase()}_informatika_${new Date().toISOString().slice(0, 10)}.csv`);
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
    });

    // 6. Deadline Setting Form Handler
    const deadlineForm = document.getElementById('deadline-form');
    const deadlineInput = document.getElementById('deadline-datetime-input');
    const removeDeadlineBtn = document.getElementById('remove-deadline-btn');

    deadlineForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const val = deadlineInput.value;
      if (!val) {
        alert('Pilih tanggal dan jam tenggat waktu terlebih dahulu.');
        return;
      }
      const isoVal = new Date(val).toISOString();

      try {
        const res = await fetch('/api/admin/set-lkpd-deadline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ deadline: isoVal })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('✅ ' + data.message);
          window.location.reload();
        } else {
          alert('❌ Gagal: ' + (data.error || 'Terjadi kesalahan.'));
        }
      } catch (err) {
        alert('❌ Error koneksi ke server.');
      }
    });

    removeDeadlineBtn?.addEventListener('click', async () => {
      if (!confirm('Apakah Anda yakin ingin menghapus tenggat waktu pengumpulan LKPD? Siswa akan bebas mengirimkan tugas tanpa batasan jam.')) return;
      try {
        const res = await fetch('/api/admin/set-lkpd-deadline', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ deadline: '' })
        });
        const data = await res.json();
        if (res.ok && data.success) {
          alert('✅ ' + data.message);
          window.location.reload();
        } else {
          alert('❌ Gagal: ' + (data.error || 'Terjadi kesalahan.'));
        }
      } catch (err) {
        alert('❌ Error koneksi ke server.');
      }
    });
  });
</script>

