---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const modules = await getCollection('modules');
  return modules.map((module) => ({
    params: { slug: module.slug },
    props: { module },
  }));
}

interface Props {
  module: CollectionEntry<'modules'>;
}

const { module } = Astro.props;
const { Content } = await module.render();
---

<MainLayout title={`${module.data.title} | Materi RPL`} description={`Modul pembelajaran ${module.data.subject} (${module.data.grade})`}>
  <article class="module-container">
    <div class="back-navigation">
      <a href="/materi" class="back-link">
        &larr; Kembali ke Daftar Materi
      </a>
    </div>

    <!-- Module Hero Banner with Feature Image -->
    <header class="module-hero-card glass-card">
      <div class="feature-image-wrapper">
        {module.data.image ? (
          <img src={module.data.image} alt={module.data.title} class="feature-img" />
        ) : (
          <div class="feature-placeholder">
            <div class="feature-pattern"></div>
            <div class="feature-placeholder-content">
              <div class="feature-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
                  <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
                </svg>
              </div>
              <span class="feature-topic-tag">{module.data.subject}</span>
            </div>
          </div>
        )}
      </div>

      <div class="hero-body">
        <div class="header-badges">
          <span class="badge badge-cyan">{module.data.subject}</span>
          <span class="badge">{module.data.grade}</span>
        </div>

        <h1 class="module-title">{module.data.title}</h1>

        <div class="header-footer">
          <div class="module-tags">
            {module.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>

          {module.data.downloadUrl && (
            <a 
              href={module.data.downloadUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="btn btn-primary"
            >
              <span>Unduh Berkas PDF</span>
            </a>
          )}
        </div>
      </div>
    </header>

    <div class="module-content glass-card prose">
      <Content />
    </div>

    <footer class="module-footer-nav">
      <a href="/materi" class="btn btn-secondary">
        &larr; Kembali ke Semua Materi Pembelajaran
      </a>
    </footer>
  </article>
</MainLayout>

<style>
  .module-container {
    max-width: 880px;
    margin: 0 auto 4rem;
  }

  .back-navigation {
    margin-bottom: 1.25rem;
  }

  .back-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .module-hero-card {
    padding: 0;
    overflow: hidden;
    margin-bottom: 2rem;
    border-radius: var(--radius-xl);
  }

  /* Feature Image Hero Banner */
  .feature-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--bg-tertiary);
  }

  @media (max-width: 640px) {
    .feature-image-wrapper {
      aspect-ratio: 16 / 9;
    }
  }

  .feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #06b6d4 50%, #6366f1 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(#ffffff 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .feature-placeholder-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #ffffff;
  }

  .feature-icon-box {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #ffffff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .feature-topic-tag {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-body {
    padding: 2.25rem;
  }

  @media (max-width: 640px) {
    .hero-body {
      padding: 1.5rem;
    }
  }

  .header-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .module-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 768px) {
    .module-title {
      font-size: 1.75rem;
    }
  }

  .header-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .module-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .module-content {
    padding: 2.5rem;
  }

  @media (max-width: 640px) {
    .module-content {
      padding: 1.5rem;
    }
  }

  .module-footer-nav {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }
</style>

