---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const modules = await getCollection('modules');
---

<MainLayout 
  title="Materi Pembelajaran RPL | Suhendar Aryadi, S.Pd.,Gr."
  description="Kumpulan modul ajar, bahan praktikum, dan materi pembelajaran Rekayasa Perangkat Lunak (RPL) SMK oleh Suhendar Aryadi, S.Pd.,Gr."
>
  <div class="materi-header">
    <span class="m3-chip m3-chip-tonal-primary">
      <span class="material-symbols-rounded">menu_book</span>
      <span>Bahan Ajar &amp; Modul Vokasi</span>
    </span>
    <h1 class="page-title">Materi Pembelajaran <span class="highlight-primary">SMK RPL</span></h1>
    <p class="page-subtitle">
      Akses dan unduh modul pembelajaran, panduan praktikum, serta dokumentasi kurikulum Jurusan Rekayasa Perangkat Lunak.
    </p>
  </div>

  {modules.length > 0 ? (
    <div class="modules-grid">
      {modules.map((mod) => (
        <article class="m3-card m3-card-elevated module-card">
          <!-- Module Thumbnail Container -->
          <a href={`/materi/${mod.slug}`} class="module-thumb-wrapper">
            {mod.data.image ? (
              <img src={mod.data.image} alt={mod.data.title} class="module-thumb-img" loading="lazy" />
            ) : (
              <div class="module-thumb-placeholder">
                <span class="material-symbols-rounded thumb-m3-icon">menu_book</span>
                <span class="thumb-subject">{mod.data.subject}</span>
              </div>
            )}
            <span class="m3-chip m3-chip-tonal-secondary module-grade-badge">{mod.data.grade}</span>
          </a>

          <div class="module-body">
            <h2 class="module-title">
              <a href={`/materi/${mod.slug}`}>{mod.data.title}</a>
            </h2>

            <div class="module-tags">
              {mod.data.tags.map((tag) => (
                <span class="m3-chip m3-chip-outline tag-chip">#{tag}</span>
              ))}
            </div>

            <div class="module-footer">
              <a href={`/materi/${mod.slug}`} class="m3-btn m3-btn-filled module-btn">
                <span>Baca Modul</span>
              </a>
              {mod.data.downloadUrl && (
                <a href={mod.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="m3-btn m3-btn-outlined module-btn">
                  <span>Download PDF</span>
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="m3-card m3-card-elevated empty-card">
      <p class="empty-text">Belum ada modul pembelajaran yang tersedia saat ini.</p>
    </div>
  )}
</MainLayout>

<style>
  .materi-header {
    text-align: center;
    max-width: 750px;
    margin: 1rem auto 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0.5rem 0;
    color: var(--m3-on-surface, #1a1b1f);
  }

  .highlight-primary {
    color: var(--m3-primary, #005ac1);
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.6;
    margin: 0;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  @media (max-width: 640px) {
    .modules-grid {
      grid-template-columns: 1fr;
    }
  }

  .module-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xl, 16px);
  }

  /* Thumbnail Container */
  .module-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--m3-surface-container, #f1edf3);
    display: block;
  }

  .module-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .module-card:hover .module-thumb-img {
    transform: scale(1.05);
  }

  .module-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--m3-surface-container-high, #ebe7ed);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .thumb-m3-icon {
    font-size: 2.5rem;
    color: var(--m3-primary, #005ac1);
  }

  .thumb-subject {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .module-grade-badge {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 3;
    font-size: 0.75rem;
  }

  .module-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .module-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
    flex: 1;
  }

  .module-title a {
    color: var(--m3-on-surface, #1a1b1f);
  }

  .module-title a:hover {
    color: var(--m3-primary, #005ac1);
  }

  .module-tags {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .tag-chip {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .module-footer {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--m3-outline-variant, #c4c6d0);
  }

  .module-btn {
    height: 38px;
    padding: 0 1.15rem;
    font-size: 0.8125rem;
  }

  .empty-card {
    padding: 3rem;
    text-align: center;
    border-radius: var(--radius-xl, 16px);
  }

  .empty-text {
    color: var(--m3-outline, #74777f);
    font-size: 1.0625rem;
  }
</style>
