---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const modules = await getCollection('modules');
---

<MainLayout 
  title="Materi Pembelajaran RPL | Suhendar Aryadi, S.Kom."
  description="Kumpulan modul ajar, bahan praktikum, dan materi pembelajaran Rekayasa Perangkat Lunak (RPL) SMK oleh Suhendar Aryadi, S.Kom."
>
  <div class="materi-header">
    <span class="badge badge-cyan">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path>
        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path>
      </svg>
      Bahan Ajar & Modul Vokasi
    </span>
    <h1 class="page-title">Materi Pembelajaran <span class="text-gradient">SMK RPL</span></h1>
    <p class="page-subtitle">
      Akses dan unduh modul pembelajaran, panduan praktikum, serta dokumentasi kurikulum Jurusan Rekayasa Perangkat Lunak.
    </p>
  </div>

  {modules.length > 0 ? (
    <div class="modules-grid">
      {modules.map((mod) => (
        <article class="glass-card glass-card-interactive module-card">
          <div class="module-header-badges">
            <span class="badge badge-cyan">{mod.data.subject}</span>
            <span class="badge">{mod.data.grade}</span>
          </div>

          <h2 class="module-title">
            <a href={`/materi/${mod.slug}`}>{mod.data.title}</a>
          </h2>

          <div class="module-tags">
            {mod.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>

          <div class="module-footer">
            <a href={`/materi/${mod.slug}`} class="btn btn-primary btn-sm">
              <span>Baca Modul</span>
            </a>
            {mod.data.downloadUrl && (
              <a href={mod.data.downloadUrl} target="_blank" rel="noopener noreferrer" class="btn btn-secondary btn-sm">
                <span>PDF</span>
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="glass-card empty-card">
      <p class="empty-text">Belum ada modul pembelajaran yang tersedia saat ini.</p>
    </div>
  )}
</MainLayout>

<style>
  .materi-header {
    text-align: center;
    max-width: 750px;
    margin: 1rem auto 3rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0.75rem 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.875rem;
    }
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .modules-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .module-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .module-header-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }

  .module-title {
    font-size: 1.3rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .module-title a {
    color: var(--text-primary);
  }

  .module-title a:hover {
    color: var(--accent-cyan);
  }

  .module-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .module-footer {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .btn-sm {
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }

  .empty-card {
    padding: 3rem;
    text-align: center;
  }

  .empty-text {
    color: var(--text-muted);
    font-size: 1.0625rem;
  }
</style>
