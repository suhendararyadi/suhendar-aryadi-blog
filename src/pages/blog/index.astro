---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}
---

<MainLayout 
  title="Blog & Tutorial | Suhendar Aryadi, S.Pd.,Gr."
  description="Kumpulan artikel, panduan teknis, dan tutorial pemrograman web & rekayasa perangkat lunak oleh Suhendar Aryadi, S.Pd.,Gr."
>
  <div class="blog-header">
    <span class="m3-chip m3-chip-tonal-primary">
      <span class="material-symbols-rounded">article</span>
      <span>Blog &amp; Edukasi Tech</span>
    </span>
    <h1 class="page-title">Artikel &amp; <span class="highlight-primary">Tutorial Pemrograman</span></h1>
    <p class="page-subtitle">
      Wawasan seputar web development, tips belajar Rekayasa Perangkat Lunak (RPL), dan perkembangan industri IT modern.
    </p>
  </div>

  {posts.length > 0 ? (
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="m3-card m3-card-elevated post-card">
          <!-- Article Thumbnail Image Container -->
          <a href={`/blog/${post.slug}`} class="post-thumb-wrapper">
            {post.data.image ? (
              <img src={post.data.image} alt={post.data.title} class="post-thumb-img" loading="lazy" />
            ) : (
              <div class="post-thumb-placeholder">
                <span class="material-symbols-rounded thumb-m3-icon">article</span>
                <span class="thumb-topic">{post.data.category}</span>
              </div>
            )}
            <span class="m3-chip m3-chip-tonal-primary post-badge-floating">{post.data.category}</span>
          </a>

          <div class="post-body">
            <div class="post-meta-top">
              <time datetime={post.data.pubDate.toISOString()} class="post-date">
                {formatDate(post.data.pubDate)}
              </time>
              <span class="m3-chip m3-chip-outline read-time-chip">5 min baca</span>
            </div>

            <h2 class="post-title">
              <a href={`/blog/${post.slug}`}>{post.data.title}</a>
            </h2>

            <p class="post-description">{post.data.description}</p>

            <div class="post-footer">
              <div class="post-author">
                <div class="author-avatar">{post.data.author.charAt(0)}</div>
                <span class="author-name">{post.data.author}</span>
              </div>
              <a href={`/blog/${post.slug}`} class="m3-btn m3-btn-text read-link">
                <span>Baca Artikel</span>
                <span class="material-symbols-rounded">arrow_forward</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="m3-card m3-card-elevated empty-card">
      <p class="empty-text">Belum ada artikel yang diterbitkan saat ini.</p>
    </div>
  )}
</MainLayout>

<style>
  .blog-header {
    text-align: center;
    max-width: 750px;
    margin: 1rem auto 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .page-title {
    font-size: clamp(2rem, 4vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin: 0.5rem 0;
    color: var(--m3-on-surface, #1a1b1f);
  }

  .highlight-primary {
    color: var(--m3-primary, #005ac1);
  }

  .page-subtitle {
    font-size: 1.05rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.6;
    margin: 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.75rem;
  }

  @media (max-width: 640px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0;
    border-radius: var(--radius-xl, 16px);
  }

  /* Thumbnail Container */
  .post-thumb-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--m3-surface-container, #f1edf3);
    display: block;
  }

  .post-thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-normal);
  }

  .post-card:hover .post-thumb-img {
    transform: scale(1.05);
  }

  .post-thumb-placeholder {
    width: 100%;
    height: 100%;
    background: var(--m3-surface-container-high, #ebe7ed);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .thumb-m3-icon {
    font-size: 2.5rem;
    color: var(--m3-primary, #005ac1);
  }

  .thumb-topic {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .post-badge-floating {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    z-index: 3;
    font-size: 0.75rem;
  }

  /* Card Body */
  .post-body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-meta-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--m3-outline, #74777f);
  }

  .read-time-chip {
    font-size: 0.75rem;
    padding: 0.15rem 0.5rem;
  }

  .post-title {
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }

  .post-title a {
    color: var(--m3-on-surface, #1a1b1f);
  }

  .post-title a:hover {
    color: var(--m3-primary, #005ac1);
  }

  .post-description {
    font-size: 0.9rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.6;
    margin-bottom: 1.5rem;
    flex: 1;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--m3-outline-variant, #c4c6d0);
  }

  .post-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--m3-primary-container, #d8e2ff);
    color: var(--m3-on-primary-container, #001a41);
    font-size: 0.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-name {
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--m3-on-surface-variant, #44474f);
  }

  .read-link {
    font-size: 0.8125rem;
    font-weight: 600;
    gap: 0.25rem;
    white-space: nowrap;
  }

  .empty-card {
    padding: 3rem;
    text-align: center;
    border-radius: var(--radius-xl, 16px);
  }

  .empty-text {
    color: var(--m3-outline, #74777f);
    font-size: 1.0625rem;
  }
</style>

