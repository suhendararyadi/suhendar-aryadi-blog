---
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = await getCollection('posts');
const posts = allPosts.sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric'
  }).format(new Date(date));
}
---

<MainLayout 
  title="Blog & Tutorial | Suhendar Aryadi, S.Kom."
  description="Kumpulan artikel, panduan teknis, dan tutorial pemrograman web & rekayasa perangkat lunak oleh Suhendar Aryadi, S.Kom."
>
  <div class="blog-header">
    <span class="badge badge-cyan">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path>
      </svg>
      Blog & Edukasi Tech
    </span>
    <h1 class="page-title">Artikel & <span class="text-gradient">Tutorial Pemrograman</span></h1>
    <p class="page-subtitle">
      Wawasan seputar web development, tips belajar Rekayasa Perangkat Lunak (RPL), dan perkembangan industri IT modern.
    </p>
  </div>

  {posts.length > 0 ? (
    <div class="posts-grid">
      {posts.map((post) => (
        <article class="glass-card glass-card-interactive post-card">
          <div class="post-header">
            <span class="badge">{post.data.category}</span>
            <time datetime={post.data.pubDate.toISOString()} class="post-date">
              {formatDate(post.data.pubDate)}
            </time>
          </div>

          <h2 class="post-title">
            <a href={`/blog/${post.slug}`}>{post.data.title}</a>
          </h2>

          <p class="post-description">{post.data.description}</p>

          <div class="post-meta-author">
            <span class="author-label">Penulis:</span> {post.data.author}
          </div>

          <div class="post-footer">
            <div class="post-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">#{tag}</span>
              ))}
            </div>
            <a href={`/blog/${post.slug}`} class="read-link">
              Baca Selengkapnya &rarr;
            </a>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="glass-card empty-card">
      <p class="empty-text">Belum ada artikel yang diterbitkan saat ini.</p>
    </div>
  )}
</MainLayout>

<style>
  .blog-header {
    text-align: center;
    max-width: 750px;
    margin: 1rem auto 3rem;
  }

  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0.75rem 0;
  }

  @media (max-width: 768px) {
    .page-title {
      font-size: 1.875rem;
    }
  }

  .page-subtitle {
    font-size: 1.0625rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.75rem;
  }

  .post-card {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .post-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .post-date {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .post-title {
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.875rem;
  }

  .post-title a {
    color: var(--text-primary);
  }

  .post-title a:hover {
    color: var(--accent-primary);
  }

  .post-description {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta-author {
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }

  .author-label {
    font-weight: 500;
  }

  .post-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .post-tags {
    display: flex;
    gap: 0.375rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .read-link {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-primary);
    white-space: nowrap;
  }

  .read-link:hover {
    color: var(--accent-cyan);
  }

  .empty-card {
    padding: 3rem;
    text-align: center;
  }

  .empty-text {
    color: var(--text-muted);
    font-size: 1.0625rem;
  }
</style>
