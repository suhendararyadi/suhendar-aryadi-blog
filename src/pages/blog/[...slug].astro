---
export const prerender = true;
import MainLayout from '../../layouts/MainLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('id-ID', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
}
---

<MainLayout title={`${post.data.title} | Blog Suhendar Aryadi`} description={post.data.description}>
  <article class="post-container">
    <div class="back-navigation">
      <a href="/blog" class="back-link">
        &larr; Kembali ke Daftar Artikel
      </a>
    </div>

    <!-- Article Hero Banner with Feature Image -->
    <header class="article-hero-card glass-card">
      <div class="feature-image-wrapper">
        {post.data.image ? (
          <img src={post.data.image} alt={post.data.title} class="feature-img" />
        ) : (
          <div class="feature-placeholder">
            <div class="feature-pattern"></div>
            <div class="feature-placeholder-content">
              <div class="feature-icon-box">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="16 18 22 12 16 6"></polyline>
                  <polyline points="8 6 2 12 8 18"></polyline>
                </svg>
              </div>
              <span class="feature-topic-tag">{post.data.category}</span>
            </div>
          </div>
        )}
      </div>

      <div class="hero-body">
        <div class="header-badges">
          <span class="badge badge-cyan">{post.data.category}</span>
          <time datetime={post.data.pubDate.toISOString()} class="post-date">
            {formatDate(post.data.pubDate)}
          </time>
        </div>

        <h1 class="article-title">{post.data.title}</h1>
        <p class="article-description">{post.data.description}</p>

        <div class="article-meta">
          <div class="author-info">
            <div class="author-avatar">{post.data.author.charAt(0)}</div>
            <div class="author-details">
              <span class="author-name">{post.data.author}</span>
              <span class="author-sub">Guru & Developer RPL</span>
            </div>
          </div>
          <div class="article-tags">
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <div class="article-content glass-card prose">
      <Content />
    </div>

    <footer class="article-footer-nav">
      <a href="/blog" class="btn btn-secondary">
        &larr; Kembali ke Semua Artikel Blog
      </a>
    </footer>
  </article>
</MainLayout>

<style>
  .post-container {
    max-width: 880px;
    margin: 0 auto 4rem;
  }

  .back-navigation {
    margin-bottom: 1.25rem;
  }

  .back-link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .back-link:hover {
    color: var(--accent-primary);
  }

  .article-hero-card {
    padding: 0;
    overflow: hidden;
    margin-bottom: 2rem;
    border-radius: var(--radius-xl);
  }

  /* Feature Image Hero Banner */
  .feature-image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--bg-tertiary);
  }

  @media (max-width: 640px) {
    .feature-image-wrapper {
      aspect-ratio: 16 / 9;
    }
  }

  .feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .feature-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #06b6d4 100%);
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .feature-pattern {
    position: absolute;
    inset: 0;
    opacity: 0.15;
    background-image: radial-gradient(#ffffff 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .feature-placeholder-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    color: #ffffff;
  }

  .feature-icon-box {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-xl);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #38bdf8;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
  }

  .feature-topic-tag {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.9);
  }

  .hero-body {
    padding: 2.25rem;
  }

  @media (max-width: 640px) {
    .hero-body {
      padding: 1.5rem;
    }
  }

  .header-badges {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .post-date {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .article-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  @media (max-width: 768px) {
    .article-title {
      font-size: 1.75rem;
    }
  }

  .article-description {
    font-size: 1.1rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 1.75rem;
  }

  .article-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border-subtle);
  }

  .author-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: var(--radius-full);
    background: var(--accent-gradient);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .author-details {
    display: flex;
    flex-direction: column;
  }

  .author-name {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .author-sub {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-size: 0.8125rem;
    color: var(--text-muted);
    background: var(--bg-tertiary);
    padding: 0.2rem 0.6rem;
    border-radius: var(--radius-sm);
  }

  .article-content {
    padding: 2.5rem;
  }

  @media (max-width: 640px) {
    .article-content {
      padding: 1.5rem;
    }
  }

  .article-footer-nav {
    margin-top: 2.5rem;
    display: flex;
    justify-content: center;
  }
</style>

