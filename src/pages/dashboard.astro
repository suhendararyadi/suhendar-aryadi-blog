        <!-- Mata Pelajaran 2: Pemrograman Web & Basis Data (RPL) -->
        <div class={`mui-paper subject-paper ${isRplSqlEnrolled ? 'is-enrolled' : 'is-locked'}`}>
          <div class="subject-card-head">
            <div class="subject-title-box">
              <span class="subject-icon">🗄️</span>
              <div>
                <h3 class="subject-heading">Mata Pelajaran: Pemrograman Web &amp; Basis Data (RPL)</h3>
                <p class="subject-desc">Practical SQL Masterclass &amp; Relational Database Management</p>
              </div>
            </div>
            {isRplSqlEnrolled ? (
              <span class="mui-chip chip-success">✓ TERDAFTAR MATA PELAJARAN</span>
            ) : (
              <span class="mui-chip chip-amber">🔒 BELUM ENROLL</span>
            )}
          </div>

          <div class="subject-card-body">
            <div class="lkpd-items-grid">
              <div class="lkpd-item-box">
                <div class="lkpd-title">Practical SQL Masterclass</div>
                <div class="lkpd-score" style="color: #6366f1;">{completedCount} / {totalLessonsCount} Modul Selesai</div>
                <p class="lkpd-feedback">{completionPercentage}% Kurikulum SQL diselesaikan</p>
              </div>

              <div class="lkpd-item-box">
                <div class="lkpd-title">Predikat &amp; Kualifikasi Kompetensi</div>
                <div class="lkpd-score" style="color: #a855f7;">{rankInfo.title}</div>
                <p class="lkpd-feedback">Peringkat #{userRankPosition} dari {totalStudentsCount} Siswa Terdaftar</p>
              </div>
            </div>
          </div>

          <div class="subject-card-foot">
            {isRplSqlEnrolled ? (
              <a href="/belajar/sql" class="mui-btn mui-btn-full mui-btn-outlined">
                <span>Buka Mata Pelajaran Pemrograman Web &amp; Basis Data &rarr;</span>
              </a>
            ) : (
              <button
                type="button"
                class="mui-btn mui-btn-full mui-btn-gradient btn-enroll-trigger"
                data-course-id="rpl_web_sql"
                data-course-title="Mata Pelajaran: Pemrograman Web &amp; Basis Data (RPL)"
              >
                🔒 Enroll Mata Pelajaran Ini (Kode Akses)
              </button>
            )}
