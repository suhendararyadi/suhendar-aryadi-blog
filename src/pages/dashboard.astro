  <!-- Modal Access Code / Enroll Mata Pelajaran (MUI Dialog Style) -->
  <div id="enroll-access-modal" class="mui-dialog-backdrop" style="display: none;">
    <div class="mui-dialog-card">
      <div class="dialog-header">
        <div class="dialog-title-group">
          <div class="dialog-icon-box icon-cyan">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
          </div>
          <div>
            <h2 class="dialog-title">Enroll Mata Pelajaran</h2>
            <p class="dialog-sub">Masukkan kode akses dari Guru untuk mendaftar dan membuka mata pelajaran ini.</p>
          </div>
        </div>
        <button id="close-enroll-modal-btn" class="dialog-close-btn" type="button">&times;</button>
      </div>

      <div id="enroll-error-banner" class="alert alert-error" style="display: none;"></div>
      <div id="enroll-success-banner" class="alert alert-success" style="display: none;"></div>

      <form id="enroll-access-form" class="dialog-form">
        <input type="hidden" id="enroll-course-id" name="courseId" value="" />
        <div class="form-group">
          <label for="enroll-course-title">Mata Pelajaran</label>
          <input
            type="text"
            id="enroll-course-title"
            readonly
            class="form-input-readonly"
          />
        </div>

        <div class="form-group">
          <label for="enroll-access-code">Kode Akses dari Guru</label>
          <input
            type="text"
            id="enroll-access-code"
            name="accessCode"
            placeholder="Contoh: INFORMATIKA2026 atau RPL2026"
            required
            autocomplete="off"
          />
        </div>

        <div class="dialog-actions">
          <button id="cancel-enroll-modal-btn" class="mui-btn mui-btn-subtle" type="button">Batal</button>
          <button type="submit" id="save-enroll-btn" class="mui-btn mui-btn-gradient">
            Verifikasi &amp; Enroll
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    } catch (err) {
      console.error('Logout error:', err);
    }
  });

  // Modal Edit Profil Handlers
  const openModalBtn = document.getElementById('open-edit-profile-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const editProfileModal = document.getElementById('edit-profile-modal');
  const editProfileForm = document.getElementById('edit-profile-form') as HTMLFormElement | null;
  const classSelect = document.getElementById('edit-class-select') as HTMLSelectElement | null;
  const classCustomInput = document.getElementById('edit-class-custom') as HTMLInputElement | null;

  if (classSelect && classCustomInput) {
    function checkCustomClass() {
      if (classSelect && classCustomInput) {
        if (classSelect.value === 'CUSTOM') {
          classCustomInput.style.display = 'block';
        } else {
          classCustomInput.style.display = 'none';
        }
      }
    }
    classSelect.addEventListener('change', checkCustomClass);
    checkCustomClass();
  }

  function toggleModal(show: boolean) {
    if (editProfileModal) {
      editProfileModal.style.display = show ? 'flex' : 'none';
    }
  }

  openModalBtn?.addEventListener('click', () => toggleModal(true));
  closeModalBtn?.addEventListener('click', () => toggleModal(false));
  cancelModalBtn?.addEventListener('click', () => toggleModal(false));

  editProfileModal?.addEventListener('click', (e) => {
    if (e.target === editProfileModal) {
      toggleModal(false);
    }
  });

  editProfileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorBanner = document.getElementById('profile-error-banner');
    const successBanner = document.getElementById('profile-success-banner');
    const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement | null;
    const nameInput = document.getElementById('edit-name') as HTMLInputElement | null;
    const passwordInput = document.getElementById('edit-password') as HTMLInputElement | null;

    if (errorBanner) errorBanner.style.display = 'none';
    if (successBanner) successBanner.style.display = 'none';

    let finalClassName = classSelect?.value || '';
    if (finalClassName === 'CUSTOM') {
      finalClassName = classCustomInput?.value.trim() || '';
    }

    const payload = {
      name: nameInput?.value.trim(),
      class_name: finalClassName,
      password: passwordInput?.value || ''
    };

    if (saveBtn) saveBtn.disabled = true;

    try {
      const res = await fetch('/api/user/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal menyimpan profil.');

      if (successBanner) {
        successBanner.innerText = data.message || 'Profil berhasil diperbarui!';
        successBanner.style.display = 'block';
      }

      setTimeout(() => {
        window.location.reload();
      }, 800);
    } catch (err: any) {
      if (errorBanner) {
        errorBanner.innerText = err.message || 'Terjadi kesalahan.';
        errorBanner.style.display = 'block';
      }
      if (saveBtn) saveBtn.disabled = false;
    }
  });

  // Modal Enroll Modul Handlers
  const enrollModal = document.getElementById('enroll-access-modal');
  const closeEnrollModalBtn = document.getElementById('close-enroll-modal-btn');
  const cancelEnrollModalBtn = document.getElementById('cancel-enroll-modal-btn');
  const enrollForm = document.getElementById('enroll-access-form') as HTMLFormElement | null;
  const enrollCourseIdInput = document.getElementById('enroll-course-id') as HTMLInputElement | null;
  const enrollCourseTitleInput = document.getElementById('enroll-course-title') as HTMLInputElement | null;
  const enrollCodeInput = document.getElementById('enroll-access-code') as HTMLInputElement | null;
  const enrollErrorBanner = document.getElementById('enroll-error-banner');
  const enrollSuccessBanner = document.getElementById('enroll-success-banner');

  document.querySelectorAll('.btn-enroll-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const courseId = target.getAttribute('data-course-id') || '';
      const courseTitle = target.getAttribute('data-course-title') || '';

      if (enrollCourseIdInput) enrollCourseIdInput.value = courseId;
      if (enrollCourseTitleInput) enrollCourseTitleInput.value = courseTitle;
      if (enrollCodeInput) enrollCodeInput.value = '';
      if (enrollErrorBanner) enrollErrorBanner.style.display = 'none';
      if (enrollSuccessBanner) enrollSuccessBanner.style.display = 'none';

      if (enrollModal) enrollModal.style.display = 'flex';
    });
  });

  function toggleEnrollModal(show: boolean) {
    if (enrollModal) enrollModal.style.display = show ? 'flex' : 'none';
  }

  closeEnrollModalBtn?.addEventListener('click', () => toggleEnrollModal(false));
  cancelEnrollModalBtn?.addEventListener('click', () => toggleEnrollModal(false));
  enrollModal?.addEventListener('click', (e) => {
    if (e.target === enrollModal) toggleEnrollModal(false);
  });

  enrollForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-enroll-btn') as HTMLButtonElement | null;
    if (enrollErrorBanner) enrollErrorBanner.style.display = 'none';
    if (enrollSuccessBanner) enrollSuccessBanner.style.display = 'none';

    const courseId = enrollCourseIdInput?.value || '';
    const accessCode = enrollCodeInput?.value || '';

    if (saveBtn) saveBtn.disabled = true;

    try {
      const res = await fetch('/api/courses/enroll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subjectId: courseId, accessCode })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal mendaftar Mata Pelajaran.');

      if (enrollSuccessBanner) {
        enrollSuccessBanner.innerText = data.message || 'Berhasil terdaftar pada Mata Pelajaran!';
        enrollSuccessBanner.style.display = 'block';
      }

      setTimeout(() => {
        window.location.reload();
      }, 800);
    } catch (err: any) {
      if (enrollErrorBanner) {
        enrollErrorBanner.innerText = err.message || 'Terjadi kesalahan.';
        enrollErrorBanner.style.display = 'block';
      }
      if (saveBtn) saveBtn.disabled = false;
    }
  });
</script>

<style>
