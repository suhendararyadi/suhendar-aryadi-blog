---
import MainLayout from '../layouts/MainLayout.astro';
import { getSessionUser } from '../lib/auth';
import { seedLessons } from '../lib/seedLessons';
import { query } from '../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

let completedModules: any[] = [];
let totalLessonsCount = seedLessons.length;

try {
  const lessonsRes = await query('SELECT COUNT(*) as count FROM sql_lessons');
  if (lessonsRes.rows && lessonsRes.rows[0]?.count) {
    const parsed = parseInt(lessonsRes.rows[0].count, 10);
    if (parsed > 0) totalLessonsCount = parsed;
  }

  const progressRes = await query(
    `SELECT up.id, up.lesson_id, up.status, up.submitted_code, up.completed_at,
            sl.slug, sl.title, sl.category, sl.path_id, sl.order_index
     FROM user_progress up
     JOIN sql_lessons sl ON up.lesson_id = sl.id
     WHERE up.user_id = $1 AND up.status = 'completed'
     ORDER BY up.completed_at DESC`,
    [user.id]
  );
  completedModules = progressRes.rows;
} catch (err) {
  console.warn('Could not fetch dashboard progress from database:', err);
}

const completedCount = completedModules.length;
const completionPercentage = totalLessonsCount > 0 ? Math.round((completedCount / totalLessonsCount) * 100) : 0;

// 4-Tier Rank Badge System
let rankInfo = { title: 'SQL Novice', icon: '🟢', color: 'badge-success' };
if (completedCount >= 40) {
  rankInfo = { title: 'Master SQL Engineer', icon: '🏆', color: 'badge-warning' };
} else if (completedCount >= 25) {
  rankInfo = { title: 'SQL Advanced', icon: '🔵', color: 'badge-info' };
} else if (completedCount >= 11) {
  rankInfo = { title: 'SQL Intermediate', icon: '🟡', color: 'badge-accent' };
}

// 5 Learning Paths
const LEARNING_PATHS = [
  { id: 'basics', title: 'SQL Basics', icon: '🟢', total: 10, progressColor: 'progress-success', description: 'SELECT, WHERE, ORDER BY, INSERT, UPDATE, DELETE' },
  { id: 'aggregates', title: 'Aggregates & Functions', icon: '🟡', total: 8, progressColor: 'progress-accent', description: 'COUNT, SUM, AVG, MIN, MAX, LIKE, IN, BETWEEN' },
  { id: 'joins', title: 'Joins & Relasi Tabel', icon: '🔵', total: 6, progressColor: 'progress-info', description: 'INNER, LEFT, RIGHT, FULL, SELF JOIN, UNION' },
  { id: 'grouping', title: 'Grouping & Subqueries', icon: '🟣', total: 6, progressColor: 'progress-secondary', description: 'GROUP BY, HAVING, EXISTS, ANY/ALL, CASE' },
  { id: 'ddl_security', title: 'DDL, Constraints & Security', icon: '🟧', total: 10, progressColor: 'progress-warning', description: 'CREATE, ALTER, DROP, PK, FK, VIEW, SQL Injection' },
];

const pathCompletedCounts: Record<string, number> = { basics: 0, aggregates: 0, joins: 0, grouping: 0, ddl_security: 0 };
completedModules.forEach((item) => {
  const lesson = seedLessons.find((l) => l.id === item.lesson_id);
  const pathId = item.path_id || lesson?.path_id || 'basics';
  if (pathCompletedCounts[pathId] !== undefined) {
    pathCompletedCounts[pathId]++;
  }
});

const pathAnalytics = LEARNING_PATHS.map((path) => {
  const completed = pathCompletedCounts[path.id] || 0;
  const percentage = path.total > 0 ? Math.round((completed / path.total) * 100) : 0;
  return { ...path, completed, percentage };
});
---

<MainLayout 
  title={`Dashboard Siswa - ${user.name} | Suhendar Aryadi`}
  description="Dashboard progres belajar siswa RPL. Lihat statistik progres 5 Learning Path SQL dan peringkat kelulusan."
>
  <div class="max-w-5xl mx-auto px-4 py-8">

    <!-- Profile Card -->
    <div class="card bg-base-200">
      <div class="card-body">
        <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
          <!-- Avatar -->
          <div class="avatar placeholder">
            <div class="bg-primary text-primary-content w-16 rounded-full">
              <span class="text-2xl font-bold">{user.name.charAt(0).toUpperCase()}</span>
            </div>
          </div>
          <!-- User Info -->
          <div class="flex-1">
            <div class="flex flex-wrap gap-2 mb-1">
              <span class="badge badge-soft badge-sm">{user.role.toUpperCase()}</span>
              <span class={`badge badge-soft badge-sm ${rankInfo.color}`}>{rankInfo.icon} {rankInfo.title}</span>
            </div>
            <h1 class="text-2xl font-bold">{user.name}</h1>
            <p class="text-base-content/60 text-sm">✉️ {user.email}</p>
          </div>
          <!-- Logout -->
          <button id="logout-btn" class="btn btn-sm btn-outline" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Keluar
          </button>
        </div>
      </div>
    </div>

    <!-- Stats Summary -->
    <div class="stats stats-vertical sm:stats-horizontal w-full mt-6 bg-base-200">
      <div class="stat">
        <div class="stat-figure text-primary">
          <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </div>
        <div class="stat-title">Modul Selesai</div>
        <div class="stat-value text-primary">{completedCount}</div>
        <div class="stat-desc">dari {totalLessonsCount} modul</div>
      </div>
      <div class="stat">
        <div class="stat-figure text-secondary">
          <div class="radial-progress text-secondary" style={`--value:${completionPercentage}; --size:3.5rem; --thickness:4px;`} aria-valuenow={completionPercentage} role="progressbar">
            <span class="text-sm font-bold">{completionPercentage}%</span>
          </div>
        </div>
        <div class="stat-title">Tingkat Penyelesaian</div>
        <div class="stat-value text-secondary">{completionPercentage}%</div>
        <div class="stat-desc">Target: 100% (40 Modul)</div>
      </div>
      <div class="stat">
        <div class="stat-figure text-3xl">{rankInfo.icon}</div>
        <div class="stat-title">Peringkat</div>
        <div class="stat-value text-lg">{rankInfo.title}</div>
        <div class="stat-desc">{completedCount >= 40 ? 'Kurikulum Tuntas!' : `${40 - completedCount} modul lagi`}</div>
      </div>
    </div>

    <!-- Overall Progress Bar -->
    <div class="card bg-base-200 mt-6">
      <div class="card-body p-4">
        <div class="flex justify-between items-center mb-2">
          <span class="text-sm font-medium">Target Kurikulum SQL (40 Modul)</span>
          <span class="text-sm font-bold">{completedCount} / {totalLessonsCount}</span>
        </div>
        <progress class="progress progress-primary w-full" value={completedCount} max={totalLessonsCount}></progress>
      </div>
    </div>

    <!-- Learning Path Progress Cards -->
    <div class="mt-8">
      <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-2 mb-4">
        <div>
          <h2 class="text-xl font-bold">🎯 Progres per Learning Path</h2>
          <p class="text-base-content/60 text-sm">Breakdown pencapaian dari Dasar hingga Keamanan Database</p>
        </div>
        <a href="/belajar/sql" class="btn btn-primary btn-sm">📚 Lanjutkan Belajar ➔</a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {pathAnalytics.map((path) => (
          <div class="card bg-base-200">
            <div class="card-body p-4">
              <div class="flex justify-between items-start">
                <div class="flex gap-2 items-start">
                  <span class="text-2xl">{path.icon}</span>
                  <div>
                    <h3 class="font-bold text-sm">{path.title}</h3>
                    <p class="text-base-content/50 text-xs mt-0.5">{path.description}</p>
                  </div>
                </div>
                <span class="badge badge-sm badge-ghost">{path.completed}/{path.total}</span>
              </div>
              <div class="mt-3">
                <progress class={`progress ${path.progressColor} w-full`} value={path.completed} max={path.total}></progress>
                <div class="flex justify-between text-xs mt-1">
                  <span class="font-semibold">{path.percentage}% Selesai</span>
                  <span class="text-base-content/50">{path.completed} dari {path.total} modul</span>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Divider -->
    <div class="divider my-8">📜 Riwayat Modul</div>

    <!-- Completion History Table -->
    {completedModules.length > 0 ? (
      <div class="overflow-x-auto">
        <table class="table table-zebra">
          <thead>
            <tr>
              <th>Modul</th>
              <th>Kategori</th>
              <th>Tanggal Selesai</th>
              <th>Kode SQL</th>
              <th>Aksi</th>
            </tr>
          </thead>
          <tbody>
            {completedModules.map((item) => (
              <tr>
                <td>
                  <span class="font-bold">#{item.order_index}</span> {item.title}
                </td>
                <td>
                  <span class="badge badge-sm badge-ghost">{item.category}</span>
                </td>
                <td class="text-base-content/60 text-sm whitespace-nowrap">
                  {item.completed_at ? new Date(item.completed_at).toLocaleDateString('id-ID', {
                    day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit'
                  }) : 'Terbaru'}
                </td>
                <td>
                  <code class="bg-base-300 text-sm px-2 py-0.5 rounded inline-block max-w-[200px] overflow-hidden text-ellipsis whitespace-nowrap">{item.submitted_code}</code>
                </td>
                <td>
                  <a href={`/belajar/sql/${item.slug}`} class="btn btn-xs btn-outline">
                    Buka ➔
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : (
      <div class="card bg-base-200">
        <div class="card-body items-center text-center">
          <span class="text-4xl mb-2">💡</span>
          <h3 class="card-title">Belum Ada Modul yang Diselesaikan</h3>
          <p class="text-base-content/60 max-w-md">Anda belum menyelesaikan modul SQL. Mulai latihan sekarang dan selesaikan tantangan pertama Anda!</p>
          <div class="card-actions mt-4">
            <a href="/belajar/sql" class="btn btn-primary btn-sm">Mulai Belajar Sekarang ➔</a>
          </div>
        </div>
      </div>
    )}

  </div>
</MainLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    } catch (err) {
      console.error('Logout error:', err);
    }
  });
</script>
