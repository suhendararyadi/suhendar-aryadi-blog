---
import MainLayout from '../layouts/MainLayout.astro';
import { getSessionUser } from '../lib/auth';
import { seedLessons } from '../lib/seedLessons';
import { query } from '../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

if (user.role !== 'admin' && user.role !== 'teacher' && (!user.class_name || user.class_name.trim() === '')) {
  Astro.cookies.delete('session_id', { path: '/' });
  return Astro.redirect('/auth/login?reason=missing_class');
}

let completedModules: any[] = [];
let topLeaderboard: any[] = [];
let totalLessonsCount = seedLessons.length;
let userRankPosition = 1;
let totalStudentsCount = 1;
let userClassRankPosition = 1;
let classStudentsCount = 1;

try {
  const lessonsRes = await query('SELECT COUNT(*) as count FROM sql_lessons');
  if (lessonsRes.rows && lessonsRes.rows[0]?.count) {
    const parsed = parseInt(lessonsRes.rows[0].count, 10);
    if (parsed > 0) totalLessonsCount = parsed;
  }

  const progressRes = await query(
    `SELECT up.id, up.lesson_id, up.status, up.submitted_code, up.completed_at,
            sl.slug, sl.title, sl.category, sl.path_id, sl.order_index
     FROM user_progress up
     JOIN sql_lessons sl ON up.lesson_id = sl.id
     WHERE up.user_id = $1 AND up.status = 'completed'
     ORDER BY up.completed_at DESC`,
    [user.id]
  );
  completedModules = progressRes.rows;

  const rankRes = await query(
    `WITH user_ranks AS (
       SELECT u.id, u.name, u.role, u.class_name,
              COUNT(DISTINCT up.lesson_id) as completed_count,
              ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT up.lesson_id) DESC, u.id ASC) as overall_rank,
              ROW_NUMBER() OVER (PARTITION BY u.class_name ORDER BY COUNT(DISTINCT up.lesson_id) DESC, u.id ASC) as class_rank
       FROM users u
       LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
       GROUP BY u.id, u.name, u.role, u.class_name
     )
     SELECT * FROM user_ranks ORDER BY overall_rank ASC`
  );

  if (rankRes.rows && rankRes.rows.length > 0) {
    totalStudentsCount = rankRes.rows.length;
    const myRankRow = rankRes.rows.find((r: any) => r.id === user.id);
    if (myRankRow) {
      userRankPosition = parseInt(myRankRow.overall_rank, 10);
      userClassRankPosition = parseInt(myRankRow.class_rank, 10);
    }
    if (user.class_name) {
      classStudentsCount = rankRes.rows.filter((r: any) => r.class_name === user.class_name).length;
    }
    topLeaderboard = rankRes.rows.slice(0, 5).map((r: any) => {
      const count = parseInt(r.completed_count || '0', 10);
      const pct = totalLessonsCount > 0 ? Math.round((count / totalLessonsCount) * 100) : 0;
      return { ...r, count, pct, rank: parseInt(r.overall_rank, 10) };
    });
  }
} catch (err) {
  console.warn('Could not fetch dashboard progress from database:', err);
}

// Fetch BK & TIK LKPD Submissions and Course Enrollments
let bkSubmission: any = null;
let tikSubmission: any = null;
let enrolledSubjectIds: string[] = [];

try {
  const bkRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (bkRes.rows && bkRes.rows.length > 0) {
    bkSubmission = bkRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch BK submission:', err);
}

try {
  const tikRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_tik_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (tikRes.rows && tikRes.rows.length > 0) {
    tikSubmission = tikRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch TIK submission:', err);
}

// Auto-sync existing student progress to course_enrollments
try {
  if (bkSubmission || tikSubmission) {
    await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'informatika') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]);
  }
  if (completedModules.length > 0) {
    await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'rpl_web_sql') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]);
  }
} catch (err) {
  console.warn('Auto sync enrollments warning:', err);
}

try {
  const enrollRes = await query(
    `SELECT course_id FROM course_enrollments WHERE user_id = $1`,
    [user.id]
  );
  if (enrollRes.rows) {
    enrolledSubjectIds = enrollRes.rows.map((r: any) => String(r.course_id).toLowerCase());
  }
} catch (err) {
  console.warn('Could not fetch course_enrollments:', err);
}

const isInformatikaEnrolled = enrolledSubjectIds.includes('informatika') || enrolledSubjectIds.includes('bk') || enrolledSubjectIds.includes('tik') || !!bkSubmission || !!tikSubmission;
const isRplSqlEnrolled = enrolledSubjectIds.includes('rpl_web_sql') || enrolledSubjectIds.includes('sql') || completedModules.length > 0;

const completedCount = completedModules.length;
const completionPercentage = totalLessonsCount > 0 ? Math.round((completedCount / totalLessonsCount) * 100) : 0;

// 4-Tier Rank System
let rankInfo = { title: 'SQL Novice', badgeClass: 'badge-novice' };
if (completedCount >= 40) {
  rankInfo = { title: 'Master SQL Engineer', badgeClass: 'badge-master' };
} else if (completedCount >= 25) {
  rankInfo = { title: 'SQL Advanced', badgeClass: 'badge-advanced' };
} else if (completedCount >= 11) {
  rankInfo = { title: 'SQL Intermediate', badgeClass: 'badge-intermediate' };
}

// Calculate Scores & Average Grade for Informatika
let bkScore: number | null = bkSubmission && bkSubmission.score !== null && bkSubmission.score !== undefined ? parseInt(bkSubmission.score, 10) : null;
let tikScore: number | null = tikSubmission && tikSubmission.score !== null && tikSubmission.score !== undefined ? parseInt(tikSubmission.score, 10) : null;

let avgScore: number | null = null;
if (bkScore !== null && !isNaN(bkScore) && tikScore !== null && !isNaN(tikScore)) {
  const rawAvg = (bkScore + tikScore) / 2;
  avgScore = Number.isInteger(rawAvg) ? rawAvg : Math.round(rawAvg * 10) / 10;
} else if (bkScore !== null && !isNaN(bkScore)) {
  avgScore = bkScore;
} else if (tikScore !== null && !isNaN(tikScore)) {
  avgScore = tikScore;
}

const avgScoreText = avgScore !== null ? `${avgScore} / 100` : 'Belum Ada Nilai';
const avgScoreColor = avgScore !== null ? (avgScore >= 75 ? '#10b981' : '#f59e0b') : 'var(--text-muted)';

const bkScoreText = bkSubmission
  ? (bkScore !== null ? `${bkScore} / 100` : 'Belum Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const bkScoreColor = bkSubmission && bkScore !== null
  ? (bkScore >= 75 ? '#10b981' : '#f59e0b')
  : (bkSubmission ? '#0ea5e9' : 'var(--text-muted)');
const bkFeedbackText = bkSubmission
  ? (bkSubmission.teacher_feedback ? `Catatan Guru: "${bkSubmission.teacher_feedback}"` : (bkScore !== null ? 'Sudah dinilai oleh Pak Suhendar.' : 'LKPD telah dikirim, menunggu penilaian Guru.'))
  : (isInformatikaEnrolled ? 'Kerjakan LKPD 4 Pilar Berpikir Komputasional untuk mendapatkan nilai.' : 'Masukan kode akses dari Guru untuk membuka modul.');

const tikScoreText = tikSubmission
  ? (tikScore !== null ? `${tikScore} / 100` : 'Belum Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const tikScoreColor = tikSubmission && tikScore !== null
  ? (tikScore >= 75 ? '#10b981' : '#f59e0b')
  : (tikSubmission ? '#0ea5e9' : 'var(--text-muted)');
const tikFeedbackText = tikSubmission
  ? (tikSubmission.teacher_feedback ? `Catatan Guru: "${tikSubmission.teacher_feedback}"` : (tikScore !== null ? 'Sudah dinilai oleh Pak Suhendar.' : 'LKPD TIK telah dikirim, menunggu penilaian Guru.'))
  : (isInformatikaEnrolled ? 'Kerjakan LKPD TIK Mail Merge & Search Engine untuk mendapatkan nilai.' : 'Masukan kode akses dari Guru untuk membuka modul.');

let trophyEmoji = '🏆';
let rankMotivationalMsg = '🚀 Pertahankan semangat! Selesaikan modul berikutnya untuk naik ke 10 Besar.';

if (userRankPosition === 1) {
  trophyEmoji = '🥇';
  rankMotivationalMsg = '🥇 Luar biasa! Anda saat ini memimpin di Peringkat #1 Teratas seluruh platform.';
} else if (userRankPosition <= 3) {
  trophyEmoji = '🥈';
  rankMotivationalMsg = '🥈 Selamat! Anda berada di posisi 3 Besar Peringkat Teratas.';
} else if (userRankPosition <= 10) {
  trophyEmoji = '🥉';
  rankMotivationalMsg = '🔥 Hebat! Anda berhasil menembus 10 Besar Peringkat Teratas.';
}

interface PathDefinition {
  id: 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security';
  title: string;
  total: number;
  accentVar: string;
  description: string;
}

const LEARNING_PATHS: PathDefinition[] = [
  { id: 'basics', title: 'SQL Basics', total: 10, accentVar: '#10b981', description: 'SELECT, WHERE, ORDER BY, INSERT, UPDATE, DELETE' },
  { id: 'aggregates', title: 'Aggregates & Functions', total: 8, accentVar: '#f59e0b', description: 'COUNT, SUM, AVG, MIN, MAX, LIKE, IN, BETWEEN' },
  { id: 'joins', title: 'Joins & Relasi Tabel', total: 6, accentVar: '#0ea5e9', description: 'INNER, LEFT, RIGHT, FULL, SELF JOIN' },
  { id: 'grouping', title: 'Grouping & Subqueries', total: 6, accentVar: '#a855f7', description: 'GROUP BY, HAVING, EXISTS, ANY/ALL, CASE' },
  { id: 'ddl_security', title: 'DDL, Constraints & Security', total: 10, accentVar: '#f97316', description: 'CREATE, ALTER, DROP, PK, FK, VIEW, SQL Injection' },
];

const pathCompletedCounts: Record<string, number> = { basics: 0, aggregates: 0, joins: 0, grouping: 0, ddl_security: 0 };
completedModules.forEach((item) => {
  const lesson = seedLessons.find((l) => l.id === item.lesson_id);
  const pathId = item.path_id || lesson?.path_id || 'basics';
  if (pathCompletedCounts[pathId] !== undefined) pathCompletedCounts[pathId]++;
});

const pathAnalytics = LEARNING_PATHS.map((path) => {
  const completed = pathCompletedCounts[path.id] || 0;
  const percentage = path.total > 0 ? Math.round((completed / path.total) * 100) : 0;
  return { ...path, completed, percentage };
});

const isTeacherOrAdmin = user.role === 'teacher' || user.role === 'admin' || (user.email && user.email.toLowerCase().includes('suhendar'));
---

<MainLayout 
  title={`Dashboard Siswa — ${user.name} | Suhendar Aryadi`}
  description="Dashboard siswa interaktif untuk memantau nilai LKPD Informatika, progres SQL Masterclass, dan peringkat belajar SMK."
>
  <div class="mui-dashboard-container">

    <!-- Hero Profile Header Card (MUI Paper Elevation) -->
    <div class="mui-paper profile-hero-paper">
      <div class="hero-accent-bar"></div>
      <div class="profile-hero-content">
        <div class="avatar-column">
          <div class="avatar-mui">
            <span>{user.name.charAt(0).toUpperCase()}</span>
          </div>
        </div>

        <div class="details-column">
          <div class="chip-group">
            <span class="mui-chip chip-role">{user.role.toUpperCase()}</span>
            {user.class_name ? (
              <span class="mui-chip chip-class">{user.class_name}</span>
            ) : (
              <span class="mui-chip chip-warning">Belum Ada Kelas</span>
            )}
            <span class="mui-chip chip-rank">Peringkat #{userRankPosition}</span>
            <span class={`mui-chip ${rankInfo.badgeClass}`}>{rankInfo.title}</span>
          </div>

          <h1 class="student-name">{user.name}</h1>
          <p class="student-email">{user.email}</p>

          <div class="motivation-banner">
            <span class="motivation-icon">{trophyEmoji}</span>
            <span class="motivation-text">{rankMotivationalMsg}</span>
          </div>
        </div>

        <div class="actions-column">
          {isTeacherOrAdmin && (
            <a href="/admin/dashboard" class="mui-btn mui-btn-gradient">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              <span>Portal Guru</span>
            </a>
          )}
