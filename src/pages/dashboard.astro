---
import MainLayout from '../layouts/MainLayout.astro';
import { getSessionUser } from '../lib/auth';
import { seedLessons } from '../lib/seedLessons';
import { query } from '../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

let completedModules: any[] = [];
let totalLessonsCount = seedLessons.length;

try {
  const lessonsRes = await query('SELECT COUNT(*) as count FROM sql_lessons');
  if (lessonsRes.rows && lessonsRes.rows[0]?.count) {
    const parsed = parseInt(lessonsRes.rows[0].count, 10);
    if (parsed > 0) totalLessonsCount = parsed;
  }

  const progressRes = await query(
    `SELECT up.id, up.lesson_id, up.status, up.submitted_code, up.completed_at,
            sl.slug, sl.title, sl.category, sl.path_id, sl.order_index
     FROM user_progress up
     JOIN sql_lessons sl ON up.lesson_id = sl.id
     WHERE up.user_id = $1 AND up.status = 'completed'
     ORDER BY up.completed_at DESC`,
    [user.id]
  );
  completedModules = progressRes.rows;
} catch (err) {
  console.warn('Could not fetch dashboard progress from database:', err);
}

const completedCount = completedModules.length;
const completionPercentage = totalLessonsCount > 0 ? Math.round((completedCount / totalLessonsCount) * 100) : 0;

// 4-Tier Rank System
let rankInfo = { title: 'SQL Novice', badgeClass: 'badge-novice' };
if (completedCount >= 40) {
  rankInfo = { title: 'Master SQL Engineer', badgeClass: 'badge-master' };
} else if (completedCount >= 25) {
  rankInfo = { title: 'SQL Advanced', badgeClass: 'badge-advanced' };
} else if (completedCount >= 11) {
  rankInfo = { title: 'SQL Intermediate', badgeClass: 'badge-intermediate' };
}

interface PathDefinition {
  id: 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security';
  title: string;
  total: number;
  accentVar: string;
  description: string;
}

const LEARNING_PATHS: PathDefinition[] = [
  { id: 'basics', title: 'SQL Basics', total: 10, accentVar: '#10b981', description: 'SELECT, WHERE, ORDER BY, INSERT, UPDATE, DELETE' },
  { id: 'aggregates', title: 'Aggregates & Functions', total: 8, accentVar: '#f59e0b', description: 'COUNT, SUM, AVG, MIN, MAX, LIKE, IN, BETWEEN' },
  { id: 'joins', title: 'Joins & Relasi Tabel', total: 6, accentVar: '#0ea5e9', description: 'INNER, LEFT, RIGHT, FULL, SELF JOIN' },
  { id: 'grouping', title: 'Grouping & Subqueries', total: 6, accentVar: '#a855f7', description: 'GROUP BY, HAVING, EXISTS, ANY/ALL, CASE' },
  { id: 'ddl_security', title: 'DDL, Constraints & Security', total: 10, accentVar: '#f97316', description: 'CREATE, ALTER, DROP, PK, FK, VIEW, SQL Injection' },
];

const pathCompletedCounts: Record<string, number> = { basics: 0, aggregates: 0, joins: 0, grouping: 0, ddl_security: 0 };
completedModules.forEach((item) => {
  const lesson = seedLessons.find((l) => l.id === item.lesson_id);
  const pathId = item.path_id || lesson?.path_id || 'basics';
  if (pathCompletedCounts[pathId] !== undefined) pathCompletedCounts[pathId]++;
});

const pathAnalytics = LEARNING_PATHS.map((path) => {
  const completed = pathCompletedCounts[path.id] || 0;
  const percentage = path.total > 0 ? Math.round((completed / path.total) * 100) : 0;
  return { ...path, completed, percentage };
});
---

<MainLayout 
  title={`Dashboard — ${user.name} | Suhendar Aryadi`}
  description="Dashboard progres belajar siswa. Lihat statistik dan progres 5 Learning Path SQL."
>
  <div class="dash-wrapper">

    <!-- Profile header -->
    <div class="profile-card glass-card">
      <div class="profile-inner">
        <div class="avatar-wrap">
          <div class="avatar-circle">
            {user.name.charAt(0).toUpperCase()}
          </div>
        </div>
        <div class="profile-info">
          <div class="profile-badges">
            <span class="badge badge-role">{user.role.toUpperCase()}</span>
            <span class={`badge ${rankInfo.badgeClass}`}>{rankInfo.title}</span>
          </div>
          <h1 class="profile-name">{user.name}</h1>
          <p class="profile-email">{user.email}</p>
        </div>
        <div class="profile-actions">
          <button id="logout-btn" class="btn btn-secondary btn-sm" type="button">Keluar</button>
        </div>
      </div>
    </div>

    <!-- Stats row -->
    <div class="stats-row">
      <div class="stat-item glass-card">
        <span class="stat-value">{completedCount} <span class="stat-total">/ {totalLessonsCount}</span></span>
        <span class="stat-label">Modul Selesai</span>
      </div>
      <div class="stat-item glass-card">
        <span class="stat-value">{completionPercentage}<span class="stat-unit">%</span></span>
        <span class="stat-label">Tingkat Penyelesaian</span>
      </div>
      <div class="stat-item glass-card">
        <span class="stat-value stat-rank">{rankInfo.title}</span>
        <span class="stat-label">Peringkat Saat Ini</span>
      </div>
    </div>

    <!-- Overall progress -->
    <div class="progress-card glass-card">
      <div class="progress-header">
        <span class="progress-label">Progress Kurikulum SQL (40 Modul)</span>
        <span class="progress-count">{completedCount} / {totalLessonsCount}</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style={`width: ${completionPercentage}%`}></div>
      </div>
    </div>

    <!-- Learning paths -->
    <div class="paths-section">
      <div class="section-head">
        <div>
          <h2 class="section-title">Progress per Learning Path</h2>
          <p class="section-subtitle">5 alur belajar dari dasar hingga keamanan database</p>
        </div>
        <a href="/belajar/sql" class="btn btn-primary btn-sm">Lanjutkan Belajar</a>
      </div>

      <div class="paths-grid">
        {pathAnalytics.map((path) => (
          <div class="path-card glass-card">
            <div class="path-top">
              <div class="path-text">
                <h3 class="path-title">{path.title}</h3>
                <p class="path-desc">{path.description}</p>
              </div>
              <span class="path-count">{path.completed}/{path.total}</span>
            </div>
            <div class="path-progress-track">
              <div class="path-progress-fill" style={`width: ${path.percentage}%; background-color: ${path.accentVar};`}></div>
            </div>
            <p class="path-pct">{path.percentage}% selesai</p>
          </div>
        ))}
      </div>
    </div>

    <!-- History table -->
    <div class="history-section">
      <h2 class="section-title">Riwayat Modul Selesai</h2>

      {completedModules.length > 0 ? (
        <div class="table-wrap glass-card">
          <table class="history-table">
            <thead>
              <tr>
                <th>Modul</th>
                <th>Kategori</th>
                <th>Tanggal</th>
                <th>SQL Terakhir</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {completedModules.map((item) => (
                <tr>
                  <td>
                    <span class="module-num">#{item.order_index}</span> {item.title}
                  </td>
                  <td>
                    <span class="badge badge-role">{item.category}</span>
                  </td>
                  <td class="date-col">
                    {item.completed_at ? new Date(item.completed_at).toLocaleDateString('id-ID', {
                      day: 'numeric', month: 'short', year: 'numeric'
                    }) : '—'}
                  </td>
                  <td>
                    <code class="code-snippet">{item.submitted_code}</code>
                  </td>
                  <td>
                    <a href={`/belajar/sql/${item.slug}`} class="btn btn-outline btn-xs">Buka</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state glass-card">
          <p class="empty-title">Belum ada modul yang diselesaikan.</p>
          <p class="empty-desc">Mulai latihan SQL dan selesaikan tantangan pertama Anda.</p>
          <a href="/belajar/sql" class="btn btn-primary btn-sm" style="margin-top: 1.25rem;">Mulai Belajar</a>
        </div>
      )}
    </div>

  </div>
</MainLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    } catch (err) {
      console.error('Logout error:', err);
    }
  });
</script>

<style>
  .dash-wrapper {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Profile Card */
  .profile-card {
    padding: 1.75rem 2rem;
  }

  .profile-inner {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .avatar-circle {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: var(--radius-full);
    background: var(--accent-gradient);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  .profile-info {
    flex: 1;
  }

  .profile-badges {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 0.4rem;
    flex-wrap: wrap;
  }

  .profile-name {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .profile-email {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.15rem;
  }

  .profile-actions {
    margin-left: auto;
  }

  /* Stats Row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .stats-row {
      grid-template-columns: 1fr;
    }
  }

  .stat-item {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .stat-value {
    font-size: 2rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat-rank {
    font-size: 1.1rem;
    letter-spacing: 0;
  }

  .stat-total {
    font-size: 1.25rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .stat-unit {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .stat-label {
    font-size: 0.8125rem;
    color: var(--text-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Overall Progress */
  .progress-card {
    padding: 1.25rem 1.75rem;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.75rem;
    font-size: 0.875rem;
  }

  .progress-label {
    color: var(--text-secondary);
    font-weight: 500;
  }

  .progress-count {
    color: var(--text-primary);
    font-weight: 600;
  }

  .progress-track {
    height: 6px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--accent-gradient);
    border-radius: var(--radius-full);
    transition: width 0.6s ease;
  }

  /* Paths section */
  .paths-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .section-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--text-primary);
    letter-spacing: -0.01em;
  }

  .section-subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-top: 0.2rem;
  }

  .paths-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1rem;
  }

  .path-card {
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .path-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 0.75rem;
  }

  .path-text {
    flex: 1;
  }

  .path-title {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .path-desc {
    font-size: 0.775rem;
    color: var(--text-muted);
    margin-top: 0.25rem;
    line-height: 1.4;
  }

  .path-count {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
    padding: 0.2rem 0.6rem;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
  }

  .path-progress-track {
    height: 4px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .path-progress-fill {
    height: 100%;
    border-radius: var(--radius-full);
    transition: width 0.6s ease;
  }

  .path-pct {
    font-size: 0.775rem;
    color: var(--text-muted);
  }

  /* Badge variants */
  .badge-role {
    background-color: var(--bg-tertiary);
    color: var(--text-secondary);
    border-color: transparent;
  }

  .badge-novice {
    background-color: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.25);
  }

  .badge-intermediate {
    background-color: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.25);
  }

  .badge-advanced {
    background-color: rgba(14, 165, 233, 0.1);
    color: #0ea5e9;
    border-color: rgba(14, 165, 233, 0.25);
  }

  .badge-master {
    background-color: rgba(168, 85, 247, 0.1);
    color: #a855f7;
    border-color: rgba(168, 85, 247, 0.25);
  }

  /* Buttons */
  .btn-sm {
    padding: 0.45rem 0.95rem;
    font-size: 0.875rem;
  }

  .btn-xs {
    padding: 0.25rem 0.65rem;
    font-size: 0.8rem;
  }

  /* History section */
  .history-section {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .table-wrap {
    overflow: hidden;
  }

  .history-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  .history-table th {
    text-align: left;
    padding: 0.875rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-secondary);
  }

  .history-table td {
    padding: 0.875rem 1.25rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-subtle);
    vertical-align: middle;
  }

  .history-table tr:last-child td {
    border-bottom: none;
  }

  .history-table tr:hover td {
    background: var(--border-subtle);
  }

  .module-num {
    font-weight: 600;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .date-col {
    color: var(--text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .code-snippet {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent-cyan);
    background: var(--bg-secondary);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    display: inline-block;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    vertical-align: middle;
  }

  /* Empty state */
  .empty-state {
    padding: 3rem 2rem;
    text-align: center;
  }

  .empty-title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .empty-desc {
    font-size: 0.9rem;
    color: var(--text-muted);
    max-width: 420px;
    margin: 0 auto;
  }

  @media (max-width: 640px) {
    .dash-wrapper {
      gap: 1rem;
    }

    .profile-card {
      padding: 1.25rem;
    }

    .profile-inner {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .profile-actions {
      width: 100%;
      margin-left: 0;
    }

    .profile-actions .btn {
      width: 100%;
      min-height: 44px;
    }

    .section-head {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .section-head .btn {
      width: 100%;
      min-height: 44px;
    }

    .paths-grid {
      grid-template-columns: 1fr;
    }

    .table-wrap {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
