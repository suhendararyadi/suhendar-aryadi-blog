---
import MainLayout from '../layouts/MainLayout.astro';
import { getSessionUser } from '../lib/auth';
import { seedLessons } from '../lib/seedLessons';
import { query } from '../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

let completedModules: any[] = [];
let totalLessonsCount = seedLessons.length;

try {
  const lessonsRes = await query('SELECT COUNT(*) as count FROM sql_lessons');
  if (lessonsRes.rows && lessonsRes.rows[0]?.count) {
    const parsed = parseInt(lessonsRes.rows[0].count, 10);
    if (parsed > 0) totalLessonsCount = parsed;
  }

  const progressRes = await query(
    `SELECT up.id, up.lesson_id, up.status, up.submitted_code, up.completed_at,
            sl.slug, sl.title, sl.category, sl.path_id, sl.order_index
     FROM user_progress up
     JOIN sql_lessons sl ON up.lesson_id = sl.id
     WHERE up.user_id = $1 AND up.status = 'completed'
     ORDER BY up.completed_at DESC`,
    [user.id]
  );
  completedModules = progressRes.rows;
} catch (err) {
  console.warn('Could not fetch dashboard progress from database:', err);
}

const completedCount = completedModules.length;
const completionPercentage = totalLessonsCount > 0 ? Math.round((completedCount / totalLessonsCount) * 100) : 0;

// 4-Tier Rank Badge System:
// - 🟢 SQL Novice (1 - 10 Modul)
// - 🟡 SQL Intermediate (11 - 24 Modul)
// - 🔵 SQL Advanced (25 - 39 Modul)
// - 🏆 Master SQL Engineer (40 Modul Selesai)
let rankInfo = {
  title: 'SQL Novice',
  icon: '🟢',
  badgeClass: 'badge-novice'
};

if (completedCount >= 40) {
  rankInfo = {
    title: 'Master SQL Engineer',
    icon: '🏆',
    badgeClass: 'badge-master'
  };
} else if (completedCount >= 25) {
  rankInfo = {
    title: 'SQL Advanced',
    icon: '🔵',
    badgeClass: 'badge-advanced'
  };
} else if (completedCount >= 11) {
  rankInfo = {
    title: 'SQL Intermediate',
    icon: '🟡',
    badgeClass: 'badge-intermediate'
  };
} else {
  rankInfo = {
    title: 'SQL Novice',
    icon: '🟢',
    badgeClass: 'badge-novice'
  };
}

// 5 Learning Paths Definition & Analytics
interface PathDefinition {
  id: 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security';
  title: string;
  shortTitle: string;
  icon: string;
  total: number;
  badgeClass: string;
  gradient: string;
  description: string;
}

const LEARNING_PATHS: PathDefinition[] = [
  {
    id: 'basics',
    title: 'Path 1: SQL Basics',
    shortTitle: 'SQL Basics',
    icon: '🟢',
    total: 10,
    badgeClass: 'badge-emerald',
    gradient: 'linear-gradient(90deg, #10b981 0%, #059669 100%)',
    description: 'SELECT, WHERE, ORDER BY, INSERT, UPDATE, DELETE'
  },
  {
    id: 'aggregates',
    title: 'Path 2: SQL Aggregates & Functions',
    shortTitle: 'Aggregates',
    icon: '🟡',
    total: 8,
    badgeClass: 'badge-amber',
    gradient: 'linear-gradient(90deg, #f59e0b 0%, #d97706 100%)',
    description: 'Fungsi Agregasi (COUNT, SUM, AVG, MIN, MAX), String & Date'
  },
  {
    id: 'joins',
    title: 'Path 3: SQL Joins & Relasi Tabel',
    shortTitle: 'Joins',
    icon: '🔵',
    total: 6,
    badgeClass: 'badge-sky',
    gradient: 'linear-gradient(90deg, #0ea5e9 0%, #0284c7 100%)',
    description: 'INNER, LEFT, RIGHT, FULL OUTER & Self Join'
  },
  {
    id: 'grouping',
    title: 'Path 4: SQL Grouping & Subqueries',
    shortTitle: 'Grouping',
    icon: '🟣',
    total: 6,
    badgeClass: 'badge-purple',
    gradient: 'linear-gradient(90deg, #a855f7 0%, #7e22ce 100%)',
    description: 'GROUP BY, HAVING, Subqueries, EXISTS, UNION'
  },
  {
    id: 'ddl_security',
    title: 'Path 5: SQL DDL, Constraints & Security',
    shortTitle: 'DDL & Security',
    icon: '🟧',
    total: 10,
    badgeClass: 'badge-orange',
    gradient: 'linear-gradient(90deg, #f97316 0%, #ea580c 100%)',
    description: 'CREATE, ALTER, DROP, Constraints, Transactions, Views'
  }
];

const pathCompletedCounts: Record<string, number> = {
  basics: 0,
  aggregates: 0,
  joins: 0,
  grouping: 0,
  ddl_security: 0
};

completedModules.forEach((item) => {
  const lesson = seedLessons.find((l) => l.id === item.lesson_id);
  const pathId = item.path_id || lesson?.path_id || 'basics';
  if (pathCompletedCounts[pathId] !== undefined) {
    pathCompletedCounts[pathId]++;
  }
});

const pathAnalytics = LEARNING_PATHS.map((path) => {
  const completed = pathCompletedCounts[path.id] || 0;
  const percentage = path.total > 0 ? Math.round((completed / path.total) * 100) : 0;
  return {
    ...path,
    completed,
    percentage
  };
});
---

<MainLayout 
  title={`Dashboard Siswa - ${user.name} | Suhendar Aryadi`}
  description="Dashboard progres belajar siswa RPL. Lihat statistik progres 5 Learning Path SQL dan peringkat kelulusan."
>
  <div class="container dashboard-container">
    <div class="dashboard-card glass-card">
      <div class="user-header">
        <div class="user-avatar-lg">
          {user.name.charAt(0).toUpperCase()}
        </div>
        <div class="user-details">
          <div class="badge-group">
            <span class="badge badge-cyan">{user.role.toUpperCase()}</span>
            <span class={`badge ${rankInfo.badgeClass}`}>
              {rankInfo.icon} {rankInfo.title}
            </span>
          </div>
          <h1 class="user-name">{user.name}</h1>
          <p class="user-email">✉️ {user.email}</p>
        </div>

        <div class="header-actions">
          <button id="logout-btn" class="btn btn-secondary btn-sm" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
            Keluar / Logout
          </button>
        </div>
      </div>

      <div class="divider"></div>

      <div class="section-title-group">
        <h2>📊 Ringkasan Statistik Progres SQL</h2>
        <a href="/belajar/sql" class="btn btn-primary btn-sm">
          📚 Lanjutkan Belajar SQL ➔
        </a>
      </div>

      <div class="stats-grid">
        <div class="stat-card glass-card">
          <div class="stat-icon">✅</div>
          <div class="stat-content">
            <span class="stat-num">{completedCount} / {totalLessonsCount}</span>
            <span class="stat-label">Modul Selesai</span>
          </div>
        </div>

        <div class="stat-card glass-card">
          <div class="stat-icon">📈</div>
          <div class="stat-content">
            <span class="stat-num">{completionPercentage}%</span>
            <span class="stat-label">Tingkat Penyelesaian</span>
          </div>
        </div>

        <div class="stat-card glass-card">
          <div class="stat-icon">{rankInfo.icon}</div>
          <div class="stat-content">
            <span class="stat-num rank-title-num">{rankInfo.title}</span>
            <span class="stat-label">Peringkat Kelulusan</span>
          </div>
        </div>
      </div>

      <div class="progress-bar-section">
        <div class="progress-bar-label">
          <span>Target Kurikulum SQL (40 Modul)</span>
          <span><strong>{completedCount} / {totalLessonsCount} Modul</strong> ({completionPercentage}%)</span>
        </div>
        <div class="progress-track">
          <div class="progress-fill" style={`width: ${completionPercentage}%`}></div>
        </div>
      </div>

      <div class="paths-analytics-section">
        <div class="paths-section-header">
          <h3>🎯 Progres per Learning Path (5 Alur Belajar)</h3>
          <p>Breakdown pencapaian modul dari tingkat Dasar hingga Keamanan Database</p>
        </div>

        <div class="paths-grid">
          {pathAnalytics.map((path) => (
            <div class="path-card glass-card">
              <div class="path-header">
                <div class="path-title-wrap">
                  <span class="path-icon">{path.icon}</span>
                  <div>
                    <h4 class="path-title">{path.title}</h4>
                    <span class="path-desc">{path.description}</span>
                  </div>
                </div>
                <div class="path-badge-wrap">
                  <span class={`badge ${path.badgeClass}`}>
                    {path.completed} / {path.total} Modul
                  </span>
                </div>
              </div>

              <div class="path-progress-bar-container">
                <div class="path-progress-track">
                  <div 
                    class="path-progress-fill" 
                    style={`width: ${path.percentage}%; background: ${path.gradient};`}
                  ></div>
                </div>
                <div class="path-progress-info">
                  <span class="path-pct-text">{path.percentage}% Selesai</span>
                  <span class="path-count-text">{path.completed} dari {path.total} modul</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="divider"></div>

      <div class="modules-section">
        <h3>📜 Riwayat Modul yang Telah Diselesaikan</h3>
        {completedModules.length > 0 ? (
          <div class="table-wrapper">
            <table class="history-table">
              <thead>
                <tr>
                  <th>Modul</th>
                  <th>Kategori</th>
                  <th>Tanggal Selesai</th>
                  <th>Kode SQL Disubmit</th>
                  <th>Aksi</th>
                </tr>
              </thead>
              <tbody>
                {completedModules.map((item) => (
                  <tr>
                    <td>
                      <strong>#{item.order_index} {item.title}</strong>
                    </td>
                    <td>
                      <span class="badge badge-cyan">{item.category}</span>
                    </td>
                    <td class="date-col">
                      {item.completed_at ? new Date(item.completed_at).toLocaleDateString('id-ID', {
                        day: 'numeric',
                        month: 'short',
                        year: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                      }) : 'Terbaru'}
                    </td>
                    <td>
                      <code class="code-preview">{item.submitted_code}</code>
                    </td>
                    <td>
                      <a href={`/belajar/sql/${item.slug}`} class="btn btn-outline btn-xs">
                        Buka Workspace ➔
                      </a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div class="empty-state glass-card">
            <div class="empty-icon">💡</div>
            <h4>Belum Ada Modul yang Diselesaikan</h4>
            <p>Anda belum menyelesaikan modul SQL. Mulai latihan sekarang dan selesaikan tantangan pertama Anda!</p>
            <a href="/belajar/sql" class="btn btn-primary btn-sm" style="margin-top: 1rem;">
              Mulai Belajar Sekarang ➔
            </a>
          </div>
        )}
      </div>
    </div>
  </div>
</MainLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    } catch (err) {
      console.error('Logout error:', err);
    }
  });
</script>

