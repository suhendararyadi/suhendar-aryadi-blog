    <!-- SQL 5 Learning Path Progress Section -->
    <div class="section-block">
      <div class="section-header">
        <div>
          <h2 class="section-title">Kurikulum SQL Masterclass (5 Learning Paths)</h2>
          <p class="section-sub">Pantau progres penyelesaian 40 modul interaktif SQL secara bertahap.</p>
        </div>
        <a href="/belajar/sql" class="mui-btn mui-btn-subtle">
          <span>Katalog Modul &rarr;</span>
        </a>
