        </div>

        <div id="profile-error-banner" class="m3-banner m3-banner-error margin-top-sm" style="display: none;"></div>
        <div id="profile-success-banner" class="m3-banner m3-banner-success margin-top-sm" style="display: none;"></div>

        <form id="edit-profile-form" class="modal-form margin-top-md">
          <div class="form-group">
            <label for="edit-name" class="m3-label-large">Nama Lengkap Siswa</label>
            <input
              type="text"
              id="edit-name"
              name="name"
              value={user.name}
              required
              class="m3-text-field"
              placeholder="Contoh: Budi Santoso"
            />
          </div>

          <div class="form-group margin-top-sm">
            <label for="edit-class-select" class="m3-label-large">Identitas Kelas</label>
            <select id="edit-class-select" class="m3-text-field">
              <option value="" disabled selected={!user.class_name}>-- Pilih Rombel / Kelas --</option>
              <optgroup label="Kelas 10 (Fase E)">
                <option value="10 RPL 1" selected={user.class_name === '10 RPL 1' || user.class_name === 'X RPL 1'}>10 RPL 1 (X RPL 1)</option>
                <option value="10 RPL 2" selected={user.class_name === '10 RPL 2' || user.class_name === 'X RPL 2'}>10 RPL 2 (X RPL 2)</option>
                <option value="10 RPL 3" selected={user.class_name === '10 RPL 3' || user.class_name === 'X RPL 3'}>10 RPL 3 (X RPL 3)</option>
                <option value="10 RPL 4" selected={user.class_name === '10 RPL 4' || user.class_name === 'X RPL 4'}>10 RPL 4 (X RPL 4)</option>
              </optgroup>
              <optgroup label="Kelas 11 (XI RPL)">
                <option value="11 RPL 1" selected={user.class_name === '11 RPL 1' || user.class_name === 'XI RPL 1'}>11 RPL 1 (XI RPL 1)</option>
                <option value="11 RPL 2" selected={user.class_name === '11 RPL 2' || user.class_name === 'XI RPL 2'}>11 RPL 2 (XI RPL 2)</option>
                <option value="11 RPL 3" selected={user.class_name === '11 RPL 3' || user.class_name === 'XI RPL 3'}>11 RPL 3 (XI RPL 3)</option>
                <option value="11 RPL 4" selected={user.class_name === '11 RPL 4' || user.class_name === 'XI RPL 4'}>11 RPL 4 (XI RPL 4)</option>
              </optgroup>
              <optgroup label="Kelas 12 (XII RPL)">
                <option value="12 RPL 1" selected={user.class_name === '12 RPL 1' || user.class_name === 'XII RPL 1'}>12 RPL 1 (XII RPL 1)</option>
                <option value="12 RPL 2" selected={user.class_name === '12 RPL 2' || user.class_name === 'XII RPL 2'}>12 RPL 2 (XII RPL 2)</option>
                <option value="12 RPL 3" selected={user.class_name === '12 RPL 3' || user.class_name === 'XII RPL 3'}>12 RPL 3 (XII RPL 3)</option>
                <option value="12 RPL 4" selected={user.class_name === '12 RPL 4' || user.class_name === 'XII RPL 4'}>12 RPL 4 (XII RPL 4)</option>
              </optgroup>
              <option value="CUSTOM" selected={!!user.class_name && !['10 RPL 1', '10 RPL 2', '10 RPL 3', '10 RPL 4', '11 RPL 1', '11 RPL 2', '11 RPL 3', '11 RPL 4', '12 RPL 1', '12 RPL 2', '12 RPL 3', '12 RPL 4', 'X RPL 1', 'X RPL 2', 'X RPL 3', 'X RPL 4', 'XI RPL 1', 'XI RPL 2', 'XI RPL 3', 'XI RPL 4', 'XII RPL 1', 'XII RPL 2', 'XII RPL 3', 'XII RPL 4'].includes(user.class_name)}>Lainnya (Ketik Manual...)</option>
            </select>
            <input
              type="text"
              id="edit-class-custom"
              name="class_name_custom"
              value={user.class_name || ''}
              placeholder="Contoh: XI PPLG 5 / Kelas Khusus"
              class="m3-text-field"
              style="display: none; margin-top: 0.5rem;"
            />
          </div>

          <div class="form-group margin-top-sm">
            <label for="edit-password" class="m3-label-large">Password Baru (Opsional)</label>
