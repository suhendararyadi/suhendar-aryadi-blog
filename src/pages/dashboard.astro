            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
            <span>Edit Profil</span>
          </button>
          <a href="/belajar/sql/leaderboard" class="mui-btn mui-btn-subtle">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
            <span>Leaderboard</span>
          </a>
          {(completedCount >= totalLessonsCount || isTeacherOrAdmin) && (
            <a href="/sertifikat/sql" class="mui-btn mui-btn-success">
              📜 Sertifikat Kelulusan
            </a>
          )}
          <button id="logout-btn" class="mui-btn mui-btn-text-danger" type="button">Keluar</button>
        </div>
      </div>
    </div>

    <!-- Certificate Banner if Completed -->
    {(completedCount >= totalLessonsCount || isTeacherOrAdmin) && (
      <div class="mui-paper cert-banner-paper">
        <div class="cert-banner-inner">
          <div>
            <span class="mui-chip chip-success">SERTIFIKAT KELULUSAN TERSEDIA</span>
            <h2 class="cert-title">Selamat! Anda Meraih Predikat Master SQL Engineer 🎓</h2>
            <p class="cert-sub">
              Seluruh <strong>{totalLessonsCount} Modul SQL</strong> telah berhasil Anda selesaikan. Unduh dan cetak Sertifikat Kelulusan Resmi untuk portofolio vokasi Anda.
            </p>
          </div>
          <a href="/sertifikat/sql" class="mui-btn mui-btn-gradient">
            <span>Lihat &amp; Cetak Sertifikat &rarr;</span>
          </a>
        </div>
      </div>
    )}

    <!-- Quick Stats Grid (4 MUI Metric Cards) -->
    <div class="mui-grid-4">
      <div class="mui-paper stat-card">
        <div class="stat-icon-box icon-purple">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
        </div>
        <div>
          <div class="stat-label">PROGRES MODUL SQL</div>
          <div class="stat-value">{completedCount} <span class="stat-subval">/ {totalLessonsCount}</span></div>
          <div class="progress-bar-sm">
            <div class="progress-fill-sm" style={`width: ${completionPercentage}%;`}></div>
          </div>
        </div>
      </div>

      <div class="mui-paper stat-card">
        <div class="stat-icon-box icon-emerald">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
        </div>
        <div>
          <div class="stat-label">RATA-RATA NILAI LKPD</div>
          <div class="stat-value" style={`color: ${avgScoreColor};`}>{avgScoreText}</div>
          <div class="stat-hint">{avgScore !== null ? 'Hasil evaluasi Pak Suhendar' : 'Belum mengerjakan LKPD'}</div>
        </div>
      </div>

      <div class="mui-paper stat-card">
        <div class="stat-icon-box icon-gold">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/></svg>
        </div>
        <div>
          <div class="stat-label">PERINGKAT PLATFORM</div>
          <div class="stat-value">#{userRankPosition} <span class="stat-subval">dari {totalStudentsCount}</span></div>
          <div class="stat-hint">{rankInfo.title}</div>
        </div>
      </div>

      <div class="mui-paper stat-card">
        <div class="stat-icon-box icon-cyan">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <div>
          <div class="stat-label">PERINGKAT DI KELAS</div>
          <div class="stat-value">#{userClassRankPosition} <span class="stat-subval">di {user.class_name || 'Rombel'}</span></div>
          <div class="stat-hint">{classStudentsCount} Siswa Terdaftar</div>
        </div>
      </div>
    </div>

    <!-- Mata Pelajaran (Subject Enrollment) & Rekap Nilai Section -->
