                  <td>
                    <span class="m3-chip m3-chip-tonal-secondary">{item.category}</span>
                  </td>
                  <td class="text-m3-muted">
                    {item.completed_at ? new Date(item.completed_at).toLocaleDateString('id-ID', {
                      day: 'numeric', month: 'short', year: 'numeric'
                    }) : '—'}
                  </td>
                  <td>
                    <code class="history-code-tag">{item.submitted_code.slice(0, 45)}...</code>
                  </td>
                  <td>
                    <a href={`/belajar/sql/${item.slug}`} class="m3-btn m3-btn-tonal btn-sm">Buka</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state margin-top-md">
          <span class="material-symbols-rounded icon-xl text-m3-muted">assignment_late</span>
          <p class="m3-title-medium margin-top-xs">Belum ada modul SQL yang diselesaikan.</p>
          <p class="m3-body-small text-m3-muted">Mulai eksplorasi SQL Masterclass untuk mencatat progres belajar Anda.</p>
          <a href="/belajar/sql" class="m3-btn m3-btn-filled btn-sm margin-top-sm">Buka Katalog SQL</a>
        </div>
      )}
    </div>

    <!-- Modal Edit Profil Siswa -->
    <div id="edit-profile-modal" class="modal-backdrop" style="display: none;">
      <div class="m3-card m3-card-elevated modal-dialog-m3">
        <div class="modal-header">
          <div class="modal-title-group">
            <span class="material-symbols-rounded icon-lg text-m3-primary">account_circle</span>
            <div>
              <h2 class="m3-title-large">Edit Profil Siswa</h2>
              <p class="m3-body-small text-m3-muted">Perbarui nama lengkap, identitas kelas, atau password Anda.</p>
            </div>
          </div>
          <button id="close-modal-btn" class="m3-btn-icon" type="button" aria-label="Tutup Modal">
