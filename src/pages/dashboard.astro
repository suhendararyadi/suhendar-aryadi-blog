---
import MainLayout from '../layouts/MainLayout.astro';
import { getSessionUser } from '../lib/auth';
import { seedLessons } from '../lib/seedLessons';
import { query } from '../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

let completedModules: any[] = [];
let topLeaderboard: any[] = [];
let totalLessonsCount = seedLessons.length;
let userRankPosition = 1;
let totalStudentsCount = 1;
let userClassRankPosition = 1;
let classStudentsCount = 1;

try {
  const lessonsRes = await query('SELECT COUNT(*) as count FROM sql_lessons');
  if (lessonsRes.rows && lessonsRes.rows[0]?.count) {
    const parsed = parseInt(lessonsRes.rows[0].count, 10);
    if (parsed > 0) totalLessonsCount = parsed;
  }

  const progressRes = await query(
    `SELECT up.id, up.lesson_id, up.status, up.submitted_code, up.completed_at,
            sl.slug, sl.title, sl.category, sl.path_id, sl.order_index
     FROM user_progress up
     JOIN sql_lessons sl ON up.lesson_id = sl.id
     WHERE up.user_id = $1 AND up.status = 'completed'
     ORDER BY up.completed_at DESC`,
    [user.id]
  );
  completedModules = progressRes.rows;

  const rankRes = await query(
    `WITH user_ranks AS (
       SELECT u.id, u.name, u.role, u.class_name,
              COUNT(DISTINCT up.lesson_id) as completed_count,
              ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT up.lesson_id) DESC, u.id ASC) as overall_rank,
              ROW_NUMBER() OVER (PARTITION BY u.class_name ORDER BY COUNT(DISTINCT up.lesson_id) DESC, u.id ASC) as class_rank
       FROM users u
       LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
       GROUP BY u.id, u.name, u.role, u.class_name
     )
     SELECT * FROM user_ranks ORDER BY overall_rank ASC`
  );

  if (rankRes.rows && rankRes.rows.length > 0) {
    totalStudentsCount = rankRes.rows.length;
    const myRankRow = rankRes.rows.find((r: any) => r.id === user.id);
    if (myRankRow) {
      userRankPosition = parseInt(myRankRow.overall_rank, 10);
      userClassRankPosition = parseInt(myRankRow.class_rank, 10);
    }
    if (user.class_name) {
      classStudentsCount = rankRes.rows.filter((r: any) => r.class_name === user.class_name).length;
    }
    topLeaderboard = rankRes.rows.slice(0, 5).map((r: any) => {
      const count = parseInt(r.completed_count || '0', 10);
      const pct = totalLessonsCount > 0 ? Math.round((count / totalLessonsCount) * 100) : 0;
      return { ...r, count, pct, rank: parseInt(r.overall_rank, 10) };
    });
  }
} catch (err) {
  console.warn('Could not fetch dashboard progress from database:', err);
}

// Fetch BK & TIK LKPD Submissions and Course Enrollments
let bkSubmission: any = null;
let tikSubmission: any = null;
let enrolledSubjectIds: string[] = [];

try {
  const bkRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (bkRes.rows && bkRes.rows.length > 0) {
    bkSubmission = bkRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch BK submission:', err);
}

try {
  const tikRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_tik_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (tikRes.rows && tikRes.rows.length > 0) {
    tikSubmission = tikRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch TIK submission:', err);
}

// Auto-sync existing student progress to course_enrollments
try {
  if (bkSubmission || tikSubmission) {
    await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'informatika') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]);
  }
  if (completedModules.length > 0) {
    await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'rpl_web_sql') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]);
  }
} catch (err) {
  console.warn('Auto sync enrollments warning:', err);
}

try {
  const enrollRes = await query(
    `SELECT course_id FROM course_enrollments WHERE user_id = $1`,
    [user.id]
  );
  if (enrollRes.rows) {
    enrolledSubjectIds = enrollRes.rows.map((r: any) => String(r.course_id).toLowerCase());
  }
} catch (err) {
  console.warn('Could not fetch course_enrollments:', err);
}

const isInformatikaEnrolled = enrolledSubjectIds.includes('informatika') || enrolledSubjectIds.includes('bk') || enrolledSubjectIds.includes('tik') || !!bkSubmission || !!tikSubmission;
const isRplSqlEnrolled = enrolledSubjectIds.includes('rpl_web_sql') || enrolledSubjectIds.includes('sql') || completedModules.length > 0;

const completedCount = completedModules.length;
const completionPercentage = totalLessonsCount > 0 ? Math.round((completedCount / totalLessonsCount) * 100) : 0;

// 4-Tier Rank System
let rankInfo = { title: 'SQL Novice', badgeClass: 'badge-novice' };
if (completedCount >= 40) {
  rankInfo = { title: 'Master SQL Engineer', badgeClass: 'badge-master' };
} else if (completedCount >= 25) {
  rankInfo = { title: 'SQL Advanced', badgeClass: 'badge-advanced' };
} else if (completedCount >= 11) {
  rankInfo = { title: 'SQL Intermediate', badgeClass: 'badge-intermediate' };
}

// Calculate Scores & Average Grade for Informatika
let bkScore: number | null = bkSubmission && bkSubmission.score !== null && bkSubmission.score !== undefined ? parseInt(bkSubmission.score, 10) : null;
let tikScore: number | null = tikSubmission && tikSubmission.score !== null && tikSubmission.score !== undefined ? parseInt(tikSubmission.score, 10) : null;

let avgScore: number | null = null;
if (bkScore !== null && !isNaN(bkScore) && tikScore !== null && !isNaN(tikScore)) {
  const rawAvg = (bkScore + tikScore) / 2;
  avgScore = Number.isInteger(rawAvg) ? rawAvg : Math.round(rawAvg * 10) / 10;
} else if (bkScore !== null && !isNaN(bkScore)) {
  avgScore = bkScore;
} else if (tikScore !== null && !isNaN(tikScore)) {
  avgScore = tikScore;
}

const avgScoreText = avgScore !== null ? `${avgScore} / 100` : 'Belum Ada Nilai';
const avgScoreColor = avgScore !== null ? (avgScore >= 75 ? '#10b981' : '#f59e0b') : 'var(--text-muted)';

const bkScoreText = bkSubmission
  ? (bkScore !== null ? `${bkScore} / 100` : 'Belum Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const bkScoreColor = bkSubmission && bkScore !== null
  ? (bkScore >= 75 ? '#10b981' : '#f59e0b')
  : (bkSubmission ? '#0ea5e9' : 'var(--text-muted)');
const bkFeedbackText = bkSubmission
  ? (bkSubmission.teacher_feedback ? `Catatan Guru: "${bkSubmission.teacher_feedback}"` : (bkScore !== null ? 'Sudah dinilai oleh Pak Suhendar.' : 'LKPD telah dikirim, menunggu penilaian Guru.'))
  : (isInformatikaEnrolled ? 'Kerjakan LKPD 4 Pilar Berpikir Komputasional untuk mendapatkan nilai.' : 'Masukan kode akses dari Guru untuk membuka modul.');

const tikScoreText = tikSubmission
  ? (tikScore !== null ? `${tikScore} / 100` : 'Belum Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const tikScoreColor = tikSubmission && tikScore !== null
  ? (tikScore >= 75 ? '#10b981' : '#f59e0b')
  : (tikSubmission ? '#0ea5e9' : 'var(--text-muted)');
const tikFeedbackText = tikSubmission
  ? (tikSubmission.teacher_feedback ? `Catatan Guru: "${tikSubmission.teacher_feedback}"` : (tikScore !== null ? 'Sudah dinilai oleh Pak Suhendar.' : 'LKPD TIK telah dikirim, menunggu penilaian Guru.'))
  : (isInformatikaEnrolled ? 'Kerjakan LKPD TIK Mail Merge & Search Engine untuk mendapatkan nilai.' : 'Masukan kode akses dari Guru untuk membuka modul.');

let trophyEmoji = '🏆';
let rankMotivationalMsg = '🚀 Pertahankan semangat! Selesaikan modul berikutnya untuk naik ke 10 Besar.';

if (userRankPosition === 1) {
  trophyEmoji = '🥇';
  rankMotivationalMsg = '🥇 Luar biasa! Anda saat ini memimpin di Peringkat #1 Teratas seluruh platform.';
} else if (userRankPosition <= 3) {
  trophyEmoji = '🥈';
  rankMotivationalMsg = '🥈 Selamat! Anda berada di posisi 3 Besar Peringkat Teratas.';
} else if (userRankPosition <= 10) {
  trophyEmoji = '🥉';
  rankMotivationalMsg = '🔥 Hebat! Anda berhasil menembus 10 Besar Peringkat Teratas.';
}

interface PathDefinition {
  id: 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security';
  title: string;
  total: number;
  accentVar: string;
  description: string;
}

const LEARNING_PATHS: PathDefinition[] = [
  { id: 'basics', title: 'SQL Basics', total: 10, accentVar: '#10b981', description: 'SELECT, WHERE, ORDER BY, INSERT, UPDATE, DELETE' },
  { id: 'aggregates', title: 'Aggregates & Functions', total: 8, accentVar: '#f59e0b', description: 'COUNT, SUM, AVG, MIN, MAX, LIKE, IN, BETWEEN' },
  { id: 'joins', title: 'Joins & Relasi Tabel', total: 6, accentVar: '#0ea5e9', description: 'INNER, LEFT, RIGHT, FULL, SELF JOIN' },
  { id: 'grouping', title: 'Grouping & Subqueries', total: 6, accentVar: '#a855f7', description: 'GROUP BY, HAVING, EXISTS, ANY/ALL, CASE' },
  { id: 'ddl_security', title: 'DDL, Constraints & Security', total: 10, accentVar: '#f97316', description: 'CREATE, ALTER, DROP, PK, FK, VIEW, SQL Injection' },
];

const pathCompletedCounts: Record<string, number> = { basics: 0, aggregates: 0, joins: 0, grouping: 0, ddl_security: 0 };
completedModules.forEach((item) => {
  const lesson = seedLessons.find((l) => l.id === item.lesson_id);
  const pathId = item.path_id || lesson?.path_id || 'basics';
  if (pathCompletedCounts[pathId] !== undefined) pathCompletedCounts[pathId]++;
});

const pathAnalytics = LEARNING_PATHS.map((path) => {
  const completed = pathCompletedCounts[path.id] || 0;
  const percentage = path.total > 0 ? Math.round((completed / path.total) * 100) : 0;
  return { ...path, completed, percentage };
});

const isTeacherOrAdmin = user.role === 'teacher' || user.role === 'admin' || (user.email && user.email.toLowerCase().includes('suhendar'));
---

<MainLayout 
  title={`Dashboard — ${user.name} | Suhendar Aryadi`}
  description="Dashboard progres belajar siswa. Lihat statistik dan progres 5 Learning Path SQL."
>
  <div class="dash-wrapper">

    <!-- Profile header -->
    <div class="profile-card glass-card">
      <div class="profile-inner">
        <div class="avatar-wrap">
          <div class="avatar-circle">
            {user.name.charAt(0).toUpperCase()}
          </div>
        </div>
        <div class="profile-info">
          <div class="profile-badges">
            <span class="badge badge-role">{user.role.toUpperCase()}</span>
            {user.class_name ? (
              <span class="badge badge-cyan">{user.class_name}</span>
            ) : (
              <span class="badge badge-muted">Kelas Belum Diisi</span>
            )}
            <span class="badge badge-gold">Peringkat #{userRankPosition}</span>
            <span class={`badge ${rankInfo.badgeClass}`}>{rankInfo.title}</span>
          </div>
          <h1 class="profile-name">{user.name}</h1>
          <p class="profile-email">{user.email}</p>
        </div>
        <div class="profile-actions">
          {isTeacherOrAdmin && (
            <a href="/admin/dashboard" class="btn btn-primary btn-sm btn-teacher-portal">
              <span>Portal Guru</span>
            </a>
          )}
          <button id="open-edit-profile-btn" class="btn btn-secondary btn-sm" type="button">
            <span>Edit Profil</span>
          </button>
          <a href="/belajar/sql/leaderboard" class="btn btn-outline btn-sm">
            <span>Papan Peringkat</span>
          </a>
          {(completedCount >= totalLessonsCount || isTeacherOrAdmin) && (
            <a href="/sertifikat/sql" class="btn btn-outline btn-sm">
              <span>Sertifikat Kelulusan</span>
            </a>
          )}
          <button id="logout-btn" class="btn btn-secondary btn-sm" type="button">Keluar</button>
        </div>
      </div>
    </div>

    {(completedCount >= totalLessonsCount || isTeacherOrAdmin) && (
      <div class="cert-congratulations-banner glass-card">
        <div class="cert-banner-left">
          <span class="badge badge-gold">SERTIFIKAT KELULUSAN TERSEDIA</span>
          <h2 class="cert-banner-title">Selamat! Predikat Master SQL Engineer</h2>
          <p class="cert-banner-desc">
            Anda telah berhasil menyelesaikan seluruh <strong>{totalLessonsCount} Modul SQL</strong>. Unduh dan cetak Sertifikat Kompetensi Resmi Anda untuk portofolio dan CV.
          </p>
        </div>
        <a href="/sertifikat/sql" class="btn btn-primary btn-cert-cta">
          <span>Lihat &amp; Cetak Sertifikat &rarr;</span>
        </a>
      </div>
    )}

    {isTeacherOrAdmin && (
      <div class="teacher-access-banner glass-card">
        <div class="teacher-banner-left">
          <span class="badge badge-purple">PORTAL AKSES GURU & ADMIN</span>
          <h2 class="teacher-banner-title">Rekap Nilai Siswa & Analitik Kelas</h2>
          <p class="teacher-banner-desc">
            Anda terautentikasi sebagai <strong>Guru / Admin</strong> ({user.email}). Akses dashboard guru untuk memantau progres seluruh siswa, melihat analitik modul tersulit, dan mengekspor rekap nilai ke Excel (CSV).
          </p>
        </div>
        <a href="/admin/dashboard" class="btn btn-primary btn-teacher-cta">
          <span>Buka Portal Guru & Admin &rarr;</span>
        </a>
      </div>
    )}

    <!-- Stats row -->
    <div class="stats-row">
      <div class="stat-item glass-card">
        <span class="stat-value">{completedCount} <span class="stat-total">/ {totalLessonsCount}</span></span>
        <span class="stat-label">Modul Selesai</span>
      </div>
      <div class="stat-item glass-card">
        <span class="stat-value">{completionPercentage}<span class="stat-unit">%</span></span>
        <span class="stat-label">Tingkat Penyelesaian</span>
      </div>
      <div class="stat-item glass-card">
        <span class="stat-value stat-rank">#{userRankPosition} <span class="stat-total">({rankInfo.title})</span></span>
        <span class="stat-label">Peringkat Siswa ({user.class_name ? `Kelas #${userClassRankPosition}` : `dari ${totalStudentsCount} Siswa`})</span>
      </div>
    </div>

    <!-- Rekap Nilai & Status Enroll Mata Pelajaran -->
    <div class="recap-section">
      <div class="section-head">
        <div>
          <h2 class="section-title">Rekap Nilai & Status Enroll Mata Pelajaran</h2>
          <p class="section-subtitle">Pantau nilai LKPD Informatika, rata-rata nilai mata pelajaran, dan progres modul RPL.</p>
        </div>
      </div>

      <div class="subject-grid">
        <!-- Mata Pelajaran 1: Informatika SMK (Fase E) -->
        <div class={`subject-card glass-card ${isInformatikaEnrolled ? 'is-enrolled' : 'is-locked'}`}>
          <div class="subject-card-header">
            <div class="subject-title-wrap">
              <span class="subject-icon">💻</span>
              <div>
                <h3 class="subject-title">Mata Pelajaran: Informatika SMK (Fase E)</h3>
                <p class="subject-sub">Integrasi Berpikir Komputasional, TIK, Sistem Komputer, & AP</p>
              </div>
            </div>
            {isInformatikaEnrolled ? (
              <span class="badge badge-success">✓ TERDAFTAR MATA PELAJARAN</span>
            ) : (
              <span class="badge badge-amber">🔒 BELUM ENROLL</span>
            )}
          </div>

          <div class="subject-body">
            <div class="lkpd-items-grid">
              <!-- LKPD 1 (BK) -->
              <div class="lkpd-item-box">
                <div class="lkpd-item-title">LKPD 1 — Berpikir Komputasional (BK)</div>
                <div class="lkpd-item-score" style={`color: ${bkScoreColor};`}>{bkScoreText}</div>
                <p class="lkpd-item-feedback">{bkFeedbackText}</p>
              </div>

              <!-- LKPD 2 (TIK) -->
              <div class="lkpd-item-box">
                <div class="lkpd-item-title">LKPD 2 — TIK & Mail Merge</div>
                <div class="lkpd-item-score" style={`color: ${tikScoreColor};`}>{tikScoreText}</div>
                <p class="lkpd-item-feedback">{tikFeedbackText}</p>
              </div>
            </div>

            <!-- Rata-rata Nilai Mata Pelajaran -->
            <div class="average-grade-box">
              <div class="avg-label">RATA-RATA NILAI MATA PELAJARAN INFORMATIKA</div>
              <div class="avg-value" style={`color: ${avgScoreColor};`}>{avgScoreText}</div>
            </div>
          </div>

          <div class="subject-card-action">
            {isInformatikaEnrolled ? (
              <a href="/belajar/informatika" class="btn btn-outline btn-sm recap-btn">
                Buka Mata Pelajaran Informatika &rarr;
              </a>
            ) : (
              <button
                type="button"
                class="btn btn-primary btn-sm btn-enroll-trigger recap-btn"
                data-course-id="informatika"
                data-course-title="Mata Pelajaran: Informatika SMK (Fase E)"
              >
                🔒 Enroll Mata Pelajaran Ini (Kode Akses)
              </button>
            )}
          </div>
        </div>

        <!-- Mata Pelajaran 2: Pemrograman Web & Basis Data (RPL) -->
        <div class={`subject-card glass-card ${isRplSqlEnrolled ? 'is-enrolled' : 'is-locked'}`}>
          <div class="subject-card-header">
            <div class="subject-title-wrap">
              <span class="subject-icon">🗄️</span>
              <div>
                <h3 class="subject-title">Mata Pelajaran: Pemrograman Web & Basis Data (RPL)</h3>
                <p class="subject-sub">Practical SQL Masterclass & Relational Database Management</p>
              </div>
            </div>
            {isRplSqlEnrolled ? (
              <span class="badge badge-success">✓ TERDAFTAR MATA PELAJARAN</span>
            ) : (
              <span class="badge badge-amber">🔒 BELUM ENROLL</span>
            )}
          </div>

          <div class="subject-body">
            <div class="lkpd-items-grid">
              <div class="lkpd-item-box">
                <div class="lkpd-item-title">Practical SQL Masterclass</div>
                <div class="lkpd-item-score" style="color: #6366f1;">{completedCount} / {totalLessonsCount} Modul Selesai</div>
                <p class="lkpd-item-feedback">{completionPercentage}% Kurikulum SQL diselesaikan</p>
              </div>

              <div class="lkpd-item-box">
                <div class="lkpd-item-title">Predikat & Kualifikasi Kompetensi</div>
                <div class="lkpd-item-score" style="color: #a855f7;">{rankInfo.title}</div>
                <p class="lkpd-item-feedback">Peringkat #{userRankPosition} dari {totalStudentsCount} Siswa Terdaftar</p>
              </div>
            </div>
          </div>

          <div class="subject-card-action">
            {isRplSqlEnrolled ? (
              <a href="/belajar/sql" class="btn btn-outline btn-sm recap-btn">
                Buka Mata Pelajaran Pemrograman Web & Basis Data &rarr;
              </a>
            ) : (
              <button
                type="button"
                class="btn btn-primary btn-sm btn-enroll-trigger recap-btn"
                data-course-id="rpl_web_sql"
                data-course-title="Mata Pelajaran: Pemrograman Web & Basis Data (RPL)"
              >
                🔒 Enroll Mata Pelajaran Ini (Kode Akses)
              </button>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Overall progress -->
    <div class="progress-card glass-card">
      <div class="progress-header">
        <span class="progress-label">Progress Kurikulum SQL (40 Modul)</span>
        <span class="progress-count">{completedCount} / {totalLessonsCount}</span>
      </div>
      <div class="progress-track">
        <div class="progress-fill" style={`width: ${completionPercentage}%`}></div>
      </div>
    </div>

    <!-- Learning paths -->
    <div class="paths-section">
      <div class="section-head">
        <div>
          <h2 class="section-title">Progress per Learning Path</h2>
          <p class="section-subtitle">5 alur belajar dari dasar hingga keamanan database</p>
        </div>
        <a href="/belajar/sql" class="btn btn-primary btn-sm">Lanjutkan Belajar</a>
      </div>

      <div class="paths-grid">
        {pathAnalytics.map((path) => (
          <div class="path-card glass-card">
            <div class="path-top">
              <div class="path-text">
                <h3 class="path-title">{path.title}</h3>
                <p class="path-desc">{path.description}</p>
              </div>
              <span class="path-count">{path.completed}/{path.total}</span>
            </div>
            <div class="path-progress-track">
              <div class="path-progress-fill" style={`width: ${path.percentage}%; background-color: ${path.accentVar};`}></div>
            </div>
            <p class="path-pct">{path.percentage}% selesai</p>
          </div>
        ))}
      </div>
    </div>

    <!-- History table -->
    <div class="history-section">
      <h2 class="section-title">Riwayat Modul Selesai</h2>

      {completedModules.length > 0 ? (
        <div class="table-wrap glass-card">
          <table class="history-table">
            <thead>
              <tr>
                <th>Modul</th>
                <th>Kategori</th>
                <th>Tanggal</th>
                <th>SQL Terakhir</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {completedModules.map((item) => (
                <tr>
                  <td>
                    <span class="module-num">#{item.order_index}</span> {item.title}
                  </td>
                  <td>
                    <span class="badge badge-role">{item.category}</span>
                  </td>
                  <td class="date-col">
                    {item.completed_at ? new Date(item.completed_at).toLocaleDateString('id-ID', {
                      day: 'numeric', month: 'short', year: 'numeric'
                    }) : '—'}
                  </td>
                  <td>
                    <code class="code-snippet">{item.submitted_code}</code>
                  </td>
                  <td>
                    <a href={`/belajar/sql/${item.slug}`} class="btn btn-outline btn-xs">Buka</a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <div class="empty-state glass-card">
          <p class="empty-title">Belum ada modul yang diselesaikan.</p>
          <p class="empty-desc">Mulai latihan SQL dan selesaikan tantangan pertama Anda.</p>
          <a href="/belajar/sql" class="btn btn-primary btn-sm" style="margin-top: 1.25rem;">Mulai Belajar</a>
        </div>
      )}
    </div>

  <!-- Modal Edit Profil Siswa -->
  <div id="edit-profile-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card glass-card">
      <div class="modal-header">
        <div class="modal-title-group">
          <div class="modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </div>
          <div>
            <h2 class="modal-title">Edit Profil Pengguna</h2>
            <p class="modal-sub">Perbarui nama lengkap, identitas kelas, atau password Anda.</p>
          </div>
        </div>
        <button id="close-modal-btn" class="modal-close" type="button" aria-label="Tutup Modal">&times;</button>
      </div>

      <div id="profile-error-banner" class="alert alert-error" style="display: none;"></div>
      <div id="profile-success-banner" class="alert alert-success" style="display: none;"></div>

      <form id="edit-profile-form" class="modal-form">
        <div class="form-group">
          <label for="edit-name">Nama Lengkap Siswa / Pengguna</label>
          <input
            type="text"
            id="edit-name"
            name="name"
            value={user.name}
            required
            placeholder="Contoh: Budi Santoso"
          />
        </div>

        <div class="form-group">
          <label for="edit-class-select">Identitas Kelas (RPL / Vokasi)</label>
          <select id="edit-class-select" class="form-select">
            <option value="" disabled selected={!user.class_name}>-- Pilih Rombel / Kelas --</option>
            <optgroup label="Kelas X (Sepuluh)">
              <option value="X RPL 1" selected={user.class_name === 'X RPL 1'}>X RPL 1</option>
              <option value="X RPL 2" selected={user.class_name === 'X RPL 2'}>X RPL 2</option>
              <option value="X RPL 3" selected={user.class_name === 'X RPL 3'}>X RPL 3</option>
              <option value="X RPL 4" selected={user.class_name === 'X RPL 4'}>X RPL 4</option>
            </optgroup>
            <optgroup label="Kelas XI (Sebelas)">
              <option value="XI RPL 1" selected={user.class_name === 'XI RPL 1'}>XI RPL 1</option>
              <option value="XI RPL 2" selected={user.class_name === 'XI RPL 2'}>XI RPL 2</option>
              <option value="XI RPL 3" selected={user.class_name === 'XI RPL 3'}>XI RPL 3</option>
              <option value="XI RPL 4" selected={user.class_name === 'XI RPL 4'}>XI RPL 4</option>
            </optgroup>
            <optgroup label="Kelas XII (Dua Belas)">
              <option value="XII RPL 1" selected={user.class_name === 'XII RPL 1'}>XII RPL 1</option>
              <option value="XII RPL 2" selected={user.class_name === 'XII RPL 2'}>XII RPL 2</option>
              <option value="XII RPL 3" selected={user.class_name === 'XII RPL 3'}>XII RPL 3</option>
              <option value="XII RPL 4" selected={user.class_name === 'XII RPL 4'}>XII RPL 4</option>
            </optgroup>
            <option value="CUSTOM" selected={!!user.class_name && !['X RPL 1', 'X RPL 2', 'X RPL 3', 'X RPL 4', 'XI RPL 1', 'XI RPL 2', 'XI RPL 3', 'XI RPL 4', 'XII RPL 1', 'XII RPL 2', 'XII RPL 3', 'XII RPL 4'].includes(user.class_name)}>Lainnya (Ketik Manual...)</option>
          </select>
          <input
            type="text"
            id="edit-class-custom"
            name="class_name_custom"
            value={user.class_name || ''}
            placeholder="Contoh: XI PPLG 5 / Kelas Khusus"
            style="display: none; margin-top: 0.5rem;"
          />
        </div>

        <div class="form-group">
          <label for="edit-password">Password Baru (Opsional)</label>
          <input
            type="password"
            id="edit-password"
            name="password"
            placeholder="Biarkan kosong jika tidak ingin mengubah password"
            autocomplete="new-password"
          />
        </div>

        <div class="modal-footer">
          <button id="cancel-modal-btn" class="btn btn-secondary" type="button">Batal</button>
          <button type="submit" id="save-profile-btn" class="btn btn-primary">
            <span class="btn-text">Simpan Perubahan</span>
            <span class="btn-spinner" style="display: none;">Memproses...</span>
          </button>
        </div>
      </form>
    </div>
  </div>

  <!-- Modal Access Code / Enroll Mata Pelajaran -->
  <div id="enroll-access-modal" class="modal-backdrop" style="display: none;">
    <div class="modal-card glass-card">
      <div class="modal-header">
        <div class="modal-title-group">
          <div class="modal-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </div>
          <div>
            <h2 class="modal-title">Enroll Mata Pelajaran</h2>
            <p class="modal-sub">Masukkan kode akses dari Guru untuk mendaftar dan membuka mata pelajaran ini.</p>
          </div>
        </div>
        <button id="close-enroll-modal-btn" class="modal-close" type="button" aria-label="Tutup Modal">&times;</button>
      </div>

      <div id="enroll-error-banner" class="alert alert-error" style="display: none;"></div>
      <div id="enroll-success-banner" class="alert alert-success" style="display: none;"></div>

      <form id="enroll-access-form" class="modal-form">
        <input type="hidden" id="enroll-course-id" name="courseId" value="" />
        <div class="form-group">
          <label for="enroll-course-title">Mata Pelajaran</label>
          <input
            type="text"
            id="enroll-course-title"
            readonly
            class="form-input-readonly"
          />
        </div>

        <div class="form-group">
          <label for="enroll-access-code">Kode Akses dari Guru</label>
          <input
            type="text"
            id="enroll-access-code"
            name="accessCode"
            placeholder="Contoh: INFORMATIKA2026 atau RPL2026"
            required
            autocomplete="off"
          />
        </div>

        <div class="modal-footer">
          <button id="cancel-enroll-modal-btn" class="btn btn-secondary" type="button">Batal</button>
          <button type="submit" id="save-enroll-btn" class="btn btn-primary">
            <span class="btn-text">Verifikasi &amp; Enroll</span>
            <span class="btn-spinner" style="display: none;">Memproses...</span>
          </button>
        </div>
      </form>
    </div>
  </div>
  </div>
</MainLayout>

<script>
  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    try {
      await fetch('/api/auth/logout', { method: 'POST' });
      window.location.href = '/auth/login';
    } catch (err) {
      console.error('Logout error:', err);
    }
  });

  // Modal Edit Profil Handlers
  const openModalBtn = document.getElementById('open-edit-profile-btn');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const cancelModalBtn = document.getElementById('cancel-modal-btn');
  const editProfileModal = document.getElementById('edit-profile-modal');
  const editProfileForm = document.getElementById('edit-profile-form') as HTMLFormElement | null;
  const classSelect = document.getElementById('edit-class-select') as HTMLSelectElement | null;
  const classCustomInput = document.getElementById('edit-class-custom') as HTMLInputElement | null;

  if (classSelect && classCustomInput) {
    function checkCustomClass() {
      if (classSelect && classCustomInput) {
        if (classSelect.value === 'CUSTOM') {
          classCustomInput.style.display = 'block';
        } else {
          classCustomInput.style.display = 'none';
        }
      }
    }
    classSelect.addEventListener('change', checkCustomClass);
    checkCustomClass();
  }

  function toggleModal(show: boolean) {
    if (editProfileModal) {
      editProfileModal.style.display = show ? 'flex' : 'none';
    }
  }

  openModalBtn?.addEventListener('click', () => toggleModal(true));
  closeModalBtn?.addEventListener('click', () => toggleModal(false));
  cancelModalBtn?.addEventListener('click', () => toggleModal(false));

  editProfileModal?.addEventListener('click', (e) => {
    if (e.target === editProfileModal) {
      toggleModal(false);
    }
  });

  editProfileForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorBanner = document.getElementById('profile-error-banner');
    const successBanner = document.getElementById('profile-success-banner');
    const saveBtn = document.getElementById('save-profile-btn') as HTMLButtonElement | null;
    const nameInput = document.getElementById('edit-name') as HTMLInputElement | null;
    const passwordInput = document.getElementById('edit-password') as HTMLInputElement | null;

    if (errorBanner) errorBanner.style.display = 'none';
    if (successBanner) successBanner.style.display = 'none';

    let finalClassName = classSelect?.value || '';
    if (finalClassName === 'CUSTOM') {
      finalClassName = classCustomInput?.value.trim() || '';
    }

    const payload = {
      name: nameInput?.value.trim(),
      class_name: finalClassName,
      password: passwordInput?.value || ''
    };

    if (saveBtn) saveBtn.disabled = true;

    try {
      const res = await fetch('/api/user/profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal menyimpan profil.');

      if (successBanner) {
        successBanner.innerText = data.message || 'Profil berhasil diperbarui!';
        successBanner.style.display = 'block';
      }

      setTimeout(() => {
        window.location.reload();
      }, 800);
    } catch (err: any) {
      if (errorBanner) {
        errorBanner.innerText = err.message || 'Terjadi kesalahan.';
        errorBanner.style.display = 'block';
      }
      if (saveBtn) saveBtn.disabled = false;
    }
  });

  // Modal Enroll Modul Handlers
  const enrollModal = document.getElementById('enroll-access-modal');
  const closeEnrollModalBtn = document.getElementById('close-enroll-modal-btn');
  const cancelEnrollModalBtn = document.getElementById('cancel-enroll-modal-btn');
  const enrollForm = document.getElementById('enroll-access-form') as HTMLFormElement | null;
  const enrollCourseIdInput = document.getElementById('enroll-course-id') as HTMLInputElement | null;
  const enrollCourseTitleInput = document.getElementById('enroll-course-title') as HTMLInputElement | null;
  const enrollCodeInput = document.getElementById('enroll-access-code') as HTMLInputElement | null;
  const enrollErrorBanner = document.getElementById('enroll-error-banner');
  const enrollSuccessBanner = document.getElementById('enroll-success-banner');

  document.querySelectorAll('.btn-enroll-trigger').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      const target = e.currentTarget as HTMLButtonElement;
      const courseId = target.getAttribute('data-course-id') || '';
      const courseTitle = target.getAttribute('data-course-title') || '';

      if (enrollCourseIdInput) enrollCourseIdInput.value = courseId;
      if (enrollCourseTitleInput) enrollCourseTitleInput.value = courseTitle;
      if (enrollCodeInput) enrollCodeInput.value = '';
      if (enrollErrorBanner) enrollErrorBanner.style.display = 'none';
      if (enrollSuccessBanner) enrollSuccessBanner.style.display = 'none';

      if (enrollModal) enrollModal.style.display = 'flex';
    });
  });

  function toggleEnrollModal(show: boolean) {
    if (enrollModal) enrollModal.style.display = show ? 'flex' : 'none';
  }

  closeEnrollModalBtn?.addEventListener('click', () => toggleEnrollModal(false));
  cancelEnrollModalBtn?.addEventListener('click', () => toggleEnrollModal(false));
  enrollModal?.addEventListener('click', (e) => {
    if (e.target === enrollModal) toggleEnrollModal(false);
  });

  enrollForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const saveBtn = document.getElementById('save-enroll-btn') as HTMLButtonElement | null;
    if (enrollErrorBanner) enrollErrorBanner.style.display = 'none';
    if (enrollSuccessBanner) enrollSuccessBanner.style.display = 'none';

    const courseId = enrollCourseIdInput?.value || '';
    const accessCode = enrollCodeInput?.value || '';

    if (saveBtn) saveBtn.disabled = true;

    try {
      const res = await fetch('/api/courses/enroll', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ subjectId: courseId, accessCode })
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || 'Gagal mendaftar Mata Pelajaran.');

      if (enrollSuccessBanner) {
        enrollSuccessBanner.innerText = data.message || 'Berhasil terdaftar pada Mata Pelajaran!';
        enrollSuccessBanner.style.display = 'block';
      }

      setTimeout(() => {
        window.location.reload();
      }, 800);
    } catch (err: any) {
      if (enrollErrorBanner) {
        enrollErrorBanner.innerText = err.message || 'Terjadi kesalahan.';
        enrollErrorBanner.style.display = 'block';
      }
      if (saveBtn) saveBtn.disabled = false;
    }
  });
</script>

<style>
  .dash-wrapper {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  /* Profile Card */
  .profile-card {
    padding: 1.75rem 2rem;
  }

  .profile-inner {
    display: flex;
    align-items: center;
