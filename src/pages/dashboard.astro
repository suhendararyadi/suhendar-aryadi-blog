---
import MainLayout from '../layouts/MainLayout.astro';
import { getSessionUser } from '../lib/auth';
import { seedLessons } from '../lib/seedLessons';
import { query } from '../lib/db';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login');
}

if (user.role !== 'admin' && user.role !== 'teacher' && (!user.class_name || user.class_name.trim() === '')) {
  Astro.cookies.delete('session_id', { path: '/' });
  return Astro.redirect('/auth/login?reason=missing_class');
}

let completedModules: any[] = [];
let topLeaderboard: any[] = [];
let totalLessonsCount = seedLessons.length;
let userRankPosition = 1;
let totalStudentsCount = 1;
let userClassRankPosition = 1;
let classStudentsCount = 1;

try {
  const lessonsRes = await query('SELECT COUNT(*) as count FROM sql_lessons');
  if (lessonsRes.rows && lessonsRes.rows[0]?.count) {
    const parsed = parseInt(lessonsRes.rows[0].count, 10);
    if (parsed > 0) totalLessonsCount = parsed;
  }

  const progressRes = await query(
    `SELECT up.id, up.lesson_id, up.status, up.submitted_code, up.completed_at,
            sl.slug, sl.title, sl.category, sl.path_id, sl.order_index
     FROM user_progress up
     JOIN sql_lessons sl ON up.lesson_id = sl.id
     WHERE up.user_id = $1 AND up.status = 'completed'
     ORDER BY up.completed_at DESC`,
    [user.id]
  );
  completedModules = progressRes.rows;

  const rankRes = await query(
    `WITH user_ranks AS (
       SELECT u.id, u.name, u.role, u.class_name,
              COUNT(DISTINCT up.lesson_id) as completed_count,
              ROW_NUMBER() OVER (ORDER BY COUNT(DISTINCT up.lesson_id) DESC, u.id ASC) as overall_rank,
              ROW_NUMBER() OVER (PARTITION BY u.class_name ORDER BY COUNT(DISTINCT up.lesson_id) DESC, u.id ASC) as class_rank
       FROM users u
       LEFT JOIN user_progress up ON u.id = up.user_id AND up.status = 'completed'
       GROUP BY u.id, u.name, u.role, u.class_name
     )
     SELECT * FROM user_ranks ORDER BY overall_rank ASC`
  );

  if (rankRes.rows && rankRes.rows.length > 0) {
    totalStudentsCount = rankRes.rows.length;
    const myRankRow = rankRes.rows.find((r: any) => r.id === user.id);
    if (myRankRow) {
      userRankPosition = parseInt(myRankRow.overall_rank, 10);
      userClassRankPosition = parseInt(myRankRow.class_rank, 10);
    }
    if (user.class_name) {
      classStudentsCount = rankRes.rows.filter((r: any) => r.class_name === user.class_name).length;
    }
    topLeaderboard = rankRes.rows.slice(0, 5).map((r: any) => {
      const count = parseInt(r.completed_count || '0', 10);
      const pct = totalLessonsCount > 0 ? Math.round((count / totalLessonsCount) * 100) : 0;
      return { ...r, count, pct, rank: parseInt(r.overall_rank, 10) };
    });
  }
} catch (err) {
  console.warn('Could not fetch dashboard progress from database:', err);
}

// Fetch BK (LKPD 1 & LKPD 2) and TIK LKPD Submissions and Course Enrollments
let bkSubmission: any = null;
let flowchartSubmission: any = null;
let tikSubmission: any = null;
let enrolledSubjectIds: string[] = [];

try {
  const bkRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (bkRes.rows && bkRes.rows.length > 0) {
    bkSubmission = bkRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch BK submission:', err);
}

try {
  const flowRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_flowchart_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (flowRes.rows && flowRes.rows.length > 0) {
    flowchartSubmission = flowRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch Flowchart submission:', err);
}

try {
  const tikRes = await query(
    `SELECT score, teacher_feedback, updated_at FROM lkpd_tik_submissions WHERE user_id = $1 ORDER BY updated_at DESC LIMIT 1`,
    [user.id]
  );
  if (tikRes.rows && tikRes.rows.length > 0) {
    tikSubmission = tikRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch TIK submission:', err);
}

// Fetch SQL Try Out Submissions
let sqlTryoutSubmission: any = null;
try {
  const tryoutRes = await query(
    `SELECT score, correct_answers, total_questions, duration_seconds, created_at 
     FROM sql_tryout_submissions 
     WHERE user_id = $1 
     ORDER BY created_at DESC 
     LIMIT 1`,
    [user.id]
  );
  if (tryoutRes.rows && tryoutRes.rows.length > 0) {
    sqlTryoutSubmission = tryoutRes.rows[0];
  }
} catch (err) {
  console.warn('Could not fetch SQL tryout submission:', err);
}

// Auto-sync existing student progress to course_enrollments
try {
  if (bkSubmission || flowchartSubmission || tikSubmission) {
    await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'informatika') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]);
  }
  if (completedModules.length > 0 || sqlTryoutSubmission) {
    await query(`INSERT INTO course_enrollments (user_id, course_id) VALUES ($1, 'rpl_web_sql') ON CONFLICT (user_id, course_id) DO NOTHING`, [user.id]);
  }
} catch (err) {
  console.warn('Auto sync enrollments warning:', err);
}

try {
  const enrollRes = await query(
    `SELECT course_id FROM course_enrollments WHERE user_id = $1`,
    [user.id]
  );
  if (enrollRes.rows) {
    enrolledSubjectIds = enrollRes.rows.map((r: any) => String(r.course_id).toLowerCase());
  }
} catch (err) {
  console.warn('Could not fetch course_enrollments:', err);
}

const isInformatikaEnrolled = enrolledSubjectIds.includes('informatika') || enrolledSubjectIds.includes('bk') || enrolledSubjectIds.includes('tik') || !!bkSubmission || !!flowchartSubmission || !!tikSubmission;
const isRplSqlEnrolled = enrolledSubjectIds.includes('rpl_web_sql') || enrolledSubjectIds.includes('sql') || completedModules.length > 0;

const completedCount = completedModules.length;
const completionPercentage = totalLessonsCount > 0 ? Math.round((completedCount / totalLessonsCount) * 100) : 0;

// 4-Tier Rank System
let rankInfo = { title: 'SQL Novice', badgeClass: 'm3-chip-tonal-secondary' };
if (completedCount >= 40) {
  rankInfo = { title: 'Master SQL Engineer', badgeClass: 'm3-chip-tonal-success' };
} else if (completedCount >= 25) {
  rankInfo = { title: 'SQL Advanced', badgeClass: 'm3-chip-tonal-primary' };
} else if (completedCount >= 11) {
  rankInfo = { title: 'SQL Intermediate', badgeClass: 'm3-chip-tonal-tertiary' };
}

// Calculate Scores & Average Grade for Informatika
let bkScore: number | null = bkSubmission && bkSubmission.score !== null && bkSubmission.score !== undefined ? parseInt(bkSubmission.score, 10) : null;
let flowScore: number | null = flowchartSubmission && flowchartSubmission.score !== null && flowchartSubmission.score !== undefined ? parseInt(flowchartSubmission.score, 10) : null;
let tikScore: number | null = tikSubmission && tikSubmission.score !== null && tikSubmission.score !== undefined ? parseInt(tikSubmission.score, 10) : null;

const activeScores = [bkScore, flowScore, tikScore].filter((s): s is number => s !== null && !isNaN(s));
let avgScore: number | null = null;
if (activeScores.length > 0) {
  const sum = activeScores.reduce((a, b) => a + b, 0);
  const rawAvg = sum / activeScores.length;
  avgScore = Number.isInteger(rawAvg) ? rawAvg : Math.round(rawAvg * 10) / 10;
}

const avgScoreText = avgScore !== null ? `${avgScore} / 100` : 'Belum Ada Nilai';
const avgScoreColor = avgScore !== null ? (avgScore >= 75 ? 'var(--m3-success)' : 'var(--m3-warning)') : 'var(--m3-outline)';

const bkScoreText = bkSubmission
  ? (bkScore !== null ? `${bkScore} / 100` : 'Menunggu Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const bkScoreColor = bkSubmission && bkScore !== null
  ? (bkScore >= 75 ? 'var(--m3-success)' : 'var(--m3-warning)')
  : (bkSubmission ? 'var(--m3-primary)' : 'var(--m3-outline)');
const bkFeedbackText = bkSubmission?.teacher_feedback ? `Catatan: "${bkSubmission.teacher_feedback}"` : null;

const flowScoreText = flowchartSubmission
  ? (flowScore !== null ? `${flowScore} / 100` : 'Menunggu Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const flowScoreColor = flowchartSubmission && flowScore !== null
  ? (flowScore >= 75 ? 'var(--m3-success)' : 'var(--m3-warning)')
  : (flowchartSubmission ? 'var(--m3-primary)' : 'var(--m3-outline)');
const flowFeedbackText = flowchartSubmission?.teacher_feedback ? `Catatan: "${flowchartSubmission.teacher_feedback}"` : null;

const tikScoreText = tikSubmission
  ? (tikScore !== null ? `${tikScore} / 100` : 'Menunggu Dinilai')
  : (isInformatikaEnrolled ? 'Belum Mengerjakan' : 'Terkunci');
const tikScoreColor = tikSubmission && tikScore !== null
  ? (tikScore >= 75 ? 'var(--m3-success)' : 'var(--m3-warning)')
  : (tikSubmission ? 'var(--m3-primary)' : 'var(--m3-outline)');
const tikFeedbackText = tikSubmission?.teacher_feedback ? `Catatan: "${tikSubmission.teacher_feedback}"` : null;

interface PathDefinition {
  id: 'basics' | 'aggregates' | 'joins' | 'grouping' | 'ddl_security';
  title: string;
  total: number;
  accentVar: string;
  description: string;
}

const LEARNING_PATHS: PathDefinition[] = [
  { id: 'basics', title: 'SQL Basics', total: 10, accentVar: '#10b981', description: 'SELECT, WHERE, ORDER BY, INSERT, UPDATE, DELETE' },
  { id: 'aggregates', title: 'Aggregates & Functions', total: 8, accentVar: '#f59e0b', description: 'COUNT, SUM, AVG, MIN, MAX, LIKE, IN, BETWEEN' },
  { id: 'joins', title: 'Joins & Relasi Tabel', total: 6, accentVar: '#0ea5e9', description: 'INNER, LEFT, RIGHT, FULL, SELF JOIN' },
  { id: 'grouping', title: 'Grouping & Subqueries', total: 6, accentVar: '#a855f7', description: 'GROUP BY, HAVING, EXISTS, ANY/ALL, CASE' },
  { id: 'ddl_security', title: 'DDL, Constraints & Security', total: 10, accentVar: '#f97316', description: 'CREATE, ALTER, DROP, PK, FK, VIEW, SQL Injection' },
];

const pathCompletedCounts: Record<string, number> = { basics: 0, aggregates: 0, joins: 0, grouping: 0, ddl_security: 0 };
completedModules.forEach((item) => {
  const lesson = seedLessons.find((l) => l.id === item.lesson_id);
  const pathId = item.path_id || lesson?.path_id || 'basics';
  if (pathCompletedCounts[pathId] !== undefined) pathCompletedCounts[pathId]++;
});

const pathAnalytics = LEARNING_PATHS.map((path) => {
  const completed = pathCompletedCounts[path.id] || 0;
  const percentage = path.total > 0 ? Math.round((completed / path.total) * 100) : 0;
  return { ...path, completed, percentage };
});

const isTeacherOrAdmin = user.role === 'teacher' || user.role === 'admin' || (user.email && user.email.toLowerCase().includes('suhendar'));
---

<MainLayout 
  title={`Dashboard — ${user.name} | Suhendar Aryadi`}
  description="Dashboard progres belajar siswa. Lihat statistik hasil belajar, nilai LKPD, dan Try Out CBT."
>
  <div class="m3-dash-container">

    <!-- 1. Profile Header Card -->
    <div class="m3-card m3-card-elevated dash-profile-card">
      <div class="dash-profile-main">
        <div class="m3-avatar">
          {user.name.charAt(0).toUpperCase()}
        </div>
        <div class="dash-profile-text">
          <div class="dash-name-cluster">
            <h1 class="dash-student-name">{user.name}</h1>
            <span class="m3-chip m3-chip-tonal-secondary dash-class-chip">
              <span class="material-symbols-rounded icon-xs">badge</span>
              {user.class_name || 'Kelas Belum Diisi'}
            </span>
          </div>
          <p class="dash-student-email text-m3-muted">{user.email}</p>
          <div class="dash-badges-row">
            <span class="m3-chip m3-chip-tonal-primary">
              <span class="material-symbols-rounded icon-xs">school</span>
              {user.role === 'admin' ? 'ADMIN' : (user.role === 'teacher' ? 'GURU' : 'SISWA')}
            </span>
            <span class="m3-chip m3-chip-tonal-tertiary">
              <span class="material-symbols-rounded icon-xs">emoji_events</span>
              Peringkat #{userRankPosition}
            </span>
            <span class={`m3-chip ${rankInfo.badgeClass}`}>
              <span class="material-symbols-rounded icon-xs">military_tech</span>
              {rankInfo.title}
            </span>
          </div>
        </div>
      </div>
      <div class="dash-profile-actions">
        {isTeacherOrAdmin && (
          <a href="/admin/dashboard" class="m3-btn m3-btn-filled btn-sm">
            <span class="material-symbols-rounded icon-sm">admin_panel_settings</span>
            Portal Guru
          </a>
        )}
        <button id="open-edit-profile-btn" class="m3-btn m3-btn-outlined btn-sm" type="button">
          <span class="material-symbols-rounded icon-sm">edit</span>
          Edit Profil
        </button>
        <a href="/belajar/leaderboard" class="m3-btn m3-btn-outlined btn-sm">
          <span class="material-symbols-rounded icon-sm">leaderboard</span>
          Leaderboard
        </a>
        {(completedCount >= totalLessonsCount || isTeacherOrAdmin) && (
          <a href="/sertifikat/sql" class="m3-btn m3-btn-outlined btn-sm">
            <span class="material-symbols-rounded icon-sm">workspace_premium</span>
            Sertifikat
          </a>
        )}
        <button id="logout-btn" class="m3-btn m3-btn-text btn-sm" type="button">
          <span class="material-symbols-rounded icon-sm">logout</span>
          Keluar
        </button>
      </div>
    </div>

    <!-- 2. KPI Overview (3 Columns) -->
    <div class="dash-kpi-grid">
      <!-- KPI 1: Informatika LKPD Average -->
      <div class="m3-card m3-card-elevated kpi-card">
        <div class="kpi-top">
          <span class="kpi-label">Nilai Rata-Rata Informatika</span>
          <span class="material-symbols-rounded icon-md text-m3-primary">psychology</span>
        </div>
        <div class="kpi-value" style={`color: ${avgScoreColor};`}>
          {avgScoreText}
        </div>
        <p class="kpi-caption text-m3-muted">
          {activeScores.length} dari 3 LKPD dinilai
        </p>
      </div>

      <!-- KPI 2: SQL Modules Progress -->
      <div class="m3-card m3-card-elevated kpi-card">
        <div class="kpi-top">
          <span class="kpi-label">Progres SQL Masterclass</span>
          <span class="material-symbols-rounded icon-md text-m3-secondary">database</span>
        </div>
        <div class="kpi-value text-m3-primary">
          {completedCount} <span class="kpi-unit text-m3-muted">/ {totalLessonsCount} Modul</span>
        </div>
        <div class="m3-linear-progress margin-top-xs">
          <div class="m3-progress-fill" style={`width: ${completionPercentage}%;`}></div>
        </div>
        <p class="kpi-caption text-m3-muted margin-top-xs">
          {completionPercentage}% kurikulum tuntas
        </p>
      </div>

      <!-- KPI 3: Try Out CBT Score -->
      <div class="m3-card m3-card-elevated kpi-card">
        <div class="kpi-top">
          <span class="kpi-label">Hasil Try Out CBT SQL</span>
          <span class="material-symbols-rounded icon-md text-m3-tertiary">quiz</span>
        </div>
        <div class="kpi-value" style={sqlTryoutSubmission ? (sqlTryoutSubmission.score >= 75 ? 'color: var(--m3-success);' : 'color: var(--m3-warning);') : 'color: var(--m3-outline);'}>
          {sqlTryoutSubmission ? `${sqlTryoutSubmission.score} / 100` : 'Belum Ujian'}
        </div>
        <p class="kpi-caption text-m3-muted">
          {sqlTryoutSubmission ? `Benar ${sqlTryoutSubmission.correct_answers}/${sqlTryoutSubmission.total_questions} (${sqlTryoutSubmission.score >= 75 ? 'Tuntas' : 'Remedial'})` : '25 butir soal evaluasi'}
        </p>
      </div>
    </div>

    <!-- 3. Mata Pelajaran Cards (Informatika & SQL RPL) -->
    <div class="dash-subjects-grid">
      <!-- Subject 1: Informatika (Fase E) -->
      <div class="m3-card m3-card-elevated subject-panel-card">
        <div class="subject-panel-header">
          <div class="subject-header-info">
            <div class="subject-icon-box bg-primary-container text-m3-primary">
              <span class="material-symbols-rounded icon-md">memory</span>
            </div>
            <div>
              <h2 class="subject-title">Informatika (Fase E)</h2>
            </div>
          </div>
          <span class={`m3-chip ${isInformatikaEnrolled ? 'm3-chip-tonal-success' : 'm3-chip-tonal-warning'}`}>
            <span class="material-symbols-rounded icon-xs">{isInformatikaEnrolled ? 'check_circle' : 'lock'}</span>
            {isInformatikaEnrolled ? 'Terdaftar' : 'Belum Terdaftar'}
          </span>
        </div>

        <div class="lkpd-list">
          <!-- LKPD 1 Item -->
          <div class="lkpd-row-card">
            <div class="lkpd-row-main">
              <span class="m3-chip m3-chip-tonal-primary lkpd-chip">BK 1</span>
              <div class="lkpd-info">
                <h4 class="lkpd-title">4 Pilar Berpikir Komputasional</h4>
                {bkFeedbackText && <p class="lkpd-note text-m3-muted">{bkFeedbackText}</p>}
              </div>
            </div>
            <div class="lkpd-row-score">
              <span class="lkpd-score-badge" style={`color: ${bkScoreColor};`}>{bkScoreText}</span>
              <a href="/belajar/informatika/bk/lkpd" class="m3-btn m3-btn-tonal btn-sm">
                <span>Buka</span>
                <span class="material-symbols-rounded icon-xs">arrow_forward</span>
              </a>
            </div>
          </div>

          <!-- LKPD 2 Item -->
          <div class="lkpd-row-card">
            <div class="lkpd-row-main">
              <span class="m3-chip m3-chip-tonal-primary lkpd-chip">BK 2</span>
              <div class="lkpd-info">
                <h4 class="lkpd-title">Perancangan Algoritma &amp; Flowchart</h4>
                {flowFeedbackText && <p class="lkpd-note text-m3-muted">{flowFeedbackText}</p>}
              </div>
            </div>
            <div class="lkpd-row-score">
              <span class="lkpd-score-badge" style={`color: ${flowScoreColor};`}>{flowScoreText}</span>
              <a href="/belajar/informatika/bk/lkpd-2" class="m3-btn m3-btn-tonal btn-sm">
                <span>Buka</span>
                <span class="material-symbols-rounded icon-xs">arrow_forward</span>
              </a>
            </div>
          </div>

          <!-- LKPD TIK Item -->
          <div class="lkpd-row-card">
            <div class="lkpd-row-main">
              <span class="m3-chip m3-chip-tonal-tertiary lkpd-chip">TIK</span>
              <div class="lkpd-info">
                <h4 class="lkpd-title">Mail Merge &amp; Search Engine</h4>
                {tikFeedbackText && <p class="lkpd-note text-m3-muted">{tikFeedbackText}</p>}
              </div>
            </div>
            <div class="lkpd-row-score">
              <span class="lkpd-score-badge" style={`color: ${tikScoreColor};`}>{tikScoreText}</span>
              <a href="/belajar/informatika/tik/lkpd" class="m3-btn m3-btn-tonal btn-sm">
                <span>Buka</span>
                <span class="material-symbols-rounded icon-xs">arrow_forward</span>
              </a>
            </div>
          </div>
        </div>

        <div class="subject-panel-footer">
          {isInformatikaEnrolled ? (
            <a href="/belajar/informatika" class="m3-btn m3-btn-outlined btn-sm full-width">
              <span>Buka Materi Informatika</span>
              <span class="material-symbols-rounded icon-sm">arrow_forward</span>
            </a>
          ) : (
            <button
              type="button"
              class="m3-btn m3-btn-tonal-primary btn-sm full-width btn-enroll-trigger"
              data-course-id="informatika"
              data-course-title="Mata Pelajaran: Informatika SMK (Fase E)"
            >
              <span class="material-symbols-rounded icon-sm">key</span>
              <span>Enroll Mata Pelajaran</span>
            </button>
          )}
        </div>
      </div>

      <!-- Subject 2: Pemrograman Web & Basis Data (RPL) -->
      <div class="m3-card m3-card-elevated subject-panel-card">
        <div class="subject-panel-header">
          <div class="subject-header-info">
            <div class="subject-icon-box bg-secondary-container text-m3-secondary">
              <span class="material-symbols-rounded icon-md">database</span>
            </div>
            <div>
              <h2 class="subject-title">Web &amp; Basis Data (RPL)</h2>
            </div>
          </div>
          <span class={`m3-chip ${isRplSqlEnrolled ? 'm3-chip-tonal-success' : 'm3-chip-tonal-warning'}`}>
            <span class="material-symbols-rounded icon-xs">{isRplSqlEnrolled ? 'check_circle' : 'lock'}</span>
            {isRplSqlEnrolled ? 'Terdaftar' : 'Belum Terdaftar'}
          </span>
        </div>

        <div class="sql-paths-overview">
          <div class="sql-paths-compact-grid">
            {pathAnalytics.map((path) => (
              <div class="sql-path-item">
                <div class="sql-path-name">
                  <span class="m3-body-small font-medium">{path.title}</span>
                  <span class="m3-body-small text-m3-muted font-mono">{path.completed}/{path.total}</span>
                </div>
                <div class="m3-linear-progress-sm">
                  <div class="m3-progress-fill" style={`width: ${path.percentage}%; background: ${path.accentVar};`}></div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="cbt-tryout-box">
          <div class="cbt-box-content">
            <div class="cbt-box-header">
              <span class="material-symbols-rounded icon-md text-m3-primary">quiz</span>
              <div>
                <strong class="cbt-title">Try Out CBT SQL</strong>
                <p class="cbt-desc text-m3-muted">25 Butir Soal • Evaluasi Instan</p>
              </div>
            </div>
            <a href="/belajar/sql/tryout" class="m3-btn m3-btn-filled btn-sm">
              <span>{sqlTryoutSubmission ? 'Review Soal' : 'Mulai Ujian'}</span>
              <span class="material-symbols-rounded icon-sm">play_arrow</span>
            </a>
          </div>
        </div>

        <div class="subject-panel-footer">
          {isRplSqlEnrolled ? (
            <a href="/belajar/sql" class="m3-btn m3-btn-outlined btn-sm full-width">
              <span>Buka SQL Masterclass</span>
              <span class="material-symbols-rounded icon-sm">arrow_forward</span>
            </a>
          ) : (
            <button
              type="button"
              class="m3-btn m3-btn-tonal-primary btn-sm full-width btn-enroll-trigger"
              data-course-id="rpl_web_sql"
              data-course-title="Mata Pelajaran: Pemrograman Web & Basis Data (RPL)"
            >
              <span class="material-symbols-rounded icon-sm">key</span>
              <span>Enroll Mata Pelajaran</span>
            </button>
          )}
        </div>
      </div>
    </div>

    <!-- 4. Riwayat Modul Selesai (Recent History) -->
    <div class="m3-card m3-card-elevated dash-history-card">
      <div class="history-card-header">
        <h3 class="m3-title-large">Riwayat Modul SQL Terakhir</h3>
        <a href="/belajar/sql" class="m3-btn m3-btn-text btn-sm">Lihat Semua Modul &rarr;</a>
      </div>

      {completedModules.length > 0 ? (
        <div class="table-wrap margin-top-sm">
          <table class="m3-table">
            <thead>
              <tr>
                <th>Modul</th>
                <th>Kategori</th>
                <th>Tanggal Selesai</th>
                <th>Query SQL</th>
                <th>Aksi</th>
              </tr>
            </thead>
            <tbody>
