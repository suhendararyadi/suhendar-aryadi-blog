---
import MainLayout from '../../layouts/MainLayout.astro';
import { getSessionUser } from '../../lib/auth';
import { query } from '../../lib/db';
import { seedLessons } from '../../lib/seedLessons';

const sessionId = Astro.cookies.get('session_id')?.value;
const user = await getSessionUser(sessionId);

if (!user) {
  return Astro.redirect('/auth/login?redirect=/sertifikat/sql');
}

const isTeacherOrAdmin = user.role === 'teacher' || user.role === 'admin' || (user.email && user.email.toLowerCase().includes('suhendar'));
const totalLessonsCount = seedLessons.length || 40;

let completedCount = 0;
try {
  const progressRes = await query(
    `SELECT COUNT(id) as count FROM user_progress WHERE user_id = $1 AND status = 'completed'`,
    [user.id]
  );
  if (progressRes.rows && progressRes.rows[0]) {
    completedCount = parseInt(progressRes.rows[0].count || '0', 10);
  }
} catch (err) {
  console.warn('Error fetching completion count for certificate:', err);
}

const isEligible = completedCount >= totalLessonsCount || isTeacherOrAdmin;
const issueDate = new Date().toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'long',
  year: 'numeric'
});
const certNumber = `CERT-SQL-2026-${user.id.toString().padStart(4, '0')}`;
---

<MainLayout
  title={`Sertifikat Kelulusan SQL — ${user.name} | Suhendar Aryadi`}
  description="Sertifikat Digital Kelulusan Kompetensi Pemrograman Basis Data (SQL) Interaktif 40 Modul."
>
  <div class="cert-page-container">
    {!isEligible ? (
      <div class="locked-cert-card glass-card">
        <div class="locked-icon-wrap">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
            <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
          </svg>
        </div>
        <h1 class="locked-title">Sertifikat Belum Dapat Diterbitkan</h1>
        <p class="locked-desc">
          Sertifikat Kelulusan SQL hanya diberikan setelah Anda menguasai dan menyelesaikan seluruh <strong>{totalLessonsCount} Modul SQL</strong>.
        </p>
        <div class="progress-box">
          <div class="progress-text">
            <span>Progres Anda: <strong>{completedCount} / {totalLessonsCount} Modul</strong></span>
            <span>{Math.round((completedCount / totalLessonsCount) * 100)}%</span>
          </div>
          <div class="progress-bar-track">
            <div class="progress-bar-fill" style={`width: ${Math.round((completedCount / totalLessonsCount) * 100)}%`}></div>
          </div>
        </div>
        <div class="locked-actions">
          <a href="/belajar/sql" class="btn btn-primary">Lanjutkan Belajar SQL &rarr;</a>
          <a href="/dashboard" class="btn btn-secondary">Kembali ke Dashboard</a>
        </div>
      </div>
    ) : (
      <div class="cert-wrapper">
        <!-- Control Actions (Hidden on print) -->
        <div class="cert-actions-bar no-print">
          <a href="/dashboard" class="btn btn-secondary btn-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="19" y1="12" x2="5" y2="12"></line>
              <polyline points="12 19 5 12 12 5"></polyline>
            </svg>
            <span>Dashboard</span>
          </a>
          <button id="print-cert-btn" class="btn btn-primary btn-sm" type="button">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            <span>Cetak / Simpan PDF</span>
          </button>
        </div>

        {isTeacherOrAdmin && completedCount < totalLessonsCount && (
          <div class="teacher-cert-note no-print">
            <span>💡 <strong>Mode Pratinjau Guru</strong>: Sertifikat ini ditampilkan sebagai pratinjau format sertifikat resmi siswa.</span>
          </div>
        )}

        <!-- Certificate Document Body -->
        <div class="certificate-paper" id="certificate-document">
          <div class="cert-border-outer">
            <div class="cert-border-inner">

              <!-- Watermark Background -->
              <div class="cert-watermark">SQL</div>

              <!-- Header -->
              <div class="cert-header">
                <div class="cert-logo">
                  <div class="logo-badge">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <polyline points="16 18 22 12 16 6"></polyline>
                      <polyline points="8 6 2 12 8 18"></polyline>
                    </svg>
                  </div>
                  <span class="logo-title">SUHENDAR ARYADI — SMK RPL</span>
                </div>
                <div class="cert-no">No. Reg: <strong>{certNumber}</strong></div>
              </div>

              <!-- Title -->
              <div class="cert-body">
                <h1 class="cert-main-title">SERTIFIKAT KELULUSAN KOMPETENSI</h1>
                <p class="cert-subtitle">Diberikan secara resmi kepada:</p>

                <div class="student-name-box">
                  <h2 class="student-name">{user.name}</h2>
                  <div class="student-class">{user.class_name ? `Kelas: ${user.class_name}` : 'Siswa Rekayasa Perangkat Lunak (RPL)'}</div>
                </div>

                <p class="cert-statement">
                  Atas keberhasilan dan ketuntasan menguasai seluruh <strong>{totalLessonsCount} Modul Kurikulum Pemrograman Basis Data (SQL) Interaktif</strong> dengan predikat kelulusan:
                </p>

                <div class="rank-achievement">
                  <span class="achievement-badge">MASTER SQL ENGINEER (100% TUNTAS)</span>
                </div>

                <div class="skills-grid">
                  <span class="skill-chip">SELECT &amp; Data Filtering</span>
                  <span class="skill-chip">INNER / LEFT / RIGHT JOINs</span>
                  <span class="skill-chip">Aggregate &amp; Subqueries</span>
                  <span class="skill-chip">Data Manipulation (DML)</span>
                  <span class="skill-chip">Schema Design (DDL)</span>
                  <span class="skill-chip">Constraints &amp; DB Security</span>
                </div>
              </div>

              <!-- Footer & Signatures -->
              <div class="cert-footer">
                <div class="cert-meta">
                  <div class="meta-item">
                    <span class="meta-label">Tanggal Mula / Lulus</span>
                    <span class="meta-val">{issueDate}</span>
                  </div>
                  <div class="meta-item">
                    <span class="meta-label">Verifikasi Keabsahan</span>
                    <span class="meta-val">Terverifikasi Sistem</span>
                  </div>
                </div>

                <div class="signature-box">
                  <div class="sig-line">
                    <span class="sig-name">Suhendar Aryadi, S.Kom.</span>
                    <span class="sig-title">Guru Pengampu RPL / Web Developer</span>
                  </div>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>
    )}
  </div>
</MainLayout>

<script>
  document.getElementById('print-cert-btn')?.addEventListener('click', () => {
    window.print();
  });
</script>

<style>
  .cert-page-container {
    max-width: 960px;
    margin: 1.5rem auto 3.5rem;
    padding: 0 1rem;
  }

  /* Locked Cert State */
  .locked-cert-card {
    padding: 3rem 2rem;
    text-align: center;
    max-width: 580px;
    margin: 2rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .locked-icon-wrap {
    width: 4.5rem;
    height: 4.5rem;
    border-radius: var(--radius-full);
    background: rgba(168, 85, 247, 0.12);
    color: #a855f7;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .locked-title {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .locked-desc {
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .progress-box {
    width: 100%;
    margin: 0.5rem 0;
  }

  .progress-text {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.5rem;
  }

  .progress-bar-track {
    height: 10px;
    background: var(--bg-tertiary);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .progress-bar-fill {
    height: 100%;
    background: var(--accent-gradient);
    border-radius: var(--radius-full);
  }

  .locked-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Certificate Paper Layout */
  .cert-actions-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .teacher-cert-note {
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-md);
    font-size: 0.875rem;
    color: var(--text-primary);
    margin-bottom: 1.25rem;
  }

  .certificate-paper {
    background: #ffffff;
    color: #0f172a;
    padding: 2.5rem;
    border-radius: 1.25rem;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.12);
    border: 1px solid rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .cert-border-outer {
    border: 3px double #0891b2;
    padding: 1.75rem;
    border-radius: 0.75rem;
  }

  .cert-border-inner {
    border: 1px solid rgba(8, 145, 178, 0.3);
    padding: 2rem 2.5rem;
    border-radius: 0.5rem;
    position: relative;
  }

  .cert-watermark {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-15deg);
    font-size: 11rem;
    font-weight: 900;
    color: rgba(8, 145, 178, 0.03);
    user-select: none;
    pointer-events: none;
    letter-spacing: 0.05em;
  }

  .cert-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 2px solid #e2e8f0;
    padding-bottom: 1.25rem;
    margin-bottom: 2rem;
  }

  .cert-logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-badge {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.5rem;
    background: linear-gradient(135deg, #0891b2, #4f46e5);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .logo-title {
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #0f172a;
  }

  .cert-no {
    font-size: 0.85rem;
    color: #64748b;
    font-family: var(--font-mono);
  }

  .cert-body {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cert-main-title {
    font-size: 1.75rem;
    font-weight: 900;
    letter-spacing: 0.12em;
    color: #0891b2;
    margin-bottom: 0.5rem;
  }

  .cert-subtitle {
    font-size: 1rem;
    color: #64748b;
    margin-bottom: 1.5rem;
  }

  .student-name-box {
    margin-bottom: 1.5rem;
  }

  .student-name {
    font-size: 2.25rem;
    font-weight: 800;
    color: #0f172a;
    text-decoration: underline;
    text-underline-offset: 8px;
    text-decoration-color: #0891b2;
  }

  .student-class {
    font-size: 1rem;
    font-weight: 600;
    color: #0891b2;
    margin-top: 0.5rem;
  }

  .cert-statement {
    font-size: 1rem;
    color: #334155;
    max-width: 680px;
    margin: 0 auto 1.5rem;
    line-height: 1.7;
  }

  .rank-achievement {
    margin-bottom: 1.75rem;
  }

  .achievement-badge {
    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: #ffffff;
    font-weight: 800;
    font-size: 0.875rem;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    letter-spacing: 0.05em;
    box-shadow: 0 4px 12px rgba(245, 158, 11, 0.3);
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    max-width: 720px;
    margin: 0 auto;
  }

  .skill-chip {
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    font-size: 0.775rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 0.375rem;
  }

  .cert-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    border-top: 2px solid #e2e8f0;
    padding-top: 1.75rem;
  }

  .cert-meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
  }

  .meta-label {
    font-size: 0.725rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .meta-val {
    font-size: 0.875rem;
    font-weight: 600;
    color: #0f172a;
  }

  .signature-box {
    text-align: center;
    min-width: 220px;
  }

  .sig-line {
    border-top: 1px dashed #94a3b8;
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
  }

  .sig-name {
    font-size: 1rem;
    font-weight: 700;
    color: #0f172a;
  }

  .sig-title {
    font-size: 0.8rem;
    color: #64748b;
  }

  /* Print Stylesheet */
  @media print {
    .no-print {
      display: none !important;
    }
    body {
      background: #ffffff !important;
    }
    .cert-page-container {
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    }
    .certificate-paper {
      box-shadow: none !important;
      border: none !important;
      padding: 1.5rem !important;
    }
  }
</style>
