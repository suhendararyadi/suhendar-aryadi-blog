---
import MainLayout from '../layouts/MainLayout.astro';

const subjects = [
  {
    code: 'PWPB',
    name: 'Pemrograman Web dan Perangkat Bergerak',
    level: 'Kelas XI & XII RPL',
    description: 'Mengajarkan dasar-dasar HTML5, CSS3, JavaScript ES6+, kerangka kerja web modern (Astro/React/Laravel), serta dasar pengembangan aplikasi mobile.',
  },
  {
    code: 'PBO',
    name: 'Pemrograman Berorientasi Objek',
    level: 'Kelas XI RPL',
    description: 'Konsep dasar OOP (Encapsulation, Inheritance, Polymorphism, Abstraction) menggunakan bahasa pemrograman Java dan C#.',
  },
  {
    code: 'BD',
    name: 'Basis Data & SQL',
    level: 'Kelas X & XI RPL',
    description: 'Perancangan ERD, Normalisasi data, serta DDL, DML, DCL menggunakan RDBMS Relasional seperti MySQL dan PostgreSQL.',
  },
  {
    code: 'PKK',
    name: 'Produk Kreatif & Kewirausahaan IT',
    level: 'Kelas XII RPL',
    description: 'Pengembangan produk perangkat lunak bernilai jual, simulasi start-up IT, riset pasar, dan Software Product Lifecycle.',
  },
];

const skills = [
  { category: 'Web Development', items: ['HTML5 & CSS3', 'JavaScript ES6+', 'Astro Framework', 'React.js', 'PHP / Laravel', 'Tailwind CSS'] },
  { category: 'Database & Systems', items: ['MySQL', 'PostgreSQL', 'RESTful API Design', 'Database Normalization', 'ERD Modeling'] },
  { category: 'Tools & DevOps', items: ['Git & GitHub', 'VS Code', 'Linux CLI', 'Netlify / Vercel Hosting', 'npm / Node.js'] },
  { category: 'Kompetensi Vokasi', items: ['Kurikulum Merdeka SMK', 'Penyusunan Modul Ajar', 'Pembimbing LKS RPL', 'Pembimbing PKL Industri'] },
];
---

<MainLayout 
  title="Tentang Guru | Suhendar Aryadi, S.Pd.,Gr."
  description="Profil profesional, latar belakang pendidikan, mata pelajaran yang diampu, dan kompetensi Suhendar Aryadi, S.Pd.,Gr. sebagai Guru Rekayasa Perangkat Lunak (RPL) SMK."
>
  <div class="tentang-container">
    <!-- Hero Profile Header -->
    <header class="m3-card m3-card-elevated profile-card">
      <div class="profile-content">
        <div class="profile-avatar">
          <div class="avatar-fallback">SA</div>
        </div>
        <div class="profile-info">
          <span class="m3-chip m3-chip-tonal-primary">Guru RPL SMK &amp; Web Developer</span>
          <h1 class="profile-name">Suhendar Aryadi, S.Pd.,Gr.</h1>
          <p class="profile-bio">
            Pendidik vokasi profesional di bidang <strong>Rekayasa Perangkat Lunak (RPL)</strong> (S.Pd.,Gr.). Berkomitmen mendidik calon pengembang perangkat lunak muda yang kompeten, berdaya saing tinggi, dan memiliki karakter profesional di industri digital.
          </p>
          <div class="profile-contact-tags">
            <span class="m3-chip m3-chip-outline"><span class="material-symbols-rounded">location_on</span> Indonesia</span>
            <span class="m3-chip m3-chip-outline"><span class="material-symbols-rounded">school</span> Edukasi &amp; Vokasi IT</span>
            <span class="m3-chip m3-chip-outline"><span class="material-symbols-rounded">code</span> Web Engineering</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Section 1: Mata Pelajaran yang Diampu -->
    <section class="section mt-10">
      <div class="section-header">
        <h2 class="section-title">Mata Pelajaran yang Diampu</h2>
        <p class="section-subtitle">Materi keahlian utama Jurusan Rekayasa Perangkat Lunak (RPL) SMK</p>
      </div>

      <div class="subjects-grid">
        {subjects.map((subj) => (
          <div class="m3-card m3-card-elevated subject-card">
            <div class="subject-header">
              <span class="m3-chip m3-chip-tonal-primary badge-code">{subj.code}</span>
              <span class="subject-level">{subj.level}</span>
            </div>
            <h3 class="subject-name">{subj.name}</h3>
            <p class="subject-desc">{subj.description}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 2: Kompetensi & Keahlian -->
    <section class="section mt-10">
      <div class="section-header">
        <h2 class="section-title">Kompetensi &amp; Keahlian Teknis</h2>
        <p class="section-subtitle">Penguasaan teknologi modern dan keahlian pedagogi vokasi</p>
      </div>

      <div class="skills-grid">
        {skills.map((group) => (
          <div class="m3-card m3-card-elevated skill-card">
            <h3 class="skill-category">{group.category}</h3>
            <ul class="skill-list">
              {group.items.map((item) => (
                <li class="skill-item">
                  <span class="material-symbols-rounded check-icon">check_circle</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <!-- Section 3: Visi & Misi Pembelajaran -->
    <section class="section mt-10">
      <div class="m3-card m3-card-elevated vision-card">
        <h2 class="vision-title">Visi &amp; Misi Pembelajaran Vokasi</h2>
        <div class="vision-grid">
          <div class="vision-box">
            <div class="vision-header-row">
              <span class="material-symbols-rounded vision-icon">lightbulb</span>
              <h3 class="vision-subhead">Visi</h3>
            </div>
            <p>
              Menjadi pendidik vokasi IT terdepan yang mampu menjembatani kurikulum sekolah dengan kebutuhan nyata industri perangkat lunak global.
            </p>
          </div>
          <div class="vision-box">
            <div class="vision-header-row">
              <span class="material-symbols-rounded vision-icon">flag</span>
              <h3 class="vision-subhead">Misi</h3>
            </div>
            <ul>
              <li>Menyediakan modul ajar &amp; praktikum berbasis proyek industri (Project-Based Learning).</li>
              <li>Membimbing siswa menguasai <em>coding standard</em>, konsep arsitektur bersih, dan kolaborasi tim.</li>
              <li>Mendorong inovasi dan jiwa kewirausahaan teknologi bagi generasi muda SMK.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>
  </div>
</MainLayout>

<style>
  .tentang-container {
    max-width: 960px;
    margin: 0 auto;
    padding: 1rem 0 3rem;
  }

  .mt-10 {
    margin-top: 3.5rem;
  }

  /* Profile Card Header */
  .profile-card {
    padding: 2.5rem;
    border-radius: var(--radius-2xl, 28px);
  }

  @media (max-width: 640px) {
    .profile-card {
      padding: 1.5rem;
    }
  }

  .profile-content {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
  }

  @media (max-width: 768px) {
    .profile-content {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }
  }

  .profile-avatar {
    flex-shrink: 0;
  }

  .avatar-fallback {
    width: 6.5rem;
    height: 6.5rem;
    border-radius: var(--radius-2xl, 28px);
    background: var(--m3-primary, #005ac1);
    color: var(--m3-on-primary, #ffffff);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2.25rem;
    font-weight: 800;
    box-shadow: 0 4px 12px rgba(0, 90, 193, 0.25);
  }

  .profile-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.65rem;
  }

  @media (max-width: 768px) {
    .profile-info {
      align-items: center;
    }
  }

  .profile-name {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.2;
    margin: 0.25rem 0;
    color: var(--m3-on-surface, #1a1b1f);
  }

  @media (max-width: 640px) {
    .profile-name {
      font-size: 1.75rem;
    }
  }

  .profile-bio {
    font-size: 1.05rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.65;
    margin: 0;
  }

  .profile-contact-tags {
    display: flex;
    gap: 0.65rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .profile-contact-tags {
      justify-content: center;
    }
  }

  .profile-contact-tags .material-symbols-rounded {
    font-size: 1rem;
    color: var(--m3-primary, #005ac1);
  }

  /* Section Header */
  .section-header {
    margin-bottom: 1.5rem;
  }

  .section-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--m3-on-surface, #1a1b1f);
  }

  .section-subtitle {
    font-size: 0.9375rem;
    color: var(--m3-on-surface-variant, #44474f);
    margin-top: 0.25rem;
  }

  /* Subjects Grid */
  .subjects-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .subject-card {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl, 16px);
  }

  .subject-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.85rem;
  }

  .badge-code {
    font-size: 0.75rem;
    font-weight: 700;
  }

  .subject-level {
    font-size: 0.75rem;
    color: var(--m3-outline, #74777f);
  }

  .subject-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--m3-on-surface, #1a1b1f);
    margin-bottom: 0.65rem;
    line-height: 1.35;
  }

  .subject-desc {
    font-size: 0.875rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.6;
    margin: 0;
  }

  /* Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .skill-card {
    padding: 1.5rem;
    border-radius: var(--radius-xl, 16px);
  }

  .skill-category {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--m3-primary, #005ac1);
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--m3-outline-variant, #c4c6d0);
    padding-bottom: 0.5rem;
  }

  .skill-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .skill-item {
    font-size: 0.875rem;
    color: var(--m3-on-surface-variant, #44474f);
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .check-icon {
    font-size: 1.15rem;
    color: var(--m3-primary, #005ac1);
    flex-shrink: 0;
  }

  /* Vision Card */
  .vision-card {
    padding: 2.25rem;
    border-radius: var(--radius-2xl, 28px);
  }

  .vision-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--m3-on-surface, #1a1b1f);
    margin: 0 0 1.5rem;
  }

  .vision-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .vision-grid {
      grid-template-columns: 1fr;
    }
  }

  .vision-header-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .vision-icon {
    font-size: 1.35rem;
    color: var(--m3-primary, #005ac1);
  }

  .vision-subhead {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--m3-on-surface, #1a1b1f);
    margin: 0;
  }

  .vision-box p {
    font-size: 0.9375rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.65;
    margin: 0;
  }

  .vision-box ul {
    font-size: 0.9375rem;
    color: var(--m3-on-surface-variant, #44474f);
    line-height: 1.65;
    padding-left: 1.25rem;
    margin: 0;
  }

  .vision-box li {
    margin-bottom: 0.5rem;
  }
</style>
