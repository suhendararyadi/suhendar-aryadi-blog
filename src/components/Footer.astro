---
const currentYear = new Date().getFullYear();
---

<footer class="cooldock-footer">
  <!-- Landscape Image Overlay with Fade Gradient -->
  <div class="footer-bg-wrapper">
    <img src="/images/footer-bg.jpg" alt="Footer Landscape" class="footer-bg-img" />
    <div class="footer-bg-gradient"></div>
  </div>

  <div class="container footer-content-container">
    <div class="cooldock-grid">
      <!-- Left Column: Main Brand & CTA -->
      <div class="cooldock-brand-col">
        <a href="/" class="brand-badge">
          <span class="brand-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"></polyline><polyline points="8 6 2 12 8 18"></polyline></svg>
          </span>
          <span class="brand-title">Suhendar Aryadi</span>
        </a>

        <h2 class="brand-headline">Media Pembelajaran &amp; Portfolio IT</h2>
        
        <p class="brand-desc">
          Platform pembelajaran interaktif, praktikum visualizer 4 pilar BK, dan laboratorium latihan SQL gratis untuk siswa SMK RPL &amp; Informatika.
        </p>

        <a href="/belajar" class="cooldock-pill-btn">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          <span>Buka Katalog Belajar</span>
        </a>

        <div class="cooldock-meta">
          <span class="meta-copyright">&copy; {currentYear} suhendararyadi.com - All rights reserved</span>
          <div class="meta-author">
            <span>Built with <span class="heart-icon">&hearts;</span> by</span>
            <img src="/images/suhendar-avatar.jpg" alt="Suhendar Aryadi" class="author-avatar" />
            <span class="author-name">Suhendar Aryadi</span>
          </div>
        </div>
      </div>

      <!-- Right 3 Navigation Columns -->
      <div class="cooldock-nav-cols">
        <!-- Col 1: Menu -->
        <div class="nav-column">
          <h4 class="nav-col-title">Menu</h4>
          <ul class="nav-col-links">
            <li><a href="/">Beranda</a></li>
            <li><a href="/belajar">Katalog Belajar</a></li>
            <li><a href="/belajar/informatika/bk/lkpd">LKPD 4 Pilar BK</a></li>
            <li><a href="/belajar/sql">Interactive SQL Lab</a></li>
            <li><a href="/blog">Blog &amp; Tutorial</a></li>
          </ul>
        </div>

        <!-- Col 2: Navigation -->
        <div class="nav-column">
          <h4 class="nav-col-title">Navigasi</h4>
          <ul class="nav-col-links">
            <li><a href="/dashboard">Dashboard Saya</a></li>
            <li><a href="/admin/dashboard">Portal Guru / Admin</a></li>
            <li><a href="/portofolio">Portofolio Proyek</a></li>
            <li><a href="/tentang">Tentang Guru</a></li>
            <li><a href="/admin/dashboard" class="status-link"><span class="status-dot"></span> System Status</a></li>
          </ul>
        </div>

        <!-- Col 3: Ekosistem -->
        <div class="nav-column">
          <h4 class="nav-col-title">Ekosistem</h4>
          <ul class="nav-col-links">
            <li><a href="https://github.com/suhendararyadi" target="_blank" rel="noopener noreferrer">GitHub Profile</a></li>
            <li><a href="https://linkedin.com/in/suhendararyadi" target="_blank" rel="noopener noreferrer">LinkedIn Profile</a></li>
            <li><a href="https://neon.tech" target="_blank" rel="noopener noreferrer">Lakebase Postgres</a></li>
            <li><a href="https://vercel.com" target="_blank" rel="noopener noreferrer">Vercel Edge Platform</a></li>
            <li><a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro v4 Engine</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Giant Watermark Typography at Bottom -->
    <div class="cooldock-watermark" aria-hidden="true">
      SUHENDAR
    </div>
  </div>
</footer>

<style>
  /* --- Cooldock Footer Base --- */
  .cooldock-footer {
    position: relative;
    background-color: #edeceb;
    color: #1c1c1e;
    padding-top: 5rem;
    padding-bottom: 4rem;
    margin-top: auto;
    overflow: hidden;
    font-family: var(--font-family, system-ui, -apple-system, sans-serif);
    transition: background-color var(--transition-normal);
  }

  [data-theme="dark"] .cooldock-footer {
    background-color: #0c0d10;
    color: #f3f4f6;
  }

  /* --- Landscape Background Overlay --- */
  .footer-bg-wrapper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .footer-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
    opacity: 0.85;
    filter: saturate(1.25) contrast(1.05);
  }

  [data-theme="dark"] .footer-bg-img {
    opacity: 0.55;
    filter: brightness(0.75) contrast(1.25) saturate(1.2);
  }

  .footer-bg-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      #edeceb 0%,
      rgba(237, 236, 235, 0.35) 30%,
      rgba(237, 236, 235, 0.6) 100%
    );
  }

  [data-theme="dark"] .footer-bg-gradient {
    background: linear-gradient(
      to bottom,
      #0c0d10 0%,
      rgba(12, 13, 16, 0.4) 30%,
      rgba(12, 13, 16, 0.65) 100%
    );
  }

  .footer-content-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
  }

  /* --- Cooldock Main Grid Layout --- */
  .cooldock-grid {
    display: grid;
    grid-template-columns: 1.4fr 1.6fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 992px) {
    .cooldock-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  /* --- Left Brand Column --- */
  .cooldock-brand-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .brand-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.375rem 0.875rem 0.375rem 0.5rem;
    background: rgba(0, 0, 0, 0.05);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-full, 9999px);
    text-decoration: none;
    color: currentColor;
    transition: all 0.2s ease;
  }

  [data-theme="dark"] .brand-badge {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .brand-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background: #000000;
    color: #ffffff;
    border-radius: 8px;
  }

  [data-theme="dark"] .brand-icon {
    background: #ffffff;
    color: #000000;
  }

  .brand-title {
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .brand-headline {
    font-size: 2rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: #0f172a;
    margin: 0;
  }

  [data-theme="dark"] .brand-headline {
    color: #ffffff;
  }

  .brand-desc {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: #475569;
    max-width: 440px;
    margin: 0;
  }

  [data-theme="dark"] .brand-desc {
    color: #94a3b8;
  }

  .cooldock-pill-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.875rem 1.625rem;
    background: #0f172a;
    color: #ffffff;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.25);
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  [data-theme="dark"] .cooldock-pill-btn {
    background: #ffffff;
    color: #0f172a;
    box-shadow: 0 10px 25px -5px rgba(255, 255, 255, 0.2);
  }

  .cooldock-pill-btn:hover {
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 14px 30px -5px rgba(15, 23, 42, 0.35);
  }

  .cooldock-meta {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin-top: 1rem;
    font-size: 0.8125rem;
    color: #64748b;
  }

  [data-theme="dark"] .cooldock-meta {
    color: #64748b;
  }

  .meta-author {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .author-avatar {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid rgba(0, 0, 0, 0.1);
  }

  .author-name {
    font-weight: 600;
    color: #334155;
  }

  [data-theme="dark"] .author-name {
    color: #cbd5e1;
  }

  .heart-icon {
    color: #006fff;
  }

  /* --- Right 3 Navigation Columns --- */
  .cooldock-nav-cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  @media (max-width: 640px) {
    .cooldock-nav-cols {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1.5rem;
    }
  }

  .nav-column {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .nav-col-title {
    font-size: 0.9375rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0;
    letter-spacing: -0.01em;
  }

  [data-theme="dark"] .nav-col-title {
    color: #ffffff;
  }

  .nav-col-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .nav-col-links a {
    font-size: 0.875rem;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease, transform 0.15s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  [data-theme="dark"] .nav-col-links a {
    color: #94a3b8;
  }

  .nav-col-links a:hover {
    color: #006fff;
    transform: translateX(2px);
  }

  [data-theme="dark"] .nav-col-links a:hover {
    color: #38bdf8;
  }

  .status-link {
    font-weight: 600;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: #10b981;
    display: inline-block;
    box-shadow: 0 0 6px #10b981;
  }

  /* --- Giant Watermark Typography --- */
  .cooldock-watermark {
    font-size: clamp(4rem, 14vw, 15rem);
    font-weight: 900;
    letter-spacing: -0.05em;
    line-height: 0.85;
    text-align: center;
    color: rgba(0, 0, 0, 0.12);
    margin-top: 2rem;
    user-select: none;
    pointer-events: none;
    text-transform: uppercase;
  }

  [data-theme="dark"] .cooldock-watermark {
    color: rgba(255, 255, 255, 0.1);
  }
</style>
