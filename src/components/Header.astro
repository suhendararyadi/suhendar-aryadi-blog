---
import ThemeToggle from './ThemeToggle.astro';
import { getSessionUser } from '../lib/auth';

const pathname = new URL(Astro.request.url).pathname;

const sessionId = Astro.cookies.get('session_id')?.value;
let user: any = null;
try {
  user = await getSessionUser(sessionId);
} catch (e) {
  // Ignore fallback during build
}

const isTeacherOrAdmin = user?.role === 'teacher' || user?.role === 'admin' || (user?.email && user.email.toLowerCase().includes('suhendar'));

const navItems = [
  { href: '/belajar', label: 'Pembelajaran' },
  { href: '/materi', label: 'Materi RPL' },
  { href: '/blog', label: 'Artikel & Tutorial' },
  { href: '/portofolio', label: 'Portofolio' },
  { href: '/tentang', label: 'Tentang Guru' },
];

function isActive(href: string): boolean {
  if (href === '/') {
    return pathname === '/';
  }
  return pathname === href || pathname.startsWith(href + '/');
}
---

<header class="header">
  <div class="container header-container">
    <a href="/" class="logo">
      <div class="logo-icon-spine">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"></path>
        </svg>
      </div>
      <span class="logo-spine-text">Suhendar<span class="logo-spine-bold">Aryadi</span></span>
    </a>

    <nav class="nav-desktop">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class:list={['nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <ThemeToggle />
      {user ? (
        isTeacherOrAdmin ? (
          <a href="/admin/dashboard" class="btn btn-primary btn-sm header-auth-btn">
            <span>Portal Guru</span>
          </a>
        ) : (
          <a href="/dashboard" class="btn btn-outline btn-sm header-auth-btn">
            <span>Dashboard Saya</span>
          </a>
        )
      ) : (
        <a href="/auth/login" class="btn btn-primary btn-sm header-auth-btn">
          <span>Masuk Akun</span>
        </a>
      )}
      <button id="mobile-menu-toggle" class="mobile-toggle" aria-label="Buka Menu Navigasi" aria-expanded="false">
        <svg class="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="12" x2="20" y2="12"></line>
          <line x1="4" y1="6" x2="20" y2="6"></line>
          <line x1="4" y1="18" x2="20" y2="18"></line>
        </svg>
        <svg class="close-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-nav" class="nav-mobile">
    <div class="container mobile-nav-content">
      {navItems.map(item => (
        <a 
          href={item.href} 
          class:list={['mobile-nav-link', { active: isActive(item.href) }]}
        >
          {item.label}
        </a>
      ))}
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(7, 10, 18, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    transition: all 0.2s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4.5rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
  }

  .logo-icon-spine {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--radius-md);
    background: #84cc16;
    color: #080c14;
    box-shadow: 0 2px 12px rgba(132, 204, 22, 0.35);
  }

  .logo-spine-text {
    font-size: 1.25rem;
    font-weight: 500;
    color: #ffffff;
    letter-spacing: -0.03em;
  }

  .logo-spine-bold {
    font-weight: 800;
    color: #ffffff;
  }

  .nav-desktop {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 768px) {
    .nav-desktop {
      display: none;
    }
  }

  .nav-link {
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: #cbd5e1;
    transition: all 0.2s ease;
  }

  .nav-link:hover {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.06);
  }

  .nav-link.active {
    color: #84cc16;
    background-color: rgba(132, 204, 22, 0.1);
    font-weight: 600;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .header-auth-btn {
    border-radius: 9999px !important;
    background: rgba(255, 255, 255, 0.08) !important;
    border: 1px solid rgba(255, 255, 255, 0.18) !important;
    color: #ffffff !important;
    font-weight: 600 !important;
    padding: 0.45rem 1.25rem !important;
    transition: all 0.2s ease !important;
  }

  .header-auth-btn:hover {
    background: rgba(255, 255, 255, 0.16) !important;
    border-color: rgba(132, 204, 22, 0.5) !important;
    transform: translateY(-1px);
  }

  .mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-lg);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .mobile-toggle {
      display: flex;
    }
  }

  .close-icon {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .hamburger-icon {
    display: none;
  }

  .mobile-toggle[aria-expanded="true"] .close-icon {
    display: block;
  }

  .nav-mobile {
    display: none;
    border-top: 1px solid var(--border-subtle);
    background: var(--bg-secondary);
    padding: 1rem 0;
  }

  .nav-mobile.open {
    display: block;
  }

  @media (min-width: 769px) {
    .nav-mobile {
      display: none !important;
    }
  }

  .mobile-nav-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .mobile-nav-link {
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .mobile-nav-link:hover {
    color: var(--text-primary);
    background-color: var(--bg-tertiary);
  }

  .mobile-nav-link.active {
    color: var(--accent-primary);
    background-color: rgba(99, 102, 241, 0.1);
    font-weight: 600;
  }
</style>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileNav = document.getElementById('mobile-nav');

    if (!toggleBtn || !mobileNav) return;

    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      mobileNav.classList.toggle('open');
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>
